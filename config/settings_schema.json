[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "manrope_n4",
        "label": "t:general.primary"
      },
      {
        "type": "range",
        "id": "body_type_scale",
        "label": "Body font size scale",
        "min": 75,
        "max": 150,
        "step": 1,
        "unit": "%",
        "default": 100,
        "info": "Scales all body text sizes proportionally."
      }
    ]
  },
  {
    "name": "Headings",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "syne_n4",
        "label": "Font"
      },
      {
        "type": "range",
        "id": "heading_hero_scale",
        "label": "Hero font size scale",
        "min": 75,
        "max": 175,
        "step": 1,
        "unit": "%",
        "default": 120
      },
      {
        "type": "range",
        "id": "heading_xl_scale",
        "label": "Extra large font size scale",
        "min": 75,
        "max": 175,
        "step": 1,
        "unit": "%",
        "default": 122
      },
      {
        "type": "range",
        "id": "heading_lg_scale",
        "label": "Large font size scale",
        "min": 75,
        "max": 175,
        "step": 1,
        "unit": "%",
        "default": 110
      },
      {
        "type": "range",
        "id": "heading_md_scale",
        "label": "Medium font size scale",
        "min": 75,
        "max": 175,
        "step": 1,
        "unit": "%",
        "default": 113
      },
      {
        "type": "range",
        "id": "heading_sm_scale",
        "label": "Small font size scale",
        "min": 75,
        "max": 175,
        "step": 1,
        "unit": "%",
        "default": 110
      },
      {
        "type": "range",
        "id": "heading_xs_scale",
        "label": "Extra small font size scale",
        "min": 75,
        "max": 175,
        "step": 1,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "Headings letter spacing",
        "min": -1,
        "max": 1,
        "step": 0.1,
        "default": -0.2
      },
      {
        "type": "range",
        "id": "heading_line_height",
        "label": "Headings line height",
        "min": 0.8,
        "max": 2.5,
        "step": 0.1,
        "default": 1.1
      },
      {
        "type": "select",
        "id": "heading_text_transform",
        "label": "Text transform",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "uppercase", "label": "Uppercase" },
          { "value": "capitalize", "label": "Capitalize" }
        ],
        "default": "uppercase"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#deddd8",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#0a0a09",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#ed9d09",
        "label": "Accent colour",
        "info": "Used for eyebrows, badges, hover highlights, and CTAs across the theme."
      },
      {
        "type": "color",
        "id": "white_color",
        "default": "#ffffff",
        "label": "White",
        "info": "Pure white used for max-brightness text on dark surfaces (e.g. header nav)."
      },
      {
        "type": "header",
        "content": "Feedback colours"
      },
      {
        "type": "color",
        "id": "success_color",
        "default": "#2e7d32",
        "label": "Success",
        "info": "Used for success states (e.g. in-stock, confirmation messages)."
      },
      {
        "type": "color",
        "id": "error_color",
        "default": "#c62828",
        "label": "Error",
        "info": "Used for error states (e.g. validation, sold out)."
      },
      {
        "type": "header",
        "content": "Corners"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 1000,
        "step": 10,
        "unit": "px",
        "label": "Button corner radius",
        "default": 1000,
        "info": "1000 = pill shape. Use lower values for rounded rectangles."
      }
    ]
  },
  {
    "name": "Spacing & sizing",
    "settings": [
      {
        "type": "range",
        "id": "section_spacing_scale",
        "label": "Section spacing scale",
        "min": 50,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100,
        "info": "Scales the vertical padding between sections proportionally."
      },
      {
        "type": "range",
        "id": "header_height",
        "label": "Header height",
        "min": 56,
        "max": 120,
        "step": 1,
        "unit": "px",
        "default": 88,
        "info": "Maximum header height on desktop. Shrinks responsively on smaller screens."
      },
      {
        "type": "range",
        "id": "border_strength",
        "label": "Border strength",
        "min": 25,
        "max": 250,
        "step": 5,
        "unit": "%",
        "default": 100,
        "info": "Controls how visible borders and dividers are across the theme."
      }
    ]
  }
]
