{% style %}
  {% # Loads all font variations with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {% # Heading font %}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

  {%- liquid
    assign moov_accent = settings.accent_color | default: '#ed9d09'
    assign moov_cream = settings.background_color | default: '#deddd8'
    assign moov_black = settings.foreground_color | default: '#0a0a09'
    assign moov_white = settings.white_color | default: '#ffffff'
    assign moov_success = settings.success_color | default: '#2e7d32'
    assign moov_error = settings.error_color | default: '#c62828'

    assign type_scale = settings.body_type_scale | default: 100 | divided_by: 100.0
    assign section_scale = settings.section_spacing_scale | default: 100 | divided_by: 100.0
    assign header_max = settings.header_height | default: 88

    # Border/divider/surface alphas derive from a single strength knob.
    # Base alpha 0.10 at 100% strength; scale proportionally.
    assign border_factor = settings.border_strength | default: 100 | divided_by: 100.0
    assign border_alpha = border_factor | times: 0.10
    assign divider_alpha = border_factor | times: 0.07
    assign surface_raised_alpha = border_factor | times: 0.04
    assign surface_elevated_alpha = border_factor | times: 0.06
  -%}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    /* Same cap as how-it-works main column + .shopify-section grid — use for full-width section innards */
    --layout-max-width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    /* Same cap as how-it-works main column + .shopify-section grid — use for full-width section innards */
    --layout-max-width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    --color-background: {{ moov_black }};
    --color-foreground: {{ moov_cream }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --style-border-radius-buttons: {{ settings.button_corner_radius }}px;
    --color-accent: {{ moov_accent }};

    /* Moov brand fonts */
    --font-hero: {{ settings.type_heading_font.family }}, 'Syne', 'Helvetica Neue', sans-serif;
    --font-body: {{ settings.type_primary_font.family }}, 'Manrope', 'Helvetica Neue', sans-serif;
    --font-display: var(--font-body);

    /* Heading settings */
    --heading-letter-spacing: {{ settings.heading_letter_spacing }}em;
    --heading-line-height: {{ settings.heading_line_height }};
    --heading-text-transform: {{ settings.heading_text_transform }};

    /* Heading size scales (base sizes × scale factor) */
    {%- assign s_hero = settings.heading_hero_scale | divided_by: 100.0 -%}
    {%- assign s_xl   = settings.heading_xl_scale   | divided_by: 100.0 -%}
    {%- assign s_lg   = settings.heading_lg_scale   | divided_by: 100.0 -%}
    {%- assign s_md   = settings.heading_md_scale   | divided_by: 100.0 -%}
    {%- assign s_sm   = settings.heading_sm_scale   | divided_by: 100.0 -%}
    {%- assign s_xs   = settings.heading_xs_scale   | divided_by: 100.0 -%}
    --text-heading-hero: clamp({{ 2.25 | times: s_hero }}rem, {{ 5 | times: s_hero }}vw, {{ 4.5 | times: s_hero }}rem);
    --text-heading-xl:   clamp({{ 1.75 | times: s_xl }}rem,  {{ 3 | times: s_xl }}vw,  {{ 3.5 | times: s_xl }}rem);
    --text-heading-lg:   clamp({{ 1.5  | times: s_lg }}rem,  {{ 2 | times: s_lg }}vw,  {{ 2.75 | times: s_lg }}rem);
    --text-heading-md:   clamp({{ 1.25 | times: s_md }}rem,  {{ 1.5 | times: s_md }}vw, {{ 2 | times: s_md }}rem);
    --text-heading-sm:   clamp({{ 1.125 | times: s_sm }}rem, {{ 1 | times: s_sm }}vw,  {{ 1.5 | times: s_sm }}rem);
    --text-heading-xs:   clamp({{ 1.0 | times: s_xs }}rem,   {{ 0.5 | times: s_xs }}vw, {{ 1.25 | times: s_xs }}rem);

    /* Brand palette: cream “white”, near-black, accent (editable under Theme settings → Colors) */
    --moov-black: {{ moov_black }};
    --moov-white: {{ moov_white }};
    --moov-cream: {{ moov_cream }};
    --moov-cream-shadow: {{ moov_cream | color_darken: 6 }};
    --moov-amber: {{ moov_accent }};
    --moov-amber-hover: {{ moov_accent | color_darken: 12 }};
    --moov-amber-glow: {{ moov_accent | color_modify: 'alpha', 0.07 }};

    /* Eyebrow accent — used for labels, badges, subtle highlights */
    --moov-eyebrow-accent: {{ moov_accent | color_modify: 'alpha', 0.7 }};

    /* Surface fills — subtle tinted backgrounds for cards & panels */
    --moov-surface-dark-raised: {{ moov_cream | color_modify: 'alpha', surface_raised_alpha }};
    --moov-surface-dark-divider: {{ moov_cream | color_modify: 'alpha', divider_alpha }};

    --moov-text-primary-dark: {{ moov_cream }};
    --moov-text-secondary-dark: {{ moov_cream | color_modify: 'alpha', 0.96 }};
    --moov-text-tertiary-dark: {{ moov_cream | color_modify: 'alpha', 0.88 }};
    --moov-text-quaternary-dark: {{ moov_cream | color_modify: 'alpha', 0.72 }};

    --moov-text-primary-light: {{ moov_black }};
    --moov-text-secondary-light: {{ moov_black | color_modify: 'alpha', 0.90 }};
    --moov-text-tertiary-light: {{ moov_black | color_modify: 'alpha', 0.80 }};

    --moov-border-dark: {{ moov_cream | color_modify: 'alpha', border_alpha }};
    --moov-border-light: {{ moov_black | color_modify: 'alpha', border_alpha }};
    --moov-border-amber: {{ moov_accent | color_modify: 'alpha', 0.35 }};

    /* Extra surfaces (avoid hard-coded grays in sections) */
    --moov-surface-dark-elevated: {{ moov_cream | color_modify: 'alpha', surface_elevated_alpha }};
    --moov-wash-on-cream-4: color-mix(in srgb, var(--moov-black) 4%, var(--moov-cream));
    --moov-wash-on-cream-6: color-mix(in srgb, var(--moov-black) 6%, var(--moov-cream));
    --moov-surface-section-rail: color-mix(in srgb, var(--moov-cream) 94%, var(--moov-black));
    --moov-neutral-mid: color-mix(in srgb, var(--moov-cream) 72%, var(--moov-black));
    --moov-neutral-deep: color-mix(in srgb, var(--moov-cream) 58%, var(--moov-black));

    /* Feedback colours — success / error states (editable under Theme settings → Colors) */
    --moov-success: {{ moov_success }};
    --moov-success-bg: {{ moov_success | color_modify: 'alpha', 0.08 }};
    --moov-error: {{ moov_error }};
    --moov-error-bg: {{ moov_error | color_modify: 'alpha', 0.06 }};

    /*
      Fluid type scale — same ratio from mobile to large screens (clamp min / preferred / max).
      Tuned so body copy stays readable (~15px+) on small viewports.
    */
    --text-2xs: clamp({{ 0.75 | times: type_scale }}rem, {{ 0.15 | times: type_scale }}vw + {{ 0.64 | times: type_scale }}rem, {{ 0.9375 | times: type_scale }}rem);
    --text-eyebrow: clamp({{ 0.9375 | times: type_scale }}rem, {{ 0.4 | times: type_scale }}vw + {{ 0.75 | times: type_scale }}rem, {{ 1.25 | times: type_scale }}rem);
    --text-xs: clamp({{ 0.8125 | times: type_scale }}rem, {{ 0.15 | times: type_scale }}vw + {{ 0.7 | times: type_scale }}rem, {{ 1 | times: type_scale }}rem);
    --text-sm: clamp({{ 0.875 | times: type_scale }}rem, {{ 0.2 | times: type_scale }}vw + {{ 0.72 | times: type_scale }}rem, {{ 1.125 | times: type_scale }}rem);
    --text-base: clamp({{ 1 | times: type_scale }}rem, {{ 0.25 | times: type_scale }}vw + {{ 0.85 | times: type_scale }}rem, {{ 1.1875 | times: type_scale }}rem);
    --text-md: clamp({{ 1.0625 | times: type_scale }}rem, {{ 0.25 | times: type_scale }}vw + {{ 0.9 | times: type_scale }}rem, {{ 1.3125 | times: type_scale }}rem);
    --text-lg: clamp({{ 1.1875 | times: type_scale }}rem, {{ 0.3 | times: type_scale }}vw + {{ 0.99 | times: type_scale }}rem, {{ 1.4375 | times: type_scale }}rem);
    --text-xl: clamp({{ 1.4375 | times: type_scale }}rem, {{ 0.4 | times: type_scale }}vw + {{ 1.15 | times: type_scale }}rem, {{ 1.8125 | times: type_scale }}rem);
    --text-2xl: clamp({{ 1.75 | times: type_scale }}rem, {{ 0.5 | times: type_scale }}vw + {{ 1.35 | times: type_scale }}rem, {{ 2.25 | times: type_scale }}rem);
    --text-3xl: clamp({{ 2 | times: type_scale }}rem, {{ 0.8 | times: type_scale }}vw + {{ 1.44 | times: type_scale }}rem, {{ 2.75 | times: type_scale }}rem);
    --text-4xl: clamp({{ 2.5 | times: type_scale }}rem, {{ 1.2 | times: type_scale }}vw + {{ 1.66 | times: type_scale }}rem, {{ 3.5 | times: type_scale }}rem);
    --text-5xl: clamp({{ 3 | times: type_scale }}rem, {{ 1.5 | times: type_scale }}vw + {{ 1.94 | times: type_scale }}rem, {{ 4 | times: type_scale }}rem);

    --header-height: clamp(4rem, 1vw + 3.5rem, {{ header_max }}px);
    --announcement-height: 2.25rem;
    --moov-announcement-offset: max(3.75rem, 60px);
    --section-inline-pad: clamp(1rem, 4vw + 0.75rem, 5rem);
    /* Vertical rhythm — use together with --section-inline-pad for section padding */
    --section-block-pad-y: clamp({{ 3 | times: section_scale }}rem, {{ 8 | times: section_scale }}vw, {{ 7.5 | times: section_scale }}rem);
    --section-block-pad-y-sm: clamp({{ 2.5 | times: section_scale }}rem, {{ 5 | times: section_scale }}vw, {{ 4 | times: section_scale }}rem);
    --section-block-pad-y-md: clamp({{ 3.5 | times: section_scale }}rem, {{ 7 | times: section_scale }}vw, {{ 6.25 | times: section_scale }}rem);
    --section-block-pad-y-lg: clamp({{ 4 | times: section_scale }}rem, {{ 9 | times: section_scale }}vw, {{ 8.75 | times: section_scale }}rem);
    --section-block-pad-y-xl: clamp({{ 5 | times: section_scale }}rem, {{ 11 | times: section_scale }}vw, {{ 10 | times: section_scale }}rem);
    --section-block-pad-y-hero: clamp({{ 5.5 | times: section_scale }}rem, {{ 14 | times: section_scale }}vw, {{ 10 | times: section_scale }}rem);
    --section-block-pad-y-hero-bottom: clamp({{ 3.5 | times: section_scale }}rem, {{ 8 | times: section_scale }}vw, {{ 7.5 | times: section_scale }}rem);
  }
  /* ── Page shell ── */
  html {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }
{% endstyle %}
