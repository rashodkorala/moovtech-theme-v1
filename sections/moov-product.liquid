{%- liquid
  assign product_eyebrow = product.metafields.custom.eyebrow
  if product_eyebrow == blank
    assign product_eyebrow = section.settings.product_eyebrow
  endif
  if product_eyebrow == blank
    assign product_eyebrow = 'store_marketing.badge_category' | t
  endif

  assign product_subtitle = product.metafields.custom.subtitle
  if product_subtitle == blank
    assign product_subtitle = section.settings.product_subtitle
  endif
-%}

{%- comment -%} ═══ STICKY MINI-BAR ═══ {%- endcomment -%}
<div class="moov-mini-bar" data-surface="dark">
  <div class="moov-mini-bar__inner">
    <div class="moov-mini-bar__left">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 80 | image_tag: class: 'moov-mini-bar__img', alt: product.title | escape }}
      {%- endif -%}
      <span class="moov-mini-bar__name">{{ product.title }}</span>
    </div>
    <nav class="moov-mini-bar__links" aria-label="{{ 'product.mini_bar.nav_label' | t }}">
      <a href="#moov-product-story" class="moov-mini-bar__link">{{ 'product.mini_bar.story' | t }}</a>
      <a href="#moov-specs" class="moov-mini-bar__link">{{ 'product.mini_bar.specs' | t }}</a>
      <a href="#moov-product-returns" class="moov-mini-bar__link">{{ 'product.mini_bar.returns' | t }}</a>
    </nav>
    <a href="#moov-product-cta" class="moov-mini-bar__cta">{{ 'product.pre_order' | t }}</a>
  </div>
</div>

{%- comment -%} ═══ SECTION 1: PRODUCT INTRO (cream surface) ═══ {%- endcomment -%}
<div class="moov-prod-intro full-width" data-surface="cream" id="moov-product-hero">
  <div class="moov-prod-intro__inner">
    {%- comment -%} Left — Image carousel {%- endcomment -%}
    <div class="moov-prod-intro__gallery">
      <div class="moov-prod-intro__main-image">
        {%- for image in product.images limit: 5 -%}
          <div class="moov-prod-intro__slide {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
            {{ image | image_url: width: 900 | image_tag: loading: 'eager', alt: image.alt | default: product.title | escape }}
          </div>
        {%- endfor -%}
        {%- if product.images.size > 1 -%}
          <button type="button" class="moov-prod-intro__nav-btn moov-prod-intro__nav-btn--prev" aria-label="Previous image">
            <span aria-hidden="true">&lsaquo;</span>
          </button>
          <button type="button" class="moov-prod-intro__nav-btn moov-prod-intro__nav-btn--next" aria-label="Next image">
            <span aria-hidden="true">&rsaquo;</span>
          </button>
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="moov-prod-intro__thumbs">
          {%- for image in product.images limit: 5 -%}
            <button class="moov-prod-intro__thumb {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="{{ 'general.accessibility.view_image' | t: index: forloop.index }}">
              {{ image | image_url: width: 120 | image_tag: alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Right — Product details {%- endcomment -%}
    <div class="moov-prod-intro__details">
      {%- liquid
        assign color_swatches = section.blocks | where: 'type', 'color_swatch'
        assign trust_items = section.blocks | where: 'type', 'trust_item'
        assign current_variant = product.selected_or_first_available_variant
        assign is_new = false
        if product.tags contains 'new'
          assign is_new = true
        endif
        if product.tags contains 'New'
          assign is_new = true
        endif
      -%}

      {%- comment -%} Breadcrumb + "New" chip {%- endcomment -%}
      <div class="moov-prod-intro__topline">
        <nav class="moov-prod-intro__crumbs" aria-label="{{ 'general.accessibility.breadcrumb' | t }}">
          <a href="{{ routes.collections_url }}">{{ 'product.hero.breadcrumb_shop' | t }}</a>
          {%- if product.collections.first -%}
            <span class="moov-prod-intro__crumb-sep" aria-hidden="true">›</span>
            <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
          {%- endif -%}
        </nav>
        {%- if is_new -%}
          <span class="moov-prod-intro__chip">{{ 'product.hero.new' | t }}</span>
        {%- endif -%}
      </div>

      {%- if product_eyebrow != blank -%}
        <p class="moov-prod-intro__eyebrow">{{ product_eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="moov-prod-intro__title">{{ product.title }}</h1>
      {%- if product_subtitle != blank -%}
        <p class="moov-prod-intro__subtitle">{{ product_subtitle | escape }}</p>
      {%- endif -%}

      {%- comment -%} Price + rating row {%- endcomment -%}
      <div class="moov-prod-intro__priceline">
        <div class="moov-prod-intro__price">
          <span class="moov-prod-intro__price-current" data-price>{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="moov-prod-intro__price-compare" data-compare-price>{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
        {%- assign rating_metafield = product.metafields.reviews.rating.value -%}
        {%- assign rating_count = product.metafields.reviews.rating_count -%}
        {%- if rating_metafield -%}
          {%- assign rating_score = rating_metafield.rating | default: rating_metafield -%}
          {%- assign rating_number = rating_score | times: 1.0 -%}
          {%- if rating_number > 0 -%}
            {%- assign full_stars = rating_number | floor -%}
            <a href="#moov-reviews" class="moov-prod-intro__rating" aria-label="{{ 'sections.reviews.out_of_5' | t: score: rating_number }}">
              <span class="moov-prod-intro__rating-stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- if i <= full_stars -%}
                    <span class="moov-prod-intro__star moov-prod-intro__star--on">★</span>
                  {%- else -%}
                    <span class="moov-prod-intro__star">★</span>
                  {%- endif -%}
                {%- endfor -%}
              </span>
              <span class="moov-prod-intro__rating-text">
                {{- rating_number -}}/5
                {%- if rating_count -%}
                  <span class="moov-prod-intro__rating-count">({{ rating_count }})</span>
                {%- endif -%}
              </span>
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- comment -%} Product description (full) {%- endcomment -%}
      {%- if product.description != blank -%}
        <div class="moov-prod-intro__desc-wrap">
          <div class="moov-prod-intro__desc-rich">{{ product.description }}</div>
        </div>
      {%- endif -%}

      {%- comment -%} Product form (variants + qty + CTA + delivery) {%- endcomment -%}
      <form
        id="moov-product-cta"
        action="{{ routes.cart_add_url }}"
        method="post"
        enctype="multipart/form-data"
        class="moov-prod-intro__form"
        data-product-form
        data-section-id="{{ section.id }}"
      >
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign opt_name_down = option.name | downcase
              assign is_color = false
              if opt_name_down == 'color'
                assign is_color = true
              endif
              if opt_name_down == 'colour'
                assign is_color = true
              endif
            -%}

            {%- if is_color -%}
              <div class="moov-prod-intro__option moov-prod-intro__option--swatches" data-option-index="{{ forloop.index0 }}">
                <p class="moov-prod-intro__option-label">
                  {{ option.name | escape }}:
                  <strong data-selected-value>{{ option.selected_value | escape }}</strong>
                </p>
                <div class="moov-prod-intro__swatches" role="radiogroup" aria-label="{{ option.name | escape }}">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign swatch_color = ''
                      for swatch in color_swatches
                        assign sw_val = swatch.settings.value | downcase | strip
                        assign opt_val = value | downcase | strip
                        if sw_val == opt_val
                          assign swatch_color = swatch.settings.color
                          break
                        endif
                      endfor
                      if swatch_color == blank
                        assign swatch_color = value | downcase
                      endif
                    -%}
                    <button
                      type="button"
                      class="moov-prod-intro__swatch {% if value == option.selected_value %}is-selected{% endif %}"
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-value="{{ value | escape }}"
                      style="--swatch-color: {{ swatch_color | escape }};"
                      role="radio"
                      aria-checked="{% if value == option.selected_value %}true{% else %}false{% endif %}"
                      aria-label="{{ value | escape }}"
                      title="{{ value | escape }}"
                    >
                      <span class="moov-prod-intro__swatch-dot" aria-hidden="true"></span>
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- else -%}
              {%- if option.values.size > 1 -%}
                <label class="moov-prod-intro__dropdown" data-option-index="{{ forloop.index0 }}">
                  <span class="moov-prod-intro__dropdown-small">{{ 'product.hero.selected' | t }}</span>
                  <span class="moov-prod-intro__dropdown-value" data-selected-value>{{ option.selected_value | escape }}</span>
                  <svg class="moov-prod-intro__dropdown-chev" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M3 5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <select class="moov-prod-intro__dropdown-select" data-option-select aria-label="{{ option.name | escape }}">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if value == option.selected_value %}selected{% endif %}>{{ value | escape }}</option>
                    {%- endfor -%}
                  </select>
                </label>
              {%- else -%}
                <input type="hidden" data-option-single data-option-index="{{ forloop.index0 }}" value="{{ option.selected_value | escape }}">
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}

        {%- comment -%} Quantity stepper {%- endcomment -%}
        <div class="moov-prod-intro__qty">
          <span class="moov-prod-intro__qty-label">{{ 'product.hero.quantity' | t }}</span>
          <div class="moov-prod-intro__qty-stepper">
            <button type="button" class="moov-prod-intro__qty-btn" data-qty="down" aria-label="{{ 'cart.decrease' | t }}">−</button>
            <input
              type="number"
              name="quantity"
              value="1"
              min="1"
              step="1"
              inputmode="numeric"
              class="moov-prod-intro__qty-input"
              aria-label="{{ 'cart.quantity' | t }}"
            >
            <button type="button" class="moov-prod-intro__qty-btn" data-qty="up" aria-label="{{ 'cart.increase' | t }}">+</button>
          </div>
        </div>

        {%- assign available = current_variant.available -%}
        <button
          type="submit"
          class="moov-prod-intro__add-btn"
          data-add-btn
          data-label-available="{{ 'product.pre_order' | t | escape }}"
          data-label-unavailable="{{ 'product.sold_out_button' | t | escape }}"
          {% unless available %}disabled{% endunless %}
        >
          <span data-add-label>
            {%- if available -%}
              {{ 'product.pre_order' | t }}
            {%- else -%}
              {{ 'product.sold_out_button' | t }}
            {%- endif -%}
          </span>
        </button>

        {%- comment -%} Delivery micro-note {%- endcomment -%}
        <p class="moov-prod-intro__delivery">
          <span class="moov-prod-intro__delivery-dot moov-prod-intro__delivery-dot--{% if available %}ok{% else %}out{% endif %}" aria-hidden="true"></span>
          {%- if available -%}
            <span>{{ 'product.hero.in_stock' | t }}</span>
            {%- if section.settings.shipping_note != blank -%}
              <span class="moov-prod-intro__delivery-sep" aria-hidden="true">·</span>
              <span>{{ section.settings.shipping_note | escape }}</span>
            {%- endif -%}
          {%- else -%}
            <span>{{ 'shop.sold_out' | t }}</span>
          {%- endif -%}
        </p>
      </form>

      {%- comment -%} Trust strip {%- endcomment -%}
      {%- if trust_items.size > 0 -%}
        <ul class="moov-prod-intro__trust">
          {%- for item in trust_items -%}
            <li class="moov-prod-intro__trust-item" {{ item.shopify_attributes }}>
              <span class="moov-prod-intro__trust-icon" aria-hidden="true">
                {%- case item.settings.icon -%}
                  {%- when 'shipping' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- when 'trial' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                  {%- when 'warranty' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
                  {%- when 'secure' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
                {%- endcase -%}
              </span>
              <span class="moov-prod-intro__trust-label">{{ item.settings.label | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} Returns & refunds policy link {%- endcomment -%}
      {%- if section.settings.returns_link_label != blank -%}
        {%- assign returns_href = section.settings.returns_link_url -%}
        {%- if returns_href == blank -%}
          {%- assign returns_href = '/pages/returns-refunds' -%}
        {%- endif -%}
        <a href="{{ returns_href }}" class="moov-prod-intro__returns">
          <span class="moov-prod-intro__returns-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 1 0 3-6.7"/>
              <polyline points="3 4 3 9 8 9"/>
            </svg>
          </span>
          <span class="moov-prod-intro__returns-text">
            {{- section.settings.returns_link_label | escape -}}
          </span>
          <span class="moov-prod-intro__returns-arrow" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="13 6 19 12 13 18"/>
            </svg>
          </span>
        </a>
      {%- endif -%}

      {%- comment -%} Variant map for JS sync {%- endcomment -%}
      <script type="application/json" data-variant-map>
        {{ product.variants | json }}
      </script>
    </div>
  </div>
</div>

{%- comment -%} ═══ SECTION 6: TECH SPECS (dark surface) ═══ {%- endcomment -%}
<div class="moov-specs full-width" data-surface="dark" id="moov-specs">
  <div class="moov-specs__inner">
    <div class="moov-specs__layout">
      <aside class="moov-specs__aside">
        <p class="moov-specs__eyebrow">{{ section.settings.specs_eyebrow | default: 'Tech specs' | upcase | escape }}</p>
        {%- assign specs_title_words = 'product.specs.title' | t | split: ' ' -%}
        <h2 class="moov-specs__heading">
          {%- for word in specs_title_words -%}
            {{- word | escape -}}
            {%- unless forloop.last %}<br>{% endunless -%}
          {%- endfor -%}
        </h2>
        <p class="moov-specs__intro">{{ section.settings.specs_intro | default: 'Everything you need to know about MOOV hardware, connectivity, and in-box setup at a glance.' | escape }}</p>
      </aside>

      <div class="moov-specs__content">
        <div class="moov-specs__tabs" role="tablist">
          <button class="moov-specs__tab is-active" role="tab" aria-selected="true" data-tab="design">{{ 'product.specs.design' | t }}</button>
          <button class="moov-specs__tab" role="tab" aria-selected="false" data-tab="dimensions">{{ 'product.specs.dimensions' | t }}</button>
          <button class="moov-specs__tab" role="tab" aria-selected="false" data-tab="connectivity">{{ 'product.specs.connectivity' | t }}</button>
          <button class="moov-specs__tab" role="tab" aria-selected="false" data-tab="inbox">{{ 'product.specs.in_the_box' | t }}</button>
        </div>

        <div class="moov-specs__panel is-active" data-panel="design">
          <dl class="moov-specs__list">
            <div class="moov-specs__row"><dt>{{ 'product.specs.build' | t }}</dt><dd>{{ 'product.specs.build_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.led' | t }}</dt><dd>{{ 'product.specs.led_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.control' | t }}</dt><dd>{{ 'product.specs.control_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.mounting' | t }}</dt><dd>{{ 'product.specs.mounting_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.setup' | t }}</dt><dd>{{ 'product.specs.setup_val' | t }}</dd></div>
          </dl>
        </div>

        <div class="moov-specs__panel" data-panel="dimensions">
          <dl class="moov-specs__list">
            <div class="moov-specs__row"><dt>{{ 'product.specs.length' | t }}</dt><dd>{{ 'product.specs.length_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.width' | t }}</dt><dd>{{ 'product.specs.width_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.depth' | t }}</dt><dd>{{ 'product.specs.depth_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.battery' | t }}</dt><dd>{{ 'product.specs.battery_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.charging' | t }}</dt><dd>{{ 'product.specs.charging_val' | t }}</dd></div>
          </dl>
        </div>

        <div class="moov-specs__panel" data-panel="connectivity">
          <dl class="moov-specs__list">
            <div class="moov-specs__row"><dt>{{ 'product.specs.bluetooth' | t }}</dt><dd>{{ 'product.specs.bluetooth_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.android' | t }}</dt><dd>{{ 'product.specs.android_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.ios' | t }}</dt><dd>{{ 'product.specs.ios_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.alarm' | t }}</dt><dd>{{ 'product.specs.alarm_val' | t }}</dd></div>
            <div class="moov-specs__row"><dt>{{ 'product.specs.dismiss' | t }}</dt><dd>{{ 'product.specs.dismiss_val' | t }}</dd></div>
          </dl>
        </div>

        <div class="moov-specs__panel" data-panel="inbox">
          <dl class="moov-specs__list">
            <div class="moov-specs__row"><dt>1×</dt><dd>{{ 'product.specs.inbox_device' | t }}</dd></div>
            <div class="moov-specs__row"><dt>1×</dt><dd>{{ 'product.specs.inbox_mount' | t }}</dd></div>
            <div class="moov-specs__row"><dt>1×</dt><dd>{{ 'product.specs.inbox_strip' | t }}</dd></div>
            <div class="moov-specs__row"><dt>1×</dt><dd>{{ 'product.specs.inbox_charger' | t }}</dd></div>
            <div class="moov-specs__row"><dt>1×</dt><dd>{{ 'product.specs.inbox_guide' | t }}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>

{%- comment -%} ═══ SECTION 7: ACCESSORIES (dark surface) ═══ {%- endcomment -%}
{%- if product.collections.size > 0 -%}
  {%- assign related = product.collections.first.products -%}
  {%- if related.size > 1 -%}
    <div class="moov-accessories full-width" data-surface="dark">
      <div class="moov-accessories__inner">
        <h2 class="moov-accessories__heading">{{ 'product.accessories.title' | t }}</h2>
        <div class="moov-accessories__scroll">
          {%- for item in related limit: 8 -%}
            {%- if item.handle != product.handle -%}
              <a href="{{ item.url }}" class="moov-accessories__card">
                <div class="moov-accessories__card-img">
                  {%- if item.featured_image -%}
                    {{ item.featured_image | image_url: width: 520 | image_tag: loading: 'lazy', alt: item.title | escape }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <p class="moov-accessories__card-title">{{ item.title }}</p>
                <p class="moov-accessories__card-price">{{ item.price | money }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /* ═══ MINI-BAR ═══════════════════════════════ */
  .moov-mini-bar {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    z-index: 99;
    height: 56px;
    background: var(--moov-black);
    border-bottom: 0.5px solid var(--moov-border-dark);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .moov-mini-bar.mini-bar--visible {
    opacity: 1;
    pointer-events: auto;
  }
  .moov-mini-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--section-inline-pad);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .moov-mini-bar__left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .moov-mini-bar__img {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    object-fit: cover;
  }
  .moov-mini-bar__name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
  }
  .moov-mini-bar__links {
    display: flex;
    gap: 32px;
  }
  .moov-mini-bar__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-secondary-dark);
    text-decoration: none;
    transition: color 0.2s;
  }
  .moov-mini-bar__link:hover {
    color: var(--moov-text-primary-dark);
  }
  .moov-mini-bar__cta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--moov-amber);
    border: 0.5px solid var(--moov-border-amber);
    border-radius: 999px;
    padding: 7px 18px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .moov-mini-bar__cta:hover {
    background: var(--moov-amber);
    color: var(--moov-black);
  }

  /* ═══ PRODUCT INTRO ══════════════════════════ */
  .moov-prod-intro {
    background: var(--moov-cream);
    padding: clamp(5rem, 11vw, 8rem) 0 clamp(4.5rem, 9vw, 7rem);
    overflow: hidden;
  }
  .moov-prod-intro__inner {
    width: 100%;
    max-width: 1240px;
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(40px, 5.5vw, 112px);
    row-gap: clamp(24px, 3.2vw, 46px);
    align-items: start;
  }
  .moov-prod-intro__gallery {
    min-width: 0;
    width: 100%;
    position: sticky;
    top: calc(var(--header-height, 5rem) + 2rem);
  }
  .moov-prod-intro__main-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    min-height: clamp(500px, 60vw, 740px);
    overflow: hidden;
    border-radius: 16px;
    background: transparent;
  }
  .moov-prod-intro__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .moov-prod-intro__slide.is-active {
    opacity: 1;
  }
  .moov-prod-intro__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .moov-prod-intro__nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--moov-border-light);
    background: color-mix(in srgb, var(--moov-cream) 88%, transparent);
    color: var(--moov-text-primary-light);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .moov-prod-intro__nav-btn--prev {
    left: 12px;
  }
  .moov-prod-intro__nav-btn--next {
    right: 12px;
  }
  .moov-prod-intro__nav-btn:hover {
    background: var(--moov-amber);
    border-color: var(--moov-amber);
    color: var(--moov-black);
  }
  .moov-prod-intro__thumbs {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 14px;
  }
  .moov-prod-intro__thumb {
    width: 56px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--moov-border-light);
    background: none;
    padding: 0;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .moov-prod-intro__thumb.is-active {
    opacity: 1;
    border-color: var(--moov-amber);
  }
  .moov-prod-intro__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Details */
  .moov-prod-intro__details {
    width: 100%;
    min-width: 0;
    max-width: 560px;
    padding-top: clamp(0.4rem, 1vw, 0.9rem);
  }
  .moov-prod-intro__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-text-primary-light);
    margin: 0 0 14px;
  }
  .moov-prod-intro__title {
    font-family: var(--font-hero);
    font-size: clamp(2.2rem, 3.9vw, 3.1rem);
    font-weight: 500;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--moov-text-primary-light);
    margin: 0 0 10px;
  }
  .moov-prod-intro__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--moov-text-secondary-light);
    margin: 0 0 14px;
    max-width: 46ch;
  }
  .moov-prod-intro__desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.65;
    color: var(--moov-text-secondary-light);
    margin: 0 0 24px;
    max-width: 50ch;
  }
  .moov-prod-intro__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 26px;
  }
  .moov-prod-intro__price-current {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    color: var(--moov-text-primary-light);
  }
  .moov-prod-intro__price-compare {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--moov-text-secondary-light);
    text-decoration: line-through;
  }

  /* Options */
  .moov-prod-intro__option {
    margin-bottom: 20px;
    max-width: 430px;
  }
  .moov-prod-intro__option-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-secondary-light);
    margin: 0 0 12px;
  }
  .moov-prod-intro__option-label strong {
    font-weight: 400;
    color: var(--moov-text-primary-light);
  }
  .moov-prod-intro__option-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .moov-colour-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 0.5px solid var(--moov-border-light);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-secondary-light);
    background: none;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .moov-colour-pill.is-selected {
    border-color: var(--moov-text-primary-light);
    color: var(--moov-text-primary-light);
  }

  /* CTA */
  .moov-prod-intro__add-btn {
    display: block;
    width: 100%;
    height: 58px;
    background: var(--moov-black);
    border: 0.5px solid var(--moov-black);
    color: var(--moov-text-primary-dark);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    margin-bottom: 14px;
    max-width: 430px;
  }
  .moov-prod-intro__add-btn:hover:not(:disabled) {
    background: var(--moov-amber);
    border-color: var(--moov-amber);
  }
  .moov-prod-intro__add-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* ═══ BUY BOX — Sonos-style additions ═════════ */

  /* Breadcrumb + New chip */
  .moov-prod-intro__topline {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .moov-prod-intro__crumbs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--moov-text-secondary-light);
    letter-spacing: 0.02em;
  }
  .moov-prod-intro__crumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .moov-prod-intro__crumbs a:hover {
    color: var(--moov-text-primary-light);
  }
  .moov-prod-intro__crumb-sep {
    color: var(--moov-text-tertiary-light);
  }
  .moov-prod-intro__chip {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--moov-black);
    color: var(--moov-text-primary-dark);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Price + rating line */
  .moov-prod-intro__priceline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .moov-prod-intro__priceline .moov-prod-intro__price {
    margin-bottom: 0;
  }
  .moov-prod-intro__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--moov-text-secondary-light);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    transition: color 0.15s ease;
  }
  .moov-prod-intro__rating:hover {
    color: var(--moov-text-primary-light);
  }
  .moov-prod-intro__rating-stars {
    display: inline-flex;
    gap: 2px;
    font-size: 0.9rem;
    letter-spacing: 1px;
  }
  .moov-prod-intro__star {
    color: var(--moov-text-tertiary-light);
    line-height: 1;
  }
  .moov-prod-intro__star--on {
    color: var(--moov-amber);
  }
  .moov-prod-intro__rating-text {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 0.5px;
  }
  .moov-prod-intro__rating-count {
    margin-left: 4px;
    color: var(--moov-text-tertiary-light);
  }

  /* Description + "More info" disclosure */
  .moov-prod-intro__desc-wrap {
    margin: 0 0 22px;
    max-width: 50ch;
  }
  .moov-prod-intro__desc-wrap .moov-prod-intro__desc {
    margin-bottom: 6px;
  }
  .moov-prod-intro__desc-full {
    overflow: hidden;
  }
  .moov-prod-intro__desc-rich {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.65;
    color: var(--moov-text-secondary-light);
    margin-top: 10px;
  }
  .moov-prod-intro__desc-rich p {
    margin: 0 0 10px;
  }
  .moov-prod-intro__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    padding: 4px 0;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--moov-text-primary-light);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 0.5px;
  }
  .moov-prod-intro__more-chev {
    transition: transform 0.2s ease;
  }
  .moov-prod-intro__more[aria-expanded="true"] .moov-prod-intro__more-chev {
    transform: rotate(180deg);
  }

  /* "Selected" variant dropdown */
  .moov-prod-intro__dropdown {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 14px;
    row-gap: 2px;
    align-items: center;
    padding: 12px 18px;
    border: 1px solid var(--moov-border-light);
    border-radius: 14px;
    background: transparent;
    margin-bottom: 18px;
    max-width: 430px;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .moov-prod-intro__dropdown:hover {
    border-color: color-mix(in srgb, var(--moov-black) 35%, transparent);
  }
  .moov-prod-intro__dropdown:focus-within {
    border-color: var(--moov-black);
    outline: none;
  }
  .moov-prod-intro__dropdown-small {
    grid-column: 1 / 2;
    grid-row: 1;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--moov-text-secondary-light);
    letter-spacing: 0.02em;
  }
  .moov-prod-intro__dropdown-value {
    grid-column: 1 / 2;
    grid-row: 2;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--moov-text-primary-light);
  }
  .moov-prod-intro__dropdown-chev {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--moov-text-secondary-light);
  }
  .moov-prod-intro__dropdown-select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    border: none;
    background: transparent;
  }

  /* Colour swatches (replace old text pills) */
  .moov-prod-intro__option--swatches .moov-prod-intro__option-label {
    margin-bottom: 10px;
  }
  .moov-prod-intro__swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .moov-prod-intro__swatch {
    position: relative;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid var(--moov-border-light);
    border-radius: 999px;
    background: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .moov-prod-intro__swatch:hover {
    border-color: color-mix(in srgb, var(--moov-black) 40%, transparent);
  }
  .moov-prod-intro__swatch.is-selected {
    border-color: var(--moov-text-primary-light);
  }
  .moov-prod-intro__swatch-dot {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--swatch-color, var(--moov-text-primary-light));
    border: 1px solid color-mix(in srgb, var(--moov-black) 10%, transparent);
    display: block;
  }

  /* Quantity stepper */
  .moov-prod-intro__qty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 18px;
    max-width: 430px;
  }
  .moov-prod-intro__qty-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--moov-text-secondary-light);
  }
  .moov-prod-intro__qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--moov-border-light);
    border-radius: 999px;
    overflow: hidden;
    background: transparent;
  }
  .moov-prod-intro__qty-btn {
    width: 38px;
    height: 38px;
    border: none;
    background: none;
    font-size: 1.1rem;
    font-family: var(--font-body);
    color: var(--moov-text-primary-light);
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .moov-prod-intro__qty-btn:hover {
    background: color-mix(in srgb, var(--moov-black) 6%, transparent);
  }
  .moov-prod-intro__qty-input {
    width: 38px;
    height: 38px;
    border: none;
    background: transparent;
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--moov-text-primary-light);
    -moz-appearance: textfield;
  }
  .moov-prod-intro__qty-input::-webkit-outer-spin-button,
  .moov-prod-intro__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .moov-prod-intro__qty-input:focus {
    outline: none;
  }

  /* Delivery micro-note */
  .moov-prod-intro__delivery {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--moov-text-secondary-light);
    margin: 14px 0 0;
    max-width: 430px;
  }
  .moov-prod-intro__delivery-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--moov-text-tertiary-light);
    flex-shrink: 0;
  }
  .moov-prod-intro__delivery-dot--ok {
    background: var(--moov-success, #2e7d32);
  }
  .moov-prod-intro__delivery-dot--out {
    background: var(--moov-error, #c62828);
  }
  .moov-prod-intro__delivery-sep {
    color: var(--moov-text-tertiary-light);
  }

  /* Trust strip */
  .moov-prod-intro__trust {
    list-style: none;
    margin: 24px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--moov-border-light);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 14px 16px;
    max-width: 430px;
  }
  .moov-prod-intro__trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  .moov-prod-intro__trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--moov-text-primary-light);
  }
  .moov-prod-intro__trust-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--moov-text-secondary-light);
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  /* Returns & refunds link (sits below the trust strip) */
  .moov-prod-intro__returns {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 16px 0 0;
    padding: 10px 14px;
    background: var(--moov-cream-shadow);
    border: 0.5px solid var(--moov-border-light);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--moov-text-primary-light);
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    max-width: 430px;
  }
  .moov-prod-intro__returns:hover {
    background: var(--moov-cream);
    border-color: var(--moov-border-amber);
  }
  .moov-prod-intro__returns:hover .moov-prod-intro__returns-arrow {
    transform: translateX(2px);
  }
  .moov-prod-intro__returns-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--moov-black);
    color: var(--moov-cream);
    flex-shrink: 0;
  }
  .moov-prod-intro__returns-text {
    flex: 1;
    line-height: 1.3;
  }
  .moov-prod-intro__returns-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--moov-text-tertiary-light);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  /* ═══ TECH SPECS ═════════════════════════════ */
  .moov-specs {
    background: var(--moov-black);
    padding: var(--section-block-pad-y-lg) 0;
  }
  .moov-specs__inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--section-inline-pad);
  }
  .moov-specs__tabs {
    display: flex;
    gap: 24px;
    border-bottom: 0.5px solid var(--moov-border-dark);
    margin-bottom: 0;
  }
  .moov-specs__tab {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-secondary-dark);
    background: none;
    border: none;
    padding: 12px 0;
    cursor: pointer;
    border-bottom: 1px solid transparent;
    margin-bottom: -0.5px;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .moov-specs__tab.is-active {
    color: var(--moov-text-primary-dark);
    border-bottom-color: var(--moov-amber);
  }
  .moov-specs__panel {
    display: none;
  }
  .moov-specs__panel.is-active {
    display: block;
  }
  .moov-specs__list {
    margin: 0;
  }
  .moov-specs__row {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 0.5px solid var(--moov-border-dark);
  }
  .moov-specs__row:last-child {
    border-bottom: none;
  }
  .moov-specs__row dt {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-secondary-dark);
  }
  .moov-specs__row dd {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
    margin: 0;
    text-align: right;
  }

  /* ═══ ACCESSORIES ════════════════════════════ */
  .moov-accessories {
    background: var(--moov-black);
    padding: var(--section-block-pad-y-lg) 0;
  }
  .moov-accessories__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--section-inline-pad);
  }
  .moov-accessories__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.15;
    color: var(--moov-text-primary-dark);
    margin: 0 0 32px;
  }
  .moov-accessories__scroll {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
  }
  .moov-accessories__scroll::-webkit-scrollbar {
    display: none;
  }
  .moov-accessories__card {
    flex: 0 0 260px;
    scroll-snap-align: start;
    text-decoration: none;
  }
  .moov-accessories__card-img {
    width: 260px;
    height: 260px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--moov-surface-dark-raised);
    margin-bottom: 12px;
  }
  .moov-accessories__card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .moov-accessories__card-title {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
    margin: 0 0 4px;
  }
  .moov-accessories__card-price {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-secondary-dark);
    margin: 0;
  }

  /* ═══ RESPONSIVE ═════════════════════════════ */
  @media (max-width: 1100px) {
    .moov-prod-intro__inner {
      grid-template-columns: minmax(0, 1fr);
      column-gap: 0;
      row-gap: 28px;
      max-width: 640px;
    }
    .moov-prod-intro__gallery {
      position: static;
      top: auto;
    }
    .moov-prod-intro__main-image {
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
    .moov-prod-intro__details {
      max-width: none;
      padding-top: 0;
    }
  }

  @media (max-width: 899px) {
    .moov-mini-bar__links { display: none; }
    .moov-prod-intro {
      padding: clamp(3.8rem, 9vw, 5.2rem) 0 clamp(3.2rem, 8vw, 4.6rem);
    }
  }

  @media (max-width: 767px) {
    .moov-prod-intro__thumbs { display: none; }
    .moov-specs__tabs { gap: 16px; overflow-x: auto; }
  }

  /* ═══ REDESIGN OVERRIDES ═════════════════════ */
  .moov-specs {
    padding: clamp(2.6rem, 6vw, 4.8rem) 0;
  }
  .moov-specs__inner {
    max-width: 1200px;
  }
  .moov-specs__layout {
    display: grid;
    grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    gap: clamp(1.2rem, 3vw, 2.4rem);
    align-items: start;
  }
  .moov-specs__aside {
    position: sticky;
    top: calc(var(--header-height, 5rem) + 1rem);
  }
  .moov-specs__eyebrow {
    margin: 0 0 0.55rem;
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-eyebrow-accent);
  }
  .moov-specs__heading {
    font-family: var(--font-display);
    color: var(--moov-text-primary-dark);
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0 0 0.7rem;
    overflow-wrap: normal;
    word-break: keep-all;
    hyphens: manual;
  }
  .moov-specs__intro {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--moov-text-secondary-dark);
    max-width: 34ch;
  }
  .moov-specs__content {
    border: 1px solid var(--moov-border-dark);
    border-radius: 18px;
    background: var(--moov-surface-dark-raised);
    padding: clamp(0.8rem, 1.6vw, 1.15rem);
  }
  .moov-specs__tabs {
    gap: 12px;
    margin-bottom: 0.65rem;
    border-bottom: none;
    flex-wrap: wrap;
  }
  .moov-specs__tab {
    border: 1px solid var(--moov-border-dark);
    border-radius: 999px;
    padding: 8px 14px;
    margin-bottom: 0;
    background: transparent;
  }
  .moov-specs__tab.is-active {
    background: var(--moov-amber);
    color: var(--moov-black);
    border-color: var(--moov-amber);
  }
  .moov-specs__list {
    border: 1px solid var(--moov-border-dark);
    border-radius: 12px;
    overflow: hidden;
    background: color-mix(in srgb, var(--moov-black) 50%, transparent);
  }
  .moov-specs__row {
    padding: 12px 14px;
  }

  .moov-accessories {
    padding: clamp(2.8rem, 6vw, 4.8rem) 0;
  }
  .moov-accessories__heading {
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-bottom: 1.15rem;
  }
  .moov-accessories__card {
    flex-basis: 280px;
  }
  .moov-accessories__card-img {
    width: 280px;
    height: 280px;
    border-radius: 14px;
    border: 1px solid var(--moov-border-dark);
  }
  .moov-accessories__card-title {
    font-size: var(--text-base);
    margin-bottom: 0.35rem;
  }

  @media (max-width: 899px) {
    .moov-specs__layout {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .moov-specs__aside {
      position: static;
    }
  }

{% endstylesheet %}

{% javascript %}
  /* Mini-bar visibility */
  var hero = document.getElementById('moov-product-hero');
  var miniBar = document.querySelector('.moov-mini-bar');
  if (hero && miniBar) {
    var miniObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        miniBar.classList.toggle('mini-bar--visible', !entry.isIntersecting);
      });
    }, { threshold: 0 });
    miniObserver.observe(hero);
  }

  /* Image carousel */
  document.querySelectorAll('.moov-prod-intro__thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      var idx = thumb.getAttribute('data-index');
      var gallery = thumb.closest('.moov-prod-intro__gallery');
      gallery.querySelectorAll('.moov-prod-intro__slide').forEach(function(s) {
        s.classList.toggle('is-active', s.getAttribute('data-index') === idx);
      });
      gallery.querySelectorAll('.moov-prod-intro__thumb').forEach(function(t) {
        t.classList.toggle('is-active', t.getAttribute('data-index') === idx);
      });
    });
  });

  document.querySelectorAll('.moov-prod-intro__nav-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var gallery = btn.closest('.moov-prod-intro__gallery');
      if (!gallery) return;
      var slides = gallery.querySelectorAll('.moov-prod-intro__slide');
      if (!slides.length) return;
      var currentIdx = 0;
      slides.forEach(function(s, i) { if (s.classList.contains('is-active')) currentIdx = i; });
      var dir = btn.classList.contains('moov-prod-intro__nav-btn--next') ? 1 : -1;
      var nextIdx = (currentIdx + dir + slides.length) % slides.length;
      slides.forEach(function(s, i) { s.classList.toggle('is-active', i === nextIdx); });
      gallery.querySelectorAll('.moov-prod-intro__thumb').forEach(function(t, i) {
        t.classList.toggle('is-active', i === nextIdx);
      });
    });
  });

  /* Spec tabs */
  document.querySelectorAll('.moov-specs__tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var target = tab.getAttribute('data-tab');
      document.querySelectorAll('.moov-specs__tab').forEach(function(t) {
        t.classList.toggle('is-active', t.getAttribute('data-tab') === target);
        t.setAttribute('aria-selected', t.getAttribute('data-tab') === target ? 'true' : 'false');
      });
      document.querySelectorAll('.moov-specs__panel').forEach(function(p) {
        p.classList.toggle('is-active', p.getAttribute('data-panel') === target);
      });
    });
  });

  /* Smooth scroll for mini-bar links */
  document.querySelectorAll('.moov-mini-bar__link').forEach(function(link) {
    link.addEventListener('click', function(e) {
      var target = document.querySelector(link.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      var top = target.getBoundingClientRect().top + window.pageYOffset - 140;
      window.scrollTo({ top: top, behavior: 'smooth' });
    });
  });

  /* "More info" description disclosure */
  document.querySelectorAll('[data-disclosure-toggle]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var wrap = btn.closest('[data-disclosure]');
      if (!wrap) return;
      var full = wrap.querySelector('.moov-prod-intro__desc-full');
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (full) full.hidden = isOpen;
      var openLabel = btn.querySelector('[data-disclosure-open]');
      var closeLabel = btn.querySelector('[data-disclosure-close]');
      if (openLabel) openLabel.hidden = !isOpen;
      if (closeLabel) closeLabel.hidden = isOpen;
    });
  });

  /* Product form — variant sync, swatches, qty */
  document.querySelectorAll('[data-product-form]').forEach(function(form) {
    var dataEl = form.parentElement.querySelector('[data-variant-map]');
    if (!dataEl) return;
    var variants;
    try { variants = JSON.parse(dataEl.textContent); } catch (err) { return; }
    if (!Array.isArray(variants)) return;

    var variantInput = form.querySelector('[data-variant-id]');
    var addBtn = form.querySelector('[data-add-btn]');
    var addLabel = form.querySelector('[data-add-label]');
    var priceEl = form.parentElement.querySelector('[data-price]');
    var comparePriceEl = form.parentElement.querySelector('[data-compare-price]');
    function formatMoney(cents) {
      var format = (window.Shopify && window.Shopify.money_format) || '${{amount}}';
      var amt = (cents / 100).toFixed(2);
      return format.replace(/\{\{\s*amount\s*\}\}/, amt).replace(/\{\{\s*amount_no_decimals\s*\}\}/, Math.round(cents / 100));
    }

    function currentSelection() {
      var selection = [];
      form.querySelectorAll('[data-option-index]').forEach(function(el) {
        var idx = parseInt(el.getAttribute('data-option-index'), 10);
        if (isNaN(idx)) return;
        if (el.matches('[data-option-single]')) {
          selection[idx] = el.value;
        } else if (el.matches('.moov-prod-intro__dropdown')) {
          var sel = el.querySelector('[data-option-select]');
          if (sel) selection[idx] = sel.value;
        } else if (el.matches('.moov-prod-intro__option--swatches')) {
          var active = el.querySelector('.moov-prod-intro__swatch.is-selected');
          if (active) selection[idx] = active.getAttribute('data-value');
        }
      });
      return selection;
    }

    function findVariant(selection) {
      return variants.find(function(v) {
        return v.options.every(function(val, i) { return val === selection[i]; });
      });
    }

    function updateVariant() {
      var selection = currentSelection();
      var variant = findVariant(selection);
      var availLabel = addBtn ? (addBtn.getAttribute('data-label-available') || '') : '';
      var unavailLabel = addBtn ? (addBtn.getAttribute('data-label-unavailable') || 'Sold out') : 'Sold out';

      if (!variant) {
        if (addBtn) {
          addBtn.disabled = true;
          if (addLabel) addLabel.textContent = unavailLabel;
        }
        return;
      }
      if (variantInput) variantInput.value = variant.id;
      if (priceEl) priceEl.textContent = formatMoney(variant.price);
      if (comparePriceEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          comparePriceEl.textContent = formatMoney(variant.compare_at_price);
          comparePriceEl.hidden = false;
        } else {
          comparePriceEl.hidden = true;
        }
      }
      if (addBtn) {
        addBtn.disabled = !variant.available;
        if (addLabel) {
          addLabel.textContent = variant.available ? availLabel : unavailLabel;
        }
      }
      var url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url);
    }

    /* Dropdown change */
    form.querySelectorAll('[data-option-select]').forEach(function(sel) {
      sel.addEventListener('change', function() {
        var wrap = sel.closest('.moov-prod-intro__dropdown');
        if (wrap) {
          var label = wrap.querySelector('[data-selected-value]');
          if (label) label.textContent = sel.value;
        }
        updateVariant();
      });
    });

    /* Swatch click */
    form.querySelectorAll('.moov-prod-intro__swatch').forEach(function(sw) {
      sw.addEventListener('click', function() {
        var group = sw.closest('.moov-prod-intro__option--swatches');
        if (!group) return;
        group.querySelectorAll('.moov-prod-intro__swatch').forEach(function(s) {
          s.classList.toggle('is-selected', s === sw);
          s.setAttribute('aria-checked', s === sw ? 'true' : 'false');
        });
        var label = group.querySelector('[data-selected-value]');
        if (label) label.textContent = sw.getAttribute('data-value');
        updateVariant();
      });
    });

    /* Quantity stepper */
    var qtyInput = form.querySelector('.moov-prod-intro__qty-input');
    form.querySelectorAll('[data-qty]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (!qtyInput) return;
        var current = parseInt(qtyInput.value, 10) || 1;
        var dir = btn.getAttribute('data-qty') === 'up' ? 1 : -1;
        qtyInput.value = Math.max(1, current + dir);
      });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "MOOV Product",
  "settings": [
    { "type": "text", "id": "product_eyebrow", "label": "Product eyebrow", "info": "Leave blank for store_marketing.badge_category" },
    { "type": "text", "id": "product_subtitle", "label": "Product subtitle", "default": "Built for better mornings, less snooze." },

    { "type": "header", "content": "Buy box" },
    { "type": "text", "id": "shipping_note", "label": "Shipping/delivery note", "default": "Ships in 3–5 days" },
    { "type": "text", "id": "returns_link_label", "label": "Returns link label", "info": "Shown as a small pill below the trust strip. Leave blank to hide.", "default": "View return & refund policy" },
    { "type": "url", "id": "returns_link_url", "label": "Returns link URL", "info": "Defaults to /pages/returns-refunds when left blank." },

    { "type": "header", "content": "Tech specs intro" },
    { "type": "text", "id": "specs_eyebrow", "label": "Specs eyebrow", "default": "Tech specs" },
    { "type": "textarea", "id": "specs_intro", "label": "Specs intro text", "default": "Everything you need to know about MOOV hardware, connectivity, and in-box setup at a glance." }
  ],
  "blocks": [
    {
      "type": "color_swatch",
      "name": "Colour swatch",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "value", "label": "Option value", "info": "Must match the product option value (e.g. Black, Cream)" },
        { "type": "color", "id": "color", "label": "Swatch colour", "default": "#0a0a09" }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "trial", "label": "Trial" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "secure", "label": "Secure" }
          ],
          "default": "shipping"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Free shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MOOV Product",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "shipping", "label": "Free shipping" } },
        { "type": "trust_item", "settings": { "icon": "trial", "label": "30-day trial" } },
        { "type": "trust_item", "settings": { "icon": "warranty", "label": "2-year warranty" } }
      ]
    }
  ]
}
{% endschema %}
