{%- liquid
  assign overlay_opacity = section.settings.hero_overlay_opacity | default: 55
  assign overlay_decimal = overlay_opacity | times: 1.0 | divided_by: 100.0

  assign video_src = 'hero-bg.mp4' | asset_url
  if section.settings.hero_video_mp4 != blank
    assign video_src = section.settings.hero_video_mp4
  endif
-%}

<section class="moov-hero full-width" style="--hero-overlay: rgba(10, 10, 9, {{ overlay_decimal }});">
  {%- comment -%} Layer 1 — Video background {%- endcomment -%}
  <video
    class="moov-hero__video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    {%- if section.settings.hero_poster -%}
      poster="{{ section.settings.hero_poster | image_url: width: 1920 }}"
    {%- endif -%}
    aria-hidden="true"
  >
    <source src="{{ video_src }}" type="video/mp4">
    {%- if section.settings.hero_video_webm != blank -%}
      <source src="{{ section.settings.hero_video_webm }}" type="video/webm">
    {%- endif -%}
  </video>

  {%- comment -%} Layer 2 — Dark overlay {%- endcomment -%}
  <div class="moov-hero__overlay" aria-hidden="true"></div>

  {%- comment -%} Layer 3 — Content {%- endcomment -%}
  <div class="moov-hero__content">
    {%- if section.settings.hero_eyebrow != blank -%}
      <p class="moov-hero__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="moov-hero__heading">
      {{- section.settings.hero_headline | escape -}}
    </h1>

    {%- if section.settings.hero_subheadline != blank -%}
      <p class="moov-hero__subheadline">{{ section.settings.hero_subheadline | escape }}</p>
    {%- endif -%}

    <div class="moov-hero__ctas">
      {%- if section.settings.cta_primary_label != blank -%}
        <a
          href="{{ section.settings.cta_primary_url | default: routes.root_url }}"
          class="moov-hero__btn moov-hero__btn--primary"
        >
          {{- section.settings.cta_primary_label | escape -}}
        </a>
      {%- endif -%}

      {%- if section.settings.cta_ghost_label != blank -%}
        <a
          href="{{ section.settings.cta_ghost_url | default: '#' }}"
          class="moov-hero__btn moov-hero__btn--ghost"
        >
          {{- section.settings.cta_ghost_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .moov-hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--moov-black);
  }

  /* Layer 1 — Video / poster */
  .moov-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  /* Layer 2 — Overlay */
  .moov-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay, rgba(10, 10, 9, 0.55));
    z-index: 1;
  }

  /* Layer 3 — Content */
  .moov-hero__content {
    position: relative;
    z-index: 2;
    padding: 0 var(--section-inline-pad);
    max-width: 700px;
  }

  .moov-hero__eyebrow {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-2xs);
    color: rgba(240, 180, 41, 0.7);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 clamp(12px, 1.5vw, 20px);
  }

  .moov-hero__heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-5xl);
    line-height: 1.1;
    color: var(--moov-text-primary-dark);
    margin: 0 0 clamp(20px, 2.5vw, 32px);
  }

  .moov-hero__subheadline {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--moov-text-secondary-dark);
    margin: 0 0 clamp(24px, 3vw, 40px);
    max-width: 520px;
  }

  /* CTAs */
  .moov-hero__ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .moov-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 14px 28px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.03em;
    text-decoration: none;
    white-space: nowrap;
  }

  .moov-hero__btn--primary {
    background: transparent;
    border: 0.5px solid var(--moov-border-amber);
    color: var(--moov-amber);
    font-weight: 400;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .moov-hero__btn--primary:hover {
    background: var(--moov-amber);
    color: var(--moov-black);
  }

  .moov-hero__btn--ghost {
    background: transparent;
    border: 0.5px solid rgba(245, 238, 220, 0.20);
    color: var(--moov-text-secondary-dark);
    font-weight: 300;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .moov-hero__btn--ghost:hover {
    border-color: rgba(245, 238, 220, 0.55);
    color: var(--moov-text-primary-dark);
  }

  /* Responsive */
  @media (max-width: 767px) {
    .moov-hero__overlay {
      background: rgba(10, 10, 9, 0.60);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOOV Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Video background"
    },
    {
      "type": "text",
      "id": "hero_video_mp4",
      "label": "Hero video URL (MP4)",
      "info": "Upload your video to Shopify Files and paste the URL here."
    },
    {
      "type": "text",
      "id": "hero_video_webm",
      "label": "Hero video URL (WebM)",
      "info": "Optional but recommended for smaller file size on Chrome and Firefox."
    },
    {
      "type": "image_picker",
      "id": "hero_poster",
      "label": "Hero video poster image",
      "info": "Shown before the video loads and on devices where autoplay is blocked."
    },
    {
      "type": "range",
      "id": "hero_overlay_opacity",
      "label": "Dark overlay opacity",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 55,
      "unit": "%",
      "info": "Controls how dark the overlay sits over the video. Higher = more readable text, less visible video."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow text",
      "default": "Smart alarm technology"
    },
    {
      "type": "text",
      "id": "hero_headline",
      "label": "Headline",
      "default": "Begin well."
    },
    {
      "type": "textarea",
      "id": "hero_subheadline",
      "label": "Subheadline",
      "default": "Wake at the right moment, every morning. Calm, unhurried, and ready."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Pre-order now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA link"
    },
    {
      "type": "header",
      "content": "Ghost CTA"
    },
    {
      "type": "text",
      "id": "cta_ghost_label",
      "label": "Ghost CTA label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "cta_ghost_url",
      "label": "Ghost CTA link"
    }
  ],
  "presets": [
    {
      "name": "MOOV Hero"
    }
  ]
}
{% endschema %}
