<div
  class="hero full-width"
  style="--hero-min-height: {{ section.settings.min_height }}px;"
>
  {%- liquid
    assign video_src = 'hero-bg.mp4' | asset_url
    if section.settings.video_url != blank
      assign video_src = section.settings.video_url
    endif
  -%}

  <div class="hero__bg">
    {%- if video_src != blank -%}
      <video
        class="hero__bg-video"
        src="{{ video_src }}"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        {%- if section.settings.image -%}
          poster="{{ section.settings.image | image_url: width: 2400 }}"
        {%- endif -%}
        aria-hidden="true"
      ></video>
    {%- elsif section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'hero__bg-img',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt | escape
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__bg-placeholder' }}
    {%- endif -%}
  </div>

  <div class="hero__overlay"></div>

  {%- comment -%} Logo — top-left, outside nav {%- endcomment -%}
  <a href="{{ routes.root_url }}" class="hero__logo" aria-label="{{ shop.name }}">
    <img
      src="{{ 'moov-logo.png' | asset_url }}"
      alt="{{ shop.name }}"
      class="hero__logo-img"
      width="120"
      height="40"
      loading="eager"
    >
  </a>

  {%- comment -%} Floating pill navigation {%- endcomment -%}
  <nav class="hero__nav" aria-label="{{ 'general.accessibility.nav_label' | t }}">
    <div class="hero__nav-inner">
      <a href="{{ routes.root_url }}" class="hero__nav-logo" aria-label="{{ shop.name }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="currentColor"/>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </a>
      <ul class="hero__nav-links" role="list">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a
              href="{{ link.url }}"
              class="hero__nav-link{% if link.active %} hero__nav-link--active{% endif %}"
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{- link.title -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </nav>

  {%- comment -%} Hero content {%- endcomment -%}
  <div class="hero__content">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="hero__heading">
        {{- section.settings.heading | escape -}}
        {%- if section.settings.heading_accent != blank -%}
          <br>
          <em class="hero__heading-accent">{{ section.settings.heading_accent | escape }}</em>
        {%- endif -%}
      </h1>

      <div class="hero__ctas">
        {%- if section.settings.primary_button_label != blank -%}
          <a
            href="{{ section.settings.primary_button_url | default: routes.root_url }}"
            class="hero__btn hero__btn--primary"
          >
            {{- section.settings.primary_button_label | escape -}}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_button_label != blank -%}
          <a
            href="{{ section.settings.secondary_button_url | default: '#' }}"
            class="hero__btn hero__btn--secondary"
          >
            <span>{{- section.settings.secondary_button_label | escape -}}</span>
            <span class="hero__btn-arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Community social proof {%- endcomment -%}
    {%- if section.settings.community_label != blank -%}
      <div class="hero__community">
        <div class="hero__community-avatars">
          {%- if section.settings.avatar_1 -%}
            {{
              section.settings.avatar_1
              | image_url: width: 80
              | image_tag: class: 'hero__avatar', alt: '', loading: 'lazy'
            }}
          {%- else -%}
            <span class="hero__avatar hero__avatar--placeholder">{{ 'icon-account.svg' | inline_asset_content }}</span>
          {%- endif -%}
          {%- if section.settings.avatar_2 -%}
            {{
              section.settings.avatar_2
              | image_url: width: 80
              | image_tag: class: 'hero__avatar', alt: '', loading: 'lazy'
            }}
          {%- else -%}
            <span class="hero__avatar hero__avatar--placeholder">{{ 'icon-account.svg' | inline_asset_content }}</span>
          {%- endif -%}
          {%- if section.settings.avatar_3 -%}
            {{
              section.settings.avatar_3
              | image_url: width: 80
              | image_tag: class: 'hero__avatar', alt: '', loading: 'lazy'
            }}
          {%- else -%}
            <span class="hero__avatar hero__avatar--placeholder">{{ 'icon-account.svg' | inline_asset_content }}</span>
          {%- endif -%}
        </div>
        <div class="hero__community-text">
          <span class="hero__community-label">{{ section.settings.community_label | escape }}</span>
          <span class="hero__community-subtitle">{{ section.settings.community_subtitle | escape }}</span>
        </div>
        {%- if section.settings.community_url != blank -%}
          <a href="{{ section.settings.community_url }}" class="hero__community-arrow" aria-label="{{ section.settings.community_label | escape }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400;1,700&family=DM+Sans:wght@300;400;500&display=swap');

  .hero {
    position: relative;
    min-height: var(--hero-min-height, 100vh);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Background */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-video,
  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .hero__bg-placeholder {
    width: 100%;
    height: 100%;
  }

  /* Gradient overlay — subtle bottom darkening for text legibility */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(0, 0, 0, 0.45) 100%
    );
  }

  /* Logo — top-left */
  .hero__logo {
    position: absolute;
    top: 32px;
    left: 40px;
    z-index: 10;
    display: block;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .hero__logo:hover {
    opacity: 0.75;
  }

  .hero__logo-img {
    height: 36px;
    width: auto;
    display: block;
  }

  /* Floating pill nav */
  .hero__nav {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    width: calc(100% - 48px);
    max-width: 840px;
  }

  .hero__nav-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 16px 28px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }

  .hero__nav-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
    flex-shrink: 0;
    text-decoration: none;
  }

  .hero__nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__nav-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #1a1a1a;
    text-decoration: none;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .hero__nav-link:hover {
    opacity: 0.6;
  }

  .hero__nav-link--active {
    font-weight: 500;
  }

  /* Hero content */
  .hero__content {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 48px 56px;
    padding-top: 120px;
  }

  /* Text block */
  .hero__text {
    max-width: 560px;
  }

  .hero__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 16px;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  .hero__heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(42px, 5.5vw, 72px);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin: 0 0 32px;
    letter-spacing: -0.02em;
  }

  .hero__heading-accent {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    color: #C9A058;
    display: inline;
  }

  /* CTA buttons */
  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 500;
    transition: opacity 0.2s, transform 0.2s;
  }

  .hero__btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .hero__btn--primary {
    background: #ffffff;
    color: #1a1a1a;
    padding: 12px 28px;
    border-radius: 100px;
    font-weight: 500;
  }

  .hero__btn--secondary {
    color: #ffffff;
    font-weight: 300;
  }

  .hero__btn-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Community social proof */
  .hero__community {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 100px;
    padding: 10px 16px 10px 10px;
  }

  .hero__community-avatars {
    display: flex;
    align-items: center;
  }

  .hero__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.8);
    object-fit: cover;
    display: block;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.2);
  }

  .hero__avatar + .hero__avatar {
    margin-left: -10px;
  }

  .hero__avatar--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__avatar--placeholder svg {
    width: 18px;
    height: 18px;
    color: rgba(255, 255, 255, 0.7);
  }

  .hero__community-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .hero__community-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    white-space: nowrap;
  }

  .hero__community-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.7);
    white-space: nowrap;
  }

  .hero__community-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    color: #ffffff;
    text-decoration: none;
    margin-left: 4px;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }

  .hero__community-arrow:hover {
    opacity: 0.7;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .hero__logo {
      top: 20px;
      left: 24px;
    }

    .hero__logo-img {
      height: 28px;
    }

    .hero__nav-inner {
      padding: 12px 20px;
      gap: 20px;
    }

    .hero__nav-links {
      gap: 16px;
    }

    .hero__nav-link {
      font-size: 13px;
    }

    .hero__content {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 24px;
      padding: 32px 24px;
    }

    .hero__heading {
      font-size: clamp(36px, 8vw, 52px);
      margin-bottom: 24px;
    }

    .hero__community {
      align-self: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "t:labels.video_url",
      "info": "t:labels.video_url_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.background_image",
      "info": "t:labels.background_image_info"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "t:labels.min_height",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 860
    },
    {
      "type": "header",
      "content": "t:general.navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text",
      "default": "Wake up stronger. Start every day with intention and momentum."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Reclaim your mornings with"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "t:labels.heading_accent",
      "default": "the MOOV Alarm."
    },
    {
      "type": "header",
      "content": "t:general.primary_button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "t:labels.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "header",
      "content": "t:general.secondary_button"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:labels.button_label",
      "default": "See how it works"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "header",
      "content": "t:general.community"
    },
    {
      "type": "text",
      "id": "community_label",
      "label": "t:labels.community_label",
      "default": "Our community"
    },
    {
      "type": "text",
      "id": "community_subtitle",
      "label": "t:labels.community_subtitle",
      "default": "Join the morning movement"
    },
    {
      "type": "url",
      "id": "community_url",
      "label": "t:labels.community_url"
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "t:labels.avatar_1"
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "t:labels.avatar_2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "t:labels.avatar_3"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
