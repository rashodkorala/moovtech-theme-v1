{%- liquid
  assign overlay_opacity = section.settings.hero_overlay_opacity | default: 55

  assign video_src = 'hero-bg-2.mov' | asset_url
  assign hero_video_mime = 'video/quicktime'
  if section.settings.hero_video_mp4 != blank
    assign video_src = section.settings.hero_video_mp4
    assign hero_video_mime = 'video/mp4'
  endif

  assign hero_overline = section.settings.hero_eyebrow

  assign hero_headline = section.settings.hero_headline
  if hero_headline == blank
    assign hero_headline = 'store_marketing.hero_heading' | t
  endif

  assign hero_subheadline = section.settings.hero_subheadline
  if hero_subheadline == blank
    assign hero_subheadline = 'store_marketing.hero_subheading' | t
  endif

  assign cta_primary_label = section.settings.cta_primary_label
  if cta_primary_label == blank
    assign cta_primary_label = 'store_marketing.hero_cta_primary' | t
  endif

  assign has_slides = false
  if section.blocks.size > 0
    assign has_slides = true
  endif
-%}

<section
  class="moov-hero full-width{% unless section.settings.hero_desaturate_video == false %} moov-hero--desaturated{% endunless %}"
  data-surface="dark"
  style="--hero-overlay: color-mix(in srgb, var(--moov-black) {{ overlay_opacity }}%, transparent);"
>
  {%- comment -%} Video / slide layer {%- endcomment -%}
  {%- if has_slides -%}
    <div class="moov-hero__frame">
      <div class="moov-hero__slides">
        {%- for block in section.blocks -%}
          {%- liquid
            assign slide_video = block.settings.video_mp4
            assign slide_video_mime = 'video/mp4'
            if slide_video == blank
              assign slide_video = video_src
              assign slide_video_mime = hero_video_mime
            endif
            assign slide_overlay = block.settings.overlay_opacity | default: overlay_opacity
          -%}
          <div
            class="moov-hero__slide{% if forloop.first %} is-active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <video
              class="moov-hero__video"
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              {%- if block.settings.poster != blank -%}
                poster="{{ block.settings.poster | image_url: width: 1920 }}"
              {%- elsif section.settings.hero_poster != blank -%}
                poster="{{ section.settings.hero_poster | image_url: width: 1920 }}"
              {%- endif -%}
              aria-hidden="true"
            >
              <source src="{{ slide_video }}" type="{{ slide_video_mime }}">
              {%- if block.settings.video_webm != blank -%}
                <source src="{{ block.settings.video_webm }}" type="video/webm">
              {%- endif -%}
            </video>
            <div
              class="moov-hero__overlay"
              aria-hidden="true"
              style="--hero-overlay: color-mix(in srgb, var(--moov-black) {{ slide_overlay }}%, transparent);"
            ></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="moov-hero__frame">
      <video
        class="moov-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        {%- if section.settings.hero_poster -%}
          poster="{{ section.settings.hero_poster | image_url: width: 1920 }}"
        {%- endif -%}
        aria-hidden="true"
      >
        <source src="{{ video_src }}" type="{{ hero_video_mime }}">
        {%- if section.settings.hero_video_webm != blank -%}
          <source src="{{ section.settings.hero_video_webm }}" type="video/webm">
        {%- endif -%}
      </video>
      <div class="moov-hero__overlay" aria-hidden="true"></div>
    </div>
  {%- endif -%}

  {%- comment -%} Centre content {%- endcomment -%}
  <div class="moov-hero__content">
    {%- if hero_overline != blank -%}
      <p class="moov-hero__overline">{{ hero_overline | escape }}</p>
    {%- endif -%}

    <h1 class="moov-hero__heading">
      {{- hero_headline | escape -}}
    </h1>

    {%- if hero_subheadline != blank -%}
      <p class="moov-hero__subheadline">{{ hero_subheadline | escape }}</p>
    {%- endif -%}

    <div class="moov-hero__ctas">
      {%- if cta_primary_label != blank -%}
        <a
          href="{{ section.settings.cta_primary_url | default: routes.root_url }}"
          class="moov-hero__btn"
        >
          {{- cta_primary_label | escape -}}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="2" y1="12" x2="12" y2="2"/>
            <polyline points="5,2 12,2 12,9"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Carousel dots {%- endcomment -%}
  {%- if has_slides and section.blocks.size > 1 -%}
    <div class="moov-hero__dots" role="tablist" aria-label="{{ 'sections.hero.carousel_label' | t }}">
      {%- for block in section.blocks -%}
        <button
          class="moov-hero__dot{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ 'general.accessibility.view_image' | t: index: forloop.index }}"
          data-dot-index="{{ forloop.index0 }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  body:has(.moov-header--transparent) .moov-hero {
    margin-top: calc(var(--header-height) + env(safe-area-inset-top, 0px));
    scroll-margin-top: calc(var(--header-height) + env(safe-area-inset-top, 0px));
    min-height: calc(100vh - var(--header-height) - env(safe-area-inset-top, 0px));
    min-height: calc(100svh - var(--header-height) - env(safe-area-inset-top, 0px));
    min-height: calc(100dvh - var(--header-height) - env(safe-area-inset-top, 0px));
  }

  body:has(.moov-header--transparent .moov-announcement) .moov-hero {
    margin-top: calc(
      var(--header-height) + var(--moov-announcement-offset) + env(safe-area-inset-top, 0px)
    );
    scroll-margin-top: calc(
      var(--header-height) + var(--moov-announcement-offset) + env(safe-area-inset-top, 0px)
    );
    min-height: calc(
      100vh - var(--header-height) - var(--moov-announcement-offset) - env(safe-area-inset-top, 0px)
    );
    min-height: calc(
      100svh - var(--header-height) - var(--moov-announcement-offset) - env(safe-area-inset-top, 0px)
    );
    min-height: calc(
      100dvh - var(--header-height) - var(--moov-announcement-offset) - env(safe-area-inset-top, 0px)
    );
  }

  .moov-hero {
    --hero-content-pad-x: var(--section-inline-pad);
    position: relative;
    width: 100%;
    margin-inline: 0;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    box-sizing: border-box;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--moov-black);
  }

  /* Inset media */
  .moov-hero__frame {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 0;
    overflow: hidden;
  }

  /* Slides container */
  .moov-hero__slides {
    position: absolute;
    inset: 0;
  }

  .moov-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .moov-hero__slide.is-active {
    opacity: 1;
  }

  /* Video */
  .moov-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .moov-hero--desaturated .moov-hero__video {
    filter: grayscale(1);
  }

  /* Overlay */
  .moov-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay, color-mix(in srgb, var(--moov-black) 55%, transparent));
    z-index: 1;
  }

  /* Centre content */
  .moov-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 var(--hero-content-pad-x);
    max-width: min(720px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .moov-hero__overline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent, #ed9d09);
    margin: 0 0 clamp(10px, 1.2vw, 16px);
  }

  .moov-hero__overline::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent, #ed9d09);
    box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent, #ed9d09) 70%, transparent);
    animation: moov-hero-pulse 2.4s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes moov-hero-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.25);
      opacity: 0.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .moov-hero__overline::before {
      animation: none;
    }
  }

  /* Headline — white on media (reference storefront) */
  .moov-hero__heading {
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: clamp(1.5rem, 4vw, 3.5rem);
    line-height: var(--heading-line-height, 1.05);
    letter-spacing: 0.1px;
    text-transform: var(--heading-text-transform, uppercase);
    color: var(--moov-cream);
    margin: 0 0 clamp(20px, 3vw, 36px);
    white-space: nowrap;
  }

  .moov-hero__subheadline {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-base);
    line-height: 1.7;
    color: color-mix(in srgb, var(--moov-cream) 92%, transparent);
    margin: 0 0 clamp(24px, 3vw, 40px);
    max-width: 520px;
  }

  /* CTAs — white pill buttons */
  .moov-hero__ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .moov-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: clamp(13px, 1.2vw, 18px) clamp(28px, 3vw, 42px);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    background: var(--moov-cream);
    color: var(--moov-black);
    border: none;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--moov-black) 6%, transparent);
  }

  .moov-hero__btn:hover {
    background: var(--moov-cream);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--moov-black) 12%, transparent);
  }

  /* Carousel dots */
  .moov-hero__dots {
    position: absolute;
    bottom: clamp(1.5rem, 3vw, 2.5rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 3;
  }

  .moov-hero__dot {
    height: 3px;
    width: 40px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--moov-cream) 32%, transparent);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.25s ease;
  }

  .moov-hero__dot.is-active {
    background: var(--color-accent, #ed9d09);
    width: 56px;
  }

  /* Responsive */
  @media (max-width: 767px) {
    .moov-hero__heading {
      white-space: normal;
      max-width: 100%;
    }

    .moov-hero__overlay {
      background: color-mix(in srgb, var(--moov-black) 65%, transparent);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    var hero = document.querySelector('.moov-hero');
    if (!hero) return;

    var slides = hero.querySelectorAll('.moov-hero__slide');
    var dots = hero.querySelectorAll('.moov-hero__dot');
    if (slides.length <= 1) return;

    var currentIndex = 0;
    var autoAdvanceTimer = null;

    function goToSlide(index) {
      slides[currentIndex].classList.remove('is-active');
      dots[currentIndex].classList.remove('is-active');
      dots[currentIndex].setAttribute('aria-selected', 'false');

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex].classList.add('is-active');
      dots[currentIndex].classList.add('is-active');
      dots[currentIndex].setAttribute('aria-selected', 'true');

      /* Pause and play the active slide video */
      slides.forEach(function(slide, i) {
        var video = slide.querySelector('video');
        if (!video) return;
        if (i === currentIndex) {
          video.play();
        } else {
          video.pause();
        }
      });
    }

    function startAutoAdvance() {
      autoAdvanceTimer = setInterval(function() {
        goToSlide(currentIndex + 1);
      }, 6000);
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        clearInterval(autoAdvanceTimer);
        goToSlide(parseInt(this.getAttribute('data-dot-index'), 10));
        startAutoAdvance();
      });
    });

    startAutoAdvance();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "MOOV Hero",
  "tag": "section",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "video_mp4",
          "label": "Slide video URL (MP4)",
          "info": "Upload to Shopify Files and paste the URL here."
        },
        {
          "type": "text",
          "id": "video_webm",
          "label": "Slide video URL (WebM)",
          "info": "Optional smaller-file alternative for Chrome/Firefox."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Slide poster image",
          "info": "Shown before video loads."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 20,
          "max": 80,
          "step": 5,
          "default": 55,
          "unit": "%"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Default video (used when no slides are added)"
    },
    {
      "type": "text",
      "id": "hero_video_mp4",
      "label": "Hero video URL (MP4)",
      "info": "Upload your video to Shopify Files and paste the URL here."
    },
    {
      "type": "text",
      "id": "hero_video_webm",
      "label": "Hero video URL (WebM)",
      "info": "Optional but recommended for smaller file size on Chrome and Firefox."
    },
    {
      "type": "image_picker",
      "id": "hero_poster",
      "label": "Video poster image",
      "info": "Shown before the video loads."
    },
    {
      "type": "range",
      "id": "hero_overlay_opacity",
      "label": "Dark overlay opacity",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 55,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "hero_desaturate_video",
      "label": "Black and white video",
      "info": "Applies a grayscale look to the hero video (like the reference storefront).",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Overline text",
      "info": "Leave blank to hide the overline."
    },
    {
      "type": "text",
      "id": "hero_headline",
      "label": "Headline",
      "default": "Reclaim your morning"
    },
    {
      "type": "textarea",
      "id": "hero_subheadline",
      "label": "Subheadline",
      "default": "Quit losing your morning to bad phone habits. MOOV is designed to get you up and into action."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA link"
    }
  ],
  "presets": [
    {
      "name": "MOOV Hero"
    }
  ]
}
{% endschema %}
