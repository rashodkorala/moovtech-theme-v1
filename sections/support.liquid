    {
      "type": "url",
      "id": "book_url",
      "label": "Book a call URL"
    },
    {
      "type": "header",
      "content": "CTA section"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL",
      "info": "Defaults to mailto: your email"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL",
      "info": "Defaults to tel: your phone number"
    }
  ],
  "presets": [
    {
      "name": "Support",
      "settings": {
        "email_address": "help@moov.co",
        "phone_number": "(415) 555-0142",
