{%- liquid
  assign hero_heading = section.settings.hero_heading
  if hero_heading == blank
    assign hero_heading = 'sections.our_story.hero_heading_default' | t
  endif

  assign hero_sub = section.settings.hero_sub
  if hero_sub == blank
    assign hero_sub = 'sections.our_story.hero_sub_default' | t
  endif

  assign hero_image_asset = section.settings.hero_image_asset | strip

  assign video_poster_asset = section.settings.video_poster_asset | strip
  if video_poster_asset == blank
    assign video_poster_asset = 'CFC86724-4271-4448-BD4D-1BFC891817C5.PNG'
  endif

  assign cta_heading = section.settings.cta_heading
  if cta_heading == blank
    assign cta_heading = 'sections.our_story.cta_heading_default' | t
  endif

  assign cta_sub = section.settings.cta_sub
  if cta_sub == blank
    assign cta_sub = 'sections.our_story.cta_sub_default' | t
  endif

  assign cta_primary_label = section.settings.cta_primary_label
  if cta_primary_label == blank
    assign cta_primary_label = 'sections.our_story.cta_primary_default' | t
  endif

  assign cta_primary_url = section.settings.cta_primary_url | default: '/pages/get-moov'

  assign cta_secondary_label = section.settings.cta_secondary_label
  if cta_secondary_label == blank
    assign cta_secondary_label = 'sections.our_story.cta_secondary_default' | t
  endif

  assign cta_secondary_url = section.settings.cta_secondary_url | default: '/pages/how-it-works'

  assign video_url = section.settings.video_url | strip
  assign video_file_url = section.settings.video_file_url
  assign fv_type = 'none'
  assign fv_youtube_id = ''
  assign fv_vimeo_id = ''

  if video_url != blank
    if video_url contains 'youtube.com'
      assign fv_type = 'youtube'
      if video_url contains 'v='
        assign fv_youtube_id = video_url | split: 'v=' | last | split: '&' | first
      endif
    elsif video_url contains 'youtu.be'
      assign fv_type = 'youtube'
      assign fv_youtube_id = video_url | split: 'youtu.be/' | last | split: '?' | first
    elsif video_url contains 'vimeo.com'
      assign fv_type = 'vimeo'
      assign fv_vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first
    endif
  elsif video_file_url != blank
    assign fv_type = 'file'
  else
    assign fv_type = 'file'
    assign video_file_url = 'hero-bg-1.mp4' | asset_url
  endif
-%}

{%- comment -%}── 01 STORY HERO ──{%- endcomment -%}
<section class="os-story-hero full-width" data-surface="dark">
  <div class="os-inner">
    <div class="story-hero-grid">

      <div class="story-hero-copy">
        <p class="os-eyebrow">{{ 'sections.our_story.hero_eyebrow' | t }}</p>
        <h1 class="story-hero-h1">{{ hero_heading | escape }}</h1>
        {%- if hero_sub != blank -%}
          <p class="story-hero-sub">{{ hero_sub | escape }}</p>
        {%- endif -%}
      </div>

      <div class="story-hero-media">
        {%- if section.settings.hero_image != blank -%}
          {{
            section.settings.hero_image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              class: 'story-hero-img',
              alt: section.settings.hero_image.alt,
              sizes: '(min-width: 880px) 48vw, 100vw',
              widths: '400, 600, 800, 1000, 1200'
          }}
        {%- elsif hero_image_asset != blank -%}
          <img
            src="{{ hero_image_asset | asset_url }}"
            alt="{{ hero_heading | escape }}"
            loading="eager"
            class="story-hero-img"
            width="900"
            height="1125"
          >
        {%- else -%}
          <div class="story-hero-placeholder" aria-hidden="true">
            <span class="story-hero-placeholder-label">Founder photo<br>Upload via theme editor</span>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{%- comment -%}── 02 ORIGIN LETTER ──{%- endcomment -%}
<section class="os-origin full-width" data-surface="dark" id="origin">
  <div class="os-inner">
    <div class="origin-grid">

      <aside class="origin-aside">
        <p class="os-eyebrow">{{ 'sections.our_story.origin_eyebrow' | t }}</p>
        <div class="origin-meta">
          <span>{{ 'sections.our_story.origin_founder_name' | t }}</span>
          <span class="origin-meta-role">{{ 'sections.our_story.origin_founder_role' | t }}</span>
        </div>
      </aside>

      <div class="origin-body">
        <p class="lede">I've always cared about productivity, goals, and building a better life. But mornings were still a struggle.</p>
        <p>I'd hit snooze. Scroll my phone. Rush into the day already feeling behind.</p>
        <p>Eventually I realized most alarms don't actually get you out of bed.</p>
        <p>So I started building MOOV — a system designed to create movement first.</p>
        <p class="sign-off">Not motivation. Not guilt. Just action.</p>
      </div>

    </div>
  </div>
</section>

{%- comment -%}── 03 FOUNDER VIDEO ──{%- endcomment -%}
<section class="os-founder-video full-width" data-surface="dark" id="film">
  <div class="os-inner">

    <div class="fv-head">
      <p class="os-eyebrow">{{ 'sections.our_story.video_eyebrow_default' | t }}</p>
      <h2 class="fv-head-h2">{{ 'sections.our_story.video_heading_default' | t }}</h2>
      <p class="fv-head-sub">{{ 'sections.our_story.video_sub_default' | t }}</p>
    </div>

    <figure class="fv-frame">
      <div
        class="fv-stage"
        data-fv-type="{{ fv_type | escape }}"
        data-fv-youtube-id="{{ fv_youtube_id | escape }}"
        data-fv-vimeo-id="{{ fv_vimeo_id | escape }}"
        {%- if fv_type != 'none' %}
          role="button"
          tabindex="0"
          aria-label="{{ 'sections.our_story.video_play_label' | t }}"
        {%- endif %}
      >
        {%- comment -%} Poster / video element {%- endcomment -%}
        {%- if fv_type == 'file' -%}
          {%- liquid
            assign poster_src = ''
            if section.settings.video_poster != blank
              assign poster_src = section.settings.video_poster | image_url: width: 1600
            elsif video_poster_asset != blank
              assign poster_src = video_poster_asset | asset_url
            endif
          -%}
          <video
            class="fv-video"
            playsinline
            preload="metadata"
            {%- if poster_src != blank %} poster="{{ poster_src }}"{% endif %}
          >
            <source src="{{ video_file_url }}" type="video/mp4">
          </video>
        {%- else -%}
          {%- liquid
            assign poster_src = ''
            if section.settings.video_poster != blank
              assign poster_src = section.settings.video_poster | image_url: width: 1600
            elsif video_poster_asset != blank
              assign poster_src = video_poster_asset | asset_url
            endif
          -%}
          {%- if poster_src != blank -%}
            <img src="{{ poster_src }}" alt="" class="fv-video" loading="lazy" width="1600" height="900">
          {%- else -%}
            <div class="fv-video fv-video-placeholder" aria-hidden="true"></div>
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} Veil + Overlay {%- endcomment -%}
        <div class="fv-veil" aria-hidden="true"></div>

        <div class="fv-overlay">
          <div class="fv-overlay-top">
            <span class="fv-chip">
              <span class="os-rec-dot" aria-hidden="true"></span>
              {{- 'sections.our_story.video_film_chip' | t -}}
            </span>
            <span class="fv-chip fv-chip-ghost">00:30</span>
          </div>
          <div class="fv-overlay-bottom">
            {%- if fv_type != 'none' -%}
              <button type="button" class="fv-play" aria-label="{{ 'sections.our_story.video_play_label' | t }}">
                <svg class="fv-play-icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M7 4.5v15a.6.6 0 0 0 .92.51l12.1-7.5a.6.6 0 0 0 0-1.02L7.92 3.99A.6.6 0 0 0 7 4.5z"/>
                </svg>
                <svg class="fv-pause-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="7" y="5" width="3.5" height="14" rx="0.5"/>
                  <rect x="13.5" y="5" width="3.5" height="14" rx="0.5"/>
                </svg>
                <span class="fv-play-label">{{- 'sections.our_story.video_play_label' | t -}}</span>
              </button>
            {%- endif -%}
            <div class="fv-meta">
              <span class="fv-title">{{ 'sections.our_story.video_film_title' | t }}</span>
              <span class="fv-by">{{ 'sections.our_story.video_film_by' | t }}</span>
            </div>
          </div>
        </div>

        {%- comment -%} Iframe placeholder — injected by JS on click {%- endcomment -%}
        <div class="fv-iframe-slot" aria-hidden="true"></div>
      </div>

    </figure>

  </div>
</section>

{%- comment -%}── 04 MANIFESTO (cream) ──{%- endcomment -%}
<section class="os-manifesto full-width" data-surface="cream">
  <div class="os-inner">

    <div class="manifesto-head">
      <p class="os-eyebrow os-eyebrow--accent">{{ 'sections.our_story.manifesto_eyebrow' | t }}</p>
      <h2 class="manifesto-h2">{{ 'sections.our_story.manifesto_heading' | t }}</h2>
    </div>

    <div class="manifesto-grid">
      <article class="principle">
        <span class="principle-num">M</span>
        <h4 class="principle-h4">{{ 'sections.our_story.principle_1_title' | t }}</h4>
        <p>{{ 'sections.our_story.principle_1_body' | t }}</p>
      </article>
      <article class="principle">
        <span class="principle-num">O</span>
        <h4 class="principle-h4">{{ 'sections.our_story.principle_2_title' | t }}</h4>
        <p>{{ 'sections.our_story.principle_2_body' | t }}</p>
      </article>
      <article class="principle">
        <span class="principle-num">O</span>
        <h4 class="principle-h4">{{ 'sections.our_story.principle_3_title' | t }}</h4>
        <p>{{ 'sections.our_story.principle_3_body' | t }}</p>
      </article>
      <article class="principle">
        <span class="principle-num">V</span>
        <h4 class="principle-h4">{{ 'sections.our_story.principle_4_title' | t }}</h4>
        <p>{{ 'sections.our_story.principle_4_body' | t }}</p>
      </article>
    </div>

    <p class="manifesto-sub">{{ 'sections.our_story.manifesto_sub' | t }}</p>

  </div>
</section>

{%- comment -%}── 05 STORY CTA ──{%- endcomment -%}
<section class="os-story-cta full-width" data-surface="dark">
  <div class="os-inner">
    <div class="story-cta-inner">
      <p class="os-eyebrow">{{ 'sections.our_story.cta_eyebrow' | t }}</p>
      <h2 class="story-cta-h2">{{ cta_heading | escape }}</h2>
      {%- if cta_sub != blank -%}
        <p class="story-cta-sub">{{ cta_sub | escape }}</p>
      {%- endif -%}
      <div class="story-cta-btns">
        <a href="{{ cta_primary_url }}" class="os-btn-white">
          {{- cta_primary_label | escape -}}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="2" y1="7" x2="11" y2="7"/>
            <polyline points="7,3.5 11,7 7,10.5"/>
          </svg>
        </a>
        <a href="{{ cta_secondary_url }}" class="os-btn-ghost">
          {{- cta_secondary_label | escape -}}
        </a>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}

  /* ── Shared inner wrapper ── */
  .os-inner {
    width: 100%;
    max-width: var(--layout-max-width);
    margin-inline: auto;
  }

  /* ── Shared eyebrow ── */
  .os-eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
  }
  .os-eyebrow--accent {
    color: var(--moov-eyebrow-accent);
  }

  /* ── Shared media placeholder ── */
  .os-media-placeholder {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--moov-cream) 10%, var(--moov-black)) 0%,
      var(--moov-surface-dark-elevated) 100%
    );
  }

  /* ── Shared rec-dot animation ── */
  @keyframes moov-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.85); }
  }
  .os-rec-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--moov-amber);
    box-shadow: 0 0 10px rgba(237, 157, 9, 0.7);
    animation: moov-pulse 2.4s ease-in-out infinite;
    flex-shrink: 0;
  }

  /* ══════════════════════════════════════════
     01 STORY HERO
  ══════════════════════════════════════════ */
  .os-story-hero {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: calc(var(--header-height, 72px) + clamp(2rem, 5vw, 5rem)) var(--section-inline-pad) var(--section-block-pad-y-md);
  }

  .story-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
  }

  .story-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-bottom: 12px;
  }

  .story-hero-h1 {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: clamp(2.6rem, 5.5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-cream);
    text-wrap: balance;
  }

  .story-hero-sub {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--moov-text-secondary-dark);
    max-width: 38ch;
  }
  .story-hero-sub em {
    color: var(--moov-text-primary-dark);
    font-style: italic;
  }

  .story-hero-media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card, 16px);
    overflow: hidden;
    background: var(--moov-surface-dark-elevated);
    border: 1px solid var(--moov-border-dark);
  }

  .story-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.35) brightness(0.85) contrast(1.05);
  }

  .os-story-hero .os-eyebrow {
    color: var(--moov-amber);
  }

  .story-hero-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--moov-cream) 5%, var(--moov-black));
    border: 1px dashed color-mix(in srgb, var(--moov-cream) 20%, transparent);
  }

  .story-hero-placeholder-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--moov-cream) 30%, transparent);
    text-align: center;
    line-height: 1.8;
  }

  @media (max-width: 880px) {
    .story-hero-grid { grid-template-columns: 1fr; }
    .story-hero-media { aspect-ratio: 4 / 5; max-height: min(80vw, 520px); }
  }

  /* ══════════════════════════════════════════
     02 ORIGIN LETTER
  ══════════════════════════════════════════ */
  .os-origin {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: var(--section-block-pad-y-md) var(--section-inline-pad);
    border-top: 1px solid var(--moov-border-dark);
  }

  .origin-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(32px, 6vw, 100px);
    align-items: start;
  }

  .origin-aside {
    position: sticky;
    top: calc(var(--header-height, 72px) + 24px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .origin-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-hero);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: var(--text-lg);
    color: var(--moov-cream);
  }

  .origin-meta-role {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--moov-text-tertiary-dark);
  }

  .origin-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 60ch;
  }

  .origin-body p {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.75;
    color: var(--moov-text-secondary-dark);
  }

  .origin-body p em {
    color: var(--moov-text-primary-dark);
    font-style: italic;
  }

  .origin-body .lede {
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-md);
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--moov-cream);
    margin-bottom: 4px;
  }

  .origin-body .lede em {
    font-style: italic;
    color: var(--moov-amber);
  }

  .origin-body .sign-off {
    font-family: var(--font-hero);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--moov-amber);
    font-size: var(--text-md);
    margin-top: 4px;
  }

  @media (max-width: 880px) {
    .origin-grid { grid-template-columns: 1fr; }
    .origin-aside { position: static; }
  }

  /* ══════════════════════════════════════════
     03 FOUNDER VIDEO
  ══════════════════════════════════════════ */
  .os-founder-video {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: var(--section-block-pad-y-md) var(--section-inline-pad);
    border-top: 1px solid var(--moov-border-dark);
  }

  .fv-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: clamp(28px, 4vw, 48px);
    max-width: 60ch;
  }

  .fv-head-h2 {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-cream);
  }

  .fv-head-sub {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--moov-text-secondary-dark);
    max-width: 50ch;
  }

  .fv-frame {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fv-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card, 16px);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--moov-border-dark);
    cursor: default;
    isolation: isolate;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .fv-stage[role="button"] {
    cursor: pointer;
  }

  .fv-stage[role="button"]:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .fv-stage:focus-visible {
    outline: 2px solid var(--moov-amber);
    outline-offset: 4px;
  }

  .fv-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.25) brightness(0.9) contrast(1.05);
  }

  .fv-video-placeholder {
    background: var(--moov-surface-dark-elevated);
  }

  .fv-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(10, 10, 9, 0.35) 0%, rgba(10, 10, 9, 0) 30%, rgba(10, 10, 9, 0) 55%, rgba(10, 10, 9, 0.7) 100%),
      radial-gradient(60% 60% at 50% 55%, rgba(10, 10, 9, 0) 0%, rgba(10, 10, 9, 0.35) 100%);
    transition: opacity 0.3s ease;
  }

  .fv-stage.is-playing .fv-veil { opacity: 0.4; }
  .fv-stage.is-playing .fv-meta { opacity: 0; }
  .fv-stage.is-playing .fv-play-label { display: none; }
  .fv-stage.is-playing .fv-play { width: 56px; padding: 0; justify-content: center; }
  .fv-stage.is-playing .fv-play-icon { display: none; }
  .fv-stage:not(.is-playing) .fv-pause-icon { display: none; }

  .fv-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(18px, 2.5vw, 28px);
    pointer-events: none;
  }

  .fv-overlay-top,
  .fv-overlay-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .fv-overlay-bottom { align-items: flex-end; }

  .fv-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-cream);
    background: rgba(10, 10, 9, 0.55);
    border: 1px solid var(--moov-border-dark);
    padding: 6px 12px;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  .fv-chip-ghost { color: var(--moov-text-secondary-dark); }

  .fv-play {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 22px 0 18px;
    border-radius: 999px;
    border: 1px solid var(--moov-cream);
    background: var(--moov-cream);
    color: var(--moov-black);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease, width 0.2s ease, padding 0.2s ease;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    white-space: nowrap;
  }

  .fv-play:hover {
    background: var(--moov-amber);
    color: var(--moov-black);
    border-color: var(--moov-amber);
    transform: translateY(-1px);
  }

  .fv-play svg { flex-shrink: 0; }

  .fv-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: right;
    transition: opacity 0.3s ease;
    max-width: 60%;
  }

  .fv-title {
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-sm);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--moov-cream);
    line-height: 1.1;
  }

  .fv-by {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-text-secondary-dark);
  }

  .fv-iframe-slot {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: none;
  }

  .fv-iframe-slot iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .fv-caption {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
    padding-top: 4px;
  }

  @media (max-width: 560px) {
    .fv-overlay-bottom { flex-direction: column; align-items: flex-start; }
    .fv-meta { text-align: left; max-width: 100%; }
  }

  /* ══════════════════════════════════════════
     04 MANIFESTO (cream surface)
  ══════════════════════════════════════════ */
  .os-manifesto {
    background: var(--moov-cream);
    color: var(--moov-black);
    padding: var(--section-block-pad-y-lg) var(--section-inline-pad);
  }

  .manifesto-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .manifesto-h2 {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-black);
    max-width: 16ch;
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--moov-border-light);
  }

  .principle {
    padding: 28px 24px 36px;
    border-right: 1px solid var(--moov-border-light);
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 280px;
  }

  .principle:last-child { border-right: none; }

  .principle-num {
    font-family: var(--font-hero);
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-amber);
    opacity: 0.85;
  }

  .principle-h4 {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-md);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--moov-black);
    text-wrap: balance;
  }

  .principle p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--moov-text-secondary-light);
  }

  @media (max-width: 980px) {
    .manifesto-grid { grid-template-columns: repeat(2, 1fr); }
    .principle { border-bottom: 1px solid var(--moov-border-light); }
    .principle:nth-child(2n) { border-right: none; }
    .principle:nth-last-child(-n+2) { border-bottom: none; }
  }

  @media (max-width: 560px) {
    .manifesto-grid { grid-template-columns: 1fr; }
    .principle { border-right: none; }
    .principle:not(:last-child) { border-bottom: 1px solid var(--moov-border-light); }
    .principle:nth-last-child(-n+2) { border-bottom: 1px solid var(--moov-border-light); }
    .principle:last-child { border-bottom: none; }
  }

  .manifesto-sub {
    margin: clamp(36px, 4vw, 52px) auto 0;
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--moov-text-secondary-light);
    text-align: center;
    max-width: 50ch;
  }

  /* ══════════════════════════════════════════
     05 STORY CTA
  ══════════════════════════════════════════ */
  .os-story-cta {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: var(--section-block-pad-y-lg) var(--section-inline-pad);
    border-top: 1px solid var(--moov-border-dark);
  }

  .story-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    max-width: 50ch;
    margin-inline: auto;
  }

  .story-cta-h2 {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-xl);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-cream);
    text-wrap: balance;
  }

  .story-cta-sub {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--moov-text-secondary-dark);
    max-width: 38ch;
  }

  .story-cta-btns {
    display: flex;
    gap: 12px;
    margin-top: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .os-btn-white {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--moov-black);
    background: var(--moov-cream);
    border: 1px solid var(--moov-cream);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .os-btn-white:hover {
    background: var(--moov-amber);
    border-color: var(--moov-amber);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--moov-black) 30%, transparent);
  }

  .os-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--moov-cream);
    background: transparent;
    border: 1px solid var(--moov-border-dark);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .os-btn-ghost:hover {
    background: color-mix(in srgb, var(--moov-cream) 12%, transparent);
    border-color: var(--moov-cream);
    transform: translateY(-1px);
  }

{% endstylesheet %}

{% javascript %}
  (function () {
    var stages = document.querySelectorAll('.fv-stage[data-fv-type]');
    if (!stages.length) return;

    stages.forEach(function (stage) {
      var type = stage.dataset.fvType;
      if (type === 'none') return;

      var video = stage.querySelector('video');
      var slot  = stage.querySelector('.fv-iframe-slot');
      var btn   = stage.querySelector('.fv-play');
      var btnLabel = stage.querySelector('.fv-play-label');
      var playLabel  = stage.getAttribute('aria-label') || 'Play';
      var pauseLabel = (btnLabel && btnLabel.textContent) || 'Pause';

      function setPlaying(on) {
        stage.classList.toggle('is-playing', on);
        stage.setAttribute('aria-label', on ? pauseLabel : playLabel);
      }

      function loadEmbed() {
        if (!slot) return;
        var src = '';
        if (type === 'youtube') {
          src = 'https://www.youtube.com/embed/' + stage.dataset.fvYoutubeId + '?autoplay=1&rel=0';
        } else if (type === 'vimeo') {
          src = 'https://player.vimeo.com/video/' + stage.dataset.fvVimeoId + '?autoplay=1';
        }
        var iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.allow = 'autoplay; fullscreen';
        iframe.allowFullscreen = true;
        slot.appendChild(iframe);
        slot.style.display = 'block';
        setPlaying(true);
      }

      stage.addEventListener('click', function () {
        if (type === 'youtube' || type === 'vimeo') {
          if (slot.style.display === 'block') return;
          loadEmbed();
        } else if (type === 'file' && video) {
          if (video.paused) {
            video.play().then(function () { setPlaying(true); }).catch(function () { setPlaying(true); });
          } else {
            video.pause();
            setPlaying(false);
          }
        }
      });

      stage.addEventListener('keydown', function (e) {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          stage.click();
        }
      });

      if (video) {
        video.addEventListener('play',  function () { setPlaying(true);  });
        video.addEventListener('pause', function () { setPlaying(false); });
        video.addEventListener('ended', function () { setPlaying(false); });
      }
    });
  })();
{% endjavascript %}

