{%- liquid
  assign hero_heading = section.settings.hero_heading
  if hero_heading == blank
    assign hero_heading = 'sections.our_story.default_hero_heading' | t
  endif
  assign hero_body = section.settings.hero_body
  if hero_body == blank
    assign hero_body = 'sections.our_story.default_hero_body' | t
  endif

  assign video_eyebrow = section.settings.video_eyebrow
  if video_eyebrow == blank
    assign video_eyebrow = 'sections.our_story.default_video_eyebrow' | t
  endif

  assign moov_heading = section.settings.moov_heading
  if moov_heading == blank
    assign moov_heading = 'sections.our_story.default_moov_heading' | t
  endif
  assign moov_body = section.settings.moov_body
  if moov_body == blank
    assign moov_body = 'sections.our_story.default_moov_body' | t
  endif

  assign closing_heading = section.settings.closing_heading
  if closing_heading == blank
    assign closing_heading = 'sections.our_story.default_closing_heading' | t
  endif
  assign closing_body = section.settings.closing_body
  if closing_body == blank
    assign closing_body = 'sections.our_story.default_closing_body' | t
  endif
  assign closing_button_label = section.settings.closing_button_label
  assign closing_button_url = section.settings.closing_button_url | default: '/collections/all'

  assign letter_blocks = section.blocks | where: 'type', 'moov_letter'
  assign milestone_blocks = section.blocks | where: 'type', 'story_milestone'
-%}

{%- comment -%} ══ SECTION 1: HERO (split layout, founder-centric) ══ {%- endcomment -%}
<section class="story-hero full-width" data-surface="cream">
  <div class="story-hero__wrap">
    <div class="story-hero__grid">
      <div class="story-hero__media" data-animate="story-fade-up">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', class: 'story-hero__img', sizes: '(min-width: 750px) 55vw, 100vw', widths: '400, 600, 800, 1000, 1200' }}
        {%- elsif section.settings.hero_image_url != blank -%}
          <img src="{{ section.settings.hero_image_url | escape }}" alt="" loading="eager" class="story-hero__img" width="900" height="1200">
        {%- else -%}
          <div class="story-hero__placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>

      <div class="story-hero__content" data-animate="story-fade-up">
        <h1 class="story-hero__heading">{{ hero_heading | escape }}</h1>
        {%- if hero_body != blank -%}
          <p class="story-hero__body">{{ hero_body | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} ══ SECTION 2: FOUNDER VIDEO ══ {%- endcomment -%}
<section class="story-video full-width" data-surface="dark">
  <div class="story-video__wrap">
    {%- if video_eyebrow != blank -%}
      <p class="story-video__eyebrow" data-animate="story-fade-up">{{ video_eyebrow | escape }}</p>
    {%- endif -%}
    <div class="story-video__frame" data-animate="story-fade-up">
      {%- if section.settings.video_url != blank -%}
        {%- liquid
          assign vurl = section.settings.video_url
          assign is_youtube = false
          assign is_vimeo = false
          if vurl contains 'youtube.com' or vurl contains 'youtu.be'
            assign is_youtube = true
          endif
          if vurl contains 'vimeo.com'
            assign is_vimeo = true
          endif
        -%}
        {%- if is_youtube -%}
          {%- liquid
            assign yt_id = ''
            if vurl contains 'v='
              assign yt_id = vurl | split: 'v=' | last | split: '&' | first
            elsif vurl contains 'youtu.be/'
              assign yt_id = vurl | split: 'youtu.be/' | last | split: '?' | first
            endif
          -%}
          {%- if yt_id != blank -%}
            <iframe
              src="https://www.youtube.com/embed/{{ yt_id }}"
              title="{{ video_eyebrow | escape }}"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
              class="story-video__embed"
            ></iframe>
          {%- endif -%}
        {%- elsif is_vimeo -%}
          {%- assign vimeo_id = vurl | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | first -%}
          {%- if vimeo_id != blank -%}
            <iframe
              src="https://player.vimeo.com/video/{{ vimeo_id }}"
              title="{{ video_eyebrow | escape }}"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"
              class="story-video__embed"
            ></iframe>
          {%- endif -%}
        {%- endif -%}
      {%- elsif section.settings.video_file_url != blank -%}
        <video
          class="story-video__player"
          controls
          playsinline
          preload="metadata"
          {%- if section.settings.video_poster != blank %}
            poster="{{ section.settings.video_poster | image_url: width: 1200 }}"
          {%- endif %}
        >
          <source src="{{ section.settings.video_file_url }}" type="video/mp4">
        </video>
        <div class="story-video__play-overlay" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="31" stroke="currentColor" stroke-width="1.5" opacity="0.6"/>
            <polygon points="26,20 26,44 46,32" fill="currentColor"/>
          </svg>
        </div>
      {%- else -%}
        <div class="story-video__placeholder" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="31" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
            <polygon points="26,20 26,44 46,32" fill="currentColor" opacity="0.3"/>
          </svg>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%} ══ SECTION 3: TIMELINE / JOURNEY ══ {%- endcomment -%}
{%- if milestone_blocks.size > 0 -%}
<section class="story-timeline full-width" data-surface="cream">
  <div class="story-timeline__wrap">
    <div class="story-timeline__track">
      <div class="story-timeline__line" aria-hidden="true"></div>
      {%- for block in milestone_blocks -%}
        <div class="story-timeline__milestone" data-animate="story-fade-up" {{ block.shopify_attributes }}>
          <div class="story-timeline__dot" aria-hidden="true"></div>
          <div class="story-timeline__content">
            {%- if block.settings.heading != blank -%}
              <h3 class="story-timeline__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="story-timeline__body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ══ SECTION 4: WHY MOOV (vertical stack) ══ {%- endcomment -%}
{%- if letter_blocks.size > 0 or moov_heading != blank -%}
<section class="story-moov full-width" data-surface="dark">
  <div class="story-moov__wrap">
    {%- if moov_heading != blank -%}
      <h2 class="story-moov__heading" data-animate="story-fade-up">{{ moov_heading | escape }}</h2>
    {%- endif -%}

    {%- if letter_blocks.size > 0 -%}
      <div class="story-moov__stack">
        {%- for block in letter_blocks -%}
          <div class="story-moov__item" data-animate="story-fade-up" {{ block.shopify_attributes }}>
            <span class="story-moov__letter">{{ block.settings.letter | escape }}</span>
            <div class="story-moov__word-wrap">
              <span class="story-moov__word">{{ block.settings.word | escape }}</span>
              {%- if block.settings.description != blank -%}
                <p class="story-moov__desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </div>
          {%- unless forloop.last -%}
            <div class="story-moov__separator" aria-hidden="true"></div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if moov_body != blank -%}
      <p class="story-moov__body" data-animate="story-fade-up">{{ moov_body | escape }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{%- comment -%} ══ SECTION 5: CLOSING (warm, welcoming) ══ {%- endcomment -%}
<section class="story-closing full-width" data-surface="cream">
  <div class="story-closing__wrap" data-animate="story-fade-up">
    {%- if closing_heading != blank -%}
      <h2 class="story-closing__heading">{{ closing_heading | escape }}</h2>
    {%- endif -%}
    {%- if closing_body != blank -%}
      <p class="story-closing__body">{{ closing_body | escape }}</p>
    {%- endif -%}
    {%- if closing_button_label != blank -%}
      <a href="{{ closing_button_url }}" class="story-closing__btn">
        {{- closing_button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ══ SECTION 1: HERO (split layout) ══ */
  .story-hero {
    background: var(--moov-cream);
    padding: var(--section-block-pad-y-lg) 0;
  }

  .story-hero__wrap {
    width: 100%;
    max-width: min(
      calc(var(--layout-max-width) + clamp(2rem, 6vw, 8.5rem)),
      calc(100vw - 2 * var(--section-inline-pad))
    );
    box-sizing: border-box;
    margin-inline: auto;
    padding: 0 var(--section-inline-pad);
  }

  .story-hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .story-hero__media {
    border-radius: 16px;
    overflow: hidden;
  }

  .story-hero__img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  .story-hero__placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: linear-gradient(135deg, var(--moov-wash-on-cream-4) 0%, var(--moov-wash-on-cream-6) 100%);
    border-radius: 16px;
  }

  .story-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .story-hero__heading {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-3xl);
    line-height: 1.25;
    color: var(--moov-text-primary-light);
    margin: 0;
    text-wrap: balance;
  }

  .story-hero__body {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.7;
    color: var(--moov-text-secondary-light);
    margin: 0;
    max-width: 38ch;
  }

  @media (max-width: 749px) {
    .story-hero__grid {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 4vw, 2.5rem);
    }

    .story-hero__img {
      aspect-ratio: 4 / 5;
    }

    .story-hero__placeholder {
      aspect-ratio: 4 / 5;
    }

    .story-hero__heading {
      font-size: var(--text-2xl);
    }
  }

  /* ══ SECTION 2: FOUNDER VIDEO ══ */
  .story-video {
    background: var(--moov-black);
    padding: var(--section-block-pad-y-lg) 0;
  }

  .story-video__wrap {
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
    padding: 0 var(--section-inline-pad);
    box-sizing: border-box;
    text-align: center;
  }

  .story-video__eyebrow {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-eyebrow-accent);
    margin: 0 0 clamp(1.25rem, 2vw, 2rem);
  }

  .story-video__frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: color-mix(in srgb, var(--moov-cream) 6%, var(--moov-black));
  }

  .story-video__embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .story-video__player {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-video__play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--moov-cream);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .story-video__player:not(:paused) ~ .story-video__play-overlay {
    opacity: 0;
  }

  .story-video__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--moov-text-secondary-dark);
  }

  /* ══ SECTION 3: TIMELINE / JOURNEY ══ */
  .story-timeline {
    background: var(--moov-cream);
    padding: var(--section-block-pad-y-xl) 0;
  }

  .story-timeline__wrap {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
    padding: 0 var(--section-inline-pad);
    box-sizing: border-box;
  }

  .story-timeline__track {
    position: relative;
    padding-left: 2rem;
  }

  .story-timeline__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 4px;
    width: 2px;
    background: var(--moov-border-light);
  }

  .story-timeline__milestone {
    position: relative;
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .story-timeline__milestone:last-child {
    padding-bottom: 0;
  }

  .story-timeline__dot {
    position: absolute;
    left: calc(-2rem + -1px);
    top: 0.35em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--moov-amber);
  }

  .story-timeline__content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .story-timeline__heading {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--moov-text-primary-light);
    margin: 0;
  }

  .story-timeline__body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.7;
    color: var(--moov-text-secondary-light);
    margin: 0;
    max-width: 50ch;
  }

  /* Mobile: simpler left-border accent, no dots */
  @media (max-width: 749px) {
    .story-timeline__track {
      padding-left: 1.25rem;
    }

    .story-timeline__line {
      left: 0;
    }

    .story-timeline__dot {
      display: none;
    }
  }

  /* ══ SECTION 4: WHY MOOV ══ */
  .story-moov {
    background: var(--moov-black);
    padding: var(--section-block-pad-y-lg) 0;
  }

  .story-moov__wrap {
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    padding: 0 var(--section-inline-pad);
    box-sizing: border-box;
    text-align: center;
  }

  .story-moov__heading {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-3xl);
    color: var(--moov-text-primary-dark);
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.01em;
  }

  .story-moov__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: left;
  }

  .story-moov__item {
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.5rem);
    width: 100%;
    padding: clamp(1rem, 2vw, 1.5rem) 0;
  }

  .story-moov__letter {
    font-family: var(--font-body);
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1;
    color: var(--moov-amber);
    flex-shrink: 0;
    min-width: 2.5ch;
  }

  .story-moov__word-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 0.5em;
  }

  .story-moov__word {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--moov-text-primary-dark);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .story-moov__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1.7;
    color: var(--moov-text-secondary-dark);
    margin: 0;
    max-width: 40ch;
  }

  .story-moov__separator {
    width: 100%;
    height: 1px;
    background: var(--moov-border-dark);
  }

  .story-moov__body {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.7;
    color: var(--moov-text-secondary-dark);
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    max-width: 50ch;
    text-align: center;
  }

  /* ══ SECTION 5: CLOSING ══ */
  .story-closing {
    background: var(--moov-cream);
    padding: var(--section-block-pad-y-lg) 0;
    text-align: center;
  }

  .story-closing__wrap {
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    padding: 0 var(--section-inline-pad);
    box-sizing: border-box;
  }

  .story-closing__heading {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-2xl);
    color: var(--moov-text-primary-light);
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    text-wrap: balance;
  }

  .story-closing__body {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.7;
    color: var(--moov-text-secondary-light);
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    max-width: 50ch;
    margin-inline: auto;
  }

  .story-closing__btn {
    display: inline-block;
    padding: 14px 28px;
    border: 1.5px solid var(--moov-border-amber);
    border-radius: 999px;
    color: var(--moov-text-primary-light);
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .story-closing__btn:hover {
    background: var(--moov-amber);
    color: var(--moov-black);
  }

  /* ══ ANIMATIONS ══ */
  [data-animate="story-fade-up"] {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  [data-animate="story-fade-up"].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animate="story-fade-up"] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var els = document.querySelectorAll('[data-animate^="story-"]');
    if (!els.length) return;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    els.forEach(function (el) { observer.observe(el); });
  })();
{% endjavascript %}

