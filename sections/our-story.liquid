  [data-theme="dark"] .about-page-founder__mobile-step { border-left-color: var(--moov-border-dark); }
  .about-page-founder__mobile-step-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0 0 6px;
  }
  .about-page-founder__mobile-step-body {
    font-size: 13px;
    line-height: 1.55;
    color: var(--moov-text-secondary-light);
    margin: 0;
  }
  [data-theme="dark"] .about-page-founder__mobile-step-body { color: var(--moov-text-secondary-dark); }
  .about-page-founder__media { border-radius: 14px; }
  .about-page-founder__caption { padding-top: 18px; }
  .about-page-founder__caption-title { font-size: clamp(1.25rem, 6vw, 1.75rem); line-height: 1.18; }
  .about-page-founder__caption-text { font-size: 14px; line-height: 1.6; max-width: 100%; }
  .about-stats { padding: 32px 24px; }
  .about-stats__inner { grid-template-columns: 1fr; }
  .about-stats__card { min-height: 0; padding: 28px 24px; gap: 18px; }
  .about-career { padding: 56px 24px; }
  .about-career__inner { grid-template-columns: 1fr; }
  .about-career__img,
  .about-career__img-placeholder { min-height: 320px; }
  .about-career__content-col { padding: 44px 28px; }
  .about-career__body { font-size: 14px; line-height: 1.6; }
  .about-blog { padding: 0 24px 56px; }
  .about-blog__header { flex-wrap: wrap; gap: 14px; margin-bottom: 22px; }
  .about-blog__read-all { padding: 10px 18px; }
  .about-blog__grid { grid-template-columns: 1fr; }
}

@media (min-width: 600px) and (max-width: 960px) {
  .about-blog__grid { grid-template-columns: repeat(2, 1fr); }
  .about-stats__inner { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .about-hero { padding: 40px 16px 28px; }
  .about-hero__eyebrow { margin-bottom: 12px; letter-spacing: 0.15em; }
  .about-image-grid { padding: 0 16px 40px; }
  .about-feature { padding: 40px 16px 48px; }
  .about-page-founder { padding: 1.75rem 1rem 2.5rem; }
  .about-page-founder__title { margin-bottom: 1rem; font-size: clamp(1.6rem, 10vw, 2.2rem); }
  .about-page-founder__articles { gap: 2rem; }
  .about-stats { padding: 24px 16px; }
  .about-career { padding: 44px 16px; }
  .about-career__img,
  .about-career__img-placeholder { min-height: 250px; }
  .about-career__content-col { padding: 34px 20px; }
  .about-career__btn { width: 100%; justify-content: center; }
  .about-blog { padding: 0 16px 44px; }
  .about-blog__grid { gap: 20px; }
}

