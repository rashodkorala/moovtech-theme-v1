{% comment %}
  Story page: In Shopify admin, create a page (e.g. handle "story") and set Theme template to "our-story".
  Body copy defaults ship via templates/page.our-story.json; add grid, step, and CTA images in the theme editor.
{% endcomment %}
<div class="about-page" id="about-page-{{ section.id }}">

  {%- comment -%} ── 1. HERO ── {%- endcomment -%}
  <div class="about-hero">
    <div class="about-hero__inner">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="about-hero__eyebrow">{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.hero_headline != blank -%}
        <h1 class="about-hero__headline">
          {%- assign hl = section.settings.hero_headline -%}
          {%- assign hl_parts = hl | split: 'easier' -%}
          {%- if hl_parts.size == 2 -%}
            {{- hl_parts[0] | escape -}}<span class="about-page-accent">easier</span>{{- hl_parts[1] | escape -}}
          {%- else -%}
            {%- assign hl_parts_cap = hl | split: 'Easier' -%}
            {%- if hl_parts_cap.size == 2 -%}
              {{- hl_parts_cap[0] | escape -}}<span class="about-page-accent">Easier</span>{{- hl_parts_cap[1] | escape -}}
            {%- else -%}
              {{- hl | escape -}}
            {%- endif -%}
          {%- endif -%}
        </h1>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── 2. TWO-COLUMN IMAGE GRID ── {%- endcomment -%}
  <div class="about-image-grid">
    <div class="about-image-grid__inner">
      <div class="about-image-grid__left">
        {%- if section.settings.feature_image_left != blank -%}
          {{ section.settings.feature_image_left | image_url: width: 900 | image_tag: loading: 'lazy', class: 'about-image-grid__img' }}
        {%- elsif section.settings.feature_image_left_url != blank -%}
          <img
            src="{{ section.settings.feature_image_left_url | escape }}"
            alt=""
            loading="lazy"
            class="about-image-grid__img"
            width="900"
            height="1200"
          >
        {%- else -%}
          <div class="about-image-grid__placeholder about-image-grid__placeholder--tall"></div>
        {%- endif -%}
      </div>
      <div class="about-image-grid__right">
        {%- if section.settings.feature_image_right != blank -%}
          {{ section.settings.feature_image_right | image_url: width: 900 | image_tag: loading: 'lazy', class: 'about-image-grid__img' }}
        {%- elsif section.settings.feature_image_right_url != blank -%}
          <img
            src="{{ section.settings.feature_image_right_url | escape }}"
            alt=""
            loading="lazy"
            class="about-image-grid__img"
            width="900"
            height="675"
          >
        {%- else -%}
          <div class="about-image-grid__placeholder about-image-grid__placeholder--wide"></div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ── 3. FEATURE BLOCK ── {%- endcomment -%}
  <div class="about-feature">
    <div class="about-feature__inner">
      <div class="about-feature__left">
        {%- if section.settings.feature_headline != blank -%}
          <h2 class="about-feature__headline">
            {%- assign fh = section.settings.feature_headline -%}
            {%- assign fh_parts = fh | split: 'believe' -%}
            {%- if fh_parts.size == 2 -%}
              {{- fh_parts[0] | escape -}}<span class="about-page-accent">believe</span>{{- fh_parts[1] | escape -}}
            {%- else -%}
              {%- assign fh_parts2 = fh | split: 'Believe' -%}
              {%- if fh_parts2.size == 2 -%}
                {{- fh_parts2[0] | escape -}}<span class="about-page-accent">Believe</span>{{- fh_parts2[1] | escape -}}
              {%- else -%}
                {%- assign fh_parts3 = fh | split: 'BELIEVE' -%}
                {%- if fh_parts3.size == 2 -%}
                  {{- fh_parts3[0] | escape -}}<span class="about-page-accent">BELIEVE</span>{{- fh_parts3[1] | escape -}}
                {%- else -%}
                  {{- fh | escape -}}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          </h2>
        {%- endif -%}
      </div>
      <div class="about-feature__right">
        <div class="about-feature__body-cols">
          {%- if section.settings.feature_body_1 != blank -%}
            <p class="about-feature__body">{{ section.settings.feature_body_1 }}</p>
          {%- endif -%}
          {%- if section.settings.feature_body_2 != blank -%}
            <p class="about-feature__body">{{ section.settings.feature_body_2 }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ── 4. STORY SECTION ── {%- endcomment -%}
  {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
  {%- if step_blocks.size > 0 -%}
  <div class="about-page-founder" data-founder-spy-root="{{ section.id }}">
    <div class="about-page-founder__inner">
      <div class="about-page-founder__grid">

        {%- comment -%} Left column: title + sidebar nav {%- endcomment -%}
        <aside class="about-page-founder__sidebar" id="about-page-founder-sidebar-{{ section.id }}">
          <h2 class="about-page-founder__title">
            {%- if section.settings.story_sidebar_title != blank -%}
              {{ section.settings.story_sidebar_title | upcase }}
            {%- else -%}
              {{ 'sections.about_page.our_story' | t | default: 'Our Story' | upcase }}
            {%- endif -%}
          </h2>
          <div class="about-page-founder__nav-rule"></div>
          <div class="about-page-founder__nav">
            {%- for block in step_blocks -%}
              <button
                type="button"
                class="about-page-founder__nav-btn{% if forloop.first %} about-page-founder__nav-btn--active{% endif %}"
                data-story-index="{{ forloop.index0 }}"
                aria-pressed="{{ forloop.first | json }}"
                aria-controls="about-page-founder-article-{{ section.id }}-{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.label != blank -%}
                  <p class="about-page-founder__nav-label">
                    {%- assign nl = block.settings.label | upcase | escape -%}
                    {%- assign nl = nl | replace: 'FRUSTRATION', '<span class="about-page-accent">FRUSTRATION</span>' -%}
                    {{- nl -}}
                  </p>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="about-page-founder__nav-body">{{ block.settings.body }}</p>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        </aside>

        {%- comment -%} Right slides {%- endcomment -%}
        <div class="about-page-founder__articles" id="about-page-founder-articles-{{ section.id }}">
          {%- for block in step_blocks -%}
            <article
              class="about-page-founder__article{% if forloop.first %} about-page-founder__article--active{% endif %}"
              id="about-page-founder-article-{{ section.id }}-{{ forloop.index0 }}"
              data-story-block="{{ forloop.index0 }}"
              tabindex="-1"
            >
              <div class="about-page-founder__mobile-step">
                {%- if block.settings.label != blank -%}
                  <p class="about-page-founder__mobile-step-label">
                    {%- assign msl = block.settings.label | upcase | escape -%}
                    {%- assign msl = msl | replace: 'FRUSTRATION', '<span class="about-page-accent">FRUSTRATION</span>' -%}
                    {{- msl -}}
                  </p>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="about-page-founder__mobile-step-body">{{ block.settings.body }}</p>
                {%- endif -%}
              </div>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'about-page-founder__media' }}
              {%- elsif block.settings.image_url != blank -%}
                <img
                  src="{{ block.settings.image_url | escape }}"
                  alt="{{ block.settings.caption_headline | default: block.settings.label | escape }}"
                  loading="lazy"
                  class="about-page-founder__media"
                  width="1400"
                  height="788"
                >
              {%- else -%}
                <div class="about-page-founder__media-placeholder"></div>
              {%- endif -%}
              {%- if block.settings.caption_headline != blank or block.settings.caption_body != blank -%}
                <div class="about-page-founder__caption">
                  {%- if block.settings.caption_headline != blank -%}
                    <h3 class="about-page-founder__caption-title">
                      {%- assign ch = block.settings.caption_headline | escape -%}
                      {%- assign ch = ch | replace: 'FRUSTRATION', '<span class="about-page-accent">FRUSTRATION</span>' -%}
                      {%- assign ch = ch | replace: 'Frustration', '<span class="about-page-accent">Frustration</span>' -%}
                      {%- assign ch = ch | replace: 'frustration', '<span class="about-page-accent">frustration</span>' -%}
                      {%- assign ch = ch | replace: 'SYSTEM', '<span class="about-page-accent">SYSTEM</span>' -%}
                      {%- assign ch = ch | replace: 'System', '<span class="about-page-accent">System</span>' -%}
                      {%- assign ch = ch | replace: 'system', '<span class="about-page-accent">system</span>' -%}
                      {{- ch -}}
                    </h3>
                  {%- endif -%}
                  {%- if block.settings.caption_body != blank -%}
                    <p class="about-page-founder__caption-text">
                      {%- assign cb = block.settings.caption_body | escape -%}
                      {%- assign cb = cb | replace: 'ONE MORNING AT A TIME', '<span class="about-page-accent">ONE MORNING AT A TIME</span>' -%}
                      {%- assign cb = cb | replace: 'One morning at a time', '<span class="about-page-accent">One morning at a time</span>' -%}
                      {%- assign cb = cb | replace: 'one morning at a time', '<span class="about-page-accent">one morning at a time</span>' -%}
                      {{- cb -}}
                    </p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>

      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ── 5. STATS BAND ── {%- endcomment -%}
  {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
  {%- if stat_blocks.size > 0 -%}
    <div class="about-stats">
      <div class="about-stats__inner">
        {%- for block in stat_blocks -%}
          <div class="about-stats__card" {{ block.shopify_attributes }}>
            <div class="about-stats__card-top">
              {%- if block.settings.number != blank -%}
                <p class="about-stats__number">{{ block.settings.number }}</p>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <p class="about-stats__label">{{ block.settings.label | upcase }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.description != blank -%}
              <p class="about-stats__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── 6. BOTTOM CTA (shop / newsletter) ── {%- endcomment -%}
  {%- if section.settings.show_career_cta -%}
  <div class="about-career">
    <div class="about-career__inner">
      <div class="about-career__image-col">
        {%- if section.settings.career_image != blank -%}
          {{ section.settings.career_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'about-career__img' }}
        {%- elsif section.settings.career_image_url != blank -%}
          <img
            src="{{ section.settings.career_image_url | escape }}"
            alt=""
            loading="lazy"
            class="about-career__img"
            width="1000"
            height="1250"
          >
        {%- else -%}
          <div class="about-career__img-placeholder"></div>
        {%- endif -%}
      </div>
      <div class="about-career__content-col">
        <div class="about-career__content">
          {%- if section.settings.career_label != blank -%}
            <p class="about-career__label">{{ section.settings.career_label | upcase }}</p>
          {%- endif -%}
          {%- if section.settings.career_headline != blank -%}
            <h2 class="about-career__headline">{{ section.settings.career_headline | upcase }}</h2>
          {%- endif -%}
          {%- if section.settings.career_body != blank -%}
            <p class="about-career__body">{{ section.settings.career_body }}</p>
          {%- endif -%}
          {%- if section.settings.career_button_label != blank -%}
            <a href="{{ section.settings.career_button_url | default: '#' }}" class="about-career__btn">
              {{ section.settings.career_button_label }}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5M11.5 2.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ── 7. BLOG GRID ── {%- endcomment -%}
  {%- assign article_blocks = section.blocks | where: 'type', 'article' -%}
  {%- if article_blocks.size > 0 -%}
    <div class="about-blog">
      <div class="about-blog__inner">
        <div class="about-blog__header">
          <h2 class="about-blog__heading">{{ 'sections.about_page.blog_heading' | t | default: 'Blog' | upcase }}</h2>
          {%- if section.settings.blog_read_all_url != blank -%}
            <a href="{{ section.settings.blog_read_all_url }}" class="about-blog__read-all">
              {{ section.settings.blog_read_all_label | default: 'Read all' }}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5M11.5 2.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
        <div class="about-blog__grid">
          {%- for block in article_blocks -%}
            <article class="about-blog__card" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.url | default: '#' }}" class="about-blog__card-image-link">
                <div class="about-blog__card-image-wrap">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'about-blog__card-img' }}
                  {%- elsif block.settings.image_url != blank -%}
                    <img
                      src="{{ block.settings.image_url | escape }}"
                      alt="{{ block.settings.title | escape }}"
                      loading="lazy"
                      class="about-blog__card-img"
                      width="800"
                      height="600"
                    >
                  {%- else -%}
                    <div class="about-blog__card-img-placeholder"></div>
                  {%- endif -%}
                </div>
              </a>
              <div class="about-blog__card-meta">
                {%- if block.settings.category != blank -%}
                  <span class="about-blog__card-category">{{ block.settings.category }}</span>
                  <span class="about-blog__card-sep">&middot;</span>
                {%- endif -%}
                {%- if block.settings.date != blank -%}
                  <span class="about-blog__card-date">{{ block.settings.date }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="about-blog__card-title">{{ block.settings.title | upcase }}</h3>
              {%- endif -%}
              <a href="{{ block.settings.url | default: '#' }}" class="about-blog__card-link">
                <span class="about-blog__card-link-icon">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5M11.5 2.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                {{ 'sections.about_page.read_article' | t | default: 'Read article' }}
              </a>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

</div>

{% stylesheet %}

.about-page {
  font-family: var(--font-body, 'Helvetica Neue', Helvetica, Arial, sans-serif);
  color: var(--color-foreground);
  background: var(--color-background);
  overflow-x: clip;
}

/* ── 1. Hero ── */
.about-hero {
  background: transparent;
  padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
  text-align: center;
}
.about-hero__inner {
  max-width: 1000px;
  margin: 0 auto;
}
.about-hero__eyebrow {
  font-size: clamp(0.875rem, 1.5vw, 1.125rem);
  font-weight: 400;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--moov-text-secondary-light);
  margin: 0 0 20px;
  line-height: 1.6;
}
[data-theme="dark"] .about-hero__eyebrow {
  color: var(--moov-text-secondary-dark);
}
.about-hero__headline {
  font-family: var(--font-hero);
  font-size: clamp(1.75rem, 3.5vw, 3rem);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.0;
  margin: 0;
  color: var(--color-foreground);
}
.about-page-accent {
  color: var(--color-accent);
}

/* ── 2. Image Grid ── */
.about-image-grid {
  background: transparent;
  padding: 0 clamp(1.5rem, 5vw, 4rem) clamp(3rem, 5vw, 5rem);
}
.about-image-grid__inner {
  display: grid;
  grid-template-columns: 2fr 3fr;
  grid-template-rows: clamp(320px, 50vw, 620px);
  gap: 14px;
}
.about-image-grid__left,
.about-image-grid__right {
  overflow: hidden;
  border-radius: 20px;
  height: 100%;
}
.about-image-grid__left .about-image-grid__img,
.about-image-grid__left .about-image-grid__placeholder,
.about-image-grid__right .about-image-grid__img,
.about-image-grid__right .about-image-grid__placeholder {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.about-image-grid__placeholder {
  background: var(--moov-wash-on-cream-6);
}
[data-theme="dark"] .about-image-grid__placeholder {
  background: var(--moov-surface-dark-raised);
}

/* ── 3. Feature Block ── */
.about-feature {
  padding: 64px 48px 80px;
}
.about-feature__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: start;
}
.about-feature__headline {
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.1;
  margin: 0;
  color: var(--color-foreground);
}
.about-feature__body-cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
}
.about-feature__body {
  font-size: 15px;
  font-weight: 400;
  color: var(--moov-text-secondary-light);
  line-height: 1.65;
  margin: 0;
}
[data-theme="dark"] .about-feature__body {
  color: var(--moov-text-secondary-dark);
}

/* ── 4. Founder story (namespaced; avoids clash with moov-about .about-story__inner grid) ── */
.about-page-founder {
  padding: clamp(3rem, 5vw, 5rem) clamp(1.5rem, 5vw, 4rem);
  background: transparent;
}
.about-page-founder__inner {
  width: 100%;
  max-width: min(
    calc(var(--page-width) - var(--page-margin) * 2),
    calc(100% - var(--page-margin) * 2)
  );
  margin-inline: auto;
}
.about-page-founder__grid {
  display: grid;
  grid-template-columns: minmax(280px, 380px) minmax(0, 1fr);
  gap: clamp(2rem, 4vw, 3.5rem);
  align-items: start;
  width: 100%;
  min-width: 0;
}

/* Left column: title + sidebar nav */
.about-page-founder__sidebar {
  position: sticky;
  top: var(--about-founder-sticky-top, calc(var(--header-height, 5rem) + 1.25rem));
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
}
.about-page-founder__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  color: var(--color-foreground);
  margin: 0.25rem 0 clamp(1.5rem, 3vw, 2.5rem);
  line-height: 1.05;
}
.about-page-founder__nav-rule {
  display: none;
}
.about-page-founder__nav {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  border-left: 1.5px solid var(--moov-border-light);
  padding-left: 5px;
}
[data-theme="dark"] .about-page-founder__nav {
  border-left-color: var(--moov-border-dark);
}
.about-page-founder__nav-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  background: none;
  border: 1px solid transparent;
  border-radius: 10px;
  padding: 16px 18px;
  text-align: left;
  cursor: pointer;
  opacity: 0.35;
  transition: opacity 0.25s ease, border-color 0.25s ease, background 0.25s ease;
}
.about-page-founder__nav-btn--active {
  opacity: 1;
  border-color: var(--moov-border-light);
  background: var(--moov-wash-on-cream-4);
}
[data-theme="dark"] .about-page-founder__nav-btn--active {
  border-color: var(--moov-border-dark);
  background: var(--moov-surface-dark-raised);
}
.about-page-founder__nav-label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-foreground);
  margin: 0 0 8px;
}
.about-page-founder__nav-body {
  font-size: 14px;
  font-weight: 400;
  color: var(--moov-text-secondary-light);
  line-height: 1.6;
  margin: 0;
}
[data-theme="dark"] .about-page-founder__nav-body {
  color: var(--moov-text-secondary-dark);
}

/* Slides: stacked for scroll; nav highlights via scroll-spy */
.about-page-founder__articles {
  display: flex;
  flex-direction: column;
  gap: clamp(2.5rem, 5vw, 4rem);
  min-width: 0;
}
.about-page-founder__article {
  scroll-margin-top: calc(var(--about-founder-sticky-top, var(--header-height, 5rem)) + 0.5rem);
  min-width: 0;
  opacity: 0.55;
  transition: opacity 0.28s ease;
}
.about-page-founder__article--active {
  opacity: 1;
}
.about-page-founder__article:last-child {
  margin-bottom: 0;
}
.about-page-founder__mobile-step {
  display: none;
}
.about-page-founder__media {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 16px;
  display: block;
}
.about-page-founder__media-placeholder {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: var(--moov-wash-on-cream-6);
