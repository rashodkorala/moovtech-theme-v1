{%- liquid
  assign hero_overlay = section.settings.hero_overlay_opacity | default: 55
  assign panel_overlay = section.settings.panel_overlay_opacity | default: 20
  assign hero_eyebrow = section.settings.hero_eyebrow
  if hero_eyebrow == blank
    assign hero_eyebrow = 'sections.our_story.default_hero_eyebrow' | t
  endif
  assign hero_heading = section.settings.hero_heading
  if hero_heading == blank
    assign hero_heading = 'sections.our_story.default_hero_heading' | t
  endif
  assign hero_body = section.settings.hero_body
  if hero_body == blank
    assign hero_body = 'sections.our_story.default_hero_body' | t
  endif
  assign hero_cta_label = section.settings.hero_cta_label
  assign hero_cta_url = section.settings.hero_cta_url | default: routes.root_url

  assign step_blocks = section.blocks | where: 'type', 'step'

  assign founder_eyebrow = section.settings.founder_eyebrow
  if founder_eyebrow == blank
    assign founder_eyebrow = 'sections.our_story.default_founder_eyebrow' | t
  endif
  assign founder_heading = section.settings.founder_heading
  if founder_heading == blank
    assign founder_heading = 'sections.our_story.default_founder_heading' | t
  endif
  assign founder_body = section.settings.founder_body
  if founder_body == blank
    assign founder_body = 'sections.our_story.default_founder_body' | t
  endif
  assign founder_cta_label = section.settings.founder_cta_label
  assign founder_cta_url = section.settings.founder_cta_url | default: '/collections/all'

  assign cta_heading = section.settings.cta_heading
  if cta_heading == blank
    assign cta_heading = 'sections.our_story.default_cta_heading' | t
  endif
  assign cta_body = section.settings.cta_body
  if cta_body == blank
    assign cta_body = 'sections.our_story.default_cta_body' | t
  endif
  assign cta_button_label = section.settings.cta_button_label
  if cta_button_label == blank
    assign cta_button_label = 'sections.our_story.default_cta_button' | t
  endif
  assign cta_button_url = section.settings.cta_button_url | default: '/collections/all'
-%}

{%- comment -%} ══ ZONE 1: HERO ══ {%- endcomment -%}
<section class="story-hero full-width" data-surface="dark" style="--story-hero-overlay: color-mix(in srgb, var(--moov-black) {{ hero_overlay }}%, transparent);">
  <div class="story-hero__wrap">
    <div class="story-hero__frame">
      <div class="story-hero__media">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'story-hero__img', sizes: '100vw', widths: '600, 900, 1200, 1800, 2400' }}
        {%- elsif section.settings.hero_image_url != blank -%}
          <img src="{{ section.settings.hero_image_url | escape }}" alt="" loading="eager" class="story-hero__img" width="2400" height="1350">
        {%- else -%}
          <div class="story-hero__placeholder" aria-hidden="true"></div>
        {%- endif -%}
        <div class="story-hero__overlay" aria-hidden="true"></div>
      </div>

      <div class="story-hero__content" data-animate="story-fade-up">
        {%- if hero_eyebrow != blank -%}
          <p class="story-hero__overline">{{ hero_eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="story-hero__heading">{{ hero_heading | escape }}</h1>
        {%- if hero_body != blank -%}
          <p class="story-hero__body">{{ hero_body | escape }}</p>
        {%- endif -%}
        {%- if hero_cta_label != blank -%}
          <a href="{{ hero_cta_url }}" class="story-hero__cta">
            {{- hero_cta_label | escape -}}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="2" y1="12" x2="12" y2="2"/><polyline points="5,2 12,2 12,9"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} ══ ZONE 2: ORIGIN STORY — CINEMATIC SCROLL PANELS ══ {%- endcomment -%}
{%- if step_blocks.size > 0 -%}
<section class="story-panels full-width" data-surface="dark">
  <div class="story-panels__stack">
    {%- for block in step_blocks -%}
      {%- assign is_reversed = forloop.index | modulo: 2 -%}
      <div class="story-panels__item">
        <div class="story-panel__wrap">
          <div class="story-panel__frame" data-surface="cream">
            <div class="story-panel{% if is_reversed == 0 %} story-panel--reversed{% endif %}" data-animate="story-fade-up" style="--story-panel-overlay: color-mix(in srgb, var(--moov-black) {{ panel_overlay }}%, transparent);" {{ block.shopify_attributes }}>
              <div class="story-panel__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'story-panel__img', sizes: '(min-width: 768px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1400' }}
                {%- elsif block.settings.image_url != blank -%}
                  <img src="{{ block.settings.image_url | escape }}" alt="" loading="lazy" class="story-panel__img" width="1400" height="900">
                {%- else -%}
                  <div class="story-panel__placeholder" aria-hidden="true"></div>
                {%- endif -%}
                <div class="story-panel__overlay" aria-hidden="true"></div>
              </div>
              <div class="story-panel__text">
                {%- if block.settings.caption_headline != blank -%}
                  <h2 class="story-panel__heading">{{ block.settings.caption_headline | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.caption_body != blank -%}
                  <p class="story-panel__body">{{ block.settings.caption_body | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{%- comment -%} ══ ZONE 3: VALUES — TYPOGRAPHIC TILES ══ {%- endcomment -%}
{%- assign value_blocks = section.blocks | where: 'type', 'value' -%}
{%- if value_blocks.size > 0 -%}
<section class="story-values full-width" data-surface="dark">
  <div class="story-values__grid">
    {%- for block in value_blocks -%}
      <div class="story-values__tile" style="--stagger: {{ forloop.index0 | times: 1 }}" data-animate="story-fade-up" {{ block.shopify_attributes }}>
        <span class="story-values__watermark" aria-hidden="true">{{ block.settings.value_word | escape }}</span>
        <h3 class="story-values__title">{{ block.settings.value_title | escape }}</h3>
        <p class="story-values__desc">{{ block.settings.value_description | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{%- comment -%} ══ ZONE 4: FOUNDER NOTE ══ {%- endcomment -%}
<section class="story-founder full-width" data-surface="dark">
  <div class="story-founder__wrap">
    <div class="story-founder__frame" data-surface="cream">
      <div class="story-founder__inner">
        <div class="story-founder__media" data-animate="story-fade">
          {%- if section.settings.founder_image != blank -%}
            {{ section.settings.founder_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'story-founder__img', sizes: '(min-width: 768px) 45vw, 100vw', widths: '400, 600, 800, 1000, 1200' }}
          {%- elsif section.settings.founder_image_url != blank -%}
            <img src="{{ section.settings.founder_image_url | escape }}" alt="" loading="lazy" class="story-founder__img" width="1200" height="800">
          {%- else -%}
            <div class="story-founder__placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>
        <div class="story-founder__content" data-animate="story-slide-right">
          {%- if founder_eyebrow != blank -%}
            <p class="story-founder__eyebrow">{{ founder_eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="story-founder__heading">{{ founder_heading | escape }}</h2>
          {%- if founder_body != blank -%}
            <p class="story-founder__body">{{ founder_body | escape }}</p>
          {%- endif -%}
          {%- if founder_cta_label != blank -%}
            <a href="{{ founder_cta_url }}" class="story-founder__cta">
              {{- founder_cta_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ══ ZONE 5: BOTTOM CTA ══ {%- endcomment -%}
<section class="story-cta full-width" data-surface="dark" data-animate="story-fade-up">
  <div class="story-cta__inner">
    <h2 class="story-cta__heading">{{ cta_heading | escape }}</h2>
    {%- if cta_body != blank -%}
      <p class="story-cta__body">{{ cta_body | escape }}</p>
    {%- endif -%}
    <a href="{{ cta_button_url }}" class="story-cta__btn">
      {{- cta_button_label | escape -}}
    </a>
  </div>
</section>

{% stylesheet %}
  /* ══ ZONE 1: HERO ══ */
  .story-hero {
    position: relative;
    background: var(--moov-black);
    padding: calc(var(--section-block-pad-y-md) * 0.58) 0 calc(var(--section-block-pad-y-sm) * 0.58);
  }

  .story-hero__wrap {
    width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-inline: auto;
    max-width: none;
  }

  .story-hero__frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: clamp(18px, 2.4vw, 28px);
    min-height: min(70vh, 640px);
    isolation: isolate;
  }

  @media (max-width: 749px) {
    .story-hero__frame {
      min-height: min(58vh, 520px);
    }
  }

  .story-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .story-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-hero__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, color-mix(in srgb, var(--moov-cream) 20%, var(--moov-black)) 0%, var(--moov-black) 100%);
  }

  .story-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--story-hero-overlay);
    z-index: 1;
    pointer-events: none;
  }

  .story-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    text-align: center;
    padding: var(--section-block-pad-y-hero) var(--section-inline-pad) var(--section-block-pad-y-hero-bottom);
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .story-hero__overline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-eyebrow-accent);
    margin: 0 0 20px;
  }

  .story-hero__overline::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent, #ed9d09);
    box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent, #ed9d09) 70%, transparent);
    animation: story-pulse 2.4s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes story-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.25); opacity: 0.75; }
  }

  .story-hero__heading {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: var(--text-5xl);
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--moov-text-primary-dark);
    margin: 0 0 28px;
  }

  .story-hero__body {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.7;
    color: var(--moov-text-secondary-dark);
    margin: 0 0 36px;
    max-width: 560px;
  }

  .story-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 14px 28px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.03em;
    text-decoration: none;
    background: #fff;
    color: var(--moov-black);
    border: none;
    transition: opacity 0.2s ease;
  }

  .story-hero__cta:hover {
    opacity: 0.85;
  }

  /* ══ ZONE 2: CINEMATIC PANELS (inset rounded frames on dark, mirrors story-hero) ══ */
  .story-panels {
    background: var(--moov-black);
    padding: calc(var(--section-block-pad-y-md) * 0.58) 0 calc(var(--section-block-pad-y-sm) * 0.58);
  }

  .story-panels__stack {
    display: flex;
    flex-direction: column;
    gap: calc(var(--section-block-pad-y-sm) * 0.5);
  }

  .story-panel__wrap {
    width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-inline: auto;
    padding: 0;
  }

  .story-panel__frame {
    border-radius: clamp(18px, 2.4vw, 28px);
    overflow: hidden;
    background: var(--moov-cream);
    isolation: isolate;
  }

  .story-panel {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(88vh, 880px);
  }

  .story-panel--reversed {
    direction: rtl;
  }

  .story-panel--reversed > * {
    direction: ltr;
  }

  .story-panel__media {
    position: relative;
    overflow: hidden;
    z-index: 0;
  }

  .story-panel__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: var(--story-panel-overlay, color-mix(in srgb, var(--moov-black) 20%, transparent));
  }

  .story-panel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .story-panel__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--moov-wash-on-cream-6) 0%, var(--moov-wash-on-cream-4) 100%);
    position: relative;
    z-index: 0;
  }

  .story-panel__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1rem, 2.5vw, 2rem) clamp(1.25rem, 3.25vw, 2.25rem);
    max-width: none;
    margin: 0;
    height: 100%;
  }

  .story-panel__heading {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: clamp(2rem, 4.25vw, 3.75rem);
    line-height: 1.08;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--moov-text-primary-light);
    margin: 0 0 clamp(0.75rem, 2vw, 1.25rem);
    max-width: min(100%, 28rem);
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
    text-wrap: balance;
  }

  .story-panel__body {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.75;
    color: var(--moov-text-secondary-light);
    margin: 0;
    max-width: 75%;
  }

  @media (min-width: 768px) and (max-width: 1279px) {
    .story-panel {
      grid-template-columns: 45fr 55fr;
    }
  }

  @media (max-width: 767px) {
    .story-panel {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .story-panel--reversed {
      direction: ltr;
    }

    .story-panel__wrap {
      padding: 0;
    }

    .story-panel__media {
      position: relative;
      height: min(52vh, 420px);
      min-height: 240px;
    }

    .story-panel__img {
      position: absolute;
    }

    .story-panel__text {
      padding: clamp(1.25rem, 3vw, 2.125rem) clamp(1.5rem, 5vw, 2.25rem);
      max-width: none;
      margin: 0;
    }
  }

  /* ══ ZONE 3: VALUES ══ */
  .story-values {
    background: var(--moov-black);
    padding: var(--section-block-pad-y-xl) 0;
  }

  .story-values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-inline: auto;
  }

  .story-values__tile {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    border: 0.5px solid var(--moov-border-dark);
    padding: 36px 28px;
    transition: background 0.2s ease;
  }

  .story-values__tile:hover {
    background: var(--moov-surface-dark-raised);
  }

  .story-values__watermark {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 5vw, 6rem);
    font-weight: 400;
    text-transform: uppercase;
    opacity: 0.06;
    color: var(--moov-cream);
    line-height: 1;
    margin-bottom: 20px;
    white-space: nowrap;
  }

  .story-values__title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--moov-text-primary-dark);
    margin: 0 0 12px;
  }

  .story-values__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1.7;
    color: var(--moov-text-secondary-dark);
    margin: 0;
  }

  @media (max-width: 1279px) {
    .story-values__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .story-values__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* ══ ZONE 4: FOUNDER NOTE (matches story-hero inset frame) ══ */
  .story-founder {
    position: relative;
    background: var(--moov-black);
    padding: calc(var(--section-block-pad-y-md) * 0.58) 0 calc(var(--section-block-pad-y-sm) * 0.58);
  }

  .story-founder__wrap {
    width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-inline: auto;
    max-width: none;
  }

  .story-founder__frame {
    position: relative;
    overflow: hidden;
    border-radius: clamp(18px, 2.4vw, 28px);
    background: var(--moov-cream);
    isolation: isolate;
  }

  .story-founder__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 80px);
    align-items: center;
    max-width: none;
    width: 100%;
    margin: 0;
    padding: clamp(2rem, 5vw, 3.75rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .story-founder__media {
    overflow: hidden;
  }

  .story-founder__img {
    width: 100%;
    display: block;
    object-fit: cover;
    border-radius: 0;
  }

  .story-founder__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--moov-wash-on-cream-6);
    border-radius: 0;
  }

  .story-founder__content {
    display: flex;
    flex-direction: column;
  }

  .story-founder__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-eyebrow-accent);
    margin: 0 0 16px;
  }

  .story-founder__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.15;
    color: var(--moov-text-primary-light);
    margin: 0 0 24px;
  }

  .story-founder__body {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.75;
    color: var(--moov-text-secondary-light);
    margin: 0;
    max-width: 440px;
  }

  .story-founder__cta {
    display: inline-block;
    margin-top: 32px;
    padding: 14px 28px;
    background: var(--moov-black);
    color: var(--moov-cream);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .story-founder__cta:hover {
    opacity: 0.85;
  }

  @media (min-width: 768px) and (max-width: 1279px) {
    .story-founder__inner {
      gap: 48px;
    }
  }

  @media (max-width: 767px) {
    .story-founder__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ══ ZONE 5: BOTTOM CTA ══ */
  .story-cta {
    background: var(--moov-black);
    padding: var(--section-block-pad-y-lg) 0;
    text-align: center;
  }

  .story-cta__inner {
    width: min(600px, var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-inline: auto;
  }

  .story-cta__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--moov-text-primary-dark);
    margin: 0 0 20px;
  }

  .story-cta__body {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.7;
    color: var(--moov-text-secondary-dark);
    margin: 0 0 36px;
  }

  .story-cta__btn {
    display: inline-block;
    padding: 14px 28px;
    border: 0.5px solid var(--moov-border-amber);
    border-radius: 999px;
    color: var(--moov-amber);
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .story-cta__btn:hover {
    background: var(--moov-amber);
    color: var(--moov-black);
  }

  /* ══ ANIMATIONS ══ */
  [data-animate="story-fade-up"] {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  [data-animate="story-fade"] {
    opacity: 0;
    transition: opacity 0.8s ease-out;
    transition-delay: 0.15s;
  }

  [data-animate="story-slide-right"] {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  [data-animate="story-fade-up"].is-visible,
  [data-animate="story-fade"].is-visible,
  [data-animate="story-slide-right"].is-visible {
    opacity: 1;
    transform: none;
  }

  .story-values__tile[data-animate="story-fade-up"] {
    transition-delay: calc(var(--stagger, 0) * 100ms);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-animate="story-fade-up"],
    [data-animate="story-fade"],
    [data-animate="story-slide-right"] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .story-hero__overline::before {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var els = document.querySelectorAll('[data-animate^="story-"]');
    if (!els.length) return;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    els.forEach(function (el) { observer.observe(el); });
  })();
{% endjavascript %}

