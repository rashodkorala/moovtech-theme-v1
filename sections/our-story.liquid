{% javascript %}
(function () {
  function getHeaderBottomOffset() {
    var maxBottom = 0;
    var headerGroup = document.querySelector('.shopify-section-group-header-group');
    var header = document.querySelector('.moov-header');

    if (headerGroup) {
      maxBottom = Math.max(maxBottom, headerGroup.getBoundingClientRect().bottom);
    }
    if (header) {
      maxBottom = Math.max(maxBottom, header.getBoundingClientRect().bottom);
    }

    if (maxBottom <= 0) return null;
    return Math.max(0, Math.ceil(maxBottom + 16));
  }

  function updateStickyTop(root) {
    var stickyTop = getHeaderBottomOffset();
    if (!stickyTop) {
      root.style.removeProperty('--about-founder-sticky-top');
      return;
    }
    root.style.setProperty('--about-founder-sticky-top', stickyTop + 'px');
  }

  function prefersReducedMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function isMobileViewport() {
    return window.matchMedia && window.matchMedia('(max-width: 960px)').matches;
  }

  function setActiveState(ctx, index) {
    if (!ctx || index < 0 || index >= ctx.navItems.length) return;
    ctx.navItems.forEach(function (item, i) {
      var active = i === index;
      item.classList.toggle('about-page-founder__nav-btn--active', active);
      item.setAttribute('aria-pressed', String(active));
    });
    ctx.slides.forEach(function (item, i) {
      item.classList.toggle('about-page-founder__article--active', i === index);
    });
  }

  function indexFromReadingBand(ctx) {
    var slides = ctx.slides;
    var vh = window.innerHeight || 700;
    var header = document.querySelector('.moov-header');
    var hb = header ? header.getBoundingClientRect().bottom : 0;
    var markerY = Math.max(hb + 24, vh * 0.35);
    markerY = Math.min(markerY, vh * 0.5);
    var active = 0;

    for (var i = 0; i < slides.length; i++) {
      var r = slides[i].getBoundingClientRect();
      if (r.top <= markerY) active = i;
    }

    return active;
  }

  function bindNavClicks(ctx, state, onScrollSpy) {
    ctx.navItems.forEach(function (item) {
      if (item.getAttribute('data-founder-spy-bound') === 'true') return;
      item.setAttribute('data-founder-spy-bound', 'true');
      item.addEventListener('click', function () {
        var idx = parseInt(item.getAttribute('data-story-index'), 10);
        if (isNaN(idx)) return;
        if (isMobileViewport()) {
          setActiveState(ctx, idx);
          return;
        }
        var target = ctx.slidesContainer.querySelector('.about-page-founder__article[data-story-block="' + idx + '"]');
        if (!target) return;
        state.ignoreScroll = true;
        setActiveState(ctx, idx);
        target.scrollIntoView({ behavior: prefersReducedMotion() ? 'auto' : 'smooth', block: 'start' });
        if (state.timer) clearTimeout(state.timer);
        state.timer = setTimeout(function () {
          state.ignoreScroll = false;
          onScrollSpy();
        }, prefersReducedMotion() ? 80 : 900);
      });
    });
  }

  function setupRoot(root) {
    if (root.getAttribute('data-founder-spy-ready') === 'true') return;

    var sidebar = root.querySelector('.about-page-founder__sidebar');
    var slidesContainer = root.querySelector('.about-page-founder__articles');
    if (!sidebar || !slidesContainer) return;

    var navItems = sidebar.querySelectorAll('.about-page-founder__nav-btn');
    var slides = slidesContainer.querySelectorAll('.about-page-founder__article');
    if (!navItems.length || !slides.length) return;

    root.setAttribute('data-founder-spy-ready', 'true');

    var state = {
      ignoreScroll: false,
      ticking: false,
      timer: null,
    };

    var ctx = {
      slidesContainer: slidesContainer,
      navItems: navItems,
      slides: slides,
    };

    var onScrollSpy = function () {
      if (isMobileViewport()) return;
      if (state.ignoreScroll) return;
      setActiveState(ctx, indexFromReadingBand(ctx));
    };

    var onScroll = function () {
      if (state.ignoreScroll || state.ticking) return;
      state.ticking = true;
      requestAnimationFrame(function () {
        state.ticking = false;
        updateStickyTop(root);
        onScrollSpy();
      });
    };

    bindNavClicks(ctx, state, onScrollSpy);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateStickyTop(root);
    onScrollSpy();
  }

  function run() {
    var roots = document.querySelectorAll('[data-founder-spy-root]');
    if (!roots.length) return;
    roots.forEach(function (root) {
      setupRoot(root);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }

  document.addEventListener('shopify:section:load', function () {
    setTimeout(run, 0);
  });
})();
{% endjavascript %}

