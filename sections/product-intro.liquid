{%- liquid
  assign intro_eyebrow = section.settings.eyebrow
  if intro_eyebrow == blank
    assign intro_eyebrow = 'store_marketing.badge_category' | t
  endif

  assign intro_heading = section.settings.heading
  if intro_heading == blank
    assign intro_heading = 'store_marketing.product_intro_heading' | t
  endif

  assign intro_body = section.settings.body
  if intro_body == blank
    assign intro_body = 'store_marketing.hero_subheading' | t
  endif

  assign intro_proof_1 = section.settings.proof_1
  if intro_proof_1 == blank
    assign intro_proof_1 = 'store_marketing.badge_social_proof' | t
  endif

  assign intro_proof_2 = section.settings.proof_2
  if intro_proof_2 == blank
    assign intro_proof_2 = 'store_marketing.badge_30_day' | t
  endif

  assign intro_cta_label = section.settings.cta_label
  if intro_cta_label == blank
    assign intro_cta_label = 'store_marketing.hero_cta_primary' | t
  endif
-%}

<div class="product-intro full-width" data-surface="dark">
  <div class="product-intro__inner">

    <div class="product-intro__left" data-animate="slide-left">
      {%- if intro_eyebrow != blank -%}
        <p class="product-intro__eyebrow">{{ intro_eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="product-intro__heading">{{ intro_heading | escape }}</h2>

      {%- if intro_body != blank -%}
        <p class="product-intro__body">{{ intro_body | escape }}</p>
      {%- endif -%}

      <div class="product-intro__proof">
        {%- if intro_proof_1 != blank -%}
          <span class="product-intro__proof-item">{{ intro_proof_1 | escape }}</span>
        {%- endif -%}
        {%- if intro_proof_1 != blank and intro_proof_2 != blank -%}
          <span class="product-intro__proof-divider" aria-hidden="true"></span>
        {%- endif -%}
        {%- if intro_proof_2 != blank -%}
          <span class="product-intro__proof-item">{{ intro_proof_2 | escape }}</span>
        {%- endif -%}
      </div>

      {%- if intro_cta_label != blank -%}
        <a
          href="{{ section.settings.cta_url | default: routes.root_url }}"
          class="product-intro__cta"
        >
          {{- intro_cta_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <div class="product-intro__right" data-animate="fade-in">
      {%- if section.settings.product_image -%}
        {{
          section.settings.product_image
          | image_url: width: 1200
          | image_tag:
            class: 'product-intro__render',
            loading: 'lazy',
            alt: section.settings.product_image.alt | escape
        }}
      {%- else -%}
        <img
          src="{{ 'moov-product.jpg' | asset_url }}"
          alt="{{ section.settings.product_image_alt | escape }}"
          class="product-intro__render"
          loading="lazy"
          width="600"
          height="800"
        >
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .product-intro {
    background: var(--moov-black);
    padding: var(--section-block-pad-y-hero) var(--section-inline-pad) var(--section-block-pad-y-hero-bottom);
  }

  .product-intro__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Left column */
  .product-intro__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .product-intro__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--moov-eyebrow-accent);
    margin: 0 0 24px;
  }

  .product-intro__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 700;
    font-style: normal;
    line-height: 1.1;
    color: var(--moov-text-primary-dark);
    max-width: 480px;
    margin: 0 0 28px;
    letter-spacing: -0.02em;
  }

  .product-intro__body {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 200;
    line-height: 1.75;
    color: var(--moov-text-secondary-dark);
    max-width: 400px;
    margin: 0 0 48px;
  }

  /* Proof points */
  .product-intro__proof {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .product-intro__proof-item {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-secondary-dark);
  }

  .product-intro__proof-divider {
    display: inline-block;
    width: 1px;
    height: 14px;
    background: var(--moov-border-dark);
    flex-shrink: 0;
  }

  /* CTA ghost button */
  .product-intro__cta {
    display: inline-block;
    margin-top: 40px;
    padding: 14px 32px;
    border: 1px solid var(--moov-border-amber);
    color: var(--moov-text-primary-dark);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    border-radius: 999px;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .product-intro__cta:hover {
    border-color: var(--moov-amber);
    background: var(--moov-amber);
    color: var(--moov-black);
  }

  /* Right column */
  .product-intro__right {
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateY(-20px);
  }

  .product-intro__render {
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    object-position: center center;
    border-radius: 12px;
    box-shadow: 0 40px 120px color-mix(in srgb, var(--moov-black) 50%, transparent);
    transition: transform 0.6s ease;
  }

  .product-intro__render:hover {
    transform: scale(1.02);
  }

  .product-intro__render--placeholder {
    opacity: 0.15;
    max-height: 400px;
  }

  /* Scroll animations */
  [data-animate] {
    opacity: 0;
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  [data-animate="slide-left"] {
    transform: translateX(-24px);
  }

  [data-animate="fade-in"] {
    transform: none;
    transition-delay: 0.2s;
  }

  [data-animate].is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1279px) {
    .product-intro__inner {
      grid-template-columns: 45fr 55fr;
      gap: 48px;
    }

  }

  /* Mobile */
  @media (max-width: 767px) {
    .product-intro__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .product-intro__right {
      order: -1;
      transform: translateY(0);
    }

    .product-intro__render {
      max-width: 280px;
      max-height: 280px;
      margin: 0 auto;
    }

    .product-intro__body {
      margin-bottom: 32px;
    }

    .product-intro__proof {
      flex-wrap: wrap;
      gap: 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const animatedEls = document.querySelectorAll('[data-animate]');
    if (!animatedEls.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    animatedEls.forEach((el) => observer.observe(el));
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.product_intro.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text",
      "default": "Meet MOOV"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The alarm that moves with you."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.body",
      "default": "Most alarms reward you for lying still. MOOV doesn't. It requires physical movement to stop. Instead of winning by pressing snooze, you win by starting your day."
    },
    {
      "type": "header",
      "content": "t:general.proof_points"
    },
    {
      "type": "text",
      "id": "proof_1",
      "label": "t:labels.proof_point_1",
      "default": "Detects movement"
    },
    {
      "type": "text",
      "id": "proof_2",
      "label": "t:labels.proof_point_2",
      "default": "Stops when you're up"
    },
    {
      "type": "header",
      "content": "t:general.primary_button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label",
      "default": "Pre-Order Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "header",
      "content": "t:general.product_render"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "t:labels.product_render"
    },
    {
      "type": "text",
      "id": "product_image_alt",
      "label": "t:labels.product_render_alt",
      "default": "MOOV Alarm"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_intro.name"
    }
  ]
}
{% endschema %}
