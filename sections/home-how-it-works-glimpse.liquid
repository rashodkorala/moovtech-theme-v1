{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.home_how_glimpse.default_eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.home_how_glimpse.default_heading' | t
  endif

  assign body = section.settings.body
  if body == blank
    assign body = 'sections.home_how_glimpse.default_body' | t
  endif

  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'sections.home_how_glimpse.default_cta' | t
  endif

  assign cta_url = section.settings.cta_url | default: '/pages/how-it-works'
  assign surface = section.settings.surface | default: 'dark'
-%}

<section
  class="hiw-glimpse hiw-glimpse--{{ surface }} full-width"
  aria-labelledby="hiw-glimpse-heading-{{ section.id }}"
>
  <div class="hiw-glimpse__inner">
    <div class="hiw-glimpse__header">
      <div class="hiw-glimpse__header-lead">
        {%- if eyebrow != blank -%}
          <p class="hiw-glimpse__eyebrow">{{ eyebrow | escape }}</p>
        {%- endif -%}

        <h2 id="hiw-glimpse-heading-{{ section.id }}" class="hiw-glimpse__heading">
          {{ heading | escape }}
        </h2>
      </div>

      <div class="hiw-glimpse__header-trail">
        {%- if body != blank -%}
          <p class="hiw-glimpse__intro">{{ body | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="hiw-glimpse__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- liquid
              assign step_index = forloop.index
              if step_index < 10
                assign step_badge = step_index | prepend: '0'
              else
                assign step_badge = step_index | append: ''
              endif
            -%}

            <li class="hiw-glimpse__cell" {{ block.shopify_attributes }}>
              <div class="hiw-glimpse__card">
                <div class="hiw-glimpse__media">
                  {%- if block.settings.image != blank -%}
                    {%- assign step_alt = block.settings.image.alt | default: block.settings.title -%}
                    {{
                      block.settings.image
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'lazy',
                        class: 'hiw-glimpse__img',
                        alt: step_alt,
                        sizes: '(min-width: 990px) 32vw, (min-width: 750px) 45vw, 100vw',
                        widths: '400, 600, 800, 1000'
                    }}
                  {%- elsif block.settings.image_url != blank -%}
                    <img
                      src="{{ block.settings.image_url | escape }}"
                      alt="{{ block.settings.title | default: heading | escape }}"
                      loading="lazy"
                      class="hiw-glimpse__img"
                      width="1000"
                      height="800"
                    >
                  {%- else -%}
                    <div
                      class="hiw-glimpse__placeholder"
                      role="img"
                      aria-label="{{ 'sections.home_how_glimpse.image_placeholder_label' | t }}"
                    ></div>
                  {%- endif -%}
                  <span class="hiw-glimpse__badge" aria-hidden="true">Step · {{ step_badge | escape }}</span>
                </div>

                <div class="hiw-glimpse__card-body">
                  {%- if block.settings.kicker != blank -%}
                    <p class="hiw-glimpse__kicker">{{ block.settings.kicker | escape }}</p>
                  {%- endif -%}

                  {%- if block.settings.title != blank -%}
                    <h3 class="hiw-glimpse__step-title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <p class="hiw-glimpse__step-text">{{ block.settings.text | strip_html | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if cta_label != blank -%}
      <div class="hiw-glimpse__footer">
        <a href="{{ cta_url }}" class="hiw-glimpse__cta">
          {{- cta_label | escape -}}
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="2" y1="7" x2="11" y2="7" />
            <polyline points="7,3.5 11,7 7,10.5" />
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hiw-glimpse {
    padding: var(--section-block-pad-y-md) var(--section-inline-pad);
  }

  .hiw-glimpse--dark {
    background: var(--moov-black);
    color: var(--moov-cream);
  }

  .hiw-glimpse--cream {
    background: var(--moov-cream);
    color: var(--moov-black);
  }

  .hiw-glimpse__inner {
    width: 100%;
    max-width: var(--layout-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hiw-glimpse__header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 48px;
  }

  .hiw-glimpse__header-lead,
  .hiw-glimpse__header-trail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.35rem, 0.6vw, 0.5rem);
  }

  .hiw-glimpse__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-amber);
  }

  .hiw-glimpse--cream  .hiw-glimpse__eyebrow {
    color: var(--moov-amber);
  }

  .hiw-glimpse__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-text-primary-dark);
  }

  .hiw-glimpse--cream .hiw-glimpse__heading {
    color: var(--moov-black);
  }

  .hiw-glimpse__intro {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--moov-text-secondary-dark);
    max-width: 44ch;
  }

  .hiw-glimpse--cream .hiw-glimpse__intro {
    color: var(--moov-text-secondary-light);
  }

  .hiw-glimpse__footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .hiw-glimpse__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--moov-black);
    background: var(--moov-cream);
    border: 1px solid var(--moov-border-dark);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hiw-glimpse--cream .hiw-glimpse__cta {
    background: var(--moov-black);
    color: var(--moov-cream);
    border-color: transparent;
  }

  .hiw-glimpse__cta:hover {
    background: var(--moov-cream-shadow);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--moov-black) 30%, transparent);
  }

  .hiw-glimpse--cream .hiw-glimpse__cta:hover {
    background: color-mix(in srgb, var(--moov-black) 85%, var(--moov-cream));
    box-shadow: 0 8px 24px color-mix(in srgb, var(--moov-black) 20%, transparent);
  }

  .hiw-glimpse__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .hiw-glimpse__cell {
    min-width: 0;
  }

  .hiw-glimpse__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 18px;
    background: transparent;
    border: none;
    border-radius: 0;
    overflow: visible;
  }

  .hiw-glimpse__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px;
    background: var(--moov-surface-dark-elevated);
    border: 1px solid var(--moov-border-dark);
  }

  .hiw-glimpse--cream .hiw-glimpse__media {
    background: color-mix(in srgb, var(--moov-black) 8%, var(--moov-cream));
    border-color: color-mix(in srgb, var(--moov-black) 12%, transparent);
  }

  .hiw-glimpse__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: grayscale(0.2) brightness(0.92) contrast(1.04);
  }

  .hiw-glimpse__placeholder {
    width: 100%;
    height: 100%;
    min-height: 120px;
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--moov-cream) 10%, var(--moov-black)) 0%,
      var(--moov-neutral-deep) 100%
    );
  }

  .hiw-glimpse__badge {
    position: absolute;
    left: 14px;
    top: 14px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(10, 10, 9, 0.55);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-text-primary-dark);
  }

  .hiw-glimpse__card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0 clamp(0.15rem, 0.4vw, 0.25rem) clamp(0.25rem, 0.6vw, 0.35rem);
    flex: 1;
  }

  .hiw-glimpse__kicker {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
  }

  .hiw-glimpse--cream .hiw-glimpse__kicker {
    color: var(--moov-text-tertiary-light);
  }

  .hiw-glimpse__step-title {
    margin: 0;
    font-family: var(--font-hero);
    font-size: var(--text-heading-md);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--moov-text-primary-dark);
  }

  .hiw-glimpse--cream .hiw-glimpse__step-title {
    color: var(--moov-black);
  }

  .hiw-glimpse__step-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--moov-text-secondary-dark);
  }

  .hiw-glimpse--cream .hiw-glimpse__step-text {
    color: var(--moov-text-secondary-light);
  }

  @media (max-width: 880px) {
    .hiw-glimpse__header {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .hiw-glimpse__grid {
      grid-template-columns: 1fr;
    }

    .hiw-glimpse__media {
      aspect-ratio: 16 / 10;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_how_glimpse.name",
  "tag": "section",
  "class": "section-hiw-glimpse",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "t:labels.surface",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "t:options.surface.dark" },
        { "value": "cream", "label": "t:options.surface.cream" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.home_how_glimpse.content_header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.body",
      "info": "t:sections.home_how_glimpse.body_info"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.button_url"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.home_how_glimpse.blocks.step.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.home_how_glimpse.blocks.step.kicker"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.body"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.background_image"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "t:sections.home_how_glimpse.image_url_label",
          "info": "t:sections.home_how_glimpse.image_url_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_how_glimpse.name",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "kicker": "Device and mobile app",
            "title": "Place MOOV on the wall",
            "text": "10-second, damage-free install. Put it where you go first in the morning.",
            "image_url": "https://images.unsplash.com/photo-1757693223749-d5ce2dff34f4?auto=format&fit=crop&w=1200&q=80"
          }
        },
        {
          "type": "step",
          "settings": {
            "kicker": "Configure your alarm",
            "title": "Set your get-up time in the app",
            "text": "Choose your alarm, volume, and optional pre-alert for a gentler start.",
            "image_url": "https://images.unsplash.com/photo-1771499931747-5a383e3bd54d?auto=format&fit=crop&w=1200&q=80"
          }
        },
        {
          "type": "step",
          "settings": {
            "kicker": "Get up to silence",
            "title": "Walk to the device to turn it off",
            "text": "Movement first — the alarm stops only when you act. No more half-asleep snoozes.",
            "image_url": "https://images.unsplash.com/photo-1632466477918-66ed5a901be2?auto=format&fit=crop&w=1200&q=80"
          }
        }
      ]
    }
  ]
}
{% endschema %}
