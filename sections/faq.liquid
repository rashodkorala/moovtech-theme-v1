{%- liquid
  # Prefer per-product metafields when we're on a product page; fall back to section settings/blocks.
  assign faq_heading = section.settings.heading
  if product and product.metafields.custom.faq_heading != blank
    assign faq_heading = product.metafields.custom.faq_heading
  endif

  assign faq_eyebrow = section.settings.eyebrow | strip

  assign faq_items_mf = nil
  if product
    assign faq_items_mf = product.metafields.custom.faq_items.value
  endif
  assign use_metafield_faq = false
  if faq_items_mf != blank and faq_items_mf.size > 0
    assign use_metafield_faq = true
  endif
-%}

<div class="faq full-width" data-surface="cream">
  <div class="faq__inner">

    {%- comment -%} Left — section label {%- endcomment -%}
    <div class="faq__label-col">
      {%- if faq_eyebrow != blank -%}
        <p class="faq__eyebrow" data-animate="faq-label">
          <span class="faq__eyebrow-dot" aria-hidden="true"></span>
          {{ faq_eyebrow | escape | upcase }}
        </p>
      {%- endif -%}
      <h2 class="faq__label" data-animate="faq-label">
        {{- faq_heading | escape | upcase -}}
      </h2>
    </div>

    {%- comment -%} Right — accordion {%- endcomment -%}
    <div class="faq__accordion" role="list">
      {%- if use_metafield_faq -%}
        {%- for entry in faq_items_mf -%}
          {%- liquid
            assign entry_id = entry.system.id | default: forloop.index
            assign entry_question = entry.question | default: entry.fields.question
            assign entry_answer = entry.answer | default: entry.fields.answer
          -%}
          <div
            class="faq__item{%- if forloop.first %} faq__item--open{%- endif -%}"
            data-animate="faq-item"
            style="--item-delay: {{ forloop.index0 | times: 80 }}ms;"
            role="listitem"
          >
            <button
              class="faq__question"
              aria-expanded="{%- if forloop.first -%}true{%- else -%}false{%- endif -%}"
              aria-controls="faq-answer-{{ entry_id }}"
            >
              <span class="faq__question-text">{{ entry_question | escape }}</span>
              <span class="faq__indicator" aria-hidden="true">
                <span class="faq__indicator-plus">+</span>
                <span class="faq__indicator-times">&times;</span>
              </span>
            </button>
            <div
              class="faq__answer"
              id="faq-answer-{{ entry_id }}"
              role="region"
            >
              <p class="faq__answer-text">{{ entry_answer | escape }}</p>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            <div
              class="faq__item{%- if forloop.first %} faq__item--open{%- endif -%}"
              data-animate="faq-item"
              style="--item-delay: {{ forloop.index0 | times: 80 }}ms;"
              role="listitem"
              {{ block.shopify_attributes }}
            >
              <button
                class="faq__question"
                aria-expanded="{%- if forloop.first -%}true{%- else -%}false{%- endif -%}"
                aria-controls="faq-answer-{{ block.id }}"
              >
                <span class="faq__question-text">{{ block.settings.question | escape }}</span>
                <span class="faq__indicator" aria-hidden="true">
                  <span class="faq__indicator-plus">+</span>
                  <span class="faq__indicator-times">&times;</span>
                </span>
              </button>
              <div
                class="faq__answer"
                id="faq-answer-{{ block.id }}"
                role="region"
              >
                <p class="faq__answer-text">{{ block.settings.answer | escape }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .faq {
    background: var(--moov-cream);
    color: var(--moov-black);
    padding: var(--section-block-pad-y-hero) var(--section-inline-pad);
  }

  .faq__inner {
    display: grid;
    grid-template-columns: 35fr 65fr;
    gap: 80px;
    align-items: start;
    max-width: var(--layout-max-width);
    margin: 0 auto;
  }

  /* Left col */
  .faq__label-col {
    position: sticky;
    top: calc(var(--header-height, 72px) + 40px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .faq__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--moov-eyebrow-accent);
  }

  .faq__eyebrow-dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--moov-amber);
    box-shadow: 0 0 10px color-mix(in srgb, var(--moov-amber) 55%, transparent);
  }

  .faq__label {
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5vw, 5.5rem);
    font-weight: 700;
    line-height: 0.95;
    color: var(--moov-black);
    margin: 0;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .faq__accordion {
    width: 100%;
    border-top: 1px solid var(--moov-border-light);
  }

  /* FAQ item */
  .faq__item {
    border-bottom: 1px solid var(--moov-border-light);
    background: transparent;
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
    transition-delay: var(--item-delay, 0ms), var(--item-delay, 0ms);
    opacity: 0;
    transform: translateY(8px);
    cursor: pointer;
  }

  .faq__item.is-visible {
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  /* Question button */
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 22px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .faq__question-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--moov-black);
    transition: color 0.2s ease;
  }

  .faq__item--open .faq__question-text {
    color: color-mix(in srgb, var(--moov-black) 65%, transparent);
  }

  /* Indicator */
  .faq__indicator {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--moov-black);
    flex-shrink: 0;
    line-height: 1;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--moov-border-light);
    border-radius: 50%;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .faq__item:hover .faq__indicator {
    border-color: var(--moov-black);
  }

  .faq__indicator-times {
    display: none;
  }

  .faq__item--open .faq__indicator-plus {
    display: none;
  }

  .faq__item--open .faq__indicator-times {
    display: inline;
  }

  /* Answer panel */
  .faq__answer {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 0.4s ease,
      opacity 0.3s ease 0.05s;
  }

  .faq__item--open .faq__answer {
    max-height: 400px;
    opacity: 1;
  }

  .faq__answer-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.75;
    color: color-mix(in srgb, var(--moov-black) 60%, transparent);
    max-width: 52ch;
    margin: 0 0 22px;
  }

  /* Animations */
  [data-animate="faq-label"] {
    opacity: 0;
    transform: translateX(-12px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  [data-animate="faq-label"].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 768px) and (max-width: 1100px) {
    .faq__inner {
      grid-template-columns: 30fr 70fr;
      gap: 48px;
    }
  }

  @media (max-width: 767px) {
    .faq__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .faq__label-col {
      position: static;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var accordion = document.querySelector('.faq__accordion');
    if (!accordion) return;

    var items = Array.from(accordion.querySelectorAll('.faq__item'));

    items.forEach(function (item) {
      var btn = item.querySelector('.faq__question');

      btn.addEventListener('click', function () {
        var isOpen = item.classList.contains('faq__item--open');

        items.forEach(function (i) {
          i.classList.remove('faq__item--open');
          i.querySelector('.faq__question').setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('faq__item--open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    var animatedEls = document.querySelectorAll(
      '.faq [data-animate="faq-label"], .faq [data-animate="faq-item"]'
    );
    if (!animatedEls.length) return;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    animatedEls.forEach(function (el) { observer.observe(el); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The five we get most."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "t:sections.faq.blocks.faq_item.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "t:labels.answer",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Is MOOV just an alarm clock?",
            "answer": "No. MOOV is a three-part morning system: a movement-based alarm you physically disarm, a companion app that blocks distracting feeds during your first hour, and AI-guided routines that adapt to your energy and schedule. Each part works alone, but they're designed to work together."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How does MOOV actually stop the alarm?",
            "answer": "MOOV uses a built-in motion sensor to detect physical movement. When your alarm goes off, you need to get up and move (shake it, walk with it, or complete a short movement) before it stops. Pressing a button or tapping your phone won't work. The only way to silence it is to actually move your body."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What does the companion app actually block, and can I override it?",
            "answer": "You choose which apps are blocked during your morning window: social media, email, news, or anything else that pulls your attention sideways. You can always override the block. MOOV doesn't force anything. But the friction of overriding is often enough to make you choose not to."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "I've tried morning routines before and they never stick. Why would this be different?",
            "answer": "Most routines fail because they rely on willpower in the moments willpower is lowest, right after waking. MOOV changes the environment instead. The alarm requires movement to silence, so the first action of your day is physical, not mental. The app removes the temptation before it becomes a decision. You're not relying on discipline; you're reducing the need for it."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is this actually going to change my mornings, or is it just another gadget I stop using?",
            "answer": "Fair question, and we'd rather you ask it now than regret it later. MOOV works best for people who already know their mornings could be better and want a structural change, not just a new app. If that's you, it will work. If you're looking for passive improvement, it probably won't. We back it with a 30-day satisfaction promise so the risk is ours, not yours."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How does pre-order billing work?",
            "answer": "Your card is charged when you place your pre-order. Estimated shipping begins May 2026. You'll get a confirmation email with your order details and can cancel anytime before your unit ships for a full refund. No questions asked."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What phones is the MOOV App compatible with?",
            "answer": "The MOOV App is available on iOS (iPhone 12 and later, iOS 15+) and Android (Android 10+). The app connects to your MOOV device via Bluetooth and is required to set alarms, configure your routine, and enable the app blocker."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "We offer a 30-day return window from the date of delivery. If MOOV isn't the right fit, return it in its original condition for a full refund. No questions asked. Pre-orders can be cancelled at any time before your unit ships."
          }
        }
      ]
    }
  ]
}
{% endschema %}
