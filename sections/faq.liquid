<div class="faq full-width" data-surface="dark">
  <div class="faq__inner">

    {%- comment -%} Left — section label {%- endcomment -%}
    <div class="faq__label-col">
      <h2 class="faq__label" data-animate="faq-label">
        {{- section.settings.heading | escape -}}
      </h2>
    </div>

    {%- comment -%} Right — accordion {%- endcomment -%}
    <div class="faq__accordion" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          <div
            class="faq__item{%- if forloop.first %} faq__item--open{%- endif -%}"
            data-animate="faq-item"
            style="--item-delay: {{ forloop.index0 | times: 80 }}ms;"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            <button
              class="faq__question"
              aria-expanded="{%- if forloop.first -%}true{%- else -%}false{%- endif -%}"
              aria-controls="faq-answer-{{ block.id }}"
            >
              <span class="faq__question-text">{{ block.settings.question | escape }}</span>
              <span class="faq__indicator" aria-hidden="true">
                <span class="faq__indicator-plus">+</span>
                <span class="faq__indicator-times">&times;</span>
              </span>
            </button>
            <div
              class="faq__answer"
              id="faq-answer-{{ block.id }}"
              role="region"
            >
              <p class="faq__answer-text">{{ block.settings.answer | escape }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .faq {
    background: var(--moov-black);
    padding: var(--section-block-pad-y-hero) var(--section-inline-pad);
  }

  .faq__inner {
    display: grid;
    grid-template-columns: 35fr 65fr;
    gap: 80px;
    align-items: start;
    max-width: 1200px;
    margin: 0 auto;
  }

  .faq__label {
    position: sticky;
    top: 160px;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 8vw, 8rem);
    font-weight: 400;
    line-height: 1;
    color: var(--moov-text-primary-dark);
    margin: 0;
    letter-spacing: -0.03em;
  }

  .faq__accordion {
    width: 100%;
  }

  /* FAQ item — base */
  .faq__item {
    border-bottom: 0.5px solid var(--moov-border-dark);
    border-radius: 0;
    background: transparent;
    transition:
      background 0.25s ease,
      border-radius 0.25s ease,
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
    transition-delay: 0s, 0s, var(--item-delay, 0ms), var(--item-delay, 0ms);
    opacity: 0;
    transform: translateY(10px);
    cursor: pointer;
  }

  .faq__item.is-visible {
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  /* FAQ item — open */
  .faq__item--open {
    background: var(--moov-surface-dark-raised);
    border-radius: 12px;
    border-bottom: none;
    margin: -1px 0;
  }

  /* Question button */
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 24px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: padding 0.25s ease;
  }

  .faq__item--open .faq__question {
    padding: 24px 28px;
  }

  .faq__question-text {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 400;
    color: var(--moov-text-secondary-dark);
    transition: color 0.2s ease, font-weight 0.2s ease;
  }

  .faq__item:hover .faq__question-text {
    color: var(--moov-text-primary-dark);
  }

  .faq__item--open .faq__question-text {
    font-weight: 500;
    color: var(--moov-text-primary-dark);
  }

  /* Indicator */
  .faq__indicator {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--moov-text-tertiary-dark);
    flex-shrink: 0;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .faq__item:hover .faq__indicator {
    color: var(--moov-text-secondary-dark);
  }

  .faq__item--open .faq__indicator {
    font-size: var(--text-lg);
    color: var(--moov-text-secondary-dark);
  }

  .faq__indicator-times {
    display: none;
  }

  .faq__item--open .faq__indicator-plus {
    display: none;
  }

  .faq__item--open .faq__indicator-times {
    display: inline;
  }

  /* Answer panel */
  .faq__answer {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    padding: 0;
    transition:
      max-height 0.4s ease,
      opacity 0.3s ease 0.05s,
      padding 0.25s ease;
  }

  .faq__item--open .faq__answer {
    max-height: 400px;
    opacity: 1;
    padding: 0 28px 24px;
  }

  .faq__answer-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.75;
    color: var(--moov-text-secondary-dark);
    max-width: 520px;
    margin: 12px 0 0;
  }

  /* Section label scroll animation */
  [data-animate="faq-label"] {
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  [data-animate="faq-label"].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 768px) and (max-width: 1279px) {
    .faq__inner {
      grid-template-columns: 30fr 70fr;
      gap: 48px;
    }

    .faq__label {
      top: 100px;
    }
  }

  @media (max-width: 767px) {
    .faq__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .faq__label {
      position: static;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var accordion = document.querySelector('.faq__accordion');
    if (!accordion) return;

    var items = Array.from(accordion.querySelectorAll('.faq__item'));

    items.forEach(function (item) {
      var btn = item.querySelector('.faq__question');

      btn.addEventListener('click', function () {
        var isOpen = item.classList.contains('faq__item--open');

        items.forEach(function (i) {
          i.classList.remove('faq__item--open');
          i.querySelector('.faq__question').setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('faq__item--open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    var animatedEls = document.querySelectorAll(
      '.faq [data-animate="faq-label"], .faq [data-animate="faq-item"]'
    );
    if (!animatedEls.length) return;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    animatedEls.forEach(function (el) { observer.observe(el); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "FAQs"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "t:sections.faq.blocks.faq_item.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "t:labels.answer",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How does MOOV actually stop the alarm?",
            "answer": "MOOV uses a built-in motion sensor to detect physical movement. When your alarm goes off, you need to get up and move — shake it, walk with it, or complete a short movement — before it stops. Pressing a button or tapping your phone won't work. The only way to silence it is to actually move your body."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "When will my order ship?",
            "answer": "MOOV is currently in the pre-order phase. Estimated shipping begins in Q3 2025. You'll receive email updates with your tracking information as your order gets closer to dispatch. Pre-order customers are first in line."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What phones is the MOOV App compatible with?",
            "answer": "The MOOV App is available on iOS (iPhone 12 and later, iOS 15+) and Android (Android 10+). The app connects to your MOOV device via Bluetooth and is required to set alarms, configure your routine, and enable the app blocker."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does the battery last?",
            "answer": "MOOV is designed to last up to 30 days on a single charge with regular daily use. Charging takes approximately 90 minutes via the included magnetic USB-C cable. A low battery notification is sent to your phone before it runs out."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "We offer a 30-day return window from the date of delivery. If MOOV isn't the right fit, return it in its original condition for a full refund — no questions asked. Pre-orders can be cancelled at any time before your unit ships."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How is MOOV different from a regular alarm?",
            "answer": "A standard alarm rewards passivity — you press snooze and stay in bed. MOOV is the opposite. It requires your body to be in motion before it stops, which means the act of dismissing the alarm is itself the first step of your morning. Pair it with the MOOV App and that first step becomes a full routine."
          }
        }
      ]
    }
  ]
}
{% endschema %}
