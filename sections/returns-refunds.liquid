{% comment %}
  Returns & refunds page: In Shopify admin, create a Page (suggested handle "returns-refunds")
  and assign Theme template "returns-refunds". Default copy ships via the schema below; merchants
  can override every string in the theme editor.

  Layout favours readability over decoration: single light surface, narrow column,
  document-style typography hierarchy.
{% endcomment %}

{%- liquid
  assign contact_email = section.settings.contact_email
-%}

<article class="returns-doc" data-surface="cream">
  <div class="returns-doc__inner">

    {%- comment -%} ─── 1. HEADER ─── {%- endcomment -%}
    <header class="returns-doc__header">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="returns-doc__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.hero_heading != blank -%}
        <h1 class="returns-doc__title">{{ section.settings.hero_heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.hero_intro != blank -%}
        <p class="returns-doc__lede">{{ section.settings.hero_intro | escape }}</p>
      {%- endif -%}
    </header>

    {%- comment -%} ─── 2. ELIGIBILITY ─── {%- endcomment -%}
    <section class="returns-doc__section">
      {%- if section.settings.eligibility_heading != blank -%}
        <h2 class="returns-doc__h2">{{ section.settings.eligibility_heading | escape }}</h2>
      {%- endif -%}

      <ul class="returns-doc__list">
        {%- for i in (1..4) -%}
          {%- liquid
            case i
              when 1
                assign item = section.settings.eligibility_item_1
              when 2
                assign item = section.settings.eligibility_item_2
              when 3
                assign item = section.settings.eligibility_item_3
              when 4
                assign item = section.settings.eligibility_item_4
            endcase
          -%}
          {%- if item != blank -%}
            <li>{{ item | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </section>

    {%- comment -%} ─── 3. HOW IT WORKS ─── {%- endcomment -%}
    <section class="returns-doc__section">
      {%- if section.settings.steps_heading != blank -%}
        <h2 class="returns-doc__h2">{{ section.settings.steps_heading | escape }}</h2>
      {%- endif -%}

      <ol class="returns-doc__steps">
        {%- for i in (1..4) -%}
          {%- liquid
            case i
              when 1
                assign step_title = section.settings.step_1_title
                assign step_body = section.settings.step_1_body
              when 2
                assign step_title = section.settings.step_2_title
                assign step_body = section.settings.step_2_body
              when 3
                assign step_title = section.settings.step_3_title
                assign step_body = section.settings.step_3_body
              when 4
                assign step_title = section.settings.step_4_title
                assign step_body = section.settings.step_4_body
            endcase
          -%}
          {%- if step_title != blank or step_body != blank -%}
            <li class="returns-doc__step">
              {%- if step_title != blank -%}
                <h3 class="returns-doc__step-title">{{ step_title | escape }}</h3>
              {%- endif -%}
              {%- if step_body != blank -%}
                <p class="returns-doc__step-body">
                  {%- if i == 1 and contact_email != blank -%}
                    {%- assign body_parts = step_body | split: contact_email -%}
                    {%- if body_parts.size == 2 -%}
                      {{- body_parts[0] | escape -}}<a class="returns-doc__link" href="mailto:{{ contact_email }}">{{ contact_email }}</a>{{- body_parts[1] | escape -}}
                    {%- else -%}
                      {{- step_body | escape -}}
                    {%- endif -%}
                  {%- else -%}
                    {{- step_body | escape -}}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </section>

    {%- comment -%} ─── 4. NOTES ─── {%- endcomment -%}
    <section class="returns-doc__section">
      {%- if section.settings.notes_heading != blank -%}
        <h2 class="returns-doc__h2">{{ section.settings.notes_heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.notes_body_1 != blank -%}
        <p class="returns-doc__p">{{ section.settings.notes_body_1 | escape }}</p>
      {%- endif -%}
      {%- if section.settings.notes_body_2 != blank -%}
        <p class="returns-doc__p">{{ section.settings.notes_body_2 | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        {%- assign cta_href = section.settings.cta_url -%}
        {%- if cta_href == blank -%}
          {%- assign cta_href = '/pages/contact' -%}
        {%- endif -%}
        <p class="returns-doc__p returns-doc__p--cta">
          {{ 'returns.questions_prefix' | t | default: 'Have questions?' }}
          <a class="returns-doc__link" href="{{ cta_href }}">{{ section.settings.cta_label | escape }}</a>.
        </p>
      {%- endif -%}
    </section>

  </div>
</article>

{% stylesheet %}
  /* ─── Page surface ─── */
  .returns-doc {
    background: var(--moov-cream);
    padding: clamp(3rem, 7vw, 5rem) var(--section-inline-pad) clamp(4rem, 9vw, 7rem);
  }

  .returns-doc__inner {
    max-width: 680px;
    margin: 0 auto;
    color: var(--moov-text-primary-light);
  }

  /* ─── Header ─── */
  .returns-doc__header {
    margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 0.5px solid var(--moov-border-light);
  }

  .returns-doc__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-text-tertiary-light);
    margin: 0 0 12px;
  }

  .returns-doc__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1.15;
    color: var(--moov-text-primary-light);
    margin: 0 0 18px;
  }

  .returns-doc__lede {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.65;
    color: var(--moov-text-secondary-light);
    margin: 0;
  }

  /* ─── Section blocks ─── */
  .returns-doc__section {
    margin-bottom: clamp(2.25rem, 4.5vw, 3rem);
  }

  .returns-doc__section:last-child {
    margin-bottom: 0;
  }

  .returns-doc__h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.25;
    color: var(--moov-text-primary-light);
    margin: 0 0 16px;
  }

  /* ─── Eligibility list ─── */
  .returns-doc__list {
    margin: 0;
    padding: 0 0 0 1.25rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.65;
    color: var(--moov-text-primary-light);
  }

  .returns-doc__list li {
    margin-bottom: 8px;
  }

  .returns-doc__list li::marker {
    color: var(--moov-text-tertiary-light);
  }

  /* ─── Steps (ordered list, document style) ─── */
  .returns-doc__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: returns-step;
  }

  .returns-doc__step {
    counter-increment: returns-step;
    position: relative;
    padding: 0 0 20px 2.5rem;
    margin-bottom: 20px;
    border-bottom: 0.5px solid var(--moov-border-light);
  }

  .returns-doc__step:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .returns-doc__step::before {
    content: counter(returns-step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.15em;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--moov-text-tertiary-light);
  }

  .returns-doc__step-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
    color: var(--moov-text-primary-light);
    margin: 0 0 6px;
  }

  .returns-doc__step-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.65;
    color: var(--moov-text-primary-light);
    margin: 0;
  }

  /* ─── Generic paragraph ─── */
  .returns-doc__p {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.65;
    color: var(--moov-text-primary-light);
    margin: 0 0 12px;
  }

  .returns-doc__p:last-child {
    margin-bottom: 0;
  }

  .returns-doc__p--cta {
    margin-top: 20px;
    color: var(--moov-text-secondary-light);
  }

  /* ─── Inline link ─── */
  .returns-doc__link {
    color: var(--moov-text-primary-light);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.15s ease;
  }

  .returns-doc__link:hover {
    color: var(--moov-amber-hover);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Returns & refunds",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Policy"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading",
      "default": "Returns & refunds"
    },
    {
      "type": "textarea",
      "id": "hero_intro",
      "label": "Intro",
      "default": "We want you to feel confident trying MOOV. If it's not the right fit, you can return it within 30 days of delivery."
    },
    {
      "type": "header",
      "content": "Eligibility"
    },
    {
      "type": "text",
      "id": "eligibility_heading",
      "label": "Heading",
      "default": "To be eligible for a return"
    },
    {
      "type": "text",
      "id": "eligibility_item_1",
      "label": "Item 1",
      "default": "Item must be in good condition"
    },
    {
      "type": "text",
      "id": "eligibility_item_2",
      "label": "Item 2",
      "default": "All components to be included"
    },
    {
      "type": "text",
      "id": "eligibility_item_3",
      "label": "Item 3",
      "default": "Returned with original packaging"
    },
    {
      "type": "text",
      "id": "eligibility_item_4",
      "label": "Item 4",
      "default": "Proof of purchase required"
    },
    {
      "type": "header",
      "content": "How it works"
    },
    {
      "type": "text",
      "id": "steps_heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Returns email",
      "info": "Used as a mailto link inside step 1.",
      "default": "refunds@moovalarm.com"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Step 1 title",
      "default": "Email us"
    },
    {
      "type": "textarea",
      "id": "step_1_body",
      "label": "Step 1 body",
      "default": "Send a request to refunds@moovalarm.com with your order details."
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Step 2 title",
      "default": "Get instructions"
    },
    {
      "type": "textarea",
      "id": "step_2_body",
      "label": "Step 2 body",
      "default": "We'll send return instructions and a confirmation within 1–2 business days."
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Step 3 title",
      "default": "Ship it back"
    },
    {
      "type": "textarea",
      "id": "step_3_body",
      "label": "Step 3 body",
      "default": "Pack the product in its original packaging and ship it back to us."
    },
    {
      "type": "text",
      "id": "step_4_title",
      "label": "Step 4 title",
      "default": "Get refunded"
    },
    {
      "type": "textarea",
      "id": "step_4_body",
      "label": "Step 4 body",
      "default": "Refund issued to your original payment method once received and inspected."
    },
    {
      "type": "header",
      "content": "Notes"
    },
    {
      "type": "text",
      "id": "notes_heading",
      "label": "Heading",
      "default": "A few notes"
    },
    {
      "type": "textarea",
      "id": "notes_body_1",
      "label": "Note 1",
      "default": "Return shipping fee is the customer's responsibility."
    },
    {
      "type": "textarea",
      "id": "notes_body_2",
      "label": "Note 2",
      "default": "Refunds are issued to your original payment method."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL",
      "info": "Defaults to /pages/contact when left blank."
    }
  ],
  "presets": [
    {
      "name": "Returns & refunds"
    }
  ]
}
{% endschema %}
