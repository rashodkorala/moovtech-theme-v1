{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.home_founder_story.default_eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.home_founder_story.default_heading' | t
  endif

  assign body = section.settings.body
  if body == blank
    assign body = 'sections.home_founder_story.default_body' | t
  endif

  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'sections.home_founder_story.default_cta' | t
  endif

  assign cta_url = section.settings.cta_url | default: '/pages/our-story'
  assign overlay_opacity = section.settings.overlay_opacity | default: 40
  assign image_position = section.settings.image_position | default: 'left'
-%}

<section
  class="founder-story full-width founder-story--image-{{ image_position }}"
  data-surface="white"
  aria-labelledby="founder-story-heading-{{ section.id }}"
  style="--fs-image-tint: {{ overlay_opacity }}%;"
>
  <div class="founder-story__inner">
    <div class="founder-story__media-cell">
      <div class="founder-story__frame">
        {%- if section.settings.image != blank -%}
          {%- assign media_alt = section.settings.image.alt | default: heading -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              class: 'founder-story__img',
              alt: media_alt,
              sizes: '(min-width: 750px) 58vw, 100vw',
              widths: '400, 600, 800, 1200, 1600, 2000, 2400'
          }}
        {%- elsif section.settings.image_url != blank -%}
          <img
            src="{{ section.settings.image_url | escape }}"
            alt="{{ heading | escape }}"
            loading="lazy"
            class="founder-story__img"
            width="2400"
            height="1350"
          >
        {%- else -%}
          <div
            class="founder-story__placeholder"
            role="img"
            aria-label="{{ 'sections.home_founder_story.image_placeholder_label' | t }}"
          ></div>
        {%- endif -%}
      </div>
    </div>

    <div class="founder-story__content">
      {%- if eyebrow != blank -%}
        <p class="founder-story__eyebrow">{{ eyebrow | escape }}</p>
      {%- endif -%}

      <h2 id="founder-story-heading-{{ section.id }}" class="founder-story__heading">
        {{ heading | escape }}
      </h2>

      {%- if body != blank -%}
        <p class="founder-story__body">{{ body | escape }}</p>
      {%- endif -%}

      {%- if cta_label != blank -%}
        <a href="{{ cta_url }}" class="founder-story__cta">
          {{- cta_label | escape -}}
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="2" y1="12" x2="12" y2="2" />
            <polyline points="5,2 12,2 12,9" />
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .founder-story[data-surface='white'] {
    background: var(--moov-cream);
    color: var(--moov-text-primary-light);
    padding: clamp(3.5rem, 7vw, 6.25rem) 0;
    overflow: hidden;
  }

  .founder-story__inner {
    width: 100%;
    max-width: min(
      calc(var(--layout-max-width) + clamp(2rem, 6vw, 8.5rem)),
      calc(100vw - 2 * var(--section-inline-pad))
    );
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0 var(--section-inline-pad);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(56px, 8vw, 160px);
    row-gap: clamp(1.75rem, 3vw, 2.75rem);
    align-items: center;
  }

  .founder-story--image-right .founder-story__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .founder-story--image-right .founder-story__content {
    grid-column: 1;
    grid-row: 1;
  }

  .founder-story--image-right .founder-story__media-cell {
    grid-column: 2;
    grid-row: 1;
  }

  .founder-story__media-cell {
    min-width: 0;
    width: 100%;
    position: sticky;
    top: calc(var(--header-height, 5rem) + 1.5rem);
    align-self: start;
  }

  .founder-story__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--moov-border-light);
    background: var(--moov-cream-shadow);
  }

  .founder-story__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: color-mix(in srgb, var(--moov-black) var(--fs-image-tint, 0%), transparent);
  }

  .founder-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    position: relative;
    z-index: 0;
  }

  .founder-story__placeholder {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: linear-gradient(
      135deg,
      var(--moov-wash-on-cream-4) 0%,
      var(--moov-wash-on-cream-6) 100%
    );
  }

  .founder-story__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 18px;
    padding-top: clamp(0.25rem, 0.8vw, 0.6rem);
    border-left: 3px solid var(--moov-black);
    padding-left: clamp(1.25rem, 3vw, 2rem);
    min-width: 0;
  }

  .founder-story__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-eyebrow-accent);
  }

  .founder-story__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-size: var(--text-heading-xl);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-text-primary-light);
    text-wrap: balance;
  }

  .founder-story__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--moov-text-secondary-light);
    max-width: 44ch;
    text-wrap: pretty;
  }

  .founder-story__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: clamp(6px, 1vw, 12px);
    padding: clamp(13px, 1.2vw, 16px) clamp(26px, 2.8vw, 38px);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--moov-text-primary-dark);
    background: var(--moov-black);
    border: 0.5px solid var(--moov-black);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .founder-story__cta:hover {
    background: var(--moov-amber);
    border-color: var(--moov-amber);
    color: var(--moov-black);
    transform: translateY(-1px);
  }

  @media (max-width: 749px) {
    .founder-story[data-surface='white'] {
      padding: clamp(2.75rem, 8vw, 4rem) 0;
    }

    .founder-story__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .founder-story--image-right .founder-story__content,
    .founder-story--image-right .founder-story__media-cell {
      grid-column: auto;
      grid-row: auto;
    }

    .founder-story__media-cell {
      position: relative;
      top: auto;
    }

    .founder-story__frame {
      aspect-ratio: 4 / 3;
    }

    .founder-story__content {
      border-left: none;
      padding-left: 0;
      border-top: 3px solid var(--moov-black);
      padding-top: clamp(1.25rem, 3vw, 1.75rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_founder_story.name",
  "tag": "section",
  "class": "section-home-founder-story",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.home_founder_story.layout_header"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.home_founder_story.image_position_label",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:sections.home_founder_story.image_left" },
        { "value": "right", "label": "t:sections.home_founder_story.image_right" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.home_founder_story.content_header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "header",
      "content": "t:sections.home_founder_story.image_header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.background_image"
    },
    {
      "type": "url",
      "id": "image_url",
      "label": "t:sections.home_founder_story.image_url_label",
      "info": "t:sections.home_founder_story.image_url_info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.home_founder_story.overlay_label",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "%",
      "info": "t:sections.home_founder_story.overlay_info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_founder_story.name",
      "settings": {
        "image_position": "left",
        "eyebrow": "Our story",
        "heading": "We're building for the first hour",
        "body": "MOOV started from frustration with mornings that felt reactive, not intentional. Read how we're designing a system that meets people where they are.",
        "cta_label": "Read our story",
        "cta_url": "/pages/our-story",
        "image_url": "https://images.unsplash.com/photo-1631312113214-8f2f03a6962f?auto=format&fit=crop&w=2400&q=80",
        "overlay_opacity": 25
      }
    }
  ]
}
{% endschema %}
