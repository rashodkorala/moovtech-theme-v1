{%- liquid
  assign cta_href = section.settings.cta_url
  if cta_href == blank
    assign cta_href = '/pages/returns-refunds'
  endif

  assign image_url_setting = section.settings.image_url
  assign image_picker = section.settings.image
-%}

<section
  class="returns-overview full-width"
  data-surface="cream"
  id="moov-product-returns"
  aria-labelledby="returns-overview-heading-{{ section.id }}"
>
  <div class="returns-overview__inner">

    {%- comment -%} Left — Image {%- endcomment -%}
    <div class="returns-overview__media">
      {%- if image_picker != blank -%}
        {{
          image_picker
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            class: 'returns-overview__img',
            alt: image_picker.alt | default: section.settings.heading,
            sizes: '(min-width: 1024px) 50vw, 100vw',
            widths: '480, 720, 990, 1200'
        }}
      {%- elsif image_url_setting != blank -%}
        <img
          src="{{ image_url_setting | escape }}"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          class="returns-overview__img"
          width="1200"
          height="900"
        >
      {%- else -%}
        <div class="returns-overview__placeholder" role="img" aria-label="{{ section.settings.heading | escape }}">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12a9 9 0 1 0 3-6.7"/>
            <polyline points="3 4 3 9 8 9"/>
          </svg>
        </div>
      {%- endif -%}

      {%- if section.settings.badge_text != blank -%}
        <span class="returns-overview__badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
          {{- section.settings.badge_text | escape -}}
        </span>
      {%- endif -%}
    </div>

    {%- comment -%} Right — Content {%- endcomment -%}
    <div class="returns-overview__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="returns-overview__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 id="returns-overview-heading-{{ section.id }}" class="returns-overview__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="returns-overview__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      <ul class="returns-overview__list" role="list">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign hl_title = section.settings.highlight_1_title
                assign hl_body = section.settings.highlight_1_body
              when 2
                assign hl_title = section.settings.highlight_2_title
                assign hl_body = section.settings.highlight_2_body
              when 3
                assign hl_title = section.settings.highlight_3_title
                assign hl_body = section.settings.highlight_3_body
            endcase
          -%}
          {%- if hl_title != blank or hl_body != blank -%}
            <li class="returns-overview__item">
              <span class="returns-overview__item-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 7.2L5.6 10.8L12 4.4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <div class="returns-overview__item-text">
                {%- if hl_title != blank -%}
                  <p class="returns-overview__item-title">{{ hl_title | escape }}</p>
                {%- endif -%}
                {%- if hl_body != blank -%}
                  <p class="returns-overview__item-body">{{ hl_body | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.cta_label != blank -%}
        <a class="returns-overview__cta" href="{{ cta_href }}">
          {{- section.settings.cta_label | escape -}}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="13 6 19 12 13 18"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.fineprint != blank -%}
        <p class="returns-overview__fineprint">{{ section.settings.fineprint | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .returns-overview {
    background: var(--moov-cream);
    padding: var(--section-block-pad-y) var(--section-inline-pad);
  }

  .returns-overview__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    max-width: var(--layout-max-width);
    margin: 0 auto;
  }

  /* ─── Media ─── */
  .returns-overview__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 18px;
    overflow: hidden;
    background: var(--moov-cream-shadow);
  }

  .returns-overview__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .returns-overview__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--moov-text-tertiary-light);
  }

  .returns-overview__badge {
    position: absolute;
    top: 18px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--moov-cream);
    color: var(--moov-text-primary-light);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }

  /* ─── Content ─── */
  .returns-overview__content {
    max-width: 480px;
  }

  .returns-overview__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-eyebrow-accent);
    margin: 0 0 16px;
  }

  .returns-overview__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.15;
    color: var(--moov-text-primary-light);
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .returns-overview__body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.65;
    color: var(--moov-text-secondary-light);
    margin: 0 0 28px;
  }

  /* ─── Highlights ─── */
  .returns-overview__list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .returns-overview__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .returns-overview__item-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--moov-black);
    color: var(--moov-cream);
    margin-top: 2px;
  }

  .returns-overview__item-text {
    flex: 1;
  }

  .returns-overview__item-title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.4;
    color: var(--moov-text-primary-light);
    margin: 0 0 2px;
  }

  .returns-overview__item-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1.55;
    color: var(--moov-text-secondary-light);
    margin: 0;
  }

  /* ─── CTA ─── */
  .returns-overview__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: var(--moov-black);
    color: var(--moov-cream);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .returns-overview__cta:hover {
    background: var(--moov-amber-hover);
  }

  .returns-overview__cta:hover svg {
    transform: translateX(2px);
  }

  .returns-overview__cta svg {
    transition: transform 0.2s ease;
  }

  .returns-overview__fineprint {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--moov-text-tertiary-light);
    margin: 14px 0 0;
    line-height: 1.5;
  }

  /* ─── Tablet ─── */
  @media (min-width: 768px) and (max-width: 1023px) {
    .returns-overview__inner {
      gap: 40px;
    }

    .returns-overview__heading {
      font-size: var(--text-2xl);
    }
  }

  /* ─── Mobile ─── */
  @media (max-width: 767px) {
    .returns-overview {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .returns-overview__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .returns-overview__media {
      aspect-ratio: 16 / 10;
      border-radius: 14px;
    }

    .returns-overview__heading {
      font-size: var(--text-2xl);
    }

    .returns-overview__content {
      max-width: 100%;
    }

    .returns-overview__cta {
      width: 100%;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Returns overview",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL fallback",
      "info": "Used only when no image is uploaded above."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Image badge text",
      "default": "30-day guarantee"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Try MOOV risk-free"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "30-day returns. Easy refunds."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Not the right fit? Send it back within 30 days of delivery and we'll refund you to the original payment method. No stress."
    },
    {
      "type": "header",
      "content": "Highlights"
    },
    {
      "type": "text",
      "id": "highlight_1_title",
      "label": "Highlight 1 title",
      "default": "30 days to decide"
    },
    {
      "type": "text",
      "id": "highlight_1_body",
      "label": "Highlight 1 body",
      "default": "Live with it for a month. If it's not for you, send it back."
    },
    {
      "type": "text",
      "id": "highlight_2_title",
      "label": "Highlight 2 title",
      "default": "Original packaging only"
    },
    {
      "type": "text",
      "id": "highlight_2_body",
      "label": "Highlight 2 body",
      "default": "Return in good condition with all components included."
    },
    {
      "type": "text",
      "id": "highlight_3_title",
      "label": "Highlight 3 title",
      "default": "Refunded the way you paid"
    },
    {
      "type": "text",
      "id": "highlight_3_body",
      "label": "Highlight 3 body",
      "default": "Issued back to your original payment method once we receive it."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "View full policy"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL",
      "info": "Defaults to /pages/returns-refunds when left blank."
    },
    {
      "type": "text",
      "id": "fineprint",
      "label": "Fine print",
      "default": "Return shipping is the customer's responsibility."
    }
  ],
  "presets": [
    {
      "name": "Returns overview"
    }
  ]
}
{% endschema %}
