{%- liquid
  assign logo_alt = section.settings.logo_alt | strip
  if logo_alt == blank
    assign logo_alt = shop.name
  endif
  assign logo_fallback = section.settings.logo_fallback_asset | strip
  if logo_fallback == blank
    assign logo_fallback = 'moov-logo-black.png'
  endif
  assign logo_max_width = section.settings.logo_max_width | default: 200

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.home_product_glimpse.default_eyebrow' | t
  endif

  assign heading_raw = section.settings.heading | strip
  assign subheading_raw = section.settings.subheading | strip

  if heading_raw != blank
    assign heading_display = heading_raw
    assign subheading_display = subheading_raw
  else
    assign heading_display = subheading_raw
    if heading_display == blank
      assign heading_display = 'sections.home_product_glimpse.default_heading' | t
    endif
    assign subheading_display = ''
  endif

  assign body_lead = section.settings.body_lead | strip
  assign body_emphasis = section.settings.body_emphasis | strip
  assign body_trail = section.settings.body_trail | strip
  assign body = section.settings.body

  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'sections.home_product_glimpse.default_cta' | t
  endif

  assign cta_url = section.settings.cta_url | default: '/products/moov'

  assign cta_secondary_label = section.settings.cta_secondary_label | strip

  assign cta_secondary_url = section.settings.cta_secondary_url | default: '/pages/our-story'

  assign image_asset = section.settings.image_asset | strip
  if section.settings.image == blank
    if section.settings.image_url == blank
      if image_asset == blank
        assign image_asset = 'product-preiview-mainpage.png'
      endif
    endif
  endif

  assign image_position = section.settings.image_position | default: 'left'
  assign show_logo = true
  if section.settings.show_logo == false
    assign show_logo = false
  endif

  assign use_split_body = false
  if body_lead != blank
    assign use_split_body = true
  endif
  if body_emphasis != blank
    assign use_split_body = true
  endif
  if body_trail != blank
    assign use_split_body = true
  endif
-%}

<section
  id="shop"
  class="product-glimpse full-width product-glimpse--image-{{ image_position }}"
  data-surface="dark"
  aria-labelledby="product-glimpse-heading-{{ section.id }}"
  style="--pg-logo-max: {{ logo_max_width }}px;"
>
  <div class="product-glimpse__inner">
    <div class="product-glimpse__media-cell">
      <div class="product-glimpse__frame">
        {%- if section.settings.image != blank -%}
          {%- assign media_alt = section.settings.image.alt | default: heading_display -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              class: 'product-glimpse__img',
              alt: media_alt,
              sizes: '(min-width: 750px) 72vw, 100vw',
              widths: '400, 600, 800, 1200, 1600, 2000, 2400'
          }}
        {%- elsif image_asset != blank -%}
          <img
            class="product-glimpse__img"
            src="{{ image_asset | asset_url }}"
            alt="{{ heading_display | escape }}"
            width="2400"
            height="1600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        {%- elsif section.settings.image_url != blank -%}
          <img
            src="{{ section.settings.image_url | escape }}"
            alt="{{ heading_display | escape }}"
            loading="lazy"
            class="product-glimpse__img"
            width="2400"
            height="1350"
          >
        {%- else -%}
          <div
            class="product-glimpse__placeholder"
            role="img"
            aria-label="{{ 'sections.home_product_glimpse.image_placeholder_label' | t }}"
          ></div>
        {%- endif -%}
      </div>
    </div>

    <div class="product-glimpse__copy">
      {%- if eyebrow != blank -%}
        <p class="product-glimpse__eyebrow">
          <span class="product-glimpse__eyebrow-dot" aria-hidden="true"></span>
          <span class="product-glimpse__eyebrow-text">{{ eyebrow | escape }}</span>
        </p>
      {%- endif -%}

      {%- if show_logo -%}
        <div class="product-glimpse__logo-row">
          {%- if section.settings.logo_image != blank -%}
            {{
              section.settings.logo_image
              | image_url: width: 400
              | image_tag:
                class: 'product-glimpse__logo',
                widths: '120, 200, 300, 400',
                sizes: '(min-width: 750px) 200px, 45vw',
                alt: logo_alt,
                loading: 'lazy'
            }}
          {%- else -%}
            <img
              class="product-glimpse__logo product-glimpse__logo--fallback"
              src="{{ logo_fallback | asset_url }}"
              alt="{{ logo_alt | escape }}"
              width="320"
              height="96"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </div>
      {%- endif -%}

      <h2 id="product-glimpse-heading-{{ section.id }}" class="product-glimpse__heading">
        {{ heading_display | escape }}
      </h2>

      {%- if subheading_display != blank -%}
        <p class="product-glimpse__subtitle">{{ subheading_display | escape }}</p>
      {%- endif -%}

      {%- if use_split_body -%}
        <p class="product-glimpse__lede">
          {%- if body_lead != blank -%}
            {{- body_lead | escape -}}
          {%- endif -%}
          {%- if body_emphasis != blank -%}
            {%- if body_lead != blank -%}
              {{ ' ' }}
            {%- endif -%}
            <em>{{ body_emphasis | escape }}</em>
          {%- endif -%}
          {%- if body_trail != blank -%}
            {%- if body_lead != blank or body_emphasis != blank -%}
              {{ ' ' }}
            {%- endif -%}
            {{- body_trail | escape -}}
          {%- endif -%}
        </p>
      {%- elsif body != blank -%}
        <div class="product-glimpse__lede">{{ body | escape | newline_to_br }}</div>
      {%- endif -%}

      {%- if cta_label != blank or cta_secondary_label != blank -%}
        <div class="product-glimpse__cta-row">
          {%- if cta_label != blank -%}
            <a href="{{ cta_url }}" class="product-glimpse__cta product-glimpse__cta--outline">
              {{- cta_label | escape -}}
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="2" y1="12" x2="12" y2="2" />
                <polyline points="5,2 12,2 12,9" />
              </svg>
            </a>
          {%- endif -%}
          {%- if cta_secondary_label != blank -%}
            <a href="{{ cta_secondary_url }}" class="product-glimpse__cta product-glimpse__cta--outline-amber">
              {{- cta_secondary_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-glimpse[data-surface='dark'] {
    background: var(--moov-cream);
    color: var(--moov-text-primary-light);
    padding: clamp(3.5rem, 7vw, 6.25rem) 0 clamp(3rem, 6vw, 5.5rem);
    overflow: hidden;
  }

  .product-glimpse__inner {
    width: 100%;
    max-width: min(
      calc(var(--layout-max-width) + clamp(2rem, 6vw, 8.5rem)),
      calc(100vw - 2 * var(--section-inline-pad))
    );
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0 var(--section-inline-pad);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(56px, 8vw, 160px);
    row-gap: clamp(1.75rem, 3vw, 2.75rem);
    align-items: center;
  }

  .product-glimpse--image-right .product-glimpse__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .product-glimpse--image-right .product-glimpse__copy {
    grid-column: 1;
    grid-row: 1;
  }

  .product-glimpse--image-right .product-glimpse__media-cell {
    grid-column: 2;
    grid-row: 1;
  }

  .product-glimpse__media-cell {
    min-width: 0;
    width: 100%;
    position: sticky;
    top: calc(var(--header-height, 5rem) + 1.5rem);
    align-self: start;
  }

  .product-glimpse__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: min(92vh, 920px);
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--moov-border-light);
    background: color-mix(in srgb, var(--moov-black) 6%, var(--moov-cream));
  }

  .product-glimpse__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .product-glimpse__placeholder {
    width: 100%;
    height: 100%;
    min-height: 280px;
    background: var(--moov-cream);
  }

  .product-glimpse__copy {
    width: 100%;
    min-width: 0;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 18px;
    padding-top: clamp(0.25rem, 0.8vw, 0.6rem);
  }

  .product-glimpse__logo-row {
    width: 100%;
    margin: 0 0 clamp(4px, 0.5vw, 8px);
  }

  .product-glimpse__logo {
    display: block;
    width: min(100%, var(--pg-logo-max));
    height: auto;
    max-height: 3.25rem;
    object-fit: contain;
    object-position: left center;
  }

  .product-glimpse[data-surface='dark'] .product-glimpse__logo--fallback {
    filter: none;
  }

  .product-glimpse__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-amber);
  }

  .product-glimpse__eyebrow-dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--moov-amber);
    box-shadow: 0 0 12px color-mix(in srgb, var(--moov-amber) 65%, transparent);
    animation: pg-pulse 2.4s ease-in-out infinite;
  }

  @keyframes pg-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.25); opacity: 0.75; }
  }

  .product-glimpse__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-size: var(--text-heading-xl);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--moov-text-primary-light);
    text-wrap: balance;
  }

  .product-glimpse__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--moov-text-secondary-light);
    max-width: 46ch;
    text-wrap: balance;
  }

  .product-glimpse__lede {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--moov-text-secondary-light);
    max-width: 44ch;
    text-wrap: pretty;
  }

  .product-glimpse__lede em {
    font-style: italic;
    color: var(--moov-text-primary-light);
  }

  .product-glimpse__cta-row {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 10px 12px;
    margin-top: clamp(8px, 1.2vw, 14px);
  }

  .product-glimpse__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: clamp(12px, 1.1vw, 15px) clamp(22px, 2.5vw, 34px);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .product-glimpse__cta--outline {
    color: var(--moov-black);
    background: transparent;
    border: 1px solid var(--moov-black);
  }

  .product-glimpse__cta--outline:hover {
    background: var(--moov-black);
    color: var(--moov-cream);
    border-color: var(--moov-black);
    transform: translateY(-1px);
  }

  .product-glimpse__cta--outline-amber {
    color: var(--moov-black);
    background: var(--moov-amber);
    border: 1px solid var(--moov-amber);
  }

  .product-glimpse__cta--outline-amber:hover {
    background: var(--moov-amber-hover);
    border-color: var(--moov-amber-hover);
    color: var(--moov-black);
    transform: translateY(-1px);
  }

  @media (max-width: 749px) {
    .product-glimpse[data-surface='dark'] {
      padding: clamp(2.75rem, 8vw, 4rem) 0;
    }

    .product-glimpse__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-glimpse--image-right .product-glimpse__copy,
    .product-glimpse--image-right .product-glimpse__media-cell {
      grid-column: auto;
      grid-row: auto;
    }

    .product-glimpse__media-cell {
      position: relative;
      top: auto;
    }

    .product-glimpse__frame {
      aspect-ratio: 4 / 5;
      max-height: min(80vw, 560px);
    }

    .product-glimpse__copy {
      max-width: none;
    }

    .product-glimpse__cta-row {
      flex-wrap: nowrap;
      width: 100%;
      gap: 8px;
    }

    .product-glimpse__cta {
      flex: 1 1 0;
      min-width: 0;
      justify-content: center;
      padding-left: clamp(10px, 2.2vw, 16px);
      padding-right: clamp(10px, 2.2vw, 16px);
      font-size: clamp(0.6875rem, 0.8vw + 0.55rem, 0.8125rem);
    }
  }
{% endstylesheet %}

