{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.home_product_glimpse.default_eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.home_product_glimpse.default_heading' | t
  endif

  assign subheading = section.settings.subheading
  if subheading == blank
    assign subheading = 'sections.home_product_glimpse.default_subheading' | t
  endif

  assign body = section.settings.body
  if body == blank
    assign body = 'sections.home_product_glimpse.default_body' | t
  endif

  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'sections.home_product_glimpse.default_cta' | t
  endif

  assign cta_url = section.settings.cta_url | default: '/pages/get-moov'
  assign overlay_opacity = section.settings.overlay_opacity | default: 40
  assign image_asset = section.settings.image_asset | strip
  if section.settings.image == blank
    if section.settings.image_url == blank
      if image_asset == blank
        assign image_asset = 'product-preiview-mainpage.PNG'
      endif
    endif
  endif
-%}

<section
  class="product-glimpse full-width"
  aria-labelledby="product-glimpse-heading-{{ section.id }}"
  style="--pg-scrim-strength: {{ overlay_opacity }};"
>
  <div class="product-glimpse__media">
    {%- if section.settings.image != blank -%}
      {%- assign media_alt = section.settings.image.alt | default: heading -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          class: 'product-glimpse__img',
          alt: media_alt,
          sizes: '(min-width: 1200px) 1200px, 100vw',
          widths: '400, 600, 800, 1200, 1600, 2000, 2400'
      }}
    {%- elsif image_asset != blank -%}
      <img
        class="product-glimpse__img"
        src="{{ image_asset | asset_url }}"
        alt="{{ heading | escape }}"
        width="2400"
        height="1600"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
    {%- elsif section.settings.image_url != blank -%}
      <img
        src="{{ section.settings.image_url | escape }}"
        alt="{{ heading | escape }}"
        loading="lazy"
        class="product-glimpse__img"
        width="2400"
        height="1350"
      >
    {%- else -%}
      <div
        class="product-glimpse__placeholder"
        role="img"
        aria-label="{{ 'sections.home_product_glimpse.image_placeholder_label' | t }}"
      ></div>
    {%- endif -%}
    <div class="product-glimpse__overlay product-glimpse__overlay--scrim" aria-hidden="true"></div>
    <div class="product-glimpse__overlay product-glimpse__overlay--bottom" aria-hidden="true"></div>
  </div>

  <div class="product-glimpse__content">
    {%- if eyebrow != blank -%}
      <p class="product-glimpse__eyebrow">{{ eyebrow | escape }}</p>
    {%- endif -%}

    <h2 id="product-glimpse-heading-{{ section.id }}" class="product-glimpse__heading">
      {{ heading | escape }}
    </h2>

    {%- if subheading != blank -%}
      <p class="product-glimpse__subheading">{{ subheading | escape }}</p>
    {%- endif -%}

    {%- if subheading != blank and body != blank -%}
      <hr class="product-glimpse__rule" aria-hidden="true">
    {%- endif -%}

    {%- if body != blank -%}
      <p class="product-glimpse__body">{{ body | escape }}</p>
    {%- endif -%}

    {%- if cta_label != blank -%}
      <a href="{{ cta_url }}" class="product-glimpse__cta">
        {{- cta_label | escape -}}
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="2" y1="12" x2="12" y2="2" />
          <polyline points="5,2 12,2 12,9" />
        </svg>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .product-glimpse {
    --pg-radius: clamp(18px, 2.4vw, 28px);
    --pg-pad: clamp(1.5rem, 5vw, 4rem);
    position: relative;
    margin: var(--section-block-pad-y-md) var(--section-inline-pad);
    border-radius: var(--pg-radius);
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(360px, 60vw, 620px);
    display: grid;
    color: var(--moov-black);
  }

  .product-glimpse__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .product-glimpse__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% center;
    display: block;
  }

  .product-glimpse__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--moov-cream) 62%, var(--moov-black)) 0%,
      var(--moov-neutral-deep) 100%
    );
  }

  .product-glimpse__overlay--scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: calc(0.2 + var(--pg-scrim-strength, 40) * 0.0028);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--moov-cream) 52%, transparent) 0%,
      color-mix(in srgb, var(--moov-cream) 18%, transparent) 26%,
      color-mix(in srgb, var(--moov-cream) 6%, transparent) 44%,
      transparent 58%
    );
  }

  .product-glimpse__overlay--bottom {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--moov-cream) 16%, transparent) 0%,
      transparent 34%
    );
  }

  .product-glimpse__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-self: start;
    align-self: center;
    gap: clamp(12px, 1.8vw, 18px);
    max-width: min(520px, 100%);
    padding: var(--pg-pad);
  }

  .product-glimpse__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: color-mix(in srgb, var(--moov-black) 78%, transparent);
  }

  .product-glimpse__heading {
    margin: 0;
    font-family: var(--font-hero, var(--font-body));
    font-weight: 700;
    font-size: clamp(2.75rem, 7vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--moov-black);
  }

  .product-glimpse__subheading {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 400;
    line-height: 1.45;
    color: color-mix(in srgb, var(--moov-black) 88%, transparent);
    max-width: 420px;
  }

  .product-glimpse__rule {
    margin: clamp(2px, 0.6vw, 6px) 0;
    border: none;
    width: 2.5rem;
    height: 1px;
    background: color-mix(in srgb, var(--moov-black) 35%, transparent);
    align-self: flex-start;
  }

  .product-glimpse__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    font-style: italic;
    color: color-mix(in srgb, var(--moov-black) 80%, transparent);
    max-width: 400px;
  }

  .product-glimpse__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: clamp(13px, 1.2vw, 16px) clamp(26px, 2.8vw, 36px);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--moov-cream);
    background: var(--moov-black);
    border: none;
    margin-top: clamp(6px, 1vw, 12px);
    box-shadow: none;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .product-glimpse__cta:hover {
    background: color-mix(in srgb, var(--moov-black) 88%, var(--moov-cream));
    transform: translateY(-1px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--moov-black) 18%, transparent);
  }

  @media (max-width: 749px) {
    .product-glimpse {
      min-height: clamp(420px, 90vw, 560px);
    }

    .product-glimpse__img {
      object-position: 20%;
      scale: 1.1;
      transform-origin: center;
    }

    .product-glimpse__content {
      align-self: end;
      padding-top: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_product_glimpse.name",
  "tag": "section",
  "class": "section-product-glimpse",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.home_product_glimpse.content_header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "header",
      "content": "t:sections.home_product_glimpse.image_header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.background_image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "t:sections.home_product_glimpse.image_asset_label",
      "info": "t:sections.home_product_glimpse.image_asset_info",
      "default": "product-preiview-mainpage.PNG"
    },
    {
      "type": "url",
      "id": "image_url",
      "label": "t:sections.home_product_glimpse.image_url_label",
      "info": "t:sections.home_product_glimpse.image_url_info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.home_product_glimpse.overlay_label",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "%",
      "info": "t:sections.home_product_glimpse.overlay_info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_product_glimpse.name",
      "settings": {
        "eyebrow": "Introducing",
        "heading": "MOOV",
        "subheading": "A better way to start your morning.",
        "body": "Built to get you out of bed — and into your day.",
        "cta_label": "Get your MOOV",
        "cta_url": "/pages/get-moov",
        "image_asset": "product-preiview-mainpage.PNG",
        "image_url": "",
        "overlay_opacity": 25
      }
    }
  ]
}
{% endschema %}
