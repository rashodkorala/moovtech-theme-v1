{%- liquid
  assign logo_alt = section.settings.logo_alt | strip
  if logo_alt == blank
    assign logo_alt = shop.name
  endif
  assign logo_fallback = section.settings.logo_fallback_asset | strip
  if logo_fallback == blank
    assign logo_fallback = 'moov-logo-black.png'
  endif
  assign logo_max_width = section.settings.logo_max_width | default: 200

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.home_product_glimpse.default_eyebrow' | t
  endif

  assign heading_raw = section.settings.heading | strip
  assign subheading_raw = section.settings.subheading | strip

  if heading_raw != blank
    assign heading_display = heading_raw
    assign subheading_display = subheading_raw
  else
    assign heading_display = subheading_raw
    if heading_display == blank
      assign heading_display = 'sections.home_product_glimpse.default_heading' | t
    endif
    assign subheading_display = ''
  endif

  assign body = section.settings.body
  if body == blank
    assign body = 'sections.home_product_glimpse.default_body' | t
  endif

  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'sections.home_product_glimpse.default_cta' | t
  endif

  assign cta_url = section.settings.cta_url | default: '/pages/get-moov'

  assign image_asset = section.settings.image_asset | strip
  if section.settings.image == blank
    if section.settings.image_url == blank
      if image_asset == blank
        assign image_asset = 'product-preiview-mainpage.png'
      endif
    endif
  endif

  assign image_position = section.settings.image_position | default: 'left'
  assign show_logo = true
  if section.settings.show_logo == false
    assign show_logo = false
  endif
-%}

<section
  class="product-glimpse full-width product-glimpse--image-{{ image_position }}"
  data-surface="cream"
  aria-labelledby="product-glimpse-heading-{{ section.id }}"
  style="--pg-logo-max: {{ logo_max_width }}px;"
>
  <div class="product-glimpse__inner">
    <div class="product-glimpse__media-cell">
      <div class="product-glimpse__frame">
        {%- if section.settings.image != blank -%}
          {%- assign media_alt = section.settings.image.alt | default: heading_display -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              class: 'product-glimpse__img',
              alt: media_alt,
              sizes: '(min-width: 750px) 72vw, 100vw',
              widths: '400, 600, 800, 1200, 1600, 2000, 2400'
          }}
        {%- elsif image_asset != blank -%}
          <img
            class="product-glimpse__img"
            src="{{ image_asset | asset_url }}"
            alt="{{ heading_display | escape }}"
            width="2400"
            height="1600"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        {%- elsif section.settings.image_url != blank -%}
          <img
            src="{{ section.settings.image_url | escape }}"
            alt="{{ heading_display | escape }}"
            loading="lazy"
            class="product-glimpse__img"
            width="2400"
            height="1350"
          >
        {%- else -%}
          <div
            class="product-glimpse__placeholder"
            role="img"
            aria-label="{{ 'sections.home_product_glimpse.image_placeholder_label' | t }}"
          ></div>
        {%- endif -%}
      </div>
    </div>

    <div class="product-glimpse__copy">
      {%- if show_logo -%}
        <div class="product-glimpse__logo-row">
          {%- if section.settings.logo_image != blank -%}
            {{
              section.settings.logo_image
              | image_url: width: 400
              | image_tag:
                class: 'product-glimpse__logo',
                widths: '120, 200, 300, 400',
                sizes: '(min-width: 750px) 200px, 45vw',
                alt: logo_alt,
                loading: 'lazy'
            }}
          {%- else -%}
            <img
              class="product-glimpse__logo"
              src="{{ logo_fallback | asset_url }}"
              alt="{{ logo_alt | escape }}"
              width="320"
              height="96"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if eyebrow != blank -%}
        <p class="product-glimpse__eyebrow">{{ eyebrow | escape }}</p>
      {%- endif -%}

      <h2 id="product-glimpse-heading-{{ section.id }}" class="product-glimpse__heading">
        {{ heading_display | escape }}
      </h2>

      {%- if subheading_display != blank -%}
        <p class="product-glimpse__subtitle">{{ subheading_display | escape }}</p>
      {%- endif -%}

      {%- if body != blank -%}
        <div class="product-glimpse__body">{{ body | escape | newline_to_br }}</div>
      {%- endif -%}

      {%- if cta_label != blank -%}
        <a href="{{ cta_url }}" class="product-glimpse__cta">
          {{- cta_label | escape -}}
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="2" y1="12" x2="12" y2="2" />
            <polyline points="5,2 12,2 12,9" />
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-glimpse[data-surface='cream'] {
    background: var(--moov-cream);
    color: var(--moov-text-primary-light);
    padding: clamp(3.5rem, 7vw, 6.25rem) 0 clamp(3rem, 6vw, 5.5rem);
    overflow: hidden;
  }

  .product-glimpse__inner {
    width: 100%;
    max-width: min(
      calc(var(--layout-max-width) + clamp(2rem, 6vw, 8.5rem)),
      calc(100vw - 2 * var(--section-inline-pad))
    );
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0 var(--section-inline-pad);
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.58fr);
    column-gap: clamp(56px, 8vw, 160px);
    row-gap: clamp(1.75rem, 3vw, 2.75rem);
    align-items: center;
  }

  .product-glimpse--image-right .product-glimpse__inner {
    grid-template-columns: minmax(0, 0.58fr) minmax(0, 1.55fr);
  }

  .product-glimpse--image-right .product-glimpse__copy {
    grid-column: 1;
    grid-row: 1;
  }

  .product-glimpse--image-right .product-glimpse__media-cell {
    grid-column: 2;
    grid-row: 1;
  }

  .product-glimpse__media-cell {
    min-width: 0;
    width: 100%;
    position: sticky;
    top: calc(var(--header-height, 5rem) + 1.5rem);
    align-self: start;
  }

  .product-glimpse__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--moov-border-light);
    background: var(--moov-cream-shadow);
  }

  .product-glimpse__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .product-glimpse__placeholder {
    width: 100%;
    height: 100%;
    min-height: 280px;
    background: linear-gradient(
      135deg,
      var(--moov-wash-on-cream-4) 0%,
      var(--moov-wash-on-cream-6) 100%
    );
  }

  .product-glimpse__copy {
    width: 100%;
    min-width: 0;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: clamp(0.65rem, 1.2vw, 0.9rem);
    padding-top: clamp(0.25rem, 0.8vw, 0.6rem);
  }

  .product-glimpse__logo-row {
    width: 100%;
    margin: 0 0 clamp(4px, 0.5vw, 8px);
  }

  .product-glimpse__logo {
    display: block;
    width: min(100%, var(--pg-logo-max));
    height: auto;
    max-height: 3.25rem;
    object-fit: contain;
    object-position: left center;
  }

  .product-glimpse__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-eyebrow-accent);
  }

  .product-glimpse__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-size: clamp(1.85rem, 3.4vw, 2.85rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: 0.02em;
    text-transform: var(--heading-text-transform, uppercase);
    color: var(--moov-text-primary-light);
    text-wrap: balance;
  }

  .product-glimpse__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--moov-text-secondary-light);
    max-width: 46ch;
    text-wrap: balance;
  }

  .product-glimpse__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--moov-text-secondary-light);
    max-width: 50ch;
    text-wrap: pretty;
  }

  .product-glimpse__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: clamp(6px, 1vw, 12px);
    padding: clamp(13px, 1.2vw, 16px) clamp(26px, 2.8vw, 38px);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--moov-text-primary-dark);
    background: var(--moov-black);
    border: 0.5px solid var(--moov-black);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .product-glimpse__cta:hover {
    background: var(--moov-amber);
    border-color: var(--moov-amber);
    color: var(--moov-black);
    transform: translateY(-1px);
  }

  @media (max-width: 749px) {
    .product-glimpse[data-surface='cream'] {
      padding: clamp(2.75rem, 8vw, 4rem) 0;
    }

    .product-glimpse__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-glimpse--image-right .product-glimpse__copy,
    .product-glimpse--image-right .product-glimpse__media-cell {
      grid-column: auto;
      grid-row: auto;
    }

    .product-glimpse__media-cell {
      position: relative;
      top: auto;
    }

    .product-glimpse__frame {
      aspect-ratio: 4 / 3;
    }

    .product-glimpse__copy {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_product_glimpse.name",
  "tag": "section",
  "class": "section-product-glimpse",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.home_product_glimpse.layout_header"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.home_product_glimpse.image_position_label",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:sections.home_product_glimpse.image_left" },
        { "value": "right", "label": "t:sections.home_product_glimpse.image_right" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.home_product_glimpse.content_header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:sections.home_product_glimpse.heading_info"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.home_product_glimpse.subtitle_label",
      "info": "t:sections.home_product_glimpse.subtitle_info"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "header",
      "content": "t:sections.home_product_glimpse.brand_header"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "t:sections.home_product_glimpse.show_logo_label",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "t:sections.home_product_glimpse.logo_image_label",
      "info": "t:sections.home_product_glimpse.logo_image_info"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "t:sections.home_product_glimpse.logo_max_width_label",
      "min": 96,
      "max": 280,
      "step": 4,
      "default": 200,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "t:sections.home_product_glimpse.logo_alt_label",
      "info": "t:sections.home_product_glimpse.logo_alt_info"
    },
    {
      "type": "text",
      "id": "logo_fallback_asset",
      "label": "t:sections.home_product_glimpse.logo_fallback_asset_label",
      "info": "t:sections.home_product_glimpse.logo_fallback_asset_info",
      "default": "moov-logo-black.png"
    },
    {
      "type": "header",
      "content": "t:sections.home_product_glimpse.image_header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.home_product_glimpse.product_image_label",
      "info": "t:sections.home_product_glimpse.product_image_info"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "t:sections.home_product_glimpse.image_asset_label",
      "info": "t:sections.home_product_glimpse.image_asset_info",
      "default": "product-preiview-mainpage.png"
    },
    {
      "type": "url",
      "id": "image_url",
      "label": "t:sections.home_product_glimpse.image_url_label",
      "info": "t:sections.home_product_glimpse.image_url_info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_product_glimpse.name",
      "settings": {
        "image_position": "left",
        "show_logo": true,
        "eyebrow": "Introducing",
        "heading": "A better way to start your morning.",
        "subheading": "",
        "body": "Built to get you out of bed — and into your day.",
        "cta_label": "Get your MOOV",
        "cta_url": "/pages/get-moov",
        "logo_max_width": 200,
        "image_asset": "product-preiview-mainpage.png",
        "image_url": ""
      }
    }
  ]
}
{% endschema %}
