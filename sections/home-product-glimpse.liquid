{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.home_product_glimpse.default_eyebrow' | t
  endif

  assign logo_alt = section.settings.logo_alt | strip
  if logo_alt == blank
    assign logo_alt = shop.name
  endif
  assign logo_fallback = section.settings.logo_fallback_asset | strip
  if logo_fallback == blank
    assign logo_fallback = 'moov-logo-black.png'
  endif
  assign logo_max_width = section.settings.logo_max_width | default: 296

  assign subheading = section.settings.subheading
  if subheading == blank
    assign subheading = 'sections.home_product_glimpse.default_subheading' | t
  endif

  assign body = section.settings.body
  if body == blank
    assign body = 'sections.home_product_glimpse.default_body' | t
  endif

  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'sections.home_product_glimpse.default_cta' | t
  endif

  assign cta_url = section.settings.cta_url | default: '/pages/get-moov'
  assign overlay_opacity = section.settings.overlay_opacity | default: 40
  assign image_asset = section.settings.image_asset | strip
  if section.settings.image == blank
    if section.settings.image_url == blank
      if image_asset == blank
        assign image_asset = 'product-preiview-mainpage.png'
      endif
    endif
  endif
-%}

<section
  class="product-glimpse full-width"
  aria-labelledby="product-glimpse-heading-{{ section.id }}"
  style="--pg-scrim-strength: {{ overlay_opacity }}; --pg-logo-max: {{ logo_max_width }}px;"
>
  <div class="product-glimpse__media">
    {%- if section.settings.image != blank -%}
      {%- assign media_alt = section.settings.image.alt | default: logo_alt -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          class: 'product-glimpse__img',
          alt: media_alt,
          sizes: '(min-width: 1200px) 1200px, 100vw',
          widths: '400, 600, 800, 1200, 1600, 2000, 2400'
      }}
    {%- elsif image_asset != blank -%}
      <img
        class="product-glimpse__img"
        src="{{ image_asset | asset_url }}"
        alt="{{ logo_alt | escape }}"
        width="2400"
        height="1600"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
    {%- elsif section.settings.image_url != blank -%}
      <img
        src="{{ section.settings.image_url | escape }}"
        alt="{{ logo_alt | escape }}"
        loading="lazy"
        class="product-glimpse__img"
        width="2400"
        height="1350"
      >
    {%- else -%}
      <div
        class="product-glimpse__placeholder"
        role="img"
        aria-label="{{ 'sections.home_product_glimpse.image_placeholder_label' | t }}"
      ></div>
    {%- endif -%}
    <div class="product-glimpse__overlay product-glimpse__overlay--scrim" aria-hidden="true"></div>
    <div class="product-glimpse__overlay product-glimpse__overlay--bottom" aria-hidden="true"></div>
  </div>

  <div class="product-glimpse__content">
    {%- if eyebrow != blank -%}
      <p class="product-glimpse__eyebrow">{{ eyebrow | escape }}</p>
    {%- endif -%}

    <h2 id="product-glimpse-heading-{{ section.id }}" class="product-glimpse__title">
      {%- if section.settings.logo_image != blank -%}
        {{
          section.settings.logo_image
          | image_url: width: 600
          | image_tag:
            class: 'product-glimpse__logo',
            widths: '200, 300, 400, 600',
            sizes: '(min-width: 750px) 280px, 62vw',
            alt: logo_alt,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        <img
          class="product-glimpse__logo"
          src="{{ logo_fallback | asset_url }}"
          alt="{{ logo_alt | escape }}"
          width="400"
          height="120"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- endif -%}
    </h2>

    {%- if subheading != blank -%}
      <p class="product-glimpse__tagline">{{ subheading | escape }}</p>
    {%- endif -%}

    {%- if body != blank -%}
      {%- if subheading != blank -%}
        <hr class="product-glimpse__rule" aria-hidden="true">
      {%- endif -%}
      <div class="product-glimpse__body">{{ body | escape | newline_to_br }}</div>
    {%- endif -%}

    {%- if cta_label != blank -%}
      <a href="{{ cta_url }}" class="product-glimpse__cta">
        {{- cta_label | escape -}}
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="2" y1="12" x2="12" y2="2" />
          <polyline points="5,2 12,2 12,9" />
        </svg>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .product-glimpse {
    --pg-radius: clamp(18px, 2.4vw, 28px);
    --pg-pad: clamp(1.5rem, 5vw, 4rem);
    position: relative;
    width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-block: var(--section-block-pad-y-md);
    margin-inline: auto;
    border-radius: var(--pg-radius);
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(360px, 60vw, 620px);
    display: grid;
    color: var(--moov-cream);
  }

  .product-glimpse__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .product-glimpse__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 32% center;
    display: block;
  }

  .product-glimpse__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--moov-cream) 62%, var(--moov-black)) 0%,
      var(--moov-neutral-deep) 100%
    );
  }

  .product-glimpse__overlay--scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: clamp(0.45, calc(0.28 + var(--pg-scrim-strength, 40) / 175), 0.92);
    background: linear-gradient(
      90deg,
      transparent 0%,
      transparent 38%,
      color-mix(in srgb, var(--moov-black) 20%, transparent) 54%,
      color-mix(in srgb, var(--moov-black) 44%, transparent) 70%,
      color-mix(in srgb, var(--moov-black) 78%, transparent) 100%
    );
  }

  .product-glimpse__overlay--bottom {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--moov-black) 36%, transparent) 0%,
      transparent 38%
    );
  }

  .product-glimpse__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-self: end;
    align-self: center;
    text-align: right;
    gap: clamp(7px, 1.05vw, 11px);
    max-width: min(380px, 94vw);
    padding: var(--pg-pad);
  }
  .product-glimpse__title {
    margin: 0;
    line-height: 0;
    font-weight: inherit;
    font-size: inherit;
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  .product-glimpse__logo {
    display: block;
    width: min(100%, var(--pg-logo-max));
    height: auto;
    object-fit: contain;
    object-position: right center;
    /* Monotone black marks read as cream/white over the darker scrim */
    filter: brightness(0) invert(1);
  }

  .product-glimpse__tagline {
    margin: 0;
    font-family: var(--font-display, var(--font-body));
    font-size: clamp(2.0625rem, 5vw, 2.875rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-transform: none;
    color: var(--moov-cream);
    max-width: 100%;
    text-wrap: balance;
  }

  .product-glimpse__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: color-mix(in srgb, var(--moov-cream) 84%, transparent);
    line-height: 1.2;
    text-wrap: balance;
    max-width: 100%;
  }

  .product-glimpse__rule {
    margin: 4px 0 2px;
    border: none;
    width: 2rem;
    height: 1px;
    background: color-mix(in srgb, var(--moov-cream) 42%, transparent);
    align-self: flex-end;
  }

  .product-glimpse__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.42;
    font-style: normal;
    color: color-mix(in srgb, var(--moov-cream) 90%, transparent);
    max-width: 100%;
    text-wrap: pretty;
  }

  .product-glimpse__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: clamp(12px, 1.15vw, 15px) clamp(24px, 2.6vw, 34px);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--moov-black);
    background: var(--moov-cream);
    border: none;
    margin-top: clamp(4px, 0.75vw, 8px);
    box-shadow: none;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .product-glimpse__cta:hover {
    background: color-mix(in srgb, var(--moov-cream) 94%, transparent);
    transform: translateY(-1px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--moov-black) 28%, transparent);
  }

  @media (max-width: 749px) {
    .product-glimpse {
      min-height: clamp(420px, 90vw, 560px);
    }

    .product-glimpse__img {
      object-position: 36%;
      scale: 1.1;
      transform-origin: center;
    }

    .product-glimpse__content {
      justify-self: end;
      align-self: end;
      align-items: flex-end;
      padding-top: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.home_product_glimpse.name",
  "tag": "section",
  "class": "section-product-glimpse",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.home_product_glimpse.content_header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text"
    },
    {
      "type": "header",
      "content": "t:sections.home_product_glimpse.brand_header"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "t:sections.home_product_glimpse.logo_image_label",
      "info": "t:sections.home_product_glimpse.logo_image_info"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "t:sections.home_product_glimpse.logo_max_width_label",
      "min": 96,
      "max": 340,
      "step": 4,
      "default": 296,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "t:sections.home_product_glimpse.logo_alt_label",
      "info": "t:sections.home_product_glimpse.logo_alt_info"
    },
    {
      "type": "text",
      "id": "logo_fallback_asset",
      "label": "t:sections.home_product_glimpse.logo_fallback_asset_label",
      "info": "t:sections.home_product_glimpse.logo_fallback_asset_info",
      "default": "moov-logo-black.png"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.home_product_glimpse.tagline_label"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "header",
      "content": "t:sections.home_product_glimpse.image_header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.background_image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "t:sections.home_product_glimpse.image_asset_label",
      "info": "t:sections.home_product_glimpse.image_asset_info",
      "default": "product-preiview-mainpage.png"
    },
    {
      "type": "url",
      "id": "image_url",
      "label": "t:sections.home_product_glimpse.image_url_label",
      "info": "t:sections.home_product_glimpse.image_url_info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.home_product_glimpse.overlay_label",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "%",
      "info": "t:sections.home_product_glimpse.overlay_info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_product_glimpse.name",
      "settings": {
        "eyebrow": "Introducing",
        "logo_max_width": 296,
        "subheading": "A better way to start your morning.",
        "body": "Built to get you out of bed — and into your day.",
        "cta_label": "Get your MOOV",
        "cta_url": "/pages/get-moov",
        "image_asset": "product-preiview-mainpage.png",
        "image_url": "",
        "overlay_opacity": 25
      }
    }
  ]
}
{% endschema %}
