<div class="about-page" id="about-page-{{ section.id }}">

  {%- comment -%} ── 1. HERO ── {%- endcomment -%}
  <div class="about-hero">
    <div class="about-hero__inner">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="about-hero__eyebrow">{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.hero_headline != blank -%}
        <h1 class="about-hero__headline">{{ section.settings.hero_headline }}</h1>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── 2. TWO-COLUMN IMAGE GRID ── {%- endcomment -%}
  <div class="about-image-grid">
    <div class="about-image-grid__inner">
      <div class="about-image-grid__left">
        {%- if section.settings.feature_image_left != blank -%}
          {{ section.settings.feature_image_left | image_url: width: 900 | image_tag: loading: 'lazy', class: 'about-image-grid__img' }}
        {%- else -%}
          <div class="about-image-grid__placeholder about-image-grid__placeholder--tall"></div>
        {%- endif -%}
      </div>
      <div class="about-image-grid__right">
        {%- if section.settings.feature_image_right != blank -%}
          {{ section.settings.feature_image_right | image_url: width: 900 | image_tag: loading: 'lazy', class: 'about-image-grid__img' }}
        {%- else -%}
          <div class="about-image-grid__placeholder about-image-grid__placeholder--wide"></div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ── 3. FEATURE BLOCK ── {%- endcomment -%}
  <div class="about-feature">
    <div class="about-feature__inner">
      <div class="about-feature__left">
        {%- if section.settings.feature_headline != blank -%}
          <h2 class="about-feature__headline">{{ section.settings.feature_headline }}</h2>
        {%- endif -%}
      </div>
      <div class="about-feature__right">
        <div class="about-feature__body-cols">
          {%- if section.settings.feature_body_1 != blank -%}
            <p class="about-feature__body">{{ section.settings.feature_body_1 }}</p>
          {%- endif -%}
          {%- if section.settings.feature_body_2 != blank -%}
            <p class="about-feature__body">{{ section.settings.feature_body_2 }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ── 4. STORY SECTION ── {%- endcomment -%}
  <div class="about-story">
    <div class="about-story__inner">
      <div class="about-story__header">
        <h2 class="about-story__section-title">{{ 'sections.about_page.our_story' | t | default: 'Our story' | upcase }}</h2>
      </div>
      <div class="about-story__layout">
        <aside class="about-story__sidebar" id="about-story-sidebar-{{ section.id }}">
          <div class="about-story__sidebar-rule"></div>
          <div class="about-story__sidebar-items">
            <div class="about-story__sidebar-item about-story__sidebar-item--active" data-story-index="0">
              {%- if section.settings.story_vision_label != blank -%}
                <p class="about-story__sidebar-label">{{ section.settings.story_vision_label | upcase }}</p>
              {%- endif -%}
              {%- if section.settings.story_vision_body != blank -%}
                <p class="about-story__sidebar-body">{{ section.settings.story_vision_body }}</p>
              {%- endif -%}
            </div>
            <div class="about-story__sidebar-item" data-story-index="1">
              {%- if section.settings.story_journey_label != blank -%}
                <p class="about-story__sidebar-label">{{ section.settings.story_journey_label | upcase }}</p>
              {%- endif -%}
              {%- if section.settings.story_journey_body != blank -%}
                <p class="about-story__sidebar-body">{{ section.settings.story_journey_body }}</p>
              {%- endif -%}
            </div>
            <div class="about-story__sidebar-item" data-story-index="2">
              {%- if section.settings.story_promise_label != blank -%}
                <p class="about-story__sidebar-label">{{ section.settings.story_promise_label | upcase }}</p>
              {%- endif -%}
              {%- if section.settings.story_promise_body != blank -%}
                <p class="about-story__sidebar-body">{{ section.settings.story_promise_body }}</p>
              {%- endif -%}
            </div>
          </div>
        </aside>
        <div class="about-story__images" id="about-story-images-{{ section.id }}">

          <div class="about-story__image-block" data-story-block="0">
            {%- if section.settings.story_image_1 != blank -%}
              {{ section.settings.story_image_1 | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'about-story__img' }}
            {%- else -%}
              <div class="about-story__img-placeholder"></div>
            {%- endif -%}
            <div class="about-story__caption">
              {%- if section.settings.story_vision_caption_headline != blank -%}
                <h3 class="about-story__caption-headline">{{ section.settings.story_vision_caption_headline }}</h3>
              {%- endif -%}
              {%- if section.settings.story_vision_caption_body != blank -%}
                <p class="about-story__caption-body">{{ section.settings.story_vision_caption_body }}</p>
              {%- endif -%}
            </div>
          </div>

          <div class="about-story__image-block" data-story-block="1">
            {%- if section.settings.story_image_2 != blank -%}
              {{ section.settings.story_image_2 | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'about-story__img' }}
            {%- else -%}
              <div class="about-story__img-placeholder"></div>
            {%- endif -%}
            <div class="about-story__caption">
              {%- if section.settings.story_journey_caption_headline != blank -%}
                <h3 class="about-story__caption-headline">{{ section.settings.story_journey_caption_headline }}</h3>
              {%- endif -%}
              {%- if section.settings.story_journey_caption_body != blank -%}
                <p class="about-story__caption-body">{{ section.settings.story_journey_caption_body }}</p>
              {%- endif -%}
            </div>
          </div>

          <div class="about-story__image-block" data-story-block="2">
            {%- if section.settings.story_image_3 != blank -%}
              {{ section.settings.story_image_3 | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'about-story__img' }}
            {%- else -%}
              <div class="about-story__img-placeholder"></div>
            {%- endif -%}
            <div class="about-story__caption">
              {%- if section.settings.story_promise_caption_headline != blank -%}
                <h3 class="about-story__caption-headline">{{ section.settings.story_promise_caption_headline }}</h3>
              {%- endif -%}
              {%- if section.settings.story_promise_caption_body != blank -%}
                <p class="about-story__caption-body">{{ section.settings.story_promise_caption_body }}</p>
              {%- endif -%}
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ── 5. STATS BAND ── {%- endcomment -%}
  {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
  {%- if stat_blocks.size > 0 -%}
    <div class="about-stats">
      <div class="about-stats__inner">
        {%- for block in stat_blocks -%}
          <div class="about-stats__card" {{ block.shopify_attributes }}>
            <div class="about-stats__card-top">
              {%- if block.settings.number != blank -%}
                <p class="about-stats__number">{{ block.settings.number }}</p>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <p class="about-stats__label">{{ block.settings.label | upcase }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.description != blank -%}
              <p class="about-stats__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── 6. CAREER CTA ── {%- endcomment -%}
  <div class="about-career">
    <div class="about-career__inner">
      <div class="about-career__image-col">
        {%- if section.settings.career_image != blank -%}
          {{ section.settings.career_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'about-career__img' }}
        {%- else -%}
          <div class="about-career__img-placeholder"></div>
        {%- endif -%}
      </div>
      <div class="about-career__content-col">
        <div class="about-career__content">
          {%- if section.settings.career_label != blank -%}
            <p class="about-career__label">{{ section.settings.career_label | upcase }}</p>
          {%- endif -%}
          {%- if section.settings.career_headline != blank -%}
            <h2 class="about-career__headline">{{ section.settings.career_headline | upcase }}</h2>
          {%- endif -%}
          {%- if section.settings.career_body != blank -%}
            <p class="about-career__body">{{ section.settings.career_body }}</p>
          {%- endif -%}
          {%- if section.settings.career_button_label != blank -%}
            <a href="{{ section.settings.career_button_url | default: '#' }}" class="about-career__btn">
              {{ section.settings.career_button_label }}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5M11.5 2.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ── 7. BLOG GRID ── {%- endcomment -%}
  {%- assign article_blocks = section.blocks | where: 'type', 'article' -%}
  {%- if article_blocks.size > 0 -%}
    <div class="about-blog">
      <div class="about-blog__inner">
        <div class="about-blog__header">
          <h2 class="about-blog__heading">{{ 'sections.about_page.blog_heading' | t | default: 'Blog' | upcase }}</h2>
          {%- if section.settings.blog_read_all_url != blank -%}
            <a href="{{ section.settings.blog_read_all_url }}" class="about-blog__read-all">
              {{ section.settings.blog_read_all_label | default: 'Read all' }}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5M11.5 2.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
        <div class="about-blog__grid">
          {%- for block in article_blocks -%}
            <article class="about-blog__card" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.url | default: '#' }}" class="about-blog__card-image-link">
                <div class="about-blog__card-image-wrap">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'about-blog__card-img' }}
                  {%- else -%}
                    <div class="about-blog__card-img-placeholder"></div>
                  {%- endif -%}
                </div>
              </a>
              <div class="about-blog__card-meta">
                {%- if block.settings.category != blank -%}
                  <span class="about-blog__card-category">{{ block.settings.category }}</span>
                  <span class="about-blog__card-sep">&ndash;</span>
                {%- endif -%}
                {%- if block.settings.date != blank -%}
                  <span class="about-blog__card-date">{{ block.settings.date }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="about-blog__card-title">{{ block.settings.title | upcase }}</h3>
              {%- endif -%}
              <a href="{{ block.settings.url | default: '#' }}" class="about-blog__card-link">
                <span class="about-blog__card-link-icon">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5M11.5 2.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                {{ 'sections.about_page.read_article' | t | default: 'Read article' }}
              </a>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

</div>

{% stylesheet %}

.about-page {
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  color: #111111;
  background: #ffffff;
}

/* ── 1. Hero ── */
.about-hero {
  padding: 80px 48px 64px;
  text-align: center;
}
.about-hero__inner {
  max-width: 960px;
  margin: 0 auto;
}
.about-hero__eyebrow {
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #999;
  margin: 0 0 20px;
  line-height: 1.5;
}
.about-hero__headline {
  font-size: clamp(2.25rem, 5vw, 3.75rem);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.05;
  margin: 0;
  color: #111111;
}

/* ── 2. Image Grid ── */
.about-image-grid {
  padding: 0 48px 64px;
}
.about-image-grid__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  align-items: start;
}
.about-image-grid__left .about-image-grid__img,
.about-image-grid__left .about-image-grid__placeholder {
  border-radius: 16px;
  display: block;
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
}
.about-image-grid__right .about-image-grid__img,
.about-image-grid__right .about-image-grid__placeholder {
  border-radius: 16px;
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}
.about-image-grid__placeholder {
  background: #e8e8e6;
}

/* ── 3. Feature Block ── */
.about-feature {
  padding: 64px 48px 80px;
}
.about-feature__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: start;
}
.about-feature__headline {
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.1;
  margin: 0;
  color: #111111;
}
.about-feature__body-cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
}
.about-feature__body {
  font-size: 15px;
  font-weight: 300;
  color: #666;
  line-height: 1.65;
  margin: 0;
}

/* ── 4. Story Section ── */
.about-story {
  padding: 0 48px 80px;
}
.about-story__section-title {
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #111111;
  margin: 0 0 40px;
}
.about-story__layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 48px;
  align-items: start;
}
.about-story__sidebar {
  position: sticky;
  top: 80px;
  display: flex;
  gap: 0;
}
.about-story__sidebar-rule {
  width: 2px;
  background: #e8e8e6;
  flex-shrink: 0;
  margin-right: 24px;
  border-radius: 2px;
}
.about-story__sidebar-items {
  display: flex;
  flex-direction: column;
  gap: 36px;
  flex: 1;
}
.about-story__sidebar-item {
  opacity: 0.3;
  transition: opacity 0.35s ease;
}
.about-story__sidebar-item--active {
  opacity: 1;
}
.about-story__sidebar-label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #111111;
  margin: 0 0 8px;
}
.about-story__sidebar-body {
  font-size: 14px;
  font-weight: 300;
  color: #444;
  line-height: 1.6;
  margin: 0;
}
.about-story__images {
  display: flex;
  flex-direction: column;
}
.about-story__image-block {
  margin-bottom: 48px;
}
.about-story__image-block:last-child {
  margin-bottom: 0;
}
.about-story__img {
  width: 100%;
  height: 600px;
  object-fit: cover;
  border-radius: 16px;
  display: block;
}
.about-story__img-placeholder {
  width: 100%;
  height: 600px;
  background: #e8e8e6;
  border-radius: 16px;
}
.about-story__caption {
  padding: 28px 0 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  align-items: start;
}
.about-story__caption-headline {
  font-size: clamp(1.5rem, 2.5vw, 2.25rem);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.1;
  margin: 0;
  color: #111111;
}
.about-story__caption-body {
  font-size: 15px;
  font-weight: 300;
  color: #666;
  line-height: 1.65;
  margin: 0;
  padding-top: 4px;
}

/* ── 5. Stats Band ── */
.about-stats {
  background: #111111;
  padding: 48px;
}
.about-stats__inner {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.about-stats__card {
  background: #e8e8e6;
  border-radius: 16px;
  padding: 36px 32px;
  min-height: 320px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.about-stats__card-top {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.about-stats__number {
  font-size: clamp(1.75rem, 2.5vw, 2.5rem);
  font-weight: 800;
  letter-spacing: -0.01em;
  line-height: 1.1;
  margin: 0;
  color: #111111;
}
.about-stats__label {
  font-size: clamp(1.5rem, 2vw, 2rem);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.1;
  margin: 0;
  color: #111111;
}
.about-stats__description {
  font-size: 13px;
  font-weight: 300;
  color: #555;
  line-height: 1.6;
  margin: 0;
}

/* ── 6. Career CTA ── */
.about-career {
  padding: 80px 48px;
}
.about-career__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  align-items: stretch;
}
.about-career__image-col {
  border-radius: 16px;
  overflow: hidden;
}
.about-career__img {
  width: 100%;
  height: 100%;
  min-height: 500px;
  object-fit: cover;
  display: block;
}
.about-career__img-placeholder {
  width: 100%;
  min-height: 500px;
  background: #e8e8e6;
}
.about-career__content-col {
  background: #f0f0ee;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64px 48px;
}
.about-career__content {
  text-align: center;
  max-width: 420px;
}
.about-career__label {
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #999;
  margin: 0 0 16px;
}
.about-career__headline {
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1.05;
  margin: 0 0 20px;
  color: #111111;
}
.about-career__body {
  font-size: 15px;
  font-weight: 300;
  color: #666;
  line-height: 1.65;
  margin: 0 0 32px;
}
.about-career__btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #111111;
  color: #ffffff;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  padding: 14px 28px;
  border-radius: 999px;
  letter-spacing: 0.01em;
  transition: background 0.2s ease;
}
.about-career__btn:hover {
  background: #333333;
}

/* ── 7. Blog Grid ── */
.about-blog {
  padding: 0 48px 80px;
}
.about-blog__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
}
.about-blog__heading {
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  line-height: 1;
  margin: 0;
  color: #111111;
}
.about-blog__read-all {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #111111;
  color: #ffffff;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  padding: 12px 22px;
  border-radius: 999px;
  letter-spacing: 0.01em;
  transition: background 0.2s ease;
}
.about-blog__read-all:hover {
  background: #333333;
}
.about-blog__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.about-blog__card {
  display: flex;
  flex-direction: column;
}
.about-blog__card-image-link {
  display: block;
  text-decoration: none;
  margin-bottom: 16px;
}
.about-blog__card-image-wrap {
  border-radius: 16px;
  overflow: hidden;
  aspect-ratio: 4 / 3;
}
.about-blog__card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.about-blog__card-image-link:hover .about-blog__card-img {
  transform: scale(1.03);
}
.about-blog__card-img-placeholder {
  width: 100%;
  height: 100%;
  background: #e8e8e6;
}
.about-blog__card-meta {
  font-size: 12px;
  font-weight: 400;
  color: #999;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.about-blog__card-sep {
  color: #ccc;
}
.about-blog__card-title {
  font-size: 15px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.01em;
  line-height: 1.3;
  margin: 0 0 14px;
  color: #111111;
  flex: 1;
}
.about-blog__card-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 400;
  color: #111111;
  text-decoration: none;
  margin-top: auto;
}
.about-blog__card-link:hover {
  color: #555;
}
.about-blog__card-link-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1.5px solid #111111;
  flex-shrink: 0;
  transition: background 0.2s ease, color 0.2s ease;
}
.about-blog__card-link:hover .about-blog__card-link-icon {
  background: #111111;
  color: #ffffff;
}

/* ── Responsive ── */
@media (max-width: 960px) {
  .about-hero { padding: 56px 24px 48px; }
  .about-image-grid { padding: 0 24px 48px; }
  .about-image-grid__inner { grid-template-columns: 1fr; }
  .about-image-grid__left .about-image-grid__img,
  .about-image-grid__left .about-image-grid__placeholder { aspect-ratio: 4 / 3; }
  .about-feature { padding: 48px 24px 64px; }
  .about-feature__inner { grid-template-columns: 1fr; gap: 24px; }
  .about-feature__body-cols { grid-template-columns: 1fr; gap: 16px; }
  .about-story { padding: 0 24px 56px; }
  .about-story__layout { grid-template-columns: 1fr; }
  .about-story__sidebar { position: static; }
  .about-story__caption { grid-template-columns: 1fr; gap: 16px; }
  .about-stats { padding: 32px 24px; }
  .about-stats__inner { grid-template-columns: 1fr; }
  .about-stats__card { min-height: 220px; }
  .about-career { padding: 56px 24px; }
  .about-career__inner { grid-template-columns: 1fr; }
  .about-career__img,
  .about-career__img-placeholder { min-height: 320px; }
  .about-blog { padding: 0 24px 56px; }
  .about-blog__grid { grid-template-columns: 1fr; }
}

@media (min-width: 600px) and (max-width: 960px) {
  .about-blog__grid { grid-template-columns: repeat(2, 1fr); }
  .about-stats__inner { grid-template-columns: repeat(2, 1fr); }
}

{% endstylesheet %}

{% javascript %}
(function () {
  var sectionId = '{{ section.id }}';
  var sidebar = document.getElementById('about-story-sidebar-' + sectionId);
  var imagesContainer = document.getElementById('about-story-images-' + sectionId);

  if (!sidebar || !imagesContainer) return;

  var sidebarItems = sidebar.querySelectorAll('.about-story__sidebar-item');
  var imageBlocks = imagesContainer.querySelectorAll('.about-story__image-block');

  if (!sidebarItems.length || !imageBlocks.length) return;

  function setActive(index) {
    sidebarItems.forEach(function (item, i) {
      if (i === index) {
        item.classList.add('about-story__sidebar-item--active');
      } else {
        item.classList.remove('about-story__sidebar-item--active');
      }
    });
  }

  var observer = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          var idx = parseInt(entry.target.getAttribute('data-story-block'), 10);
          if (!isNaN(idx)) setActive(idx);
        }
      });
    },
    {
      root: null,
      rootMargin: '-30% 0px -60% 0px',
      threshold: 0
    }
  );

  imageBlocks.forEach(function (block) {
    observer.observe(block);
  });
})();
{% endjavascript %}

