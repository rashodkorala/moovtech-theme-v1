{% if cart.item_count == 0 %}
  <div class="moov-cart moov-cart--empty" data-surface="dark">
    <div class="moov-cart__empty-state">
      <p class="moov-cart__eyebrow">{{ 'cart.empty_eyebrow' | t }}</p>
      <h2 class="moov-cart__empty-heading">{{ 'cart.empty_title' | t }}</h2>
      <a href="{{ routes.root_url }}" class="moov-cart__solid-btn">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  </div>
{% else %}
  <div class="moov-cart" data-surface="dark">
    <div class="moov-cart__inner">
      <div class="moov-cart__header">
        <p class="moov-cart__eyebrow">{{ 'cart.bag_eyebrow' | t }}</p>
        <h1 class="moov-cart__title">{{ 'cart.order_heading' | t }}</h1>
      </div>

      <div class="moov-cart__grid">
        <div class="moov-cart__items">
          {% for item in cart.items %}
            <div class="moov-cart__item">
              <a href="{{ item.url }}" class="moov-cart__item-image-link">
                {% if item.image %}
                  {{ item.image | image_url: width: 176, height: 176, crop: 'center' | image_tag: class: 'moov-cart__item-image', loading: 'lazy' }}
                {% else %}
                  <span class="moov-cart__item-image moov-cart__item-image--placeholder" aria-hidden="true"></span>
                {% endif %}
              </a>

              <div class="moov-cart__item-details">
                <a href="{{ item.url }}" class="moov-cart__item-name">{{ item.product.title }}</a>

                {% unless item.variant.title == 'Default Title' %}
                  <p class="moov-cart__item-variant">{{ item.variant.title }}</p>
                {% endunless %}

                <form action="{{ routes.cart_change_url }}" method="post" class="moov-cart__quantity-form">
                  <input type="hidden" name="line" value="{{ forloop.index }}">
                  <div class="moov-cart__quantity-stepper">
                    <button
                      type="submit"
                      name="quantity"
                      value="{{ item.quantity | minus: 1 }}"
                      class="moov-cart__qty-btn"
                      aria-label="{{ 'cart.decrease' | t }}"
                    >
                      &minus;
                    </button>
                    <span class="moov-cart__qty-value">{{ item.quantity }}</span>
                    <button
                      type="submit"
                      name="quantity"
                      value="{{ item.quantity | plus: 1 }}"
                      class="moov-cart__qty-btn"
                      aria-label="{{ 'cart.increase' | t }}"
                    >
                      &plus;
                    </button>
                  </div>
                </form>

                <form action="{{ routes.cart_change_url }}" method="post" class="moov-cart__remove-form">
                  <input type="hidden" name="line" value="{{ forloop.index }}">
                  <input type="hidden" name="quantity" value="0">
                  <button type="submit" class="moov-cart__remove">{{ 'cart.remove' | t }}</button>
                </form>
              </div>

              <div class="moov-cart__item-price">
                {{ item.final_line_price | money }}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="moov-cart__summary">
          <div class="moov-cart__summary-inner">
            <p class="moov-cart__summary-label">{{ 'cart.order_summary' | t }}</p>
            <div class="moov-cart__summary-divider"></div>

            <div class="moov-cart__summary-row">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <div class="moov-cart__summary-row moov-cart__summary-row--shipping">
              <span>{{ 'cart.shipping_label' | t }}</span>
              <span class="moov-cart__shipping-value">{{ 'cart.shipping_value' | t }}</span>
            </div>

            <div class="moov-cart__summary-divider"></div>

            <div class="moov-cart__summary-row moov-cart__summary-row--total">
              <span>{{ 'cart.total' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            {% if section.settings.preorder_ship_date != blank %}
              <p class="moov-cart__preorder-notice">
                {{ 'cart.preorder_ship_html' | t: date: section.settings.preorder_ship_date }}
              </p>
            {% endif %}

            <a href="/checkout" class="moov-cart__solid-btn moov-cart__solid-btn--full">
              {{ 'cart.checkout_proceed' | t }}
            </a>

            <a href="{{ routes.root_url }}" class="moov-cart__ghost-btn">
              {{ 'cart.continue_shopping' | t }}
            </a>

            {% if section.settings.show_cart_trust_line %}
              <p class="moov-cart__protected-line">{{ 'store_marketing.cart_trust_line' | t }}</p>
            {% endif %}
          </div>
        </div>
      </div>

      {% if section.settings.show_trust_strip %}
        <div class="moov-cart__trust-strip">
          <div class="moov-cart__trust-item">
            <span class="moov-cart__trust-label">{{ 'cart.trust_col1_label' | t }}</span>
            <span class="moov-cart__trust-sub">{{ 'cart.trust_col1_sub' | t }}</span>
          </div>
          <div class="moov-cart__trust-item">
            <span class="moov-cart__trust-label">{{ 'cart.trust_col2_label' | t }}</span>
            <span class="moov-cart__trust-sub">{{ 'cart.trust_col2_sub' | t }}</span>
          </div>
          <div class="moov-cart__trust-item">
            <span class="moov-cart__trust-label">{{ 'cart.trust_col3_label' | t }}</span>
            <span class="moov-cart__trust-sub">{{ 'cart.trust_col3_sub' | t }}</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  /* ── Cart base (dark surface) ── */
  .moov-cart {
    width: 100%;
    min-height: 80vh;
    background: var(--moov-black);
    color: var(--moov-text-primary-dark);
  }

  .moov-cart__inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--section-block-pad-y) var(--section-inline-pad) clamp(2.5rem, 5vw, 3.75rem);
  }

  /* ── Header ── */
  .moov-cart__header {
    margin-bottom: 56px;
  }

  .moov-cart__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-text-tertiary-dark);
    margin: 0 0 8px;
  }

  .moov-cart__title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 700;
    color: var(--moov-text-primary-dark);
    margin: 0;
    line-height: 1.1;
  }

  /* ── Empty state ── */
  .moov-cart--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--section-block-pad-y) var(--section-inline-pad);
  }

  .moov-cart__empty-state {
    text-align: center;
  }

  .moov-cart__empty-heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
    margin: 0 0 24px;
  }

  /* ── Grid layout ── */
  .moov-cart__grid {
    display: grid;
    grid-template-columns: 65% 35%;
    gap: 40px;
  }

  /* ── Cart items ── */
  .moov-cart__item {
    display: flex;
    align-items: flex-start;
    padding: 28px 0;
    border-bottom: 0.5px solid var(--moov-border-dark);
    gap: 16px;
  }

  .moov-cart__item:first-child {
    padding-top: 0;
  }

  .moov-cart__item-image-link {
    flex-shrink: 0;
    display: block;
  }

  .moov-cart__item-image {
    width: 88px;
    height: 88px;
    border-radius: 4px;
    object-fit: cover;
    display: block;
  }

  .moov-cart__item-image--placeholder {
    background: var(--moov-surface-dark-elevated);
    border: 0.5px solid var(--moov-border-dark);
  }

  .moov-cart__item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .moov-cart__item-name {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
    text-decoration: none;
  }

  .moov-cart__item-name:hover {
    text-decoration: underline;
  }

  .moov-cart__item-variant {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-secondary-dark);
    margin: 0;
  }

  /* ── Quantity stepper ── */
  .moov-cart__quantity-form {
    margin: 0;
  }

  .moov-cart__quantity-stepper {
    display: inline-flex;
    align-items: center;
    border: 0.5px solid var(--moov-border-dark);
    border-radius: 999px;
    padding: 6px 16px;
    gap: 12px;
  }

  .moov-cart__qty-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
    padding: 0;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease;
  }

  .moov-cart__qty-btn:hover {
    opacity: 0.7;
  }

  .moov-cart__qty-value {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
    min-width: 16px;
    text-align: center;
  }

  /* ── Remove (form-button styled as link) ── */
  .moov-cart__remove-form {
    margin: 0;
  }

  .moov-cart__remove {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--moov-text-tertiary-dark);
    text-decoration: none;
    text-align: left;
  }

  .moov-cart__remove:hover {
    text-decoration: underline;
    color: var(--moov-text-secondary-dark);
  }

  .moov-cart__item-price {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
    flex-shrink: 0;
    text-align: right;
  }

  /* ── Order summary ── */
  .moov-cart__summary {
    position: relative;
  }

  .moov-cart__summary-inner {
    position: sticky;
    top: 100px;
    background: var(--moov-surface-dark-elevated);
    border: 0.5px solid var(--moov-border-dark);
    border-radius: 12px;
    padding: 32px;
  }

  .moov-cart__summary-label {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-text-tertiary-dark);
    margin: 0;
  }

  .moov-cart__summary-divider {
    height: 0;
    border: none;
    border-top: 0.5px solid var(--moov-border-dark);
    margin: 16px 0;
  }

  .moov-cart__summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
    margin-bottom: 12px;
  }

  .moov-cart__summary-row--shipping .moov-cart__shipping-value {
    font-size: var(--text-sm);
    color: var(--moov-text-tertiary-dark);
  }

  .moov-cart__summary-row--total {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    margin-bottom: 0;
  }

  .moov-cart__preorder-notice {
    color: var(--moov-eyebrow-accent);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    text-align: center;
    margin: 16px 0 0;
  }

  /* ── Buttons (inverted for dark surface) ── */
  .moov-cart__solid-btn {
    display: inline-block;
    background: var(--moov-cream);
    color: var(--moov-black);
    border: none;
    border-radius: 999px;
    padding: 14px 28px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .moov-cart__solid-btn:hover {
    opacity: 0.85;
  }

  .moov-cart__solid-btn--full {
    display: block;
    width: 100%;
    padding: 16px 28px;
    margin-top: 20px;
    box-sizing: border-box;
  }

  .moov-cart__ghost-btn {
    display: block;
    width: 100%;
    background: transparent;
    border: 0.5px solid color-mix(in srgb, var(--moov-cream) 25%, transparent);
    border-radius: 999px;
    padding: 16px 28px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.03em;
    color: var(--moov-text-secondary-dark);
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    margin-top: 12px;
    box-sizing: border-box;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .moov-cart__ghost-btn:hover {
    border-color: color-mix(in srgb, var(--moov-cream) 50%, transparent);
    color: var(--moov-text-primary-dark);
  }

  .moov-cart__protected-line {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.5;
    color: var(--moov-text-secondary-dark);
    text-align: center;
    margin: 20px 0 0;
  }

  /* ── Trust strip ── */
  .moov-cart__trust-strip {
    display: flex;
    justify-content: center;
    gap: 64px;
    border-top: 0.5px solid var(--moov-border-dark);
    padding: var(--section-block-pad-y-md) 0;
    margin-top: var(--section-block-pad-y-md);
  }

  .moov-cart__trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
  }

  .moov-cart__trust-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
  }

  .moov-cart__trust-sub {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--moov-text-secondary-dark);
  }

  /* ── Mobile ── */
  @media screen and (max-width: 899px) {
    .moov-cart__inner {
      padding-top: clamp(2rem, 6vw, 2.5rem);
      padding-bottom: clamp(2rem, 6vw, 2.5rem);
    }

    .moov-cart__grid {
      grid-template-columns: 1fr;
    }

    .moov-cart__summary-inner {
      position: static;
    }

    .moov-cart__trust-strip {
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MOOV Cart",
  "settings": [
    {
      "type": "text",
      "id": "preorder_ship_date",
      "label": "Pre-order ship date",
      "default": "March 31, 2026"
    },
    {
      "type": "checkbox",
      "id": "show_cart_trust_line",
      "label": "Show protected order line (summary)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_strip",
      "label": "Show trust strip",
      "default": true
    }
  ]
}
{% endschema %}
