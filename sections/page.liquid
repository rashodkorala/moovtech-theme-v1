{% comment %}
  Default page template — renders any non-policy CMS page (About, Contact, etc.)
  in the themed prose layout. Custom-templated pages (page.our-story.json,
  page.contact.json, etc.) override this with their own bespoke sections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{% render 'page-prose',
  title: page.title,
  body: page.content
%}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
