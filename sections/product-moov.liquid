{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.shop.eyebrow_default' | t
  endif

  assign heading = section.settings.heading | strip
  if heading == blank
    if product != blank
      assign heading = product.title
    else
      assign heading = 'sections.shop.heading_default' | t
    endif
  endif

  assign description = section.settings.description | strip
  if description == blank
    if product != blank
      assign description = product.description | strip_html | strip
    else
      assign description = 'sections.shop.description_default' | t
    endif
  endif

  assign tagline = section.settings.tagline | strip

  assign price = section.settings.price | strip
  assign compare_price = section.settings.compare_price | strip
  if product != blank
    assign current_variant = product.selected_or_first_available_variant
    if price == blank
      assign price = current_variant.price | money
    endif
    if compare_price == blank
      if current_variant.compare_at_price > current_variant.price
        assign compare_price = current_variant.compare_at_price | money
      endif
    endif
  endif

  assign product_available = true
  if product != blank
    assign product_available = product.available
  endif

  assign perk_1       = section.settings.perk_1 | strip
  assign perk_2       = section.settings.perk_2 | strip
  assign perk_3       = section.settings.perk_3 | strip
  assign rating_score = section.settings.rating_score | strip
  assign rating_count = section.settings.rating_count | strip

  assign cta_primary_label  = section.settings.cta_primary_label | strip
  if cta_primary_label == blank
    assign cta_primary_label = 'sections.shop.cta_primary_default' | t
  endif
  assign cta_primary_url = section.settings.cta_primary_url | default: '/products/moov'

  assign cta_secondary_label = section.settings.cta_secondary_label | strip
  if cta_secondary_label == blank
    assign cta_secondary_label = 'sections.shop.cta_secondary_default' | t
  endif
  assign cta_secondary_url = section.settings.cta_secondary_url | default: '/pages/how-it-works'
-%}

{%- comment -%}── 00 BREADCRUMBS ──{%- endcomment -%}
<nav class="shop-crumbs full-width" aria-label="{{ 'general.accessibility.breadcrumb' | t }}" data-surface="dark">
  <div class="shop-crumbs__inner">
    <a href="/" class="shop-crumbs__link">{{ 'general.nav.home' | t }}</a>
    <span class="shop-crumbs__sep" aria-hidden="true">·</span>
    <a href="/collections/all" class="shop-crumbs__link">{{ 'general.nav.shop' | t }}</a>
    <span class="shop-crumbs__sep" aria-hidden="true">·</span>
    <span class="shop-crumbs__current" aria-current="page">{{ product.title | default: heading | escape }}</span>
  </div>
</nav>

{%- comment -%}── 01 SHOP HERO ──{%- endcomment -%}
<section class="shop-hero full-width" data-surface="dark">
  <div class="shop-hero__inner">

    <div class="shop-hero__copy">
      <p class="shop-hero__eyebrow">
        <span class="shop-hero__eyebrow-dot" aria-hidden="true"></span>
        {{ eyebrow | escape }}
      </p>
      <h1 class="shop-hero__heading">{{ heading | escape }}</h1>
      {%- if description != blank -%}
        <p class="shop-hero__description">{{ description | escape }}</p>
      {%- endif -%}
    </div>

    {%- if rating_score != blank or rating_count != blank -%}
      <div class="shop-hero__rating" aria-label="{{ 'sections.shop.rating_aria' | t }}">
        <div class="shop-hero__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10 1.5L12.39 6.26L17.73 7.01L13.87 10.77L14.78 16.09L10 13.5L5.22 16.09L6.13 10.77L2.27 7.01L7.61 6.26L10 1.5Z"/>
            </svg>
          {%- endfor -%}
        </div>
        {%- if rating_score != blank -%}
          <span class="shop-hero__rating-score">{{ rating_score | escape }}</span>
        {%- endif -%}
        {%- if rating_count != blank -%}
          <span class="shop-hero__rating-count">{{ rating_count | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%}── 02 PRODUCT BUY ──{%- endcomment -%}
<section class="shop-buy full-width" data-surface="dark" id="buy">
  <div class="shop-buy__inner">

    <div class="shop-buy__media-col">
      <div class="shop-buy__frame">
        {%- liquid
          assign media_image = section.settings.product_image
          assign media_alt = heading
          if media_image != blank
            assign media_alt = media_image.alt | default: heading
          elsif product != blank and product.featured_image != blank
            assign media_image = product.featured_image
            assign media_alt = product.featured_image.alt | default: heading
          endif
        -%}
        {%- if media_image != blank -%}
          {{
            media_image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              class: 'shop-buy__img',
              alt: media_alt,
              sizes: '(min-width: 900px) 50vw, 100vw',
              widths: '400, 600, 800, 1000, 1200, 1400'
          }}
        {%- else -%}
          <div class="shop-buy__placeholder">
            <span class="shop-buy__placeholder-label">Product photo<br>Upload via theme editor</span>
          </div>
        {%- endif -%}
        {%- if product != blank and product.images.size > 1 -%}
          {%- assign img_total = product.images.size -%}
          {%- if img_total < 10 -%}
            {%- assign img_total_pad = '0' | append: img_total -%}
          {%- else -%}
            {%- assign img_total_pad = img_total | append: '' -%}
          {%- endif -%}
          <span class="shop-buy__counter" aria-hidden="true" id="shop-counter-{{ section.id }}">01 / {{ img_total_pad }}</span>
        {%- endif -%}
      </div>
      {%- if product != blank and product.images.size > 1 -%}
        <div class="shop-buy__thumbnails" role="list" aria-label="{{ 'sections.shop.gallery_label' | t }}">
          {%- for img in product.images limit: 5 -%}
            <button
              type="button"
              class="shop-buy__thumb{% if forloop.first %} shop-buy__thumb--active{% endif %}"
              data-shop-thumb="{{ img | image_url: width: 1400 }}"
              aria-label="{{ img.alt | default: product.title | escape }} {{ forloop.index }}"
              role="listitem"
            >
              {{ img | image_url: width: 120 | image_tag: loading: 'lazy', alt: img.alt | default: product.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="shop-buy__copy-col">

      {%- if eyebrow != blank -%}
        <p class="shop-buy__badge">
          <span class="shop-buy__badge-dot" aria-hidden="true"></span>
          {{ eyebrow | escape }}
        </p>
      {%- endif -%}

      <h2 class="shop-buy__heading">{{ heading | escape }}</h2>

      {%- if tagline != blank -%}
        <p class="shop-buy__tagline"><em>{{ tagline | escape }}</em></p>
      {%- endif -%}

      {%- if price != blank -%}
        <div class="shop-buy__price-row">
          <span class="shop-buy__price">{{ price | escape }}</span>
          {%- if compare_price != blank -%}
            <span class="shop-buy__compare">{{ compare_price | escape }}</span>
          {%- endif -%}
          {%- if product_available and section.settings.show_stock -%}
            <span class="shop-buy__stock">
              <span class="shop-buy__stock-dot" aria-hidden="true"></span>
              {{- 'sections.shop.in_stock' | t -}}
            </span>
          {%- elsif product != blank and product_available == false -%}
            <span class="shop-buy__stock shop-buy__stock--out">
              {{- 'sections.shop.sold_out' | t -}}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if description != blank -%}
        <p class="shop-buy__description">{{ description }}</p>
      {%- endif -%}

      {%- if product != blank -%}
        {%- form 'product', product, class: 'shop-buy__form' -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign outer_idx = forloop.index0 -%}
              {%- assign option_name_lower = option.name | downcase -%}
              {%- assign is_color = false -%}
              {%- assign is_pill = false -%}
              {%- if option_name_lower contains 'finish' or option_name_lower contains 'color' or option_name_lower contains 'colour' -%}
                {%- assign is_color = true -%}
              {%- elsif option_name_lower contains 'mount' or option_name_lower contains 'style' -%}
                {%- assign is_pill = true -%}
              {%- endif -%}

              <div class="shop-buy__opt-group" data-option-index="{{ outer_idx }}">
                <div class="shop-buy__opt-header">
                  <p class="shop-buy__opt-label">{{ option.name | escape }}</p>
                  <span class="shop-buy__opt-value">{{ current_variant.options[outer_idx] | escape | upcase }}</span>
                </div>

                {%- if is_color -%}
                  <div class="shop-buy__swatches" role="group" aria-label="{{ option.name | escape }}">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="shop-buy__swatch{% if value == current_variant.options[outer_idx] %} shop-buy__swatch--active{% endif %}"
                        data-option-index="{{ outer_idx }}"
                        data-option-value="{{ value | escape }}"
                        data-swatch="{{ value | handleize }}"
                        aria-label="{{ value | escape }}"
                        title="{{ value | escape }}"
                      >
                        <span class="shop-buy__swatch-inner"></span>
                      </button>
                    {%- endfor -%}
                  </div>
                {%- elsif is_pill -%}
                  <div class="shop-buy__pills" role="group" aria-label="{{ option.name | escape }}">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="shop-buy__pill{% if value == current_variant.options[outer_idx] %} shop-buy__pill--active{% endif %}"
                        data-option-index="{{ outer_idx }}"
                        data-option-value="{{ value | escape }}"
                      >{{ value | escape }}</button>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="shop-buy__variant-wrap">
                    <select
                      class="shop-buy__variant-select"
                      data-option-index="{{ outer_idx }}"
                      data-option-select
                    >
                      {%- for value in option.values -%}
                        <option
                          value="{{ value | escape }}"
                          {%- if value == current_variant.options[outer_idx] %} selected{%- endif -%}
                        >{{ value | escape }}</option>
                      {%- endfor -%}
                    </select>
                    <svg class="shop-buy__variant-caret" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="2,5 7,10 12,5"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}

            <input type="hidden" name="id" id="shop-variant-id-{{ section.id }}" value="{{ current_variant.id }}">
            <script type="application/json" id="shop-variants-{{ section.id }}">
              {{ product.variants | json }}
            </script>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endunless -%}

          <div class="shop-buy__qty-row">
            <label class="shop-buy__qty-label" for="shop-qty-{{ section.id }}">{{ 'sections.shop.quantity_label' | t }}</label>
            <div class="shop-buy__qty-stepper">
              <button type="button" class="shop-buy__qty-btn" aria-label="{{ 'sections.shop.quantity_decrease' | t }}" data-qty-dec>−</button>
              <input
                type="number"
                id="shop-qty-{{ section.id }}"
                name="quantity"
                value="1"
                min="1"
                class="shop-buy__qty-input"
                aria-label="{{ 'sections.shop.quantity_label' | t }}"
              >
              <button type="button" class="shop-buy__qty-btn" aria-label="{{ 'sections.shop.quantity_increase' | t }}" data-qty-inc>+</button>
            </div>
          </div>

          <div class="shop-buy__cta-group">
            <button
              type="submit"
              name="add"
              class="shop-buy__cta shop-buy__cta--primary"
              data-cta-label="{{ cta_primary_label | escape }}"
              {%- unless current_variant.available %} disabled aria-disabled="true"{% endunless %}
            >
              <span class="shop-buy__btn-label">
                {%- if current_variant.available -%}
                  {{- cta_primary_label | escape -}} — {{ current_variant.price | money }}
                {%- else -%}
                  {{- 'sections.shop.sold_out' | t -}}
                {%- endif -%}
              </span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="2.5" y1="11.5" x2="11" y2="3"/>
                <polyline points="5,3 11,3 11,9"/>
              </svg>
            </button>
            <a href="{{ cta_secondary_url }}" class="shop-buy__cta shop-buy__cta--ghost">
              {{- cta_secondary_label | escape -}}
            </a>
          </div>
          {%- assign reservation_note = section.settings.reservation_note | strip -%}
          {%- if reservation_note != blank -%}
            <p class="shop-buy__reservation">{{ reservation_note | escape }}</p>
          {%- endif -%}
        {%- endform -%}
      {%- else -%}
        <div class="shop-buy__cta-group">
          <a href="{{ cta_primary_url }}" class="shop-buy__cta shop-buy__cta--primary">
            {{- cta_primary_label | escape -}}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="2.5" y1="11.5" x2="11" y2="3"/>
              <polyline points="5,3 11,3 11,9"/>
            </svg>
          </a>
          <a href="{{ cta_secondary_url }}" class="shop-buy__cta shop-buy__cta--ghost">
            {{- cta_secondary_label | escape -}}
          </a>
        </div>
      {%- endif -%}

      {%- if perk_1 != blank or perk_2 != blank or perk_3 != blank -%}
        <ul class="shop-buy__perks" role="list">
          {%- if perk_1 != blank -%}
            <li class="shop-buy__perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="7" width="14" height="10" rx="1"/><path d="M16 10h4l2 2.5L20 15h-4"/><circle cx="6" cy="19" r="1.5"/><circle cx="16" cy="19" r="1.5"/>
              </svg>
              {{ perk_1 | escape }}
            </li>
          {%- endif -%}
          {%- if perk_2 != blank -%}
            <li class="shop-buy__perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/><polyline points="12,7 12,12 15,14"/>
              </svg>
              {{ perk_2 | escape }}
            </li>
          {%- endif -%}
          {%- if perk_3 != blank -%}
            <li class="shop-buy__perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l8 3v6c0 4.5-3.4 8.4-8 9-4.6-.6-8-4.5-8-9V6z"/>
              </svg>
              {{ perk_3 | escape }}
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

    </div>

  </div>
</section>

{%- comment -%}── 03 HOW IT WORKS ──{%- endcomment -%}
<section class="shop-hiw full-width" data-surface="dark">
  <div class="shop-hiw__inner">

    <p class="shop-hiw__eyebrow">{{ 'sections.shop.hiw_eyebrow' | t }}</p>

    <div class="shop-hiw__steps">
      {%- for i in (1..3) -%}
        {%- assign _kt = 'hiw_step_' | append: i | append: '_title' -%}
        {%- assign _kb = 'hiw_step_' | append: i | append: '_body' -%}
        {%- assign step_title = section.settings[_kt] | strip -%}
        {%- assign step_body  = section.settings[_kb] | strip -%}
        {%- if step_title == blank -%}{%- assign step_title = 'sections.shop.' | append: _kt | t -%}{%- endif -%}
        {%- if step_body  == blank -%}{%- assign step_body  = 'sections.shop.' | append: _kb | t -%}{%- endif -%}
        <div class="shop-hiw__step">
          <span class="shop-hiw__num">0{{ i }}</span>
          <h4 class="shop-hiw__title">{{ step_title | escape }}</h4>
          <p class="shop-hiw__body">{{ step_body | escape }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.hiw_url != blank -%}
      <a href="{{ section.settings.hiw_url }}" class="shop-hiw__link">
        {{ 'sections.shop.hiw_link' | t }}
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="1" y1="6" x2="10" y2="6"/><polyline points="6.5,2.5 10,6 6.5,9.5"/>
        </svg>
      </a>
    {%- endif -%}

  </div>
</section>

{%- comment -%}── 04 FOUNDER DROP ──{%- endcomment -%}
{%- assign founder_img = section.settings.founder_image -%}
<section class="shop-founder full-width" data-surface="cream">
  <div class="shop-founder__inner">

    <div class="shop-founder__copy">
      <p class="shop-founder__limit">{{ 'sections.shop.founder_limit_badge' | t }}</p>
      <p class="shop-founder__eyebrow">{{ 'sections.shop.founder_eyebrow' | t }}</p>
      <h2 class="shop-founder__heading">{{ 'sections.shop.founder_heading' | t }}</h2>
      <p class="shop-founder__body">{{ 'sections.shop.founder_body' | t }}</p>
    </div>

    <div class="shop-founder__media">
      {%- if founder_img != blank -%}
        {{ founder_img | image_url: width: 900 | image_tag: loading: 'lazy', class: 'shop-founder__img', alt: 'MOOV Founder Drop' }}
      {%- else -%}
        <div class="shop-founder__placeholder"></div>
      {%- endif -%}
    </div>

  </div>
</section>

{%- comment -%}── 05 SPECS ──{%- endcomment -%}
{%- assign specs_eyebrow = section.settings.specs_eyebrow | strip -%}
{%- assign specs_heading = section.settings.specs_heading | strip -%}
<section class="shop-specs full-width" data-surface="dark" id="specs-{{ section.id }}">
  <div class="shop-specs__inner">

    <div class="shop-specs__lead">
      {%- if specs_eyebrow != blank -%}
        <p class="shop-specs__eyebrow">{{ specs_eyebrow | escape }}</p>
      {%- endif -%}
      {%- if specs_heading != blank -%}
        <h2 class="shop-specs__heading">{{ specs_heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- comment -%} Build active spec list first to know tab count {%- endcomment -%}
    {%- assign first_tab = true -%}
    <div class="shop-specs__tabs" data-specs-tabs>

      <div class="shop-specs__tab-bar" role="tablist" aria-label="{{ specs_heading | escape }}">
        {%- for i in (1..9) -%}
          {%- assign dt_key = 'spec_' | append: i | append: '_dt' -%}
          {%- assign spec_dt = section.settings[dt_key] | strip -%}
          {%- if spec_dt != blank -%}
            <button
              class="shop-specs__tab{%- if first_tab %} shop-specs__tab--active{%- endif -%}"
              role="tab"
              aria-selected="{%- if first_tab -%}true{%- else -%}false{%- endif -%}"
              aria-controls="spec-panel-{{ section.id }}-{{ i }}"
              data-spec-tab="{{ i }}"
            >{{ spec_dt | escape }}</button>
            {%- assign first_tab = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="shop-specs__panels">
        {%- assign first_panel = true -%}
        {%- for i in (1..9) -%}
          {%- assign dt_key = 'spec_' | append: i | append: '_dt' -%}
          {%- assign dd_key = 'spec_' | append: i | append: '_dd' -%}
          {%- assign spec_dt = section.settings[dt_key] | strip -%}
          {%- assign spec_dd = section.settings[dd_key] | strip -%}
          {%- if spec_dt != blank -%}
            <div
              class="shop-specs__panel{%- if first_panel %} shop-specs__panel--active{%- endif -%}"
              role="tabpanel"
              id="spec-panel-{{ section.id }}-{{ i }}"
              data-spec-panel="{{ i }}"
              {%- unless first_panel %} hidden{%- endunless %}
            >
              {%- if spec_dd != blank -%}
                {%- assign lines = spec_dd | split: "\n" -%}
                <ul class="shop-specs__lines" role="list">
                  {%- for line in lines -%}
                    {%- assign trimmed = line | strip -%}
                    {%- if trimmed != blank -%}
                      <li class="shop-specs__line">{{ trimmed | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
            {%- assign first_panel = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>

  </div>
</section>

{%- comment -%}── 06 CORE BENEFITS ──{%- endcomment -%}
<section class="shop-features full-width" data-surface="dark">
  <div class="shop-features__inner">

    <div class="shop-features__head">
      <p class="shop-features__eyebrow">{{ 'sections.shop.features_eyebrow' | t }}</p>
      <h2 class="shop-features__heading">{{ 'sections.shop.features_heading' | t }}</h2>
    </div>

    <div class="shop-features__grid">
      <article class="shop-feature">
        <span class="shop-feature__num">01</span>
        <h4 class="shop-feature__title">{{ 'sections.shop.feature_1_title' | t }}</h4>
        <p class="shop-feature__body">{{ 'sections.shop.feature_1_body' | t }}</p>
      </article>
      <article class="shop-feature">
        <span class="shop-feature__num">02</span>
        <h4 class="shop-feature__title">{{ 'sections.shop.feature_2_title' | t }}</h4>
        <p class="shop-feature__body">{{ 'sections.shop.feature_2_body' | t }}</p>
      </article>
      <article class="shop-feature">
        <span class="shop-feature__num">03</span>
        <h4 class="shop-feature__title">{{ 'sections.shop.feature_3_title' | t }}</h4>
        <p class="shop-feature__body">{{ 'sections.shop.feature_3_body' | t }}</p>
      </article>
    </div>

  </div>
</section>


{%- comment -%}── 07 CLOSING CTA ──{%- endcomment -%}
<section class="shop-cta full-width" data-surface="dark">
  <div class="shop-cta__inner">
    <p class="shop-cta__eyebrow">{{ 'sections.shop.cta_eyebrow' | t }}</p>
    <h2 class="shop-cta__heading">{{ 'sections.shop.cta_heading' | t }}</h2>
    <p class="shop-cta__sub">{{ 'sections.shop.cta_sub' | t }}</p>
    <div class="shop-cta__btns">
      <a href="{{ cta_primary_url }}" class="shop-cta__btn shop-cta__btn--primary">
        {{- cta_primary_label | escape -}}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="2" y1="7" x2="11" y2="7"/>
          <polyline points="7,3.5 11,7 7,10.5"/>
        </svg>
      </a>
      <a href="{{ cta_secondary_url }}" class="shop-cta__btn shop-cta__btn--ghost">
        {{- cta_secondary_label | escape -}}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}

  /* ── Shared inner ── */
  .shop-crumbs__inner,
  .shop-hero__inner,
  .shop-buy__inner,
  .shop-hiw__inner,
  .shop-founder__inner,
  .shop-specs__inner,
  .shop-features__inner,
  .shop-cta__inner {
    width: 100%;
    max-width: var(--layout-max-width);
    margin-inline: auto;
  }

  /* ══════════════════════════════════════════
     00 BREADCRUMBS
  ══════════════════════════════════════════ */
  .shop-crumbs {
    background: var(--moov-black);
    padding-top: var(--header-height, 72px);
    border-bottom: 1px solid var(--moov-border-dark);
  }

  .shop-crumbs__inner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-block: 14px;
    padding-inline: var(--section-inline-pad);
  }

  .shop-crumbs__link {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .shop-crumbs__link:hover {
    color: var(--moov-cream);
  }

  .shop-crumbs__sep {
    font-size: var(--text-2xs);
    color: var(--moov-border-dark);
    user-select: none;
  }

  .shop-crumbs__current {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--moov-cream);
  }

  /* ══════════════════════════════════════════
     01 SHOP HERO
  ══════════════════════════════════════════ */
  .shop-hero {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: clamp(2.5rem, 5vw, 4.5rem) var(--section-inline-pad) clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--moov-border-dark);
  }

  .shop-hero__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 56px);
    flex-wrap: wrap;
  }

  .shop-hero__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shop-hero__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-amber);
  }

  .shop-hero__eyebrow-dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--moov-amber);
    box-shadow: 0 0 10px color-mix(in srgb, var(--moov-amber) 65%, transparent);
    animation: shop-hero-pulse 2.4s ease-in-out infinite;
  }

  @keyframes shop-hero-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.25); opacity: 0.75; }
  }

  .shop-hero__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-cream);
  }

  .shop-hero__description {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--moov-text-secondary-dark);
    max-width: 44ch;
  }

  .shop-hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    padding: 10px 18px;
    border: 1px solid var(--moov-border-dark);
    border-radius: 999px;
    background: color-mix(in srgb, var(--moov-cream) 4%, transparent);
  }

  .shop-hero__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--moov-amber);
  }

  .shop-hero__rating-score {
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-sm);
    letter-spacing: -0.01em;
    color: var(--moov-cream);
  }

  .shop-hero__rating-count {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--moov-text-tertiary-dark);
  }

  @media (max-width: 680px) {
    .shop-hero__inner { flex-direction: column; align-items: flex-start; }
  }

  /* ══════════════════════════════════════════
     02 PRODUCT BUY
  ══════════════════════════════════════════ */
  .shop-buy {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: var(--section-block-pad-y-md) var(--section-inline-pad);
  }

  .shop-buy__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .shop-buy__media-col {
    position: sticky;
    top: calc(var(--header-height, 72px) + 24px);
  }

  .shop-buy__frame {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card, 16px);
    overflow: hidden;
    background: var(--moov-surface-dark-elevated);
    border: 1px solid var(--moov-border-dark);
  }

  .shop-buy__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.15) brightness(0.92) contrast(1.04);
  }

  .shop-buy__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--moov-cream) 5%, var(--moov-black));
    border: 1px dashed color-mix(in srgb, var(--moov-cream) 20%, transparent);
    border-radius: var(--radius-card, 16px);
    min-height: 480px;
  }

  .shop-buy__placeholder-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--moov-cream) 30%, transparent);
    text-align: center;
    line-height: 1.8;
  }

  /* Image counter */
  .shop-buy__counter {
    position: absolute;
    bottom: 14px;
    right: 16px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--moov-cream) 70%, transparent);
    background: color-mix(in srgb, var(--moov-black) 55%, transparent);
    padding: 4px 10px;
    border-radius: 999px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    pointer-events: none;
    user-select: none;
  }

  .shop-buy__copy-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 8px;
  }

  .shop-buy__badge {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-amber);
  }

  .shop-buy__badge-dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moov-amber);
    box-shadow: 0 0 8px color-mix(in srgb, var(--moov-amber) 65%, transparent);
  }

  .shop-buy__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-cream);
    text-wrap: balance;
  }

  /* Tagline */
  .shop-buy__tagline {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--moov-text-secondary-dark);
  }

  .shop-buy__tagline em {
    font-style: italic;
  }

  .shop-buy__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px 16px;
  }

  .shop-buy__price {
    font-family: var(--font-hero);
    font-size: var(--text-heading-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--moov-cream);
  }

  .shop-buy__compare {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--moov-text-tertiary-dark);
    text-decoration: line-through;
  }

  .shop-buy__stock {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-success);
    background: var(--moov-success-bg);
    padding: 4px 12px;
    border-radius: 999px;
  }

  .shop-buy__stock-dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moov-success);
  }

  .shop-buy__description {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--moov-text-secondary-dark);
    max-width: 44ch;
  }

  /* Option groups */
  .shop-buy__opt-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .shop-buy__opt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .shop-buy__opt-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
  }

  .shop-buy__opt-value {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-cream);
  }

  /* Swatches */
  .shop-buy__swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .shop-buy__swatch {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid transparent;
    padding: 3px;
    cursor: pointer;
    background: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .shop-buy__swatch:hover {
    border-color: color-mix(in srgb, var(--moov-cream) 45%, transparent);
    transform: scale(1.08);
  }

  .shop-buy__swatch--active {
    border-color: var(--moov-cream);
  }

  .shop-buy__swatch-inner {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--moov-text-tertiary-dark);
  }

  /* Known swatch colors */
  .shop-buy__swatch[data-swatch="cream"] .shop-buy__swatch-inner { background: #f5f0e8; }
  .shop-buy__swatch[data-swatch="off-white"] .shop-buy__swatch-inner { background: #ede8df; }
  .shop-buy__swatch[data-swatch="charcoal"] .shop-buy__swatch-inner { background: #2e2e2e; }
  .shop-buy__swatch[data-swatch="black"] .shop-buy__swatch-inner { background: #0d0d0d; }
  .shop-buy__swatch[data-swatch="white"] .shop-buy__swatch-inner { background: #ffffff; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.15); }
  .shop-buy__swatch[data-swatch="slate"] .shop-buy__swatch-inner { background: #4a5568; }
  .shop-buy__swatch[data-swatch="sand"] .shop-buy__swatch-inner { background: #c8b89a; }
  .shop-buy__swatch[data-swatch="brass"] .shop-buy__swatch-inner { background: #b5963e; }

  /* Pills */
  .shop-buy__pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .shop-buy__pill {
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--moov-border-dark);
    background: transparent;
    color: var(--moov-text-secondary-dark);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .shop-buy__pill:hover {
    border-color: color-mix(in srgb, var(--moov-cream) 45%, transparent);
    color: var(--moov-cream);
  }

  .shop-buy__pill--active {
    border-color: var(--moov-cream);
    color: var(--moov-cream);
    background: color-mix(in srgb, var(--moov-cream) 8%, transparent);
  }

  /* Variant select (fallback) */
  .shop-buy__variants {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .shop-buy__variant-label {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
  }

  .shop-buy__variant-wrap {
    position: relative;
  }

  .shop-buy__variant-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    padding: 13px 42px 13px 16px;
    border: 1px solid var(--moov-border-dark);
    border-radius: 10px;
    background: color-mix(in srgb, var(--moov-cream) 4%, transparent);
    color: var(--moov-cream);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .shop-buy__variant-select:focus {
    outline: 2px solid var(--moov-amber);
    outline-offset: 2px;
    border-color: var(--moov-amber);
  }

  .shop-buy__variant-caret {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--moov-text-tertiary-dark);
    pointer-events: none;
  }

  /* Quantity stepper */
  .shop-buy__qty-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .shop-buy__qty-label {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
    white-space: nowrap;
  }

  .shop-buy__qty-stepper {
    display: flex;
    align-items: center;
    border: 1px solid var(--moov-border-dark);
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, var(--moov-cream) 4%, transparent);
  }

  .shop-buy__qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    color: var(--moov-cream);
    font-size: 18px;
    cursor: pointer;
    transition: background 0.15s ease;
    flex-shrink: 0;
  }

  .shop-buy__qty-btn:hover {
    background: color-mix(in srgb, var(--moov-cream) 8%, transparent);
  }

  .shop-buy__qty-input {
    width: 44px;
    text-align: center;
    background: none;
    border: none;
    border-left: 1px solid var(--moov-border-dark);
    border-right: 1px solid var(--moov-border-dark);
    color: var(--moov-cream);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: 0;
    height: 40px;
    -moz-appearance: textfield;
  }

  .shop-buy__qty-input::-webkit-inner-spin-button,
  .shop-buy__qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }

  /* CTA group */
  .shop-buy__cta-group {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .shop-buy__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: clamp(13px, 1.2vw, 16px) clamp(24px, 2.6vw, 36px);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .shop-buy__cta--primary {
    background: var(--moov-cream);
    color: var(--moov-black);
    border: 1px solid var(--moov-cream);
  }

  .shop-buy__cta--primary:hover {
    background: var(--moov-amber);
    border-color: var(--moov-amber);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--moov-amber) 30%, transparent);
  }

  .shop-buy__cta--ghost {
    background: transparent;
    color: var(--moov-text-secondary-dark);
    border: 1px solid var(--moov-border-dark);
  }

  .shop-buy__cta--ghost:hover {
    background: color-mix(in srgb, var(--moov-cream) 8%, transparent);
    border-color: color-mix(in srgb, var(--moov-cream) 35%, transparent);
    color: var(--moov-cream);
    transform: translateY(-1px);
  }

  /* Form: display:contents so flex/grid layout is unaffected */
  .shop-buy__form { display: contents; }

  /* Sold out / disabled */
  .shop-buy__cta[disabled],
  .shop-buy__cta[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .shop-buy__stock--out {
    color: var(--moov-text-tertiary-dark);
    background: color-mix(in srgb, var(--moov-cream) 6%, transparent);
    border: 1px solid var(--moov-border-dark);
    padding: 4px 12px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Perks */
  .shop-buy__perks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
    border-top: 1px solid var(--moov-border-dark);
  }

  .shop-buy__perk {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--moov-text-secondary-dark);
    padding-top: 10px;
  }

  .shop-buy__perk:first-child { padding-top: 14px; }

  .shop-buy__perk svg {
    flex-shrink: 0;
    color: var(--moov-amber);
  }

  /* Thumbnails */
  .shop-buy__thumbnails {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .shop-buy__thumb {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--moov-border-dark);
    background: var(--moov-surface-dark-elevated);
    cursor: pointer;
    padding: 0;
    transition: border-color 0.15s ease;
    flex-shrink: 0;
  }

  .shop-buy__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shop-buy__thumb--active {
    border-color: var(--moov-cream);
  }

  .shop-buy__thumb:hover {
    border-color: color-mix(in srgb, var(--moov-cream) 55%, transparent);
  }

  @media (max-width: 860px) {
    .shop-buy__inner { grid-template-columns: 1fr; }
    .shop-buy__media-col { position: static; }
    .shop-buy__frame { aspect-ratio: 4 / 3; }
  }

  /* ══════════════════════════════════════════
     05 SPECS (dark, tabbed)
  ══════════════════════════════════════════ */
  .shop-specs {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: var(--section-block-pad-y-lg) var(--section-inline-pad);
    border-top: 1px solid var(--moov-border-dark);
  }

  .shop-specs__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
  }

  .shop-specs__lead {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .shop-specs__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-amber);
  }

  .shop-specs__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-cream);
    max-width: 22ch;
    text-wrap: balance;
  }

  /* Tab bar */
  .shop-specs__tab-bar {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--moov-border-dark);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .shop-specs__tab-bar::-webkit-scrollbar { display: none; }

  .shop-specs__tab {
    flex-shrink: 0;
    padding: 12px 20px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
