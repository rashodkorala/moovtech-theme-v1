{% javascript %}
  (function () {

    /* ── Money formatter ── */
    function formatMoney(cents) {
      if (window.Shopify && window.Shopify.formatMoney) {
        return window.Shopify.formatMoney(cents);
      }
      var dollars = (cents / 100).toFixed(2).replace(/\.00$/, '');
      return '$' + dollars;
    }

    /* ── Get variants JSON from form ── */
    function getVariants(form) {
      var el = form.querySelector('[id^="shop-variants-"]');
      if (!el) return null;
      try { return JSON.parse(el.textContent); } catch (e) { return null; }
    }

    /* ── Read currently selected option values from all opt groups ── */
    function getCurrentSelections(form) {
      var selections = [];
      form.querySelectorAll('.shop-buy__opt-group').forEach(function (grp) {
        var activeBtn = grp.querySelector('.shop-buy__swatch--active, .shop-buy__pill--active');
        if (activeBtn) {
          selections.push(activeBtn.dataset.optionValue);
        } else {
          var sel = grp.querySelector('[data-option-select]');
          selections.push(sel ? sel.value : null);
        }
      });
      return selections;
    }

    /* ── Find matching variant ── */
    function findVariant(variants, selections) {
      return variants.find(function (v) {
        return selections.every(function (val, i) {
          return val === null || v.options[i] === val;
        });
      });
    }

    /* ── Update the selected-value label next to option name ── */
    function updateOptValue(group, value) {
      var el = group.querySelector('.shop-buy__opt-value');
      if (el) el.textContent = value ? value.toUpperCase() : '';
    }

    /* ── Update price, button label, availability ── */
    function updateBuybox(form, variant, qty) {
      if (!variant) return;
      qty = qty || parseInt((form.querySelector('.shop-buy__qty-input') || {}).value, 10) || 1;

      var copyCol = form.closest('.shop-buy__copy-col');
      var priceEl = copyCol && copyCol.querySelector('.shop-buy__price');
      if (priceEl) priceEl.textContent = formatMoney(variant.price);

      var hiddenId = form.querySelector('input[name="id"]');
      if (hiddenId) hiddenId.value = variant.id;

      var submitBtn = form.querySelector('[name="add"]');
      var textSpan = submitBtn && submitBtn.querySelector('.shop-buy__btn-label');
      if (submitBtn) {
        submitBtn.disabled = !variant.available;
        submitBtn.setAttribute('aria-disabled', String(!variant.available));
      }
      if (textSpan) {
        textSpan.textContent = variant.available
          ? (submitBtn.dataset.ctaLabel || '') + ' \u2014 ' + formatMoney(variant.price * qty)
          : 'Sold out';
      }
    }

    /* ── Thumbnail gallery + image counter ── */
    document.querySelectorAll('.shop-buy__thumbnails').forEach(function (rail) {
      var mediaCol = rail.closest('.shop-buy__media-col');
      var frame = mediaCol && mediaCol.querySelector('.shop-buy__frame');
      var mainImg = frame && frame.querySelector('.shop-buy__img');
      var counter = mediaCol && mediaCol.querySelector('.shop-buy__counter');
      var thumbs = Array.prototype.slice.call(rail.querySelectorAll('.shop-buy__thumb'));
      var total = thumbs.length;

      if (!mainImg) return;

      thumbs.forEach(function (btn, idx) {
        btn.addEventListener('click', function () {
          mainImg.src = btn.dataset.shopThumb;
          thumbs.forEach(function (b) {
            b.classList.toggle('shop-buy__thumb--active', b === btn);
          });
          if (counter) {
            var n = idx + 1;
            counter.textContent =
              (n < 10 ? '0' + n : String(n)) + ' / ' +
              (total < 10 ? '0' + total : String(total));
          }
        });
      });
    });

    /* ── Swatch clicks ── */
    document.querySelectorAll('.shop-buy__swatch').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var form = btn.closest('form');
        if (!form) return;
        var variants = getVariants(form);
        if (!variants) return;

        var grp = btn.closest('.shop-buy__swatches');
        if (grp) {
          grp.querySelectorAll('.shop-buy__swatch').forEach(function (b) {
            b.classList.remove('shop-buy__swatch--active');
          });
          btn.classList.add('shop-buy__swatch--active');
        }

        var optIdx = parseInt(btn.dataset.optionIndex, 10);
        updateOptValue(btn.closest('.shop-buy__opt-group'), btn.dataset.optionValue);
        var selections = getCurrentSelections(form);
        selections[optIdx] = btn.dataset.optionValue;
        updateBuybox(form, findVariant(variants, selections));
      });
    });

    /* ── Pill clicks ── */
    document.querySelectorAll('.shop-buy__pill').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var form = btn.closest('form');
        if (!form) return;
        var variants = getVariants(form);
        if (!variants) return;

        var grp = btn.closest('.shop-buy__pills');
        if (grp) {
          grp.querySelectorAll('.shop-buy__pill').forEach(function (b) {
            b.classList.remove('shop-buy__pill--active');
          });
          btn.classList.add('shop-buy__pill--active');
        }

        var optIdx = parseInt(btn.dataset.optionIndex, 10);
        updateOptValue(btn.closest('.shop-buy__opt-group'), btn.dataset.optionValue);
        var selections = getCurrentSelections(form);
        selections[optIdx] = btn.dataset.optionValue;
        updateBuybox(form, findVariant(variants, selections));
      });
    });

    /* ── Fallback select change ── */
    document.querySelectorAll('[data-option-select]').forEach(function (sel) {
      sel.addEventListener('change', function () {
        var form = sel.closest('form');
        if (!form) return;
        var variants = getVariants(form);
        if (!variants) return;
        updateOptValue(sel.closest('.shop-buy__opt-group'), sel.value);
        updateBuybox(form, findVariant(variants, getCurrentSelections(form)));
      });
    });

    /* ── Quantity stepper + live price update ── */
    document.querySelectorAll('.shop-buy__qty-stepper').forEach(function (stepper) {
      var input = stepper.querySelector('.shop-buy__qty-input');

      function onQtyChange(newQty) {
        var form = stepper.closest('form');
        if (!form) return;
        var variants = getVariants(form);
        if (!variants) return;
        var hiddenId = form.querySelector('input[name="id"]');
        if (!hiddenId) return;
        var variant = variants.find(function (v) { return String(v.id) === String(hiddenId.value); });
        if (!variant) return;
        updateBuybox(form, variant, newQty);
      }

      stepper.querySelector('[data-qty-dec]').addEventListener('click', function () {
        var v = parseInt(input.value, 10) || 1;
        if (v > 1) { input.value = v - 1; onQtyChange(v - 1); }
      });
      stepper.querySelector('[data-qty-inc]').addEventListener('click', function () {
        var v = parseInt(input.value, 10) || 1;
        input.value = v + 1;
        onQtyChange(v + 1);
      });
    });

    /* ── Specs tab switching ── */
    document.querySelectorAll('[data-specs-tabs]').forEach(function (container) {
      var tabs = Array.prototype.slice.call(container.querySelectorAll('.shop-specs__tab'));
      var panels = Array.prototype.slice.call(container.querySelectorAll('.shop-specs__panel'));

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var idx = tab.dataset.specTab;

          tabs.forEach(function (t) {
            t.classList.remove('shop-specs__tab--active');
            t.setAttribute('aria-selected', 'false');
          });
          panels.forEach(function (p) {
            p.classList.remove('shop-specs__panel--active');
            p.hidden = true;
          });

          tab.classList.add('shop-specs__tab--active');
          tab.setAttribute('aria-selected', 'true');

          var target = container.querySelector('[data-spec-panel="' + idx + '"]');
          if (target) {
            target.classList.add('shop-specs__panel--active');
            target.hidden = false;
          }
        });
      });
    });

  })();
{% endjavascript %}

