{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.shop.eyebrow_default' | t
  endif

  assign heading = section.settings.heading | strip
  if heading == blank
    if product != blank
      assign heading = product.title
    else
      assign heading = 'sections.shop.heading_default' | t
    endif
  endif

  assign description = section.settings.description | strip
  if description == blank
    if product != blank
      assign description = product.description | strip_html | strip
    else
      assign description = 'sections.shop.description_default' | t
    endif
  endif

  assign tagline = section.settings.tagline | strip

  assign price = section.settings.price | strip
  assign compare_price = section.settings.compare_price | strip
  if product != blank
    assign current_variant = product.selected_or_first_available_variant
    if price == blank
      assign price = current_variant.price | money
    endif
    if compare_price == blank
      if current_variant.compare_at_price > current_variant.price
        assign compare_price = current_variant.compare_at_price | money
      endif
    endif
  endif

  assign product_available = true
  if product != blank
    assign product_available = product.available
  endif

  assign perk_1       = section.settings.perk_1 | strip
  assign perk_2       = section.settings.perk_2 | strip
  assign perk_3       = section.settings.perk_3 | strip
  assign rating_score = section.settings.rating_score | strip
  assign rating_count = section.settings.rating_count | strip

  assign cta_primary_label  = section.settings.cta_primary_label | strip
  if cta_primary_label == blank
    assign cta_primary_label = 'sections.shop.cta_primary_default' | t
  endif
  assign cta_primary_url = section.settings.cta_primary_url | default: '/products/moov'

  assign cta_secondary_label = section.settings.cta_secondary_label | strip
  if cta_secondary_label == blank
    assign cta_secondary_label = 'sections.shop.cta_secondary_default' | t
  endif
  assign cta_secondary_url = section.settings.cta_secondary_url | default: '/pages/how-it-works'
-%}

{%- comment -%}── 00 BREADCRUMBS ──{%- endcomment -%}
<nav class="shop-crumbs full-width" aria-label="{{ 'general.accessibility.breadcrumb' | t }}" data-surface="dark">
  <div class="shop-crumbs__inner">
    <a href="/" class="shop-crumbs__link">{{ 'general.nav.home' | t }}</a>
    <span class="shop-crumbs__sep" aria-hidden="true">·</span>
    <a href="/collections/all" class="shop-crumbs__link">{{ 'general.nav.shop' | t }}</a>
    <span class="shop-crumbs__sep" aria-hidden="true">·</span>
    <span class="shop-crumbs__current" aria-current="page">{{ product.title | default: heading | escape }}</span>
  </div>
</nav>

{%- comment -%}── 01 SHOP HERO ──{%- endcomment -%}
<section class="shop-hero full-width" data-surface="dark">
  <div class="shop-hero__inner">

    <div class="shop-hero__copy">
      <p class="shop-hero__eyebrow">
        <span class="shop-hero__eyebrow-dot" aria-hidden="true"></span>
        {{ eyebrow | escape }}
      </p>
      <h1 class="shop-hero__heading">{{ heading | escape }}</h1>
      {%- if description != blank -%}
        <p class="shop-hero__description">{{ description | escape }}</p>
      {%- endif -%}
    </div>

    {%- if rating_score != blank or rating_count != blank -%}
      <div class="shop-hero__rating" aria-label="{{ 'sections.shop.rating_aria' | t }}">
        <div class="shop-hero__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10 1.5L12.39 6.26L17.73 7.01L13.87 10.77L14.78 16.09L10 13.5L5.22 16.09L6.13 10.77L2.27 7.01L7.61 6.26L10 1.5Z"/>
            </svg>
          {%- endfor -%}
        </div>
        {%- if rating_score != blank -%}
          <span class="shop-hero__rating-score">{{ rating_score | escape }}</span>
        {%- endif -%}
        {%- if rating_count != blank -%}
          <span class="shop-hero__rating-count">{{ rating_count | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%}── 02 PRODUCT BUY ──{%- endcomment -%}
<section class="shop-buy full-width" data-surface="dark" id="buy">
  <div class="shop-buy__inner">

    <div class="shop-buy__media-col">
      <div class="shop-buy__frame">
        {%- liquid
          assign media_image = section.settings.product_image
          assign media_alt = heading
          if media_image != blank
            assign media_alt = media_image.alt | default: heading
          elsif product != blank and product.featured_image != blank
            assign media_image = product.featured_image
            assign media_alt = product.featured_image.alt | default: heading
          endif
        -%}
        {%- if media_image != blank -%}
          {{
            media_image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              class: 'shop-buy__img',
              alt: media_alt,
              sizes: '(min-width: 900px) 50vw, 100vw',
              widths: '400, 600, 800, 1000, 1200, 1400'
          }}
        {%- else -%}
          <div class="shop-buy__placeholder">
            <span class="shop-buy__placeholder-label">Product photo<br>Upload via theme editor</span>
          </div>
        {%- endif -%}
        {%- if product != blank and product.images.size > 1 -%}
          {%- assign img_total = product.images.size -%}
          {%- if img_total < 10 -%}
            {%- assign img_total_pad = '0' | append: img_total -%}
          {%- else -%}
            {%- assign img_total_pad = img_total | append: '' -%}
          {%- endif -%}
          <span class="shop-buy__counter" aria-hidden="true" id="shop-counter-{{ section.id }}">01 / {{ img_total_pad }}</span>
        {%- endif -%}
      </div>
      {%- if product != blank and product.images.size > 1 -%}
        <div class="shop-buy__thumbnails" role="list" aria-label="{{ 'sections.shop.gallery_label' | t }}">
          {%- for img in product.images limit: 5 -%}
            <button
              type="button"
              class="shop-buy__thumb{% if forloop.first %} shop-buy__thumb--active{% endif %}"
              data-shop-thumb="{{ img | image_url: width: 1400 }}"
              aria-label="{{ img.alt | default: product.title | escape }} {{ forloop.index }}"
              role="listitem"
            >
              {{ img | image_url: width: 120 | image_tag: loading: 'lazy', alt: img.alt | default: product.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="shop-buy__copy-col">

      {%- if eyebrow != blank -%}
        <p class="shop-buy__badge">
          <span class="shop-buy__badge-dot" aria-hidden="true"></span>
          {{ eyebrow | escape }}
        </p>
      {%- endif -%}

      <h2 class="shop-buy__heading">{{ heading | escape }}</h2>

      {%- if tagline != blank -%}
        <p class="shop-buy__tagline"><em>{{ tagline | escape }}</em></p>
      {%- endif -%}

      {%- if price != blank -%}
        <div class="shop-buy__price-row">
          <span class="shop-buy__price">{{ price | escape }}</span>
          {%- if compare_price != blank -%}
            <span class="shop-buy__compare">{{ compare_price | escape }}</span>
          {%- endif -%}
          {%- if product_available and section.settings.show_stock -%}
            <span class="shop-buy__stock">
              <span class="shop-buy__stock-dot" aria-hidden="true"></span>
              {{- 'sections.shop.in_stock' | t -}}
            </span>
          {%- elsif product != blank and product_available == false -%}
            <span class="shop-buy__stock shop-buy__stock--out">
              {{- 'sections.shop.sold_out' | t -}}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if description != blank -%}
        <p class="shop-buy__description">{{ description }}</p>
      {%- endif -%}

      {%- if product != blank -%}
        {%- form 'product', product, class: 'shop-buy__form' -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign outer_idx = forloop.index0 -%}
              {%- assign option_name_lower = option.name | downcase -%}
              {%- assign is_color = false -%}
              {%- assign is_pill = false -%}
              {%- if option_name_lower contains 'finish' or option_name_lower contains 'color' or option_name_lower contains 'colour' -%}
                {%- assign is_color = true -%}
              {%- elsif option_name_lower contains 'mount' or option_name_lower contains 'style' -%}
                {%- assign is_pill = true -%}
              {%- endif -%}

              <div class="shop-buy__opt-group" data-option-index="{{ outer_idx }}">
                <div class="shop-buy__opt-header">
                  <p class="shop-buy__opt-label">{{ option.name | escape }}</p>
                  <span class="shop-buy__opt-value">{{ current_variant.options[outer_idx] | escape | upcase }}</span>
                </div>

                {%- if is_color -%}
                  <div class="shop-buy__swatches" role="group" aria-label="{{ option.name | escape }}">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="shop-buy__swatch{% if value == current_variant.options[outer_idx] %} shop-buy__swatch--active{% endif %}"
                        data-option-index="{{ outer_idx }}"
                        data-option-value="{{ value | escape }}"
                        data-swatch="{{ value | handleize }}"
                        aria-label="{{ value | escape }}"
                        title="{{ value | escape }}"
                      >
                        <span class="shop-buy__swatch-inner"></span>
                      </button>
                    {%- endfor -%}
                  </div>
                {%- elsif is_pill -%}
                  <div class="shop-buy__pills" role="group" aria-label="{{ option.name | escape }}">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="shop-buy__pill{% if value == current_variant.options[outer_idx] %} shop-buy__pill--active{% endif %}"
                        data-option-index="{{ outer_idx }}"
                        data-option-value="{{ value | escape }}"
                      >{{ value | escape }}</button>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="shop-buy__variant-wrap">
                    <select
                      class="shop-buy__variant-select"
                      data-option-index="{{ outer_idx }}"
                      data-option-select
                    >
                      {%- for value in option.values -%}
                        <option
                          value="{{ value | escape }}"
                          {%- if value == current_variant.options[outer_idx] %} selected{%- endif -%}
                        >{{ value | escape }}</option>
                      {%- endfor -%}
                    </select>
                    <svg class="shop-buy__variant-caret" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="2,5 7,10 12,5"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}

            <input type="hidden" name="id" id="shop-variant-id-{{ section.id }}" value="{{ current_variant.id }}">
            <script type="application/json" id="shop-variants-{{ section.id }}">
              {{ product.variants | json }}
            </script>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endunless -%}

          <div class="shop-buy__qty-row">
            <label class="shop-buy__qty-label" for="shop-qty-{{ section.id }}">{{ 'sections.shop.quantity_label' | t }}</label>
            <div class="shop-buy__qty-stepper">
              <button type="button" class="shop-buy__qty-btn" aria-label="{{ 'sections.shop.quantity_decrease' | t }}" data-qty-dec>−</button>
              <input
                type="number"
                id="shop-qty-{{ section.id }}"
                name="quantity"
                value="1"
                min="1"
                class="shop-buy__qty-input"
                aria-label="{{ 'sections.shop.quantity_label' | t }}"
              >
              <button type="button" class="shop-buy__qty-btn" aria-label="{{ 'sections.shop.quantity_increase' | t }}" data-qty-inc>+</button>
            </div>
          </div>

          <div class="shop-buy__cta-group">
            <button
              type="submit"
              name="add"
              class="shop-buy__cta shop-buy__cta--primary"
              data-cta-label="{{ cta_primary_label | escape }}"
              {%- unless current_variant.available %} disabled aria-disabled="true"{% endunless %}
            >
              <span class="shop-buy__btn-label">
                {%- if current_variant.available -%}
                  {{- cta_primary_label | escape -}} — {{ current_variant.price | money }}
                {%- else -%}
                  {{- 'sections.shop.sold_out' | t -}}
                {%- endif -%}
              </span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="2.5" y1="11.5" x2="11" y2="3"/>
                <polyline points="5,3 11,3 11,9"/>
              </svg>
            </button>
            <a href="{{ cta_secondary_url }}" class="shop-buy__cta shop-buy__cta--ghost">
              {{- cta_secondary_label | escape -}}
            </a>
          </div>
        {%- endform -%}
      {%- else -%}
        <div class="shop-buy__cta-group">
          <a href="{{ cta_primary_url }}" class="shop-buy__cta shop-buy__cta--primary">
            {{- cta_primary_label | escape -}}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="2.5" y1="11.5" x2="11" y2="3"/>
              <polyline points="5,3 11,3 11,9"/>
            </svg>
          </a>
          <a href="{{ cta_secondary_url }}" class="shop-buy__cta shop-buy__cta--ghost">
            {{- cta_secondary_label | escape -}}
          </a>
        </div>
      {%- endif -%}

      {%- if perk_1 != blank or perk_2 != blank or perk_3 != blank -%}
        <ul class="shop-buy__perks" role="list">
          {%- if perk_1 != blank -%}
            <li class="shop-buy__perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="7" width="14" height="10" rx="1"/><path d="M16 10h4l2 2.5L20 15h-4"/><circle cx="6" cy="19" r="1.5"/><circle cx="16" cy="19" r="1.5"/>
              </svg>
              {{ perk_1 | escape }}
            </li>
          {%- endif -%}
          {%- if perk_2 != blank -%}
            <li class="shop-buy__perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/><polyline points="12,7 12,12 15,14"/>
              </svg>
              {{ perk_2 | escape }}
            </li>
          {%- endif -%}
          {%- if perk_3 != blank -%}
            <li class="shop-buy__perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l8 3v6c0 4.5-3.4 8.4-8 9-4.6-.6-8-4.5-8-9V6z"/>
              </svg>
              {{ perk_3 | escape }}
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

    </div>

  </div>
</section>

{%- comment -%}── 03 SPECS ──{%- endcomment -%}
{%- assign specs_eyebrow = section.settings.specs_eyebrow | strip -%}
{%- assign specs_heading = section.settings.specs_heading | strip -%}
<section class="shop-specs full-width" data-surface="cream">
  <div class="shop-specs__inner">

    <div class="shop-specs__lead">
      {%- if specs_eyebrow != blank -%}
        <p class="shop-specs__eyebrow">{{ specs_eyebrow | escape }}</p>
      {%- endif -%}
      {%- if specs_heading != blank -%}
        <h2 class="shop-specs__heading">{{ specs_heading | escape }}</h2>
      {%- endif -%}
    </div>

    <dl class="shop-specs__list">
      {%- for i in (1..9) -%}
        {%- assign dt_key = 'spec_' | append: i | append: '_dt' -%}
        {%- assign dd_key = 'spec_' | append: i | append: '_dd' -%}
        {%- assign spec_dt = section.settings[dt_key] | strip -%}
        {%- assign spec_dd = section.settings[dd_key] | strip -%}
        {%- if spec_dt != blank or spec_dd != blank -%}
          <div class="shop-specs__row">
            <dt class="shop-specs__term">{{ spec_dt | escape }}</dt>
            <dd class="shop-specs__desc">{{ spec_dd | escape }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>

  </div>
</section>

{%- comment -%}── 04 IN THE BOX ──{%- endcomment -%}
<section class="shop-box full-width" data-surface="cream">
  <div class="shop-box__inner">

    <div class="shop-box__head">
      <p class="shop-box__eyebrow">{{ 'sections.shop.box_eyebrow' | t }}</p>
      <h2 class="shop-box__heading">{{ 'sections.shop.box_heading' | t }}</h2>
    </div>

    <div class="shop-box__grid">
      <div class="shop-box__item">
        <div class="shop-box__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="14" cy="14" r="10"/>
            <circle cx="14" cy="14" r="4"/>
          </svg>
        </div>
        <h4 class="shop-box__item-title">{{ 'sections.shop.box_item_1_title' | t }}</h4>
        <p class="shop-box__item-body">{{ 'sections.shop.box_item_1_body' | t }}</p>
      </div>
      <div class="shop-box__item">
        <div class="shop-box__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="8" width="18" height="14" rx="2"/>
            <path d="M10 8V6a4 4 0 0 1 8 0v2"/>
          </svg>
        </div>
        <h4 class="shop-box__item-title">{{ 'sections.shop.box_item_2_title' | t }}</h4>
        <p class="shop-box__item-body">{{ 'sections.shop.box_item_2_body' | t }}</p>
      </div>
      <div class="shop-box__item">
        <div class="shop-box__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 4v8m0 0c0 1.1-.9 2-2 2H9a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2h-3a2 2 0 0 1-2-2z"/>
          </svg>
        </div>
        <h4 class="shop-box__item-title">{{ 'sections.shop.box_item_3_title' | t }}</h4>
        <p class="shop-box__item-body">{{ 'sections.shop.box_item_3_body' | t }}</p>
      </div>
      <div class="shop-box__item">
        <div class="shop-box__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="7" y="3" width="14" height="22" rx="3"/>
            <circle cx="14" cy="20" r="1.2" fill="currentColor" stroke="none"/>
          </svg>
        </div>
        <h4 class="shop-box__item-title">{{ 'sections.shop.box_item_4_title' | t }}</h4>
        <p class="shop-box__item-body">{{ 'sections.shop.box_item_4_body' | t }}</p>
      </div>
    </div>

  </div>
</section>

{%- comment -%}── 05 KEY FEATURES ──{%- endcomment -%}
<section class="shop-features full-width" data-surface="dark">
  <div class="shop-features__inner">

    <div class="shop-features__head">
      <p class="shop-features__eyebrow">{{ 'sections.shop.features_eyebrow' | t }}</p>
      <h2 class="shop-features__heading">{{ 'sections.shop.features_heading' | t }}</h2>
    </div>

    <div class="shop-features__grid">
      <article class="shop-feature">
        <span class="shop-feature__num">01</span>
        <h4 class="shop-feature__title">{{ 'sections.shop.feature_1_title' | t }}</h4>
        <p class="shop-feature__body">{{ 'sections.shop.feature_1_body' | t }}</p>
      </article>
      <article class="shop-feature">
        <span class="shop-feature__num">02</span>
        <h4 class="shop-feature__title">{{ 'sections.shop.feature_2_title' | t }}</h4>
        <p class="shop-feature__body">{{ 'sections.shop.feature_2_body' | t }}</p>
      </article>
      <article class="shop-feature">
        <span class="shop-feature__num">03</span>
        <h4 class="shop-feature__title">{{ 'sections.shop.feature_3_title' | t }}</h4>
        <p class="shop-feature__body">{{ 'sections.shop.feature_3_body' | t }}</p>
      </article>
    </div>

  </div>
</section>

{%- comment -%}── 06 PAIRS WITH ──{%- endcomment -%}
{%- assign pairs_eyebrow = section.settings.pairs_eyebrow | strip -%}
{%- assign pairs_heading = section.settings.pairs_heading | strip -%}
<section class="shop-pairs full-width" data-surface="cream">
  <div class="shop-pairs__inner">

    {%- if pairs_eyebrow != blank -%}
      <p class="shop-pairs__eyebrow">{{ pairs_eyebrow | escape }}</p>
    {%- endif -%}
    {%- if pairs_heading != blank -%}
      <h2 class="shop-pairs__heading">{{ pairs_heading | escape }}</h2>
    {%- endif -%}

    <div class="shop-pairs__grid">
      {%- for i in (1..3) -%}
        {%- liquid
          assign _k = 'pairs_card_' | append: i | append: '_image'
          assign card_img   = section.settings[_k]
          assign _k = 'pairs_card_' | append: i | append: '_title'
          assign card_title = section.settings[_k] | strip
          assign _k = 'pairs_card_' | append: i | append: '_eyebrow'
          assign card_brow  = section.settings[_k] | strip
          assign _k = 'pairs_card_' | append: i | append: '_price'
          assign card_price = section.settings[_k] | strip
          assign _k = 'pairs_card_' | append: i | append: '_url'
          assign card_url   = section.settings[_k]
        -%}
        <a
          href="{{ card_url | default: '#' }}"
          class="shop-pairs__card"
          {% if card_url == blank %}tabindex="-1" aria-hidden="true"{% endif %}
        >
          <div class="shop-pairs__card-media">
            {%- if card_img != blank -%}
              {{ card_img | image_url: width: 600 | image_tag: loading: 'lazy', class: 'shop-pairs__card-img', alt: card_title }}
            {%- else -%}
              <div class="shop-pairs__card-placeholder"></div>
            {%- endif -%}
          </div>
          <div class="shop-pairs__card-body">
            {%- if card_brow != blank -%}
              <p class="shop-pairs__card-eyebrow">{{ card_brow | escape }}</p>
            {%- endif -%}
            <p class="shop-pairs__card-title">{{ card_title | default: 'Accessory' | escape }}</p>
            {%- if card_price != blank -%}
              <p class="shop-pairs__card-price">{{ card_price | escape }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

