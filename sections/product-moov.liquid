{% javascript %}
  (function () {

    /* ── Thumbnail gallery ── */
    document.querySelectorAll('.shop-buy__thumbnails').forEach(function (rail) {
      var frame = rail.closest('.shop-buy__media-col').querySelector('.shop-buy__frame');
      var mainImg = frame && frame.querySelector('.shop-buy__img');
      if (!mainImg) return;

      rail.querySelectorAll('.shop-buy__thumb').forEach(function (btn) {
        btn.addEventListener('click', function () {
          mainImg.src = btn.dataset.shopThumb;
          rail.querySelectorAll('.shop-buy__thumb').forEach(function (b) {
            b.classList.toggle('shop-buy__thumb--active', b === btn);
          });
        });
      });
    });

    /* ── Quantity stepper ── */
    document.querySelectorAll('.shop-buy__qty-stepper').forEach(function (stepper) {
      var input = stepper.querySelector('.shop-buy__qty-input');
      stepper.querySelector('[data-qty-dec]').addEventListener('click', function () {
        var v = parseInt(input.value, 10) || 1;
        if (v > 1) input.value = v - 1;
      });
      stepper.querySelector('[data-qty-inc]').addEventListener('click', function () {
        var v = parseInt(input.value, 10) || 1;
        input.value = v + 1;
      });
    });

    /* ── Variant select → update price + availability ── */
    document.querySelectorAll('.shop-buy__variant-select').forEach(function (select) {
      var form = select.closest('form');
      if (!form) return;
      var priceEl = form.closest('.shop-buy__copy-col').querySelector('.shop-buy__price');
      var compareEl = form.closest('.shop-buy__copy-col').querySelector('.shop-buy__compare');
      var submitBtn = form.querySelector('[name="add"]');

      select.addEventListener('change', function () {
        fetch(window.location.pathname + '?variant=' + select.value + '&section_id=' + select.closest('[data-section-id]').dataset.sectionId)
          .then(function (r) { return r.text(); })
          .catch(function () { return null; });

        var opt = select.options[select.selectedIndex];
        var disabled = opt.disabled;
        if (submitBtn) {
          submitBtn.disabled = disabled;
          submitBtn.setAttribute('aria-disabled', String(disabled));
        }
      });
    });

  })();
{% endjavascript %}

