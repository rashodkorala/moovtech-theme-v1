{% stylesheet %}

  /* ── Shared inner ── */
  .shop-crumbs__inner,
  .shop-hero__inner,
  .shop-buy__inner,
  .shop-specs__inner,
  .shop-box__inner,
  .shop-features__inner,
  .shop-pairs__inner,
  .shop-cta__inner {
    width: 100%;
    max-width: var(--layout-max-width);
    margin-inline: auto;
  }

  /* ══════════════════════════════════════════
     00 BREADCRUMBS
  ══════════════════════════════════════════ */
  .shop-crumbs {
    background: var(--moov-black);
    padding-top: var(--header-height, 72px);
    border-bottom: 1px solid var(--moov-border-dark);
  }

  .shop-crumbs__inner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-block: 14px;
    padding-inline: var(--section-inline-pad);
  }

  .shop-crumbs__link {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .shop-crumbs__link:hover {
    color: var(--moov-cream);
  }

  .shop-crumbs__sep {
    font-size: var(--text-2xs);
    color: var(--moov-border-dark);
    user-select: none;
  }

  .shop-crumbs__current {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--moov-cream);
  }

  /* ══════════════════════════════════════════
     01 SHOP HERO
  ══════════════════════════════════════════ */
  .shop-hero {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: clamp(2.5rem, 5vw, 4.5rem) var(--section-inline-pad) clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--moov-border-dark);
  }

  .shop-hero__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 56px);
    flex-wrap: wrap;
  }

  .shop-hero__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shop-hero__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-amber);
  }

  .shop-hero__eyebrow-dot {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--moov-amber);
    box-shadow: 0 0 10px color-mix(in srgb, var(--moov-amber) 65%, transparent);
    animation: shop-hero-pulse 2.4s ease-in-out infinite;
  }

  @keyframes shop-hero-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.25); opacity: 0.75; }
  }

  .shop-hero__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-cream);
  }

  .shop-hero__description {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--moov-text-secondary-dark);
    max-width: 44ch;
  }

  .shop-hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    padding: 10px 18px;
    border: 1px solid var(--moov-border-dark);
    border-radius: 999px;
    background: color-mix(in srgb, var(--moov-cream) 4%, transparent);
  }

  .shop-hero__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--moov-amber);
  }

  .shop-hero__rating-score {
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-sm);
    letter-spacing: -0.01em;
    color: var(--moov-cream);
  }

  .shop-hero__rating-count {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--moov-text-tertiary-dark);
  }

  @media (max-width: 680px) {
    .shop-hero__inner { flex-direction: column; align-items: flex-start; }
  }

  /* ══════════════════════════════════════════
     02 PRODUCT BUY
  ══════════════════════════════════════════ */
  .shop-buy {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: var(--section-block-pad-y-md) var(--section-inline-pad);
  }

  .shop-buy__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .shop-buy__media-col {
    position: sticky;
    top: calc(var(--header-height, 72px) + 24px);
  }

  .shop-buy__frame {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card, 16px);
    overflow: hidden;
    background: var(--moov-surface-dark-elevated);
    border: 1px solid var(--moov-border-dark);
  }

  .shop-buy__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.15) brightness(0.92) contrast(1.04);
  }

  .shop-buy__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--moov-cream) 5%, var(--moov-black));
    border: 1px dashed color-mix(in srgb, var(--moov-cream) 20%, transparent);
    border-radius: var(--radius-card, 16px);
    min-height: 480px;
  }

  .shop-buy__placeholder-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--moov-cream) 30%, transparent);
    text-align: center;
    line-height: 1.8;
  }

  /* Image counter */
  .shop-buy__counter {
    position: absolute;
    bottom: 14px;
    right: 16px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--moov-cream) 70%, transparent);
    background: color-mix(in srgb, var(--moov-black) 55%, transparent);
    padding: 4px 10px;
    border-radius: 999px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    pointer-events: none;
    user-select: none;
  }

  .shop-buy__copy-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 8px;
  }

  .shop-buy__badge {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-amber);
  }

  .shop-buy__badge-dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moov-amber);
    box-shadow: 0 0 8px color-mix(in srgb, var(--moov-amber) 65%, transparent);
  }

  .shop-buy__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
    font-size: var(--text-heading-xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-cream);
    text-wrap: balance;
  }

  /* Tagline */
  .shop-buy__tagline {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--moov-text-secondary-dark);
  }

  .shop-buy__tagline em {
    font-style: italic;
  }

  .shop-buy__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px 16px;
  }

  .shop-buy__price {
    font-family: var(--font-hero);
    font-size: var(--text-heading-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--moov-cream);
  }

  .shop-buy__compare {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--moov-text-tertiary-dark);
    text-decoration: line-through;
  }

  .shop-buy__stock {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-success);
    background: var(--moov-success-bg);
    padding: 4px 12px;
    border-radius: 999px;
  }

  .shop-buy__stock-dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moov-success);
  }

  .shop-buy__description {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--moov-text-secondary-dark);
    max-width: 44ch;
  }

  /* Option groups */
  .shop-buy__opt-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .shop-buy__opt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .shop-buy__opt-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
  }

  .shop-buy__opt-value {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-cream);
  }

  /* Swatches */
  .shop-buy__swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .shop-buy__swatch {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid transparent;
    padding: 3px;
    cursor: pointer;
    background: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .shop-buy__swatch:hover {
    border-color: color-mix(in srgb, var(--moov-cream) 45%, transparent);
    transform: scale(1.08);
  }

  .shop-buy__swatch--active {
    border-color: var(--moov-cream);
  }

  .shop-buy__swatch-inner {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--moov-text-tertiary-dark);
  }

  /* Known swatch colors */
  .shop-buy__swatch[data-swatch="cream"] .shop-buy__swatch-inner { background: #f5f0e8; }
  .shop-buy__swatch[data-swatch="off-white"] .shop-buy__swatch-inner { background: #ede8df; }
  .shop-buy__swatch[data-swatch="charcoal"] .shop-buy__swatch-inner { background: #2e2e2e; }
  .shop-buy__swatch[data-swatch="black"] .shop-buy__swatch-inner { background: #0d0d0d; }
  .shop-buy__swatch[data-swatch="white"] .shop-buy__swatch-inner { background: #ffffff; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.15); }
  .shop-buy__swatch[data-swatch="slate"] .shop-buy__swatch-inner { background: #4a5568; }
  .shop-buy__swatch[data-swatch="sand"] .shop-buy__swatch-inner { background: #c8b89a; }
  .shop-buy__swatch[data-swatch="brass"] .shop-buy__swatch-inner { background: #b5963e; }

  /* Pills */
  .shop-buy__pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .shop-buy__pill {
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--moov-border-dark);
    background: transparent;
    color: var(--moov-text-secondary-dark);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .shop-buy__pill:hover {
    border-color: color-mix(in srgb, var(--moov-cream) 45%, transparent);
    color: var(--moov-cream);
  }

  .shop-buy__pill--active {
    border-color: var(--moov-cream);
    color: var(--moov-cream);
    background: color-mix(in srgb, var(--moov-cream) 8%, transparent);
  }

  /* Variant select (fallback) */
  .shop-buy__variants {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .shop-buy__variant-label {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
  }

  .shop-buy__variant-wrap {
    position: relative;
  }

  .shop-buy__variant-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    padding: 13px 42px 13px 16px;
    border: 1px solid var(--moov-border-dark);
    border-radius: 10px;
    background: color-mix(in srgb, var(--moov-cream) 4%, transparent);
    color: var(--moov-cream);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .shop-buy__variant-select:focus {
    outline: 2px solid var(--moov-amber);
    outline-offset: 2px;
    border-color: var(--moov-amber);
  }

  .shop-buy__variant-caret {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--moov-text-tertiary-dark);
    pointer-events: none;
  }

  /* Quantity stepper */
  .shop-buy__qty-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .shop-buy__qty-label {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
    white-space: nowrap;
  }

  .shop-buy__qty-stepper {
    display: flex;
    align-items: center;
    border: 1px solid var(--moov-border-dark);
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, var(--moov-cream) 4%, transparent);
  }

  .shop-buy__qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    color: var(--moov-cream);
    font-size: 18px;
    cursor: pointer;
    transition: background 0.15s ease;
    flex-shrink: 0;
  }

  .shop-buy__qty-btn:hover {
    background: color-mix(in srgb, var(--moov-cream) 8%, transparent);
  }

  .shop-buy__qty-input {
    width: 44px;
    text-align: center;
    background: none;
    border: none;
    border-left: 1px solid var(--moov-border-dark);
    border-right: 1px solid var(--moov-border-dark);
    color: var(--moov-cream);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: 0;
    height: 40px;
    -moz-appearance: textfield;
  }

  .shop-buy__qty-input::-webkit-inner-spin-button,
  .shop-buy__qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }

  /* CTA group */
  .shop-buy__cta-group {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .shop-buy__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: clamp(13px, 1.2vw, 16px) clamp(24px, 2.6vw, 36px);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .shop-buy__cta--primary {
    background: var(--moov-cream);
    color: var(--moov-black);
    border: 1px solid var(--moov-cream);
  }

  .shop-buy__cta--primary:hover {
    background: var(--moov-amber);
    border-color: var(--moov-amber);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--moov-amber) 30%, transparent);
  }

  .shop-buy__cta--ghost {
    background: transparent;
    color: var(--moov-text-secondary-dark);
    border: 1px solid var(--moov-border-dark);
  }

  .shop-buy__cta--ghost:hover {
    background: color-mix(in srgb, var(--moov-cream) 8%, transparent);
    border-color: color-mix(in srgb, var(--moov-cream) 35%, transparent);
    color: var(--moov-cream);
    transform: translateY(-1px);
  }

  /* Form: display:contents so flex/grid layout is unaffected */
  .shop-buy__form { display: contents; }

  /* Sold out / disabled */
  .shop-buy__cta[disabled],
  .shop-buy__cta[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .shop-buy__stock--out {
    color: var(--moov-text-tertiary-dark);
    background: color-mix(in srgb, var(--moov-cream) 6%, transparent);
    border: 1px solid var(--moov-border-dark);
    padding: 4px 12px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Perks */
  .shop-buy__perks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
    border-top: 1px solid var(--moov-border-dark);
  }

  .shop-buy__perk {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--moov-text-secondary-dark);
    padding-top: 10px;
  }

  .shop-buy__perk:first-child { padding-top: 14px; }

  .shop-buy__perk svg {
    flex-shrink: 0;
    color: var(--moov-amber);
  }

  /* Thumbnails */
  .shop-buy__thumbnails {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .shop-buy__thumb {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--moov-border-dark);
    background: var(--moov-surface-dark-elevated);
    cursor: pointer;
    padding: 0;
    transition: border-color 0.15s ease;
    flex-shrink: 0;
  }

  .shop-buy__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shop-buy__thumb--active {
    border-color: var(--moov-cream);
  }

  .shop-buy__thumb:hover {
    border-color: color-mix(in srgb, var(--moov-cream) 55%, transparent);
  }

  @media (max-width: 860px) {
    .shop-buy__inner { grid-template-columns: 1fr; }
    .shop-buy__media-col { position: static; }
    .shop-buy__frame { aspect-ratio: 4 / 3; }
  }

  /* ══════════════════════════════════════════
     03 SPECS
  ══════════════════════════════════════════ */
  .shop-specs {
    background: var(--moov-cream);
    color: var(--moov-black);
    padding: var(--section-block-pad-y-lg) var(--section-inline-pad);
    border-top: 1px solid var(--moov-border-light);
  }

  .shop-specs__inner {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .shop-specs__lead {
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: sticky;
    top: calc(var(--header-height, 72px) + 24px);
  }

  .shop-specs__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-eyebrow-accent);
  }

  .shop-specs__heading {
    margin: 0;
    font-family: var(--font-hero);
    font-weight: 500;
