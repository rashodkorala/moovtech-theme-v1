{%- liquid
  assign app_eyebrow = section.settings.eyebrow
  if app_eyebrow == blank
    assign app_eyebrow = 'store_marketing.app_section_eyebrow' | t
  endif

  assign app_heading = section.settings.heading
  if app_heading == blank
    assign app_heading = 'store_marketing.acronym_intro' | t
  endif

  assign app_body = section.settings.body
  if app_body == blank
    assign app_body = 'store_marketing.app_section_body' | t
  endif
-%}

<div class="app-section full-width" data-surface="cream">
  <div class="app-section__inner">

    {%- comment -%} Left — Text content {%- endcomment -%}
    <div class="app-section__left" data-animate="slide-left">

      {%- if app_eyebrow != blank -%}
        <p class="app-section__eyebrow">{{ app_eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="app-section__heading">{{ app_heading | escape }}</h2>

      {%- if app_body != blank -%}
        <p class="app-section__body">{{ app_body | escape }}</p>
      {%- endif -%}

      {%- comment -%} Feature list {%- endcomment -%}
      <div class="app-section__features">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign feat_label = section.settings.feature_1_label
                assign feat_desc = section.settings.feature_1_desc
              when 2
                assign feat_label = section.settings.feature_2_label
                assign feat_desc = section.settings.feature_2_desc
              when 3
                assign feat_label = section.settings.feature_3_label
                assign feat_desc = section.settings.feature_3_desc
            endcase
            if feat_label == blank
              assign pk = 'store_marketing.pillar_' | append: i | append: '_title'
              assign feat_label = pk | t
            endif
            if feat_desc == blank
              assign dk = 'store_marketing.pillar_' | append: i | append: '_body'
              assign feat_desc = dk | t
            endif
          -%}
          {%- if feat_label != blank or feat_desc != blank -%}
            <div class="app-section__feature" data-animate="stagger" style="--stagger-delay: {{ i | minus: 1 | times: 100 }}ms;">
              {%- if feat_label != blank -%}
                <span class="app-section__feature-label">{{ feat_label | escape }}</span>
              {%- endif -%}
              {%- if feat_desc != blank -%}
                <span class="app-section__feature-desc">{{ feat_desc | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Primary CTA {%- endcomment -%}
      {%- if section.settings.cta_label != blank -%}
        <a
          href="{{ section.settings.cta_url | default: '#' }}"
          class="app-section__cta"
          data-animate="fade-in-delayed"
        >
          {{- section.settings.cta_label | escape -}}
        </a>
      {%- endif -%}

      {%- comment -%} Store download buttons {%- endcomment -%}
      <div class="app-section__downloads" data-animate="fade-in-delayed" style="--stagger-delay: 0.1s;">
        <a
          href="{{ section.settings.app_store_url | default: '#app-store' }}"
          class="app-section__store-btn"
          aria-label="{{ 'sections.app_section.download_app_store' | t }}"
        >
          <span class="app-section__store-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
          </span>
          <span class="app-section__store-text">
            <span class="app-section__store-label">Download on the</span>
            <span class="app-section__store-name">App Store</span>
          </span>
        </a>

        <a
          href="{{ section.settings.google_play_url | default: '#google-play' }}"
          class="app-section__store-btn"
          aria-label="{{ 'sections.app_section.get_google_play' | t }}"
        >
          <span class="app-section__store-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.18 23.76c.3.17.64.24.99.2L15.39 12 11.9 8.5 3.18 23.76z" fill="#EA4335"/>
              <path d="M20.54 10.61l-2.84-1.63-3.18 3.02 3.18 3.02 2.87-1.65c.82-.47.82-1.29-.03-1.76z" fill="#FBBC04"/>
              <path d="M2.1.49C1.8.83 1.62 1.34 1.62 2v20c0 .66.18 1.17.49 1.51L13.56 12 2.1.49z" fill="#4285F4"/>
              <path d="M15.39 12 4.17.22c.35-.04.72.03 1.02.2L20.54 10.61 15.39 12z" fill="#34A853"/>
            </svg>
          </span>
          <span class="app-section__store-text">
            <span class="app-section__store-label">Get it on</span>
            <span class="app-section__store-name">Google Play</span>
          </span>
        </a>
      </div>

    </div>

    {%- comment -%} Right — Dual visuals {%- endcomment -%}
    <div class="app-section__right">
      <div class="app-section__visual-wrap">
        <div class="app-section__glow" aria-hidden="true"></div>

        {%- comment -%} Product render — left, bottom-anchored {%- endcomment -%}
        <div class="app-section__product" data-animate="fade-up">
          {%- if section.settings.product_render -%}
            {{
              section.settings.product_render
              | image_url: width: 900
              | image_tag:
                class: 'app-section__product-img',
                loading: 'lazy',
                alt: section.settings.product_render.alt | escape
            }}
          {%- else -%}
            <img
              src="{{ 'moov-app-pairing.png' | asset_url }}"
              alt="MOOV App — Pairing"
              class="app-section__product-img"
              loading="lazy"
              width="390"
              height="844"
            >
          {%- endif -%}
        </div>

        {%- comment -%} App screen — right, top-anchored, overlapping {%- endcomment -%}
        <div class="app-section__screen" data-animate="fade-up-delayed">
          {%- if section.settings.app_screen -%}
            {{
              section.settings.app_screen
              | image_url: width: 600
              | image_tag:
                class: 'app-section__screen-img',
                loading: 'lazy',
                alt: section.settings.app_screen.alt | escape
            }}
          {%- else -%}
            <img
              src="{{ 'moov-app-home.png' | asset_url }}"
              alt="MOOV App — Home"
              class="app-section__screen-img"
              loading="lazy"
              width="390"
              height="844"
            >
          {%- endif -%}
        </div>

      </div>
    </div>

  </div>
</div>

{% stylesheet %}
  .app-section {
    background: var(--moov-cream);
    padding: var(--section-block-pad-y-hero) var(--section-inline-pad);
  }

  .app-section__inner {
    display: grid;
    grid-template-columns: 40fr 60fr;
    gap: 80px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Left — text */
  .app-section__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .app-section__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(240, 180, 41, 0.7);
    margin: 0 0 24px;
  }

  .app-section__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 400;
    line-height: 1.1;
    color: var(--moov-text-primary-light);
    max-width: 460px;
    margin: 0 0 24px;
    letter-spacing: -0.02em;
  }

  .app-section__body {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 200;
    line-height: 1.75;
    color: var(--moov-text-secondary-light);
    max-width: 400px;
    margin: 0 0 52px;
  }

  /* Feature list */
  .app-section__features {
    width: 100%;
    max-width: 420px;
    margin-bottom: 52px;
  }

  .app-section__feature {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 0;
    border-top: 1px solid var(--moov-border-light);
  }

  .app-section__feature:last-child {
    border-bottom: 1px solid var(--moov-border-light);
  }

  .app-section__feature-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--moov-text-primary-light);
  }

  .app-section__feature-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 200;
    line-height: 1.6;
    color: var(--moov-text-secondary-light);
  }

  /* Primary CTA */
  .app-section__cta {
    display: block;
    width: 100%;
    max-width: 420px;
    padding: 20px 0;
    margin-top: 48px;
    border: none;
    border-radius: 999px;
    background: var(--moov-black);
    color: var(--moov-cream);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }

  .app-section__cta:hover {
    opacity: 0.85;
  }

  /* Store download buttons */
  .app-section__downloads {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 16px;
    width: 100%;
    max-width: 420px;
  }

  .app-section__store-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border: 1px solid var(--moov-border-light);
    border-radius: 10px;
    background: transparent;
    text-decoration: none;
    color: var(--moov-text-primary-light);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .app-section__store-btn:hover {
    border-color: var(--moov-text-tertiary-light);
    background: var(--moov-amber-glow);
  }

  .app-section__store-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .app-section__store-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .app-section__store-label {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--moov-text-secondary-light);
    line-height: 1;
  }

  .app-section__store-name {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--moov-text-primary-light);
    line-height: 1;
  }

  /* Right — dual visuals */
  .app-section__right {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .app-section__visual-wrap {
    position: relative;
    display: flex;
    align-items: flex-end;
  }

  .app-section__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(ellipse at center, var(--moov-amber-glow) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Product render — left, bottom-anchored */
  .app-section__product {
    position: relative;
    z-index: 1;
    align-self: flex-end;
    flex-shrink: 0;
  }

  .app-section__product-img {
    display: block;
    max-height: 500px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 40px 100px rgba(10, 10, 9, 0.15));
  }

  .app-section__product-img--placeholder {
    opacity: 0.12;
    max-height: 400px;
  }

  /* App screen — right, top-anchored, overlapping */
  .app-section__screen {
    position: relative;
    z-index: 2;
    align-self: flex-start;
    margin-left: -60px;
    flex-shrink: 0;
  }

  .app-section__screen-img {
    display: block;
    max-height: 560px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 40px 100px rgba(10, 10, 9, 0.15));
    transition: transform 0.6s ease;
  }

  .app-section__screen-img:hover {
    transform: scale(1.02);
  }

  .app-section__screen-img--placeholder {
    opacity: 0.12;
    max-height: 460px;
  }

  /* Animations */
  [data-animate="slide-left"] {
    opacity: 0;
    transform: translateX(-24px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    transition-delay: 0.15s;
  }

  [data-animate="fade-up"] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.9s ease-out, transform 0.9s ease-out;
  }

  [data-animate="fade-up-delayed"] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.9s ease-out, transform 0.9s ease-out;
    transition-delay: 0.2s;
  }

  [data-animate="stagger"] {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    transition-delay: var(--stagger-delay, 0ms);
  }

  [data-animate="fade-in-delayed"] {
    opacity: 0;
    transition: opacity 0.6s ease-out;
    transition-delay: 0.4s;
  }

  [data-animate].is-visible {
    opacity: 1;
    transform: none;
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1279px) {
    .app-section__inner {
      grid-template-columns: 45fr 55fr;
      gap: 48px;
    }

    .app-section__product-img {
      max-height: 380px;
    }

    .app-section__screen-img {
      max-height: 440px;
    }

  }

  /* Mobile */
  @media (max-width: 767px) {
    .app-section__inner {
      grid-template-columns: 1fr;
      gap: 52px;
    }

    .app-section__right {
      order: -1;
    }

    .app-section__visual-wrap {
      justify-content: center;
    }

    .app-section__product-img {
      max-height: 280px;
    }

    .app-section__screen {
      margin-left: -40px;
    }

    .app-section__screen-img {
      max-height: 260px;
    }

    .app-section__body {
      margin-bottom: 36px;
    }

    .app-section__features {
      margin-bottom: 36px;
    }

    .app-section__cta {
      max-width: 100%;
    }

    .app-section__downloads {
      flex-direction: column;
      max-width: 100%;
    }

    .app-section__store-btn {
      width: 100%;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const animatedEls = document.querySelectorAll(
      '.app-section [data-animate]'
    );
    if (!animatedEls.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    animatedEls.forEach((el) => observer.observe(el));
  })();
{% endjavascript %}

