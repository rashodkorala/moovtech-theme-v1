{%- liquid
  assign cta_has_bg = false
  if section.settings.background_image != blank or section.settings.background_image_url != blank
    assign cta_has_bg = true
  endif
-%}
<section
  class="how-it-works-cta full-width{% if cta_has_bg %} how-it-works-cta--has-image{% endif %}"
  data-surface="{{ section.settings.surface }}"
  aria-labelledby="hiw-cta-heading-{{ section.id }}"
>
  {%- if cta_has_bg -%}
    <div class="how-it-works-cta__bg-media">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            class: 'how-it-works-cta__bg-image',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1780, 2000, 2400'
        }}
      {%- else -%}
        <img
          src="{{ section.settings.background_image_url | escape }}"
          alt=""
          loading="lazy"
          class="how-it-works-cta__bg-image"
          width="2400"
          height="1200"
        >
      {%- endif -%}
    </div>
    <div class="how-it-works-cta__overlay" aria-hidden="true"></div>
    <div class="how-it-works-cta__overlay how-it-works-cta__overlay--bottom" aria-hidden="true"></div>
  {%- endif -%}

  <div class="how-it-works-cta__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="how-it-works-cta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 id="hiw-cta-heading-{{ section.id }}" class="how-it-works-cta__heading">
        {%- assign heading_text = section.settings.heading | escape -%}
        {%- assign heading_parts = heading_text | split: section.settings.highlight_word -%}
        {%- if section.settings.highlight_word != blank and heading_parts.size == 2 -%}
          {{ heading_parts[0] }}<span class="how-it-works-cta__heading-accent">{{ section.settings.highlight_word | escape }}</span>{{ heading_parts[1] }}
        {%- else -%}
          {{ heading_text }}
        {%- endif -%}
      </h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="how-it-works-cta__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_url | default: routes.collections_url }}"
        class="how-it-works-cta__button"
      >
        {{- section.settings.button_label | escape -}}
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="2" y1="12" x2="12" y2="2" />
          <polyline points="5,2 12,2 12,9" />
        </svg>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .how-it-works-cta {
    --hiw-cta-radius: clamp(18px, 2.4vw, 28px);
    --hiw-cta-pad: clamp(1.5rem, 5vw, 4rem);
    position: relative;
    width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-block: var(--section-block-pad-y-md);
    margin-inline: auto;
    border-radius: var(--hiw-cta-radius);
    overflow: hidden;
    isolation: isolate;
    background: var(--moov-black);
  }

  .how-it-works-cta[data-surface='cream'] {
    background: var(--moov-cream);
  }

  .how-it-works-cta--has-image {
    min-height: clamp(360px, 60vw, 620px);
    display: grid;
  }

  .how-it-works-cta--has-image .how-it-works-cta__content {
    justify-self: center;
    align-self: end;
  }

  .how-it-works-cta__bg-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .how-it-works-cta__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .how-it-works-cta__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: color-mix(in srgb, var(--moov-black) 40%, transparent);
  }

  .how-it-works-cta__overlay--bottom {
    z-index: 2;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--moov-black) 75%, transparent) 0%,
      color-mix(in srgb, var(--moov-black) 25%, transparent) 45%,
      transparent 72%
    );
  }

  .how-it-works-cta[data-surface='cream'] .how-it-works-cta__overlay {
    background: color-mix(in srgb, var(--moov-cream) 50%, transparent);
  }

  .how-it-works-cta[data-surface='cream'] .how-it-works-cta__overlay--bottom {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--moov-cream) 78%, transparent) 0%,
      color-mix(in srgb, var(--moov-cream) 30%, transparent) 48%,
      transparent 72%
    );
  }

  .how-it-works-cta__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(12px, 1.5vw, 18px);
    max-width: 40rem;
    width: 100%;
    box-sizing: border-box;
    padding: var(--hiw-cta-pad);
  }

  .how-it-works-cta:not(.how-it-works-cta--has-image) .how-it-works-cta__content {
    margin: 0 auto;
    padding-top: var(--section-block-pad-y-lg);
    padding-bottom: var(--section-block-pad-y-lg);
  }

  .how-it-works-cta__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .how-it-works-cta--has-image[data-surface='dark'] .how-it-works-cta__eyebrow {
    color: color-mix(in srgb, var(--moov-cream) 88%, transparent);
  }

  .how-it-works-cta--has-image[data-surface='cream'] .how-it-works-cta__eyebrow {
    color: color-mix(in srgb, var(--moov-text-primary-light) 78%, var(--moov-black));
  }

  .how-it-works-cta:not(.how-it-works-cta--has-image)[data-surface='dark'] .how-it-works-cta__eyebrow {
    color: var(--moov-text-tertiary-dark);
  }

  .how-it-works-cta:not(.how-it-works-cta--has-image)[data-surface='cream'] .how-it-works-cta__eyebrow {
    color: var(--moov-text-tertiary-light);
  }

  .how-it-works-cta__heading {
    margin: 0;
    font-family: var(--font-hero, var(--font-body));
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: var(--heading-text-transform, uppercase);
    text-wrap: balance;
  }

  .how-it-works-cta--has-image[data-surface='dark'] .how-it-works-cta__heading {
    color: var(--moov-cream);
    text-shadow: 0 1px 24px color-mix(in srgb, var(--moov-black) 20%, transparent);
  }

  .how-it-works-cta--has-image[data-surface='cream'] .how-it-works-cta__heading {
    color: var(--moov-text-primary-light);
  }

  .how-it-works-cta:not(.how-it-works-cta--has-image)[data-surface='dark'] .how-it-works-cta__heading {
    color: var(--moov-text-primary-dark);
    text-shadow: none;
  }

  .how-it-works-cta:not(.how-it-works-cta--has-image)[data-surface='cream'] .how-it-works-cta__heading {
    color: var(--moov-text-primary-light);
  }

  .how-it-works-cta__heading-accent {
    color: var(--color-accent);
  }

  .how-it-works-cta__subheading {
    margin: 0;
    max-width: 48ch;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .how-it-works-cta--has-image[data-surface='dark'] .how-it-works-cta__subheading {
    color: color-mix(in srgb, var(--moov-cream) 92%, transparent);
  }

  .how-it-works-cta--has-image[data-surface='cream'] .how-it-works-cta__subheading {
    color: var(--moov-text-secondary-light);
  }

  .how-it-works-cta:not(.how-it-works-cta--has-image)[data-surface='dark'] .how-it-works-cta__subheading {
    color: var(--moov-text-secondary-dark);
  }

  .how-it-works-cta:not(.how-it-works-cta--has-image)[data-surface='cream'] .how-it-works-cta__subheading {
    color: var(--moov-text-secondary-light);
  }

  .how-it-works-cta__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    margin-top: clamp(4px, 1vw, 10px);
    text-decoration: none;
    color: var(--moov-black);
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .how-it-works-cta--has-image .how-it-works-cta__button {
    padding: clamp(13px, 1.2vw, 16px) clamp(26px, 2.8vw, 36px);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    background: var(--moov-cream);
    border: none;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--moov-black) 6%, transparent);
  }

  .how-it-works-cta--has-image .how-it-works-cta__button:hover {
    background: var(--moov-cream);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--moov-black) 24%, transparent);
  }

  .how-it-works-cta:not(.how-it-works-cta--has-image) .how-it-works-cta__button {
    padding: 0.9rem 1.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--moov-cream);
    border: 1px solid var(--moov-border-dark);
    box-shadow: none;
  }

  .how-it-works-cta:not(.how-it-works-cta--has-image) .how-it-works-cta__button:hover {
    background: var(--moov-cream-shadow);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--moov-black) 30%, transparent);
  }

  @media (max-width: 749px) {
    .how-it-works-cta--has-image {
      min-height: clamp(420px, 90vw, 560px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .how-it-works-cta__button {
      transition: none;
    }
    .how-it-works-cta__button:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How it works CTA",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "url",
      "id": "background_image_url",
      "label": "Background image URL (fallback)"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Take back your mornings"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to own your mornings?"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlight word in heading",
      "default": "own"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Make getting up easier than staying in bed, and start your day with more control."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "How it works CTA"
    }
  ]
}
{% endschema %}
