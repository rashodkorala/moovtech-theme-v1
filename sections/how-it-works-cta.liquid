<section class="how-it-works-cta full-width" data-surface="{{ section.settings.surface }}">
  {%- if section.settings.background_image != blank or section.settings.background_image_url != blank -%}
    <div class="how-it-works-cta__bg-media">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 2200
          | image_tag:
            loading: 'lazy',
            class: 'how-it-works-cta__bg-image',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1780, 2000, 2200'
        }}
      {%- else -%}
        <img
          src="{{ section.settings.background_image_url | escape }}"
          alt=""
          loading="lazy"
          class="how-it-works-cta__bg-image"
          width="2200"
          height="1200"
        >
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="how-it-works-cta__overlay" aria-hidden="true"></div>
  <div class="how-it-works-cta__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="how-it-works-cta__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="how-it-works-cta__heading">
        {%- assign heading_text = section.settings.heading | escape -%}
        {%- assign heading_parts = heading_text | split: section.settings.highlight_word -%}
        {%- if section.settings.highlight_word != blank and heading_parts.size == 2 -%}
          {{ heading_parts[0] }}<span class="how-it-works-cta__heading-accent">{{ section.settings.highlight_word | escape }}</span>{{ heading_parts[1] }}
        {%- else -%}
          {{ heading_text }}
        {%- endif -%}
      </h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="how-it-works-cta__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_url | default: routes.collections_url }}" class="how-it-works-cta__button">
        <span>{{ section.settings.button_label }}</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5M11.5 2.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .how-it-works-cta {
    padding: clamp(3rem, 8vw, 6rem) var(--section-inline-pad);
    background: var(--moov-black);
    position: relative;
    overflow: hidden;
  }

  .how-it-works-cta[data-surface='cream'] {
    background: var(--moov-cream);
  }

  .how-it-works-cta__bg-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .how-it-works-cta__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .how-it-works-cta__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--moov-black) 45%, transparent) 0%,
      color-mix(in srgb, var(--moov-black) 72%, transparent) 100%
    );
    pointer-events: none;
  }

  .how-it-works-cta[data-surface='cream'] .how-it-works-cta__overlay {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--moov-cream) 55%, transparent) 0%,
      color-mix(in srgb, var(--moov-cream) 75%, transparent) 100%
    );
  }

  .how-it-works-cta::before {
    content: '';
    position: absolute;
    width: min(70vw, 720px);
    height: min(70vw, 720px);
    border-radius: 50%;
    left: 50%;
    top: 0;
    transform: translate(-50%, -55%);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 38%, transparent) 0%,
      color-mix(in srgb, var(--color-accent) 16%, transparent) 45%,
      transparent 70%
    );
    pointer-events: none;
    opacity: 0.8;
    z-index: 2;
  }

  .how-it-works-cta[data-surface='cream']::before {
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 28%, transparent) 0%,
      color-mix(in srgb, var(--color-accent) 12%, transparent) 44%,
      transparent 70%
    );
  }

  .how-it-works-cta__inner {
    max-width: min(var(--page-width), calc(100% - var(--page-margin) * 2));
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 3;
    padding: clamp(1.2rem, 2vw, 1.8rem);
    border-radius: 24px;
    border: 1px solid color-mix(in srgb, var(--moov-border-dark) 70%, transparent);
    background: color-mix(in srgb, var(--moov-surface-dark-raised) 40%, transparent);
    backdrop-filter: blur(3px);
  }

  .how-it-works-cta[data-surface='cream'] .how-it-works-cta__inner {
    border-color: color-mix(in srgb, var(--moov-border-light) 85%, transparent);
    background: color-mix(in srgb, #fff 82%, transparent);
  }

  .how-it-works-cta__eyebrow {
    margin: 0 0 0.75rem;
    font-size: clamp(0.75rem, 1.3vw, 0.9rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
  }

  .how-it-works-cta[data-surface='cream'] .how-it-works-cta__eyebrow {
    color: var(--moov-text-tertiary-light);
  }

  .how-it-works-cta__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--moov-text-primary-dark);
    text-wrap: balance;
  }

  .how-it-works-cta[data-surface='cream'] .how-it-works-cta__heading {
    color: var(--moov-text-primary-light);
  }

  .how-it-works-cta__heading-accent {
    color: var(--color-accent);
  }

  .how-it-works-cta__subheading {
    margin: clamp(0.75rem, 1.8vw, 1rem) auto 0;
    max-width: 58ch;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.65;
    color: var(--moov-text-secondary-dark);
    text-wrap: pretty;
  }

  .how-it-works-cta[data-surface='cream'] .how-it-works-cta__subheading {
    color: var(--moov-text-secondary-light);
  }

  .how-it-works-cta__button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: clamp(1.2rem, 3vw, 2.1rem);
    padding: 0.92rem 1.75rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.94rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.22s ease, opacity 0.2s ease, filter 0.2s ease, box-shadow 0.22s ease;
    background: var(--moov-text-primary-dark);
    color: var(--moov-black);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--moov-black) 25%, transparent);
  }

  .how-it-works-cta[data-surface='cream'] .how-it-works-cta__button {
    background: var(--moov-black);
    color: var(--moov-text-primary-dark);
  }

  .how-it-works-cta__button:hover {
    transform: translateY(-1px);
    opacity: 1;
    box-shadow: 0 12px 28px color-mix(in srgb, var(--moov-black) 32%, transparent);
  }

  .how-it-works-cta__button svg {
    transition: transform 0.22s ease;
  }

  .how-it-works-cta__button:hover svg {
    transform: translateX(2px) translateY(-1px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How it works CTA",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "url",
      "id": "background_image_url",
      "label": "Background image URL (fallback)"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Take back your mornings"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to own your mornings?"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlight word in heading",
      "default": "own"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Make getting up easier than staying in bed, and start your day with more control."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "How it works CTA"
    }
  ]
}
{% endschema %}
