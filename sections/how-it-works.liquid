{%- liquid
  assign hero_heading = section.settings.hero_heading
  if hero_heading == blank
    assign hero_heading = 'Wake up. Walk across the room. Press the ring.'
  endif

  assign hero_sub = section.settings.hero_sub
  if hero_sub == blank
    assign hero_sub = 'MOOV is a wall-mounted alarm with one job. The walk is the feature. No screens, no notifications, no scroll — just an object on a wall, and a small, ordinary triumph at 6:30 a.m.'
  endif

  assign step_blocks     = section.blocks | where: 'type', 'step'
  assign timeline_blocks = section.blocks | where: 'type', 'timeline_item'
  assign mount_steps     = section.blocks | where: 'type', 'mount_step'
  assign anatomy_blocks  = section.blocks | where: 'type', 'anatomy_part'
  assign versus_blocks   = section.blocks | where: 'type', 'versus_row'
  assign hiw_faq_blocks  = section.blocks | where: 'type', 'hiw_faq_item'

  assign mount_image   = section.settings.mount_image
  assign anatomy_image = section.settings.anatomy_image

  assign steps_eyebrow = section.settings.steps_eyebrow
  if steps_eyebrow == blank
    assign steps_eyebrow = 'Three steps'
  endif
  assign steps_heading = section.settings.steps_heading
  if steps_heading == blank
    assign steps_heading = 'Simple by design.'
  endif

  assign timeline_eyebrow = section.settings.timeline_eyebrow
  if timeline_eyebrow == blank
    assign timeline_eyebrow = 'Why it works'
  endif
  assign timeline_heading = section.settings.timeline_heading
  if timeline_heading == blank
    assign timeline_heading = 'Most alarms wake you up. MOOV gets you moving.'
  endif

  assign mount_eyebrow     = section.settings.mount_eyebrow
  if mount_eyebrow == blank
    assign mount_eyebrow = 'Mounting'
  endif
  assign mount_heading     = section.settings.mount_heading
  if mount_heading == blank
    assign mount_heading = 'Ten minutes, two anchors, one screw.'
  endif
  assign mount_body        = section.settings.mount_body
  assign mount_rental_note = section.settings.mount_rental_note

  assign anatomy_eyebrow = section.settings.anatomy_eyebrow
  if anatomy_eyebrow == blank
    assign anatomy_eyebrow = 'The object'
  endif
  assign anatomy_heading = section.settings.anatomy_heading
  if anatomy_heading == blank
    assign anatomy_heading = 'Six parts. Nothing else inside.'
  endif

  assign versus_eyebrow   = section.settings.versus_eyebrow
  if versus_eyebrow == blank
    assign versus_eyebrow = 'MOOV vs. the phone in the bed'
  endif
  assign versus_heading   = section.settings.versus_heading
  if versus_heading == blank
    assign versus_heading = 'The difference, line by line.'
  endif
  assign versus_col_moov  = section.settings.versus_col_moov
  if versus_col_moov == blank
    assign versus_col_moov = 'MOOV'
  endif
  assign versus_col_phone = section.settings.versus_col_phone
  if versus_col_phone == blank
    assign versus_col_phone = 'Phone alarm'
  endif

  assign faq_eyebrow = section.settings.faq_eyebrow
  if faq_eyebrow == blank
    assign faq_eyebrow = 'Reasonable concerns'
  endif
  assign faq_heading = section.settings.faq_heading
  if faq_heading == blank
    assign faq_heading = 'The five we hear most.'
  endif

  assign cta_eyebrow     = section.settings.cta_eyebrow
  if cta_eyebrow == blank
    assign cta_eyebrow = 'Try it on your wall'
  endif
  assign cta_inline_note = section.settings.cta_inline_note

  assign cta_heading = section.settings.cta_heading
  if cta_heading == blank
    assign cta_heading = 'Live with MOOV for thirty days.'
  endif

  assign cta_sub = section.settings.cta_sub
  if cta_sub == blank
    assign cta_sub = 'Free shipping, no restocking fee, a real person on the other end of every email.'
  endif

  assign cta_primary_label = section.settings.cta_primary_label
  if cta_primary_label == blank
    assign cta_primary_label = 'Buy MOOV — $129'
  endif

  assign cta_secondary_label = section.settings.cta_secondary_label
  if cta_secondary_label == blank
    assign cta_secondary_label = 'Read our story'
  endif
-%}

<div class="hiw-page full-width">

  {%- comment -%}01 HERO — dark{%- endcomment -%}
  <section class="hiw-hero hiw-dark" aria-label="Introduction">
    <div class="hiw-inner">
      <div class="hiw-hero-grid">
        <div class="hiw-hero-copy">
          <p class="hiw-eyebrow">How it works</p>
          <h1 class="hiw-hero-h1">{{ hero_heading | escape | newline_to_br }}</h1>
        </div>
        <p class="hiw-hero-sub">{{ hero_sub | escape }}</p>
      </div>
    </div>
  </section>

  {%- comment -%}02 THREE STEPS — cream{%- endcomment -%}
  <section class="hiw-flow hiw-cream" aria-label="Three steps">
    <div class="hiw-inner">
      <div class="hiw-section-head">
        {%- if steps_eyebrow != blank -%}<p class="hiw-eyebrow hiw-eyebrow--amber">{{ steps_eyebrow | escape }}</p>{%- endif -%}
        {%- if steps_heading != blank -%}<h2 class="hiw-section-h2 hiw-h2-dark">{{ steps_heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if step_blocks.size > 0 -%}
        <ol class="hiw-flow-grid" role="list">
          {%- for block in step_blocks -%}
            {%- liquid
              if forloop.index < 10
                assign step_badge = forloop.index | prepend: '0'
              else
                assign step_badge = forloop.index | append: ''
              endif
            -%}
            <li class="hiw-step" {{ block.shopify_attributes }}>
              <div class="hiw-step-frame">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      class: 'hiw-step-img',
                      alt: block.settings.image.alt | default: block.settings.title,
                      sizes: '(min-width: 990px) 32vw, (min-width: 750px) 45vw, 100vw',
                      widths: '400, 600, 900'
                  }}
                {%- elsif block.settings.image_asset != blank -%}
                  <img
                    src="{{ block.settings.image_asset | asset_url }}"
                    alt="{{ block.settings.title | default: 'Step' | escape }}"
                    loading="lazy"
                    class="hiw-step-img"
                    width="900"
                    height="1125"
                  >
                {%- else -%}
                  <div class="hiw-step-placeholder">
                    <span class="hiw-placeholder-label">{{ block.settings.title | default: 'Step image' | escape }}<br>Upload via theme editor</span>
                  </div>
                {%- endif -%}
                <span class="hiw-step-num" aria-hidden="true">Step -{{ step_badge }}</span>
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="hiw-step-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="hiw-step-body">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%}03 TIMELINE — dark{%- endcomment -%}
  <section class="hiw-timeline hiw-dark" aria-label="Morning timeline">
    <div class="hiw-inner">
      <div class="hiw-section-head">
        {%- if timeline_eyebrow != blank -%}<p class="hiw-eyebrow">{{ timeline_eyebrow | escape }}</p>{%- endif -%}
        {%- if timeline_heading != blank -%}<h2 class="hiw-section-h2">{{ timeline_heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if timeline_blocks.size > 0 -%}
        <ol class="hiw-time-list" role="list">
          {%- for block in timeline_blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.time != blank -%}
                <span class="hiw-time-stamp">{{ block.settings.time | escape }}</span>
              {%- endif -%}
              <span class="hiw-time-dot" aria-hidden="true"></span>
              <div class="hiw-time-copy">
                {%- if block.settings.title != blank -%}
                  <h4>{{ block.settings.title | escape }}</h4>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p>{{ block.settings.body | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%}04 MOUNT — cream{%- endcomment -%}
  <section class="hiw-mount hiw-cream" aria-label="Mounting guide">
    <div class="hiw-inner">
      <div class="hiw-mount-grid">
        <div class="hiw-mount-copy">
          {%- if mount_eyebrow != blank -%}<p class="hiw-eyebrow hiw-eyebrow--amber">{{ mount_eyebrow | escape }}</p>{%- endif -%}
          {%- if mount_heading != blank -%}<h2 class="hiw-section-h2 hiw-h2-dark">{{ mount_heading | escape }}</h2>{%- endif -%}
          {%- if mount_body != blank -%}<p class="hiw-mount-lede">{{ mount_body | escape }}</p>{%- endif -%}
          {%- if mount_steps.size > 0 -%}
            <ol class="hiw-mount-list" role="list">
              {%- for block in mount_steps -%}
                {%- liquid
                  if forloop.index < 10
                    assign step_n = forloop.index | prepend: '0'
                  else
                    assign step_n = forloop.index | append: ''
                  endif
                -%}
                <li {{ block.shopify_attributes }}><span>{{ step_n }}</span>{{ block.settings.text | escape }}</li>
              {%- endfor -%}
            </ol>
          {%- endif -%}
          {%- if mount_rental_note != blank -%}<p class="hiw-mount-rental">{{ mount_rental_note | escape }}</p>{%- endif -%}
        </div>
        <figure class="hiw-mount-media" aria-hidden="true">
          {%- if mount_image != blank -%}
            {{ mount_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'hiw-mount-img', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500, 800, 1000' }}
          {%- else -%}
            <div class="hiw-step-placeholder" role="img" aria-label="Mounting guide image — upload via theme editor"></div>
          {%- endif -%}
        </figure>
      </div>
    </div>
  </section>

  {%- comment -%}05 ANATOMY — dark{%- endcomment -%}
  <section class="hiw-anatomy hiw-dark" aria-label="Product anatomy">
    <div class="hiw-inner">
      <div class="hiw-section-head">
        {%- if anatomy_eyebrow != blank -%}<p class="hiw-eyebrow">{{ anatomy_eyebrow | escape }}</p>{%- endif -%}
        {%- if anatomy_heading != blank -%}<h2 class="hiw-section-h2">{{ anatomy_heading | escape }}</h2>{%- endif -%}
      </div>
      <div class="hiw-anatomy-grid">
        <figure class="hiw-anatomy-shot">
          {%- if anatomy_image != blank -%}
            {{ anatomy_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'hiw-anatomy-img', sizes: '(min-width: 990px) 40vw, 100vw', widths: '400, 600, 900' }}
          {%- else -%}
            <div class="hiw-step-placeholder" role="img" aria-label="Product anatomy image — upload via theme editor"></div>
          {%- endif -%}
        </figure>
        {%- if anatomy_blocks.size > 0 -%}
          <ol class="hiw-parts-list" role="list">
            {%- for block in anatomy_blocks -%}
              {%- liquid
                if forloop.index < 10
                  assign part_n = forloop.index | prepend: '0'
                else
                  assign part_n = forloop.index | append: ''
                endif
              -%}
              <li {{ block.shopify_attributes }}>
                <span class="hiw-part-n">{{ part_n }}</span>
                <div>
                  {%- if block.settings.title != blank -%}<h4>{{ block.settings.title | escape }}</h4>{%- endif -%}
                  {%- if block.settings.body != blank -%}<p>{{ block.settings.body | escape }}</p>{%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%}06 VERSUS — cream{%- endcomment -%}
  <section class="hiw-versus hiw-cream" aria-label="MOOV vs phone alarm comparison">
    <div class="hiw-inner">
      <div class="hiw-section-head">
        {%- if versus_eyebrow != blank -%}<p class="hiw-eyebrow hiw-eyebrow--amber">{{ versus_eyebrow | escape }}</p>{%- endif -%}
        {%- if versus_heading != blank -%}<h2 class="hiw-section-h2 hiw-h2-dark">{{ versus_heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if versus_blocks.size > 0 -%}
        <div class="hiw-versus-table" role="table" aria-label="Feature comparison">
          <div class="hiw-versus-row hiw-versus-head" role="row">
            <span role="columnheader"></span>
            <span class="vr-moov" role="columnheader">{{ versus_col_moov | escape }}</span>
            <span class="vr-phone" role="columnheader">{{ versus_col_phone | escape }}</span>
          </div>
          {%- for block in versus_blocks -%}
            <div class="hiw-versus-row" role="row" {{ block.shopify_attributes }}>
              <span class="vr-label" role="rowheader">{{ block.settings.label | escape }}</span>
              <span class="vr-moov" role="cell">{{ block.settings.moov_value | escape }}</span>
              <span class="vr-phone" role="cell">{{ block.settings.phone_value | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%}07 FAQ — dark{%- endcomment -%}
  <section class="hiw-faq hiw-dark" aria-labelledby="hiw-faq-heading">
    <div class="hiw-inner">
      <div class="hiw-faq-grid">
        <div class="hiw-faq-head">
          {%- if faq_eyebrow != blank -%}<p class="hiw-eyebrow">{{ faq_eyebrow | escape }}</p>{%- endif -%}
          {%- if faq_heading != blank -%}<h2 id="hiw-faq-heading" class="hiw-section-h2">{{ faq_heading | escape }}</h2>{%- endif -%}
        </div>
        {%- if hiw_faq_blocks.size > 0 -%}
          <ul class="hiw-faq-list" role="list">
            {%- for block in hiw_faq_blocks -%}
              <li {{ block.shopify_attributes }}>
                <details class="hiw-faq-item">
                  <summary class="hiw-faq-q">
                    <span>{{ block.settings.question | escape }}</span>
                    <span class="hiw-faq-caret" aria-hidden="true"></span>
                  </summary>
                  <p class="hiw-faq-a">{{ block.settings.answer | escape }}</p>
                </details>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%}08 CTA — cream{%- endcomment -%}
  <section class="hiw-cta hiw-cream" aria-label="Call to action">
    <div class="hiw-inner">
      <div class="hiw-cta-inner">
        {%- if cta_eyebrow != blank -%}<p class="hiw-eyebrow hiw-eyebrow--amber">{{ cta_eyebrow | escape }}</p>{%- endif -%}
        <h2 class="hiw-cta-h2">{{ cta_heading | escape }}{%- if cta_inline_note != blank %} <em>{{ cta_inline_note | escape }}</em>{%- endif -%}</h2>
        <p class="hiw-cta-sub">{{ cta_sub | escape }}</p>
        <div class="hiw-cta-actions">
          <a href="{{ section.settings.cta_primary_url | default: '/products/moov' }}" class="hiw-btn hiw-btn--primary">
            {{ cta_primary_label | escape }}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="2" y1="7" x2="11" y2="7"/><polyline points="7,3.5 11,7 7,10.5"/></svg>
          </a>
          <a href="{{ section.settings.cta_secondary_url | default: '/pages/our-story' }}" class="hiw-btn hiw-btn--outline">
            {{ cta_secondary_label | escape }}
          </a>
        </div>
      </div>
    </div>
  </section>

</div>

{% stylesheet %}

/* ── Shared ── */
.hiw-page {
  display: flex;
  flex-direction: column;
}

.hiw-inner {
  width: 100%;
  max-width: var(--layout-max-width);
  margin-inline: auto;
  padding-inline: var(--section-inline-pad);
}

.hiw-dark  { background: var(--moov-black); color: var(--moov-cream); }
.hiw-cream { background: var(--moov-cream); color: var(--moov-black); }

.hiw-eyebrow {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-eyebrow);
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-amber);
}

.hiw-eyebrow--amber { color: var(--moov-amber); }

.hiw-section-head {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: clamp(32px, 5vw, 56px);
  max-width: 60ch;
}

.hiw-section-h2 {
  margin: 0;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: var(--text-heading-xl);
  line-height: 1.05;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: var(--moov-cream);
}

.hiw-h2-dark { color: var(--moov-black); }

.hiw-section-h2 em {
  font-style: italic;
  color: var(--moov-amber);
}

/* ── Buttons ── */
.hiw-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.9rem 1.6rem;
  border-radius: 999px;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;
}

.hiw-btn--primary {
  background: var(--moov-black);
  color: var(--moov-cream);
  border: 1px solid transparent;
}

.hiw-btn--primary:hover {
  background: color-mix(in srgb, var(--moov-black) 85%, var(--moov-cream));
  transform: translateY(-1px);
}

.hiw-btn--outline {
  background: transparent;
  color: var(--moov-black);
  border: 1px solid color-mix(in srgb, var(--moov-black) 30%, transparent);
}

.hiw-btn--outline:hover {
  background: color-mix(in srgb, var(--moov-black) 6%, transparent);
  transform: translateY(-1px);
}

/* ==========================================================
   01 HERO
   ========================================================== */
.hiw-hero {
  padding-block: clamp(4rem, 8vw, 7rem);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-hero-grid {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: clamp(28px, 5vw, 80px);
  align-items: end;
}

.hiw-hero-copy {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.hiw-hero-h1 {
  margin: 0;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: clamp(2.2rem, 5.5vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.025em;
  text-transform: uppercase;
  color: var(--moov-cream);
}

.hiw-hero-sub {
  margin: 0;
  font-size: var(--text-md);
  line-height: 1.6;
  color: var(--moov-text-secondary-dark);
  max-width: 44ch;
  align-self: end;
  padding-bottom: 0.4rem;
}

/* ==========================================================
   02 THREE STEPS
   ========================================================== */
.hiw-flow {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid color-mix(in srgb, var(--moov-black) 12%, transparent);
}

.hiw-flow-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28px;
}

.hiw-step {
  display: flex;
  flex-direction: column;
}

.hiw-step-frame {
  position: relative;
  aspect-ratio: 4 / 5;
  border-radius: var(--radius-card, 16px);
  overflow: hidden;
  background: color-mix(in srgb, var(--moov-black) 8%, var(--moov-cream));
  margin-bottom: 18px;
  border: 1px solid color-mix(in srgb, var(--moov-black) 10%, transparent);
}

.hiw-step-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.hiw-step-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hiw-placeholder-label {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--moov-black) 25%, transparent);
  text-align: center;
  line-height: 1.8;
}

.hiw-step-num {
  position: absolute;
  left: 14px;
  bottom: 14px;
  z-index: 1;
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-cream);
  background: rgba(10, 10, 9, 0.70);
  padding: 5px 11px;
  border-radius: 999px;
}

.hiw-step-title {
  margin: 0 0 8px;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: var(--text-heading-md);
  line-height: 1.05;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--moov-black);
}

.hiw-step-body {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.65;
  color: var(--moov-text-secondary-light);
  max-width: 36ch;
}

/* ==========================================================
   03 TIMELINE
   ========================================================== */
.hiw-timeline {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-time-list {
  list-style: none;
  margin: 0;
  padding: 0;
  position: relative;
}

.hiw-time-list::before {
  content: "";
  position: absolute;
  left: 162px;
  top: 6px;
  bottom: 6px;
  width: 1px;
  background: var(--moov-border-dark);
}

.hiw-time-list li {
  display: grid;
  grid-template-columns: 140px 24px 1fr;
  gap: 20px;
  align-items: start;
  padding: 32px 0;
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-time-list li:last-child { border-bottom: none; }

.hiw-time-stamp {
  font-family: var(--font-hero);
  font-weight: 700;
  font-size: var(--text-md);
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--moov-amber);
  padding-top: 2px;
}

.hiw-time-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--moov-amber);
  box-shadow: 0 0 0 4px var(--moov-black);
  margin: 8px 0 0 6px;
  flex-shrink: 0;
}

.hiw-time-copy h4 {
  margin: 0 0 10px;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: var(--text-heading-sm);
  line-height: 1.1;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--moov-cream);
}

.hiw-time-copy p {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.75;
  color: var(--moov-text-secondary-dark);
  max-width: 52ch;
}

/* ==========================================================
   04 MOUNT
   ========================================================== */
.hiw-mount {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid color-mix(in srgb, var(--moov-black) 12%, transparent);
}

.hiw-mount-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: clamp(28px, 5vw, 80px);
  align-items: center;
}

.hiw-mount-copy {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hiw-mount-lede {
  margin: 0;
  font-size: var(--text-base);
  line-height: 1.65;
  color: var(--moov-text-secondary-light);
  max-width: 42ch;
}

.hiw-mount-rental {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.6;
  color: var(--moov-text-tertiary-light);
  max-width: 40ch;
}

.hiw-mount-list {
  list-style: none;
  margin: 4px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}

.hiw-mount-list li {
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 12px;
  padding: 14px 0;
  border-top: 1px solid var(--moov-border-light);
  font-size: var(--text-sm);
  line-height: 1.55;
  color: var(--moov-text-primary-light);
}

.hiw-mount-list li:last-child { border-bottom: 1px solid var(--moov-border-light); }

.hiw-mount-list li span {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-amber);
  padding-top: 2px;
}

.hiw-mount-media {
  margin: 0;
  aspect-ratio: 3 / 4;
  max-height: 700px;
  border-radius: var(--radius-card, 16px);
  overflow: hidden;
  background: color-mix(in srgb, var(--moov-black) 8%, var(--moov-cream));
}

.hiw-mount-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ==========================================================
   05 ANATOMY
   ========================================================== */
.hiw-anatomy {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-anatomy-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: clamp(28px, 5vw, 80px);
  align-items: start;
}

.hiw-anatomy-shot {
  margin: 0;
  aspect-ratio: 4 / 5;
  border-radius: var(--radius-card, 16px);
  overflow: hidden;
  background: var(--moov-surface-dark-elevated);
  position: sticky;
  top: calc(var(--header-height, 5rem) + 24px);
}

.hiw-anatomy-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.hiw-parts-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid var(--moov-border-dark);
}

.hiw-parts-list li {
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: 12px;
  padding: 20px 18px 22px 0;
  border-right: 1px solid var(--moov-border-dark);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-parts-list li:nth-child(2n) { border-right: none; }

.hiw-part-n {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-amber);
  padding-top: 3px;
}

.hiw-parts-list h4 {
  margin: 0 0 6px;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: var(--text-heading-sm);
  line-height: 1.1;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--moov-cream);
}

.hiw-parts-list p {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.55;
  color: var(--moov-text-secondary-dark);
  max-width: 28ch;
}

/* ==========================================================
   06 VERSUS
   ========================================================== */
.hiw-versus {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid color-mix(in srgb, var(--moov-black) 12%, transparent);
}

.hiw-versus-table {
  display: flex;
  flex-direction: column;
}

.hiw-versus-row {
  display: grid;
  grid-template-columns: 1.2fr 1.4fr 1.4fr;
  gap: 24px;
  padding: 18px 0;
  border-top: 1px solid var(--moov-border-light);
  font-size: var(--text-base);
  line-height: 1.5;
}

.hiw-versus-row:last-child { border-bottom: 1px solid var(--moov-border-light); }

.hiw-versus-head {
  padding: 12px 0;
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-text-tertiary-light);
}

.vr-label {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-text-tertiary-light);
  padding-top: 4px;
}

.vr-moov {
  color: var(--moov-black);
  font-weight: 500;
}

.hiw-versus-head .vr-moov { color: var(--moov-amber); font-weight: 500; }

.vr-phone {
  color: var(--moov-text-secondary-light);
  text-decoration: line-through;
  text-decoration-color: rgba(10, 10, 9, 0.22);
  text-decoration-thickness: 1px;
}

.hiw-versus-head .vr-phone {
  text-decoration: none;
  color: var(--moov-text-tertiary-light);
}

/* ==========================================================
   07 FAQ
   ========================================================== */
.hiw-faq {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-faq-grid {
  display: grid;
  grid-template-columns: minmax(200px, 340px) 1fr;
  gap: clamp(2rem, 5vw, 5rem);
  align-items: start;
}

.hiw-faq-head {
  position: sticky;
  top: calc(var(--header-height, 5rem) + 24px);
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.hiw-faq-list {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--moov-border-dark);
}

.hiw-faq-item {
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-faq-q {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 16px;
  padding: 20px 0;
  cursor: pointer;
  list-style: none;
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: 500;
  line-height: 1.4;
  color: var(--moov-cream);
  user-select: none;
}

.hiw-faq-q::-webkit-details-marker { display: none; }

.hiw-faq-caret {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 1px solid var(--moov-border-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
  position: relative;
  transition: border-color 0.2s ease;
}

.hiw-faq-caret::before,
.hiw-faq-caret::after {
  content: "";
  position: absolute;
  background: var(--moov-cream);
  border-radius: 1px;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.hiw-faq-caret::before { width: 8px; height: 1.5px; }
.hiw-faq-caret::after  { width: 1.5px; height: 8px; }

details[open] .hiw-faq-caret::after { transform: rotate(90deg); opacity: 0; }
details[open] .hiw-faq-q { color: var(--moov-amber); }

.hiw-faq-a {
  margin: 0;
  padding: 0 0 20px;
  font-size: var(--text-sm);
  line-height: 1.65;
  color: var(--moov-text-secondary-dark);
  max-width: 54ch;
}

/* ==========================================================
   08 CTA
   ========================================================== */
.hiw-cta {
  padding-block: var(--section-block-pad-y-md);
  text-align: center;
}

.hiw-cta-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  max-width: 60ch;
  margin: 0 auto;
}

.hiw-cta-h2 {
  margin: 0;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: clamp(1.9rem, 4.2vw, 3.75rem);
  line-height: 1.02;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: var(--moov-black);
}

.hiw-cta-h2 em {
  font-style: italic;
  color: var(--moov-amber);
}

.hiw-cta-sub {
  margin: 0;
  font-size: var(--text-md);
  line-height: 1.6;
  color: var(--moov-text-secondary-light);
  max-width: 44ch;
}

.hiw-cta-actions {
  display: flex;
  gap: 12px;
  margin-top: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

/* ==========================================================
   RESPONSIVE
   ========================================================== */
@media (max-width: 880px) {
  .hiw-hero-grid  { grid-template-columns: 1fr; }
  .hiw-mount-grid { grid-template-columns: 1fr; }
  .hiw-mount-grid .hiw-mount-media { order: -1; }
  .hiw-anatomy-grid { grid-template-columns: 1fr; }
  .hiw-anatomy-shot { position: static; aspect-ratio: 16 / 10; }
  .hiw-flow-grid  { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hiw-faq-grid   { grid-template-columns: 1fr; }
  .hiw-faq-head   { position: static; }
}

@media (max-width: 720px) {
  .hiw-time-list::before { left: 6px; }
  .hiw-time-list li { grid-template-columns: 24px 1fr; gap: 14px; }
  .hiw-time-stamp { grid-column: 2; font-size: var(--text-sm); }
  .hiw-time-dot { margin-top: 4px; }
  .hiw-versus-row { grid-template-columns: 1fr; gap: 6px; }
  .hiw-versus-head { display: none; }
  .vr-moov::before { content: "MOOV -"; color: var(--moov-amber); }
  .vr-phone::before { content: "Phone -"; color: var(--moov-text-tertiary-light); }
}

@media (max-width: 600px) {
  .hiw-flow-grid  { grid-template-columns: 1fr; }
  .hiw-step-frame { aspect-ratio: 16 / 10; }
  .hiw-parts-list { grid-template-columns: 1fr; }
  .hiw-parts-list li { border-right: none; }
}

