{%- liquid
  assign hero_heading = section.settings.hero_heading
  if hero_heading == blank
    assign hero_heading = 'Wake up. Walk across the room. Press the ring.'
  endif

  assign hero_sub = section.settings.hero_sub
  if hero_sub == blank
    assign hero_sub = 'MOOV is a wall-mounted alarm with one job. The walk is the feature. No screens, no notifications, no scroll — just an object on a wall, and a small, ordinary triumph at 6:30 a.m.'
  endif

  assign step_blocks = section.blocks | where: 'type', 'step'

  assign mount_image = section.settings.mount_image
  assign anatomy_image = section.settings.anatomy_image

  assign cta_heading = section.settings.cta_heading
  if cta_heading == blank
    assign cta_heading = 'Live with MOOV for thirty days.'
  endif

  assign cta_sub = section.settings.cta_sub
  if cta_sub == blank
    assign cta_sub = 'Free shipping, no restocking fee, a real person on the other end of every email.'
  endif

  assign cta_primary_label = section.settings.cta_primary_label
  if cta_primary_label == blank
    assign cta_primary_label = 'Buy MOOV — $129'
  endif

  assign cta_secondary_label = section.settings.cta_secondary_label
  if cta_secondary_label == blank
    assign cta_secondary_label = 'Read our story'
  endif
-%}

<div class="hiw-page full-width">

  {%- comment -%}01 HERO — dark{%- endcomment -%}
  <section class="hiw-hero hiw-dark" aria-label="Introduction">
    <div class="hiw-inner">
      <div class="hiw-hero-grid">
        <div class="hiw-hero-copy">
          <p class="hiw-eyebrow">How it works</p>
          <h1 class="hiw-hero-h1">{{ hero_heading | escape | newline_to_br }}</h1>
        </div>
        <p class="hiw-hero-sub">{{ hero_sub | escape }}</p>
      </div>
    </div>
  </section>

  {%- comment -%}02 THREE STEPS — cream{%- endcomment -%}
  <section class="hiw-flow hiw-cream" aria-label="Three steps">
    <div class="hiw-inner">
      <div class="hiw-section-head">
        <p class="hiw-eyebrow hiw-eyebrow--amber">Three steps</p>
        <h2 class="hiw-section-h2 hiw-h2-dark">Simple by design.</h2>
      </div>
      {%- if step_blocks.size > 0 -%}
        <ol class="hiw-flow-grid" role="list">
          {%- for block in step_blocks -%}
            {%- liquid
              if forloop.index < 10
                assign step_badge = forloop.index | prepend: '0'
              else
                assign step_badge = forloop.index | append: ''
              endif
            -%}
            <li class="hiw-step" {{ block.shopify_attributes }}>
              <div class="hiw-step-frame">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      class: 'hiw-step-img',
                      alt: block.settings.image.alt | default: block.settings.title,
                      sizes: '(min-width: 990px) 32vw, (min-width: 750px) 45vw, 100vw',
                      widths: '400, 600, 900'
                  }}
                {%- elsif block.settings.image_asset != blank -%}
                  <img
                    src="{{ block.settings.image_asset | asset_url }}"
                    alt="{{ block.settings.title | default: 'Step' | escape }}"
                    loading="lazy"
                    class="hiw-step-img"
                    width="900"
                    height="1125"
                  >
                {%- else -%}
                  <div class="hiw-step-placeholder">
                    <span class="hiw-placeholder-label">{{ block.settings.title | default: 'Step image' | escape }}<br>Upload via theme editor</span>
                  </div>
                {%- endif -%}
                <span class="hiw-step-num" aria-hidden="true">Step · {{ step_badge }}</span>
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="hiw-step-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="hiw-step-body">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%}03 TIMELINE — dark{%- endcomment -%}
  <section class="hiw-timeline hiw-dark" aria-label="Morning timeline">
    <div class="hiw-inner">
      <div class="hiw-section-head">
        <p class="hiw-eyebrow">Why it works</p>
        <h2 class="hiw-section-h2">Most alarms wake you up.<br><em>MOOV gets you moving.</em></h2>
      </div>
      <ol class="hiw-time-list" role="list">
        <li>
          <span class="hiw-time-stamp">10:30 p.m.</span>
          <span class="hiw-time-dot" aria-hidden="true"></span>
          <div class="hiw-time-copy">
            <h4>Phone goes in the kitchen.</h4>
            <p>On the charger, face down. MOOV has nothing to do until morning.</p>
          </div>
        </li>
        <li>
          <span class="hiw-time-stamp">6:25 a.m.</span>
          <span class="hiw-time-dot" aria-hidden="true"></span>
          <div class="hiw-time-copy">
            <h4>Soft pre-alert.</h4>
            <p>A two second amber pulse and a gentle chime. If you sleep through, the main alarm follows.</p>
          </div>
        </li>
        <li>
          <span class="hiw-time-stamp">6:30 a.m.</span>
          <span class="hiw-time-dot" aria-hidden="true"></span>
          <div class="hiw-time-copy">
            <h4>MOOV rings.</h4>
            <p>Full volume, front facing speaker. Tuned for tile rooms, bathrooms, hallways, kitchens.</p>
          </div>
        </li>
        <li>
          <span class="hiw-time-stamp">6:30:14</span>
          <span class="hiw-time-dot" aria-hidden="true"></span>
          <div class="hiw-time-copy">
            <h4>You're upright.</h4>
            <p>By second fourteen, most testers have at least one foot on the floor. By twenty, both.</p>
          </div>
        </li>
        <li>
          <span class="hiw-time-stamp">6:30:28</span>
          <span class="hiw-time-dot" aria-hidden="true"></span>
          <div class="hiw-time-copy">
            <h4>Palm on the ring.</h4>
            <p>One press. No snooze, no swipe, no second screen. The chime stops the moment you make contact.</p>
          </div>
        </li>
        <li>
          <span class="hiw-time-stamp">6:31 a.m.</span>
          <span class="hiw-time-dot" aria-hidden="true"></span>
          <div class="hiw-time-copy">
            <h4>Day starts.</h4>
            <p>You're already in the kitchen with the phone. The first conscious minute belonged to you.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {%- comment -%}04 MOUNT — cream{%- endcomment -%}
  <section class="hiw-mount hiw-cream" aria-label="Mounting guide">
    <div class="hiw-inner">
      <div class="hiw-mount-grid">
        <div class="hiw-mount-copy">
          <p class="hiw-eyebrow hiw-eyebrow--amber">Mounting</p>
          <h2 class="hiw-section-h2 hiw-h2-dark">Ten minutes,<br>two anchors,<br>one screw.</h2>
          <p class="hiw-mount-lede">The brass cleat ships with everything you need — a paper template, two drywall anchors, and a single hidden screw. MOOV slides onto it with a soft click.</p>
          <ol class="hiw-mount-list" role="list">
            <li><span>01</span>Tape the paper template at eye level, level it, drill two pilots.</li>
            <li><span>02</span>Hammer the anchors flush, drive the cleat with the included Torx key.</li>
            <li><span>03</span>Hang MOOV. Done before the kettle whistles.</li>
          </ol>
          <p class="hiw-mount-rental">Renting? The optional adhesive cleat replaces the anchors on most painted drywall — holds the 412 g shell with no holes left behind.</p>
        </div>
        <figure class="hiw-mount-media" aria-hidden="true">
          {%- if mount_image != blank -%}
            {{ mount_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'hiw-mount-img', sizes: '(min-width: 990px) 45vw, 100vw', widths: '500, 800, 1000' }}
          {%- else -%}
            <img
              src="{{ 'step-1-how it works.jpg' | asset_url }}"
              alt="Mounting a MOOV cleat to a wall"
              loading="lazy"
              class="hiw-mount-img"
              width="1000"
              height="1250"
            >
          {%- endif -%}
        </figure>
      </div>
    </div>
  </section>

  {%- comment -%}05 ANATOMY — dark{%- endcomment -%}
  <section class="hiw-anatomy hiw-dark" aria-label="Product anatomy">
    <div class="hiw-inner">
      <div class="hiw-section-head">
        <p class="hiw-eyebrow">The object</p>
        <h2 class="hiw-section-h2">Six parts.<br>Nothing else inside.</h2>
      </div>
      <div class="hiw-anatomy-grid">
        <figure class="hiw-anatomy-shot">
          {%- if anatomy_image != blank -%}
            {{ anatomy_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'hiw-anatomy-img', sizes: '(min-width: 990px) 40vw, 100vw', widths: '400, 600, 900' }}
          {%- else -%}
            <img
              src="{{ 'CFC86724-4271-4448-BD4D-1BFC891817C5.PNG' | asset_url }}"
              alt="Detail of MOOV ceramic shell and brass mount"
              loading="lazy"
              class="hiw-anatomy-img"
              width="900"
              height="1125"
            >
          {%- endif -%}
        </figure>
        <ol class="hiw-parts-list" role="list">
          <li>
            <span class="hiw-part-n">01</span>
            <div><h4>Glazed ceramic shell</h4><p>Soft white finish. Wall-mount ready. Built to live in your space.</p></div>
          </li>
          <li>
            <span class="hiw-part-n">02</span>
            <div><h4>Warm-amber LED ring</h4><p>Four brightness levels. Visible from the doorway, invisible from the pillow.</p></div>
          </li>
          <li>
            <span class="hiw-part-n">03</span>
            <div><h4>Capacitive dismiss</h4><p>One palm press, anywhere on the ring. No buttons to find in the dark.</p></div>
          </li>
          <li>
            <span class="hiw-part-n">04</span>
            <div><h4>Front-facing speaker</h4><p>Full-range driver, tuned for hard surfaces. Plenty of volume, never harsh.</p></div>
          </li>
          <li>
            <span class="hiw-part-n">05</span>
            <div><h4>Brass French-cleat</h4><p>Solid brass, single hidden screw. Lifts off in two seconds for charging.</p></div>
          </li>
          <li>
            <span class="hiw-part-n">06</span>
            <div><h4>USB-C port</h4><p>Around the back. Ninety minutes to full. Charge twice a year.</p></div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  {%- comment -%}06 VERSUS — cream{%- endcomment -%}
  <section class="hiw-versus hiw-cream" aria-label="MOOV vs phone alarm comparison">
    <div class="hiw-inner">
      <div class="hiw-section-head">
        <p class="hiw-eyebrow hiw-eyebrow--amber">MOOV vs. the phone in the bed</p>
        <h2 class="hiw-section-h2 hiw-h2-dark">The difference,<br>line by line.</h2>
      </div>
      <div class="hiw-versus-table" role="table" aria-label="Feature comparison">
        <div class="hiw-versus-row hiw-versus-head" role="row">
          <span role="columnheader"></span>
          <span class="vr-moov" role="columnheader">MOOV</span>
          <span class="vr-phone" role="columnheader">Phone alarm</span>
        </div>
        <div class="hiw-versus-row" role="row">
          <span class="vr-label" role="rowheader">Where it lives</span>
          <span class="vr-moov" role="cell">Across the room, on a wall</span>
          <span class="vr-phone" role="cell">Six inches from your face</span>
        </div>
        <div class="hiw-versus-row" role="row">
          <span class="vr-label" role="rowheader">What you dismiss with</span>
          <span class="vr-moov" role="cell">A palm on a ring</span>
          <span class="vr-phone" role="cell">A swipe through notifications</span>
        </div>
        <div class="hiw-versus-row" role="row">
          <span class="vr-label" role="rowheader">What's on the screen</span>
          <span class="vr-moov" role="cell">Nothing — there is no screen</span>
          <span class="vr-phone" role="cell">Whatever the algorithm picked overnight</span>
        </div>
        <div class="hiw-versus-row" role="row">
          <span class="vr-label" role="rowheader">Battery cadence</span>
          <span class="vr-moov" role="cell">Twice a year</span>
          <span class="vr-phone" role="cell">Every night</span>
        </div>
        <div class="hiw-versus-row" role="row">
          <span class="vr-label" role="rowheader">Account required</span>
          <span class="vr-moov" role="cell">No</span>
          <span class="vr-phone" role="cell">Yes, and three more underneath it</span>
        </div>
        <div class="hiw-versus-row" role="row">
          <span class="vr-label" role="rowheader">Subscription</span>
          <span class="vr-moov" role="cell">No, ever</span>
          <span class="vr-phone" role="cell">Depends which alarm app you trust this week</span>
        </div>
        <div class="hiw-versus-row" role="row">
          <span class="vr-label" role="rowheader">Time you spend in app</span>
          <span class="vr-moov" role="cell">Two minutes a week</span>
          <span class="vr-phone" role="cell">Two hours a day</span>
        </div>
        <div class="hiw-versus-row" role="row">
          <span class="vr-label" role="rowheader">What you wake up to</span>
          <span class="vr-moov" role="cell">A walk and a press</span>
          <span class="vr-phone" role="cell">A feed</span>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%}07 FAQ — dark{%- endcomment -%}
  <section class="hiw-faq hiw-dark" aria-labelledby="hiw-faq-heading">
    <div class="hiw-inner">
      <div class="hiw-faq-grid">
        <div class="hiw-faq-head">
          <p class="hiw-eyebrow">Reasonable concerns</p>
          <h2 id="hiw-faq-heading" class="hiw-section-h2">The five we hear most.</h2>
        </div>
        <ul class="hiw-faq-list" role="list">
          <li>
            <details class="hiw-faq-item">
              <summary class="hiw-faq-q">
                <span>What if the room I want to mount in doesn't have power nearby?</span>
                <span class="hiw-faq-caret" aria-hidden="true"></span>
              </summary>
              <p class="hiw-faq-a">It doesn't need any. MOOV runs on its internal battery for around eight months. Charge it once via USB-C in the kitchen, hang it back up, forget about it.</p>
            </details>
          </li>
          <li>
            <details class="hiw-faq-item">
              <summary class="hiw-faq-q">
                <span>Will it wake me through a closed door?</span>
                <span class="hiw-faq-caret" aria-hidden="true"></span>
              </summary>
              <p class="hiw-faq-a">Yes. The front-facing speaker is tuned for tile and stone rooms — bathrooms, hallways. Five volume steps; most testers settle on three. If it's still not enough, we'll exchange for the louder firmware build, free.</p>
            </details>
          </li>
          <li>
            <details class="hiw-faq-item">
              <summary class="hiw-faq-q">
                <span>Can I snooze?</span>
                <span class="hiw-faq-caret" aria-hidden="true"></span>
              </summary>
              <p class="hiw-faq-a">No. That's the entire premise. If you press the ring, the alarm stops. If you don't, it stops on its own after ten minutes. There is no second chance because we found that second chance was the problem.</p>
            </details>
          </li>
          <li>
            <details class="hiw-faq-item">
              <summary class="hiw-faq-q">
                <span>What happens if I take MOOV off the wall and walk back to bed?</span>
                <span class="hiw-faq-caret" aria-hidden="true"></span>
              </summary>
              <p class="hiw-faq-a">It still rings until you press the ring, and you've already done the walk. It's not designed to catch you out — it's designed to make the first thirty seconds of the day involve standing.</p>
            </details>
          </li>
          <li>
            <details class="hiw-faq-item">
              <summary class="hiw-faq-q">
                <span>Do I need to use the app every day?</span>
                <span class="hiw-faq-caret" aria-hidden="true"></span>
              </summary>
              <p class="hiw-faq-a">No. Once the alarm is set, the app has nothing to show you. There are no graphs, no streaks, no notifications. Open it again only when the alarm needs to change.</p>
            </details>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%}08 CTA — cream{%- endcomment -%}
  <section class="hiw-cta hiw-cream" aria-label="Call to action">
    <div class="hiw-inner">
      <div class="hiw-cta-inner">
        <p class="hiw-eyebrow hiw-eyebrow--amber">Try it on your wall</p>
        <h2 class="hiw-cta-h2">{{ cta_heading | escape }} <em>If your morning doesn't change, send it back.</em></h2>
        <p class="hiw-cta-sub">{{ cta_sub | escape }}</p>
        <div class="hiw-cta-actions">
          <a href="{{ section.settings.cta_primary_url | default: '/products/moov' }}" class="hiw-btn hiw-btn--primary">
            {{ cta_primary_label | escape }}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="2" y1="7" x2="11" y2="7"/><polyline points="7,3.5 11,7 7,10.5"/></svg>
          </a>
          <a href="{{ section.settings.cta_secondary_url | default: '/pages/our-story' }}" class="hiw-btn hiw-btn--outline">
            {{ cta_secondary_label | escape }}
          </a>
        </div>
      </div>
    </div>
  </section>

</div>

{% stylesheet %}

/* ── Shared ── */
.hiw-page {
  display: flex;
  flex-direction: column;
}

.hiw-inner {
  width: 100%;
  max-width: var(--layout-max-width);
  margin-inline: auto;
  padding-inline: var(--section-inline-pad);
}

.hiw-dark  { background: var(--moov-black); color: var(--moov-cream); }
.hiw-cream { background: var(--moov-cream); color: var(--moov-black); }

.hiw-eyebrow {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-eyebrow);
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-amber);
}

.hiw-eyebrow--amber { color: var(--moov-amber); }

.hiw-section-head {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: clamp(32px, 5vw, 56px);
  max-width: 60ch;
}

.hiw-section-h2 {
  margin: 0;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: var(--text-heading-xl);
  line-height: 1.05;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: var(--moov-cream);
}

.hiw-h2-dark { color: var(--moov-black); }

.hiw-section-h2 em {
  font-style: italic;
  color: var(--moov-amber);
}

/* ── Buttons ── */
.hiw-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.9rem 1.6rem;
  border-radius: 999px;
  font-family: var(--font-body);
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;
}

.hiw-btn--primary {
  background: var(--moov-black);
  color: var(--moov-cream);
  border: 1px solid transparent;
}

.hiw-btn--primary:hover {
  background: color-mix(in srgb, var(--moov-black) 85%, var(--moov-cream));
  transform: translateY(-1px);
}

.hiw-btn--outline {
  background: transparent;
  color: var(--moov-black);
  border: 1px solid color-mix(in srgb, var(--moov-black) 30%, transparent);
}

.hiw-btn--outline:hover {
  background: color-mix(in srgb, var(--moov-black) 6%, transparent);
  transform: translateY(-1px);
}

/* ==========================================================
   01 HERO
   ========================================================== */
.hiw-hero {
  padding-block: clamp(4rem, 8vw, 7rem);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-hero-grid {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: clamp(28px, 5vw, 80px);
  align-items: end;
}

.hiw-hero-copy {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.hiw-hero-h1 {
  margin: 0;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: clamp(2.2rem, 5.5vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.025em;
  text-transform: uppercase;
  color: var(--moov-cream);
}

.hiw-hero-sub {
  margin: 0;
  font-size: var(--text-md);
  line-height: 1.6;
  color: var(--moov-text-secondary-dark);
  max-width: 44ch;
  align-self: end;
  padding-bottom: 0.4rem;
}

/* ==========================================================
   02 THREE STEPS
   ========================================================== */
.hiw-flow {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid color-mix(in srgb, var(--moov-black) 12%, transparent);
}

.hiw-flow-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28px;
}

.hiw-step {
  display: flex;
  flex-direction: column;
}

.hiw-step-frame {
  position: relative;
  aspect-ratio: 4 / 5;
  border-radius: var(--radius-card, 16px);
  overflow: hidden;
  background: color-mix(in srgb, var(--moov-black) 8%, var(--moov-cream));
  margin-bottom: 18px;
  border: 1px solid color-mix(in srgb, var(--moov-black) 10%, transparent);
}

.hiw-step-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.hiw-step-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hiw-placeholder-label {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--moov-black) 25%, transparent);
  text-align: center;
  line-height: 1.8;
}

.hiw-step-num {
  position: absolute;
  left: 14px;
  bottom: 14px;
  z-index: 1;
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-cream);
  background: rgba(10, 10, 9, 0.70);
  padding: 5px 11px;
  border-radius: 999px;
}

.hiw-step-title {
  margin: 0 0 8px;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: var(--text-heading-md);
  line-height: 1.05;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--moov-black);
}

.hiw-step-body {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.65;
  color: var(--moov-text-secondary-light);
  max-width: 36ch;
}

/* ==========================================================
   03 TIMELINE
   ========================================================== */
.hiw-timeline {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-time-list {
  list-style: none;
  margin: 0;
  padding: 0;
  position: relative;
}

.hiw-time-list::before {
  content: "";
  position: absolute;
  left: 162px;
  top: 6px;
  bottom: 6px;
  width: 1px;
  background: var(--moov-border-dark);
}

.hiw-time-list li {
  display: grid;
  grid-template-columns: 140px 24px 1fr;
  gap: 20px;
  align-items: start;
  padding: 32px 0;
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-time-list li:last-child { border-bottom: none; }

.hiw-time-stamp {
  font-family: var(--font-hero);
  font-weight: 700;
  font-size: var(--text-md);
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--moov-amber);
  padding-top: 2px;
}

.hiw-time-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--moov-amber);
  box-shadow: 0 0 0 4px var(--moov-black);
  margin: 8px 0 0 6px;
  flex-shrink: 0;
}

.hiw-time-copy h4 {
  margin: 0 0 10px;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: var(--text-heading-sm);
  line-height: 1.1;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--moov-cream);
}

.hiw-time-copy p {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.75;
  color: var(--moov-text-secondary-dark);
  max-width: 52ch;
}

/* ==========================================================
   04 MOUNT
   ========================================================== */
.hiw-mount {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid color-mix(in srgb, var(--moov-black) 12%, transparent);
}

.hiw-mount-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: clamp(28px, 5vw, 80px);
  align-items: center;
}

.hiw-mount-copy {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hiw-mount-lede {
  margin: 0;
  font-size: var(--text-base);
  line-height: 1.65;
  color: var(--moov-text-secondary-light);
  max-width: 42ch;
}

.hiw-mount-rental {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.6;
  color: var(--moov-text-tertiary-light);
  max-width: 40ch;
}

.hiw-mount-list {
  list-style: none;
  margin: 4px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}

.hiw-mount-list li {
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 12px;
  padding: 14px 0;
  border-top: 1px solid var(--moov-border-light);
  font-size: var(--text-sm);
  line-height: 1.55;
  color: var(--moov-text-primary-light);
}

.hiw-mount-list li:last-child { border-bottom: 1px solid var(--moov-border-light); }

.hiw-mount-list li span {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-amber);
  padding-top: 2px;
}

.hiw-mount-media {
  margin: 0;
  aspect-ratio: 3 / 4;
  max-height: 700px;
  border-radius: var(--radius-card, 16px);
  overflow: hidden;
  background: color-mix(in srgb, var(--moov-black) 8%, var(--moov-cream));
}

.hiw-mount-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ==========================================================
   05 ANATOMY
   ========================================================== */
.hiw-anatomy {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-anatomy-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: clamp(28px, 5vw, 80px);
  align-items: start;
}

.hiw-anatomy-shot {
  margin: 0;
  aspect-ratio: 4 / 5;
  border-radius: var(--radius-card, 16px);
  overflow: hidden;
  background: var(--moov-surface-dark-elevated);
  position: sticky;
  top: calc(var(--header-height, 5rem) + 24px);
}

.hiw-anatomy-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.hiw-parts-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid var(--moov-border-dark);
}

.hiw-parts-list li {
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: 12px;
  padding: 20px 18px 22px 0;
  border-right: 1px solid var(--moov-border-dark);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-parts-list li:nth-child(2n) { border-right: none; }

.hiw-part-n {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-amber);
  padding-top: 3px;
}

.hiw-parts-list h4 {
  margin: 0 0 6px;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: var(--text-heading-sm);
  line-height: 1.1;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--moov-cream);
}

.hiw-parts-list p {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.55;
  color: var(--moov-text-secondary-dark);
  max-width: 28ch;
}

/* ==========================================================
   06 VERSUS
   ========================================================== */
.hiw-versus {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid color-mix(in srgb, var(--moov-black) 12%, transparent);
}

.hiw-versus-table {
  display: flex;
  flex-direction: column;
}

.hiw-versus-row {
  display: grid;
  grid-template-columns: 1.2fr 1.4fr 1.4fr;
  gap: 24px;
  padding: 18px 0;
  border-top: 1px solid var(--moov-border-light);
  font-size: var(--text-base);
  line-height: 1.5;
}

.hiw-versus-row:last-child { border-bottom: 1px solid var(--moov-border-light); }

.hiw-versus-head {
  padding: 12px 0;
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-text-tertiary-light);
}

.vr-label {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--moov-text-tertiary-light);
  padding-top: 4px;
}

.vr-moov {
  color: var(--moov-black);
  font-weight: 500;
}

.hiw-versus-head .vr-moov { color: var(--moov-amber); font-weight: 500; }

.vr-phone {
  color: var(--moov-text-secondary-light);
  text-decoration: line-through;
  text-decoration-color: rgba(10, 10, 9, 0.22);
  text-decoration-thickness: 1px;
}

.hiw-versus-head .vr-phone {
  text-decoration: none;
  color: var(--moov-text-tertiary-light);
}

/* ==========================================================
   07 FAQ
   ========================================================== */
.hiw-faq {
  padding-block: var(--section-block-pad-y-md);
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-faq-grid {
  display: grid;
  grid-template-columns: minmax(200px, 340px) 1fr;
  gap: clamp(2rem, 5vw, 5rem);
  align-items: start;
}

.hiw-faq-head {
  position: sticky;
  top: calc(var(--header-height, 5rem) + 24px);
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.hiw-faq-list {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--moov-border-dark);
}

.hiw-faq-item {
  border-bottom: 1px solid var(--moov-border-dark);
}

.hiw-faq-q {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 16px;
  padding: 20px 0;
  cursor: pointer;
  list-style: none;
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: 500;
  line-height: 1.4;
  color: var(--moov-cream);
  user-select: none;
}

.hiw-faq-q::-webkit-details-marker { display: none; }

.hiw-faq-caret {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 1px solid var(--moov-border-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
  position: relative;
  transition: border-color 0.2s ease;
}

.hiw-faq-caret::before,
.hiw-faq-caret::after {
  content: "";
  position: absolute;
  background: var(--moov-cream);
  border-radius: 1px;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.hiw-faq-caret::before { width: 8px; height: 1.5px; }
.hiw-faq-caret::after  { width: 1.5px; height: 8px; }

details[open] .hiw-faq-caret::after { transform: rotate(90deg); opacity: 0; }
details[open] .hiw-faq-q { color: var(--moov-amber); }

.hiw-faq-a {
  margin: 0;
  padding: 0 0 20px;
  font-size: var(--text-sm);
  line-height: 1.65;
  color: var(--moov-text-secondary-dark);
  max-width: 54ch;
}

/* ==========================================================
   08 CTA
   ========================================================== */
.hiw-cta {
  padding-block: var(--section-block-pad-y-md);
  text-align: center;
}

.hiw-cta-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  max-width: 60ch;
  margin: 0 auto;
}

.hiw-cta-h2 {
  margin: 0;
  font-family: var(--font-hero);
  font-weight: 500;
  font-size: clamp(1.9rem, 4.2vw, 3.75rem);
  line-height: 1.02;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: var(--moov-black);
}

.hiw-cta-h2 em {
  font-style: italic;
  color: var(--moov-amber);
}

.hiw-cta-sub {
  margin: 0;
  font-size: var(--text-md);
  line-height: 1.6;
  color: var(--moov-text-secondary-light);
  max-width: 44ch;
}

.hiw-cta-actions {
  display: flex;
  gap: 12px;
  margin-top: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

/* ==========================================================
   RESPONSIVE
   ========================================================== */
@media (max-width: 880px) {
  .hiw-hero-grid  { grid-template-columns: 1fr; }
  .hiw-mount-grid { grid-template-columns: 1fr; }
  .hiw-mount-grid .hiw-mount-media { order: -1; }
  .hiw-anatomy-grid { grid-template-columns: 1fr; }
  .hiw-anatomy-shot { position: static; aspect-ratio: 16 / 10; }
  .hiw-flow-grid  { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hiw-faq-grid   { grid-template-columns: 1fr; }
  .hiw-faq-head   { position: static; }
}

@media (max-width: 720px) {
  .hiw-time-list::before { left: 6px; }
  .hiw-time-list li { grid-template-columns: 24px 1fr; gap: 14px; }
  .hiw-time-stamp { grid-column: 2; font-size: var(--text-sm); }
  .hiw-time-dot { margin-top: 4px; }
  .hiw-versus-row { grid-template-columns: 1fr; gap: 6px; }
  .hiw-versus-head { display: none; }
  .vr-moov::before { content: "MOOV · "; color: var(--moov-amber); }
  .vr-phone::before { content: "Phone · "; color: var(--moov-text-tertiary-light); }
}

@media (max-width: 600px) {
  .hiw-flow-grid  { grid-template-columns: 1fr; }
  .hiw-step-frame { aspect-ratio: 16 / 10; }
  .hiw-parts-list { grid-template-columns: 1fr; }
  .hiw-parts-list li { border-right: none; }
}

{% endstylesheet %}

