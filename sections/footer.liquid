{%- liquid
  assign current_year = 'now' | date: '%Y'

  assign newsletter_heading = section.settings.newsletter_heading
  if newsletter_heading == blank
    assign newsletter_heading = 'store_marketing.newsletter_heading' | t
  endif

  assign newsletter_body = section.settings.newsletter_body
  if newsletter_body == blank
    assign newsletter_body = 'store_marketing.newsletter_body' | t
  endif
-%}

<footer class="footer full-width" data-surface="dark">

  {%- comment -%} Part 1 — Community callout card {%- endcomment -%}
  <div class="footer__outer">
    <div class="footer__card" data-animate="footer-card">

      <div class="footer__card-left">
        {%- if section.settings.community_eyebrow != blank -%}
          <p class="footer__card-eyebrow">{{ section.settings.community_eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="footer__card-heading">{{ section.settings.community_heading | escape }}</h2>

        {%- if section.settings.community_body != blank -%}
          <p class="footer__card-body">{{ section.settings.community_body | escape }}</p>
        {%- endif -%}

        {%- if section.settings.community_cta_label != blank -%}
          <a
            href="{{ section.settings.community_cta_url | default: '#community' }}"
            class="footer__card-cta"
          >
            {{- section.settings.community_cta_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <div class="footer__card-visual" aria-hidden="true">
        <div class="footer__card-glow"></div>
        <svg class="footer__card-orbits" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="200" cy="200" r="72"  stroke="rgba(240,180,41,0.18)" stroke-width="1"/>
          <circle cx="200" cy="200" r="120" stroke="rgba(240,180,41,0.11)" stroke-width="1"/>
          <circle cx="200" cy="200" r="170" stroke="rgba(240,180,41,0.06)" stroke-width="1"/>
          <circle cx="200" cy="128" r="4.5" fill="rgba(240,180,41,0.55)"/>
          <circle cx="285" cy="238" r="3"   fill="rgba(240,180,41,0.4)"/>
          <circle cx="128" cy="272" r="2.5" fill="rgba(240,180,41,0.32)"/>
          <circle cx="248" cy="76"  r="2"   fill="rgba(240,180,41,0.28)"/>
          <circle cx="56"  cy="182" r="2"   fill="rgba(240,180,41,0.22)"/>
          <circle cx="320" cy="148" r="1.5" fill="rgba(240,180,41,0.18)"/>
        </svg>
      </div>

    </div>
  </div>

  {%- comment -%} Part 2 — Footer columns {%- endcomment -%}
  <div class="footer__columns-wrapper">
    <div class="footer__columns">

      {%- comment -%} Column 1 — Brand {%- endcomment -%}
      <div class="footer__col footer__col--brand">
        <a href="{{ routes.root_url }}" class="footer__logo">MOOV</a>
        {%- if section.settings.brand_tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.brand_tagline | escape }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Column 2 — Company {%- endcomment -%}
      <div class="footer__col">
        <p class="footer__col-heading">{{ 'general.company' | t }}</p>
        <ul class="footer__links">
          {%- for i in (1..4) -%}
            {%- liquid
              case i
                when 1
                  assign lbl = section.settings.company_link_1_label
                  assign lurl = section.settings.company_link_1_url
                when 2
                  assign lbl = section.settings.company_link_2_label
                  assign lurl = section.settings.company_link_2_url
                when 3
                  assign lbl = section.settings.company_link_3_label
                  assign lurl = section.settings.company_link_3_url
                when 4
                  assign lbl = section.settings.company_link_4_label
                  assign lurl = section.settings.company_link_4_url
              endcase
            -%}
            {%- if lbl != blank -%}
              <li><a href="{{ lurl | default: '#' }}" class="footer__link">{{ lbl | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Column 3 — Socials {%- endcomment -%}
      <div class="footer__col">
        <p class="footer__col-heading">{{ 'general.socials' | t }}</p>
        <ul class="footer__links">
          {%- if section.settings.instagram_url != blank -%}
            <li>
              <a href="{{ section.settings.instagram_url }}" class="footer__link" target="_blank" rel="noopener noreferrer">
                Instagram <span class="footer__link-arrow" aria-hidden="true">&nearr;</span>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <li>
              <a href="{{ section.settings.tiktok_url }}" class="footer__link" target="_blank" rel="noopener noreferrer">
                TikTok <span class="footer__link-arrow" aria-hidden="true">&nearr;</span>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.twitter_url != blank -%}
            <li>
              <a href="{{ section.settings.twitter_url }}" class="footer__link" target="_blank" rel="noopener noreferrer">
                Twitter / X <span class="footer__link-arrow" aria-hidden="true">&nearr;</span>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.linkedin_url != blank -%}
            <li>
              <a href="{{ section.settings.linkedin_url }}" class="footer__link" target="_blank" rel="noopener noreferrer">
                LinkedIn <span class="footer__link-arrow" aria-hidden="true">&nearr;</span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Column 4 — Newsletter {%- endcomment -%}
      <div class="footer__col footer__col--newsletter">
        <p class="footer__col-heading">{{ newsletter_heading | escape }}</p>
        {%- if newsletter_body != blank -%}
          <p class="footer__newsletter-body">{{ newsletter_body | escape }}</p>
        {%- endif -%}
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer__newsletter-field">
            <label for="footer-email-{{ section.id }}" class="footer__newsletter-label">{{ 'sections.footer.newsletter_email_label' | t }}</label>
            <input
              type="email"
              id="footer-email-{{ section.id }}"
              name="contact[email]"
              class="footer__newsletter-input"
              placeholder="{{ 'sections.footer.newsletter_placeholder' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="footer__newsletter-submit" aria-label="{{ 'sections.footer.newsletter_submit' | t }}">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {% endform %}
      </div>

    </div>
  </div>

  {%- if section.settings.show_impact_line -%}
    <div class="footer__impact-wrapper">
      <p class="footer__impact">{{ 'store_marketing.impact_micro_line' | t }}</p>
    </div>
  {%- endif -%}

  {%- comment -%} Part 3 — Legal bar {%- endcomment -%}
  <div class="footer__legal-wrapper">
    <div class="footer__legal">
      <p class="footer__copyright">
        &copy; {{ current_year }} {{ section.settings.copyright_name | default: 'MOOV Technologies' | escape }} &middot; All rights reserved
      </p>
      <div class="footer__legal-links">
        {%- if section.settings.privacy_url != blank -%}
          <a href="{{ section.settings.privacy_url }}" class="footer__legal-link">Privacy Policy</a>
        {%- endif -%}
        {%- if section.settings.privacy_url != blank and section.settings.terms_url != blank -%}
          <span class="footer__legal-sep" aria-hidden="true">&middot;</span>
        {%- endif -%}
        {%- if section.settings.terms_url != blank -%}
          <a href="{{ section.settings.terms_url }}" class="footer__legal-link">Terms of Service</a>
        {%- endif -%}
      </div>
    </div>
  </div>

</footer>

{% stylesheet %}
  .footer {
    background: var(--moov-black);
    padding-top: var(--section-block-pad-y-lg);
  }

  .footer__outer,
  .footer__columns-wrapper,
  .footer__impact-wrapper,
  .footer__legal-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: var(--section-inline-pad);
    padding-right: var(--section-inline-pad);
  }

  .footer__impact-wrapper {
    padding-top: var(--section-block-pad-y-sm);
    padding-bottom: var(--section-block-pad-y-sm);
    border-top: 0.5px solid var(--moov-border-dark);
  }

  .footer__impact {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    line-height: 1.55;
    color: var(--moov-text-tertiary-dark);
    text-align: center;
    margin: 0;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── Part 1: Community card ─── */
  .footer__card {
    background: var(--moov-surface-dark-raised);
    border-radius: 20px;
    border: 0.5px solid var(--moov-border-dark);
    padding: var(--section-block-pad-y-md) clamp(2rem, 5vw, 4.5rem);
    margin-bottom: var(--section-block-pad-y-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
    overflow: hidden;
    position: relative;
  }

  .footer__card-left {
    position: relative;
    z-index: 1;
  }

  .footer__card-eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-eyebrow-accent);
    margin: 0 0 16px;
  }

  .footer__card-heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.15;
    color: var(--moov-text-primary-dark);
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .footer__card-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.7;
    color: var(--moov-text-secondary-dark);
    max-width: 380px;
    margin: 0 0 36px;
  }

  .footer__card-cta {
    display: inline-block;
    padding: 14px 28px;
    background: var(--moov-cream);
    color: var(--moov-black);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-radius: var(--style-border-radius-buttons);
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .footer__card-cta:hover {
    background: var(--moov-amber);
    transform: translateY(-1px);
  }

  .footer__card-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 280px;
  }

  .footer__card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, var(--moov-amber-glow) 0%, transparent 70%);
    pointer-events: none;
  }

  .footer__card-orbits {
    width: 300px;
    height: 300px;
  }

  /* ─── Part 2: Footer columns ─── */
  .footer__columns-wrapper {
    border-top: 0.5px solid var(--moov-border-dark);
  }

  .footer__columns {
    display: grid;
    grid-template-columns: 30fr 20fr 20fr 30fr;
    gap: 48px;
    padding: var(--section-block-pad-y-lg) 0 var(--section-block-pad-y-md);
  }

  .footer__logo {
    display: block;
    font-family: var(--font-wordmark);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--moov-text-primary-dark);
    text-decoration: none;
    margin-bottom: 16px;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.7;
    color: var(--moov-text-tertiary-dark);
    max-width: 220px;
    margin: 0;
  }

  .footer__col-heading {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-text-primary-dark);
    margin: 0 0 24px;
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--moov-text-secondary-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__link:hover {
    color: var(--moov-text-primary-dark);
  }

  .footer__link-arrow {
    color: var(--moov-text-tertiary-dark);
    transition: color 0.2s ease;
  }

  .footer__link:hover .footer__link-arrow {
    color: var(--moov-text-primary-dark);
  }

  /* Newsletter */
  .footer__newsletter-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.6;
    color: var(--moov-text-secondary-dark);
    margin: 0 0 24px;
  }

  .footer__newsletter-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .footer__newsletter-field {
    position: relative;
  }

  .footer__newsletter-input {
    width: 100%;
    padding: 14px 52px 14px 16px;
    background: var(--moov-surface-dark-raised);
    border: 0.5px solid var(--moov-border-dark);
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--moov-text-primary-dark);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .footer__newsletter-input::placeholder {
    color: var(--moov-text-tertiary-dark);
  }

  .footer__newsletter-input:focus {
    border-color: var(--moov-border-amber);
  }

  .footer__newsletter-submit {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    background: var(--moov-cream);
    color: var(--moov-black);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    flex-shrink: 0;
  }

  .footer__newsletter-submit:hover {
    background: var(--moov-amber);
  }

  /* ─── Part 3: Legal bar ─── */
  .footer__legal-wrapper {
    border-top: 0.5px solid var(--moov-border-dark);
  }

  .footer__legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--section-block-pad-y-sm) 0;
  }

  .footer__copyright {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--moov-text-tertiary-dark);
    margin: 0;
  }

  .footer__legal-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer__legal-link {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--moov-text-tertiary-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__legal-link:hover {
    color: var(--moov-text-primary-dark);
  }

  .footer__legal-sep {
    color: var(--moov-text-tertiary-dark);
    font-size: var(--text-xs);
  }

  /* ─── Scroll animation ─── */
  [data-animate="footer-card"] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  [data-animate="footer-card"].is-visible {
    opacity: 1;
    transform: none;
  }

  /* ─── Tablet ─── */
  @media (min-width: 768px) and (max-width: 1279px) {
    .footer__card {
      grid-template-columns: 55fr 45fr;
      padding: var(--section-block-pad-y-md) var(--section-inline-pad);
    }

    .footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: 40px 48px;
    }
  }

  /* ─── Mobile ─── */
  @media (max-width: 767px) {
    .footer__card {
      grid-template-columns: 1fr;
      padding: var(--section-block-pad-y-md) var(--section-inline-pad);
      gap: 0;
    }

    .footer__card-visual {
      display: none;
    }

    .footer__card-body {
      max-width: 100%;
    }

    .footer__columns {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: var(--section-block-pad-y-md) 0;
    }

    .footer__legal {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var card = document.querySelector('[data-animate="footer-card"]');
    if (!card) return;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(card);
  })();
{% endjavascript %}

