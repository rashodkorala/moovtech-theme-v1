{%- liquid
  assign current_year = 'now' | date: '%Y'

  assign newsletter_heading = section.settings.newsletter_heading
  if newsletter_heading == blank
    assign newsletter_heading = 'store_marketing.newsletter_heading' | t
  endif
-%}

<footer class="footer full-width">

  {%- comment -%} ── Dark rounded card ── {%- endcomment -%}
  <div class="footer__card-wrap">
    <div class="footer__card">

      {%- comment -%} Brand top — wordmark + tagline + social icons {%- endcomment -%}
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__wordmark">
          {{- section.settings.footer_logo_text | default: 'MOOV' | escape -}}
        </a>

        {%- if section.settings.brand_tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.brand_tagline | escape }}</p>
        {%- endif -%}

        <div class="footer__social-row">
          {%- if section.settings.twitter_url != blank -%}
            <a href="{{ section.settings.twitter_url }}" class="footer__social-icon" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.402 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" class="footer__social-icon" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M24 12.073C24 5.404 18.627 0 12 0S0 5.404 0 12.073c0 6.03 4.389 11.03 10.125 11.927v-8.434H7.078v-3.493h3.047V9.43c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.885v2.25h3.328l-.532 3.493h-2.796v8.434C19.612 23.103 24 18.103 24 12.073Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="footer__social-icon" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069Zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" class="footer__social-icon" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" class="footer__social-icon" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="footer__card-divider"></div>

      {%- comment -%} 4-column grid: Shop / Information / Company / Newsletter {%- endcomment -%}
      <div class="footer__columns">

        {%- comment -%} Shop column {%- endcomment -%}
        <div class="footer__col">
          <p class="footer__col-heading">{{ section.settings.col_heading_shop | default: 'Shop' | escape }}</p>
          <ul class="footer__links">
            {%- for i in (1..4) -%}
              {%- liquid
                case i
                  when 1
                    assign lbl = section.settings.shop_link_1_label
                    assign lurl = section.settings.shop_link_1_url
                  when 2
                    assign lbl = section.settings.shop_link_2_label
                    assign lurl = section.settings.shop_link_2_url
                  when 3
                    assign lbl = section.settings.shop_link_3_label
                    assign lurl = section.settings.shop_link_3_url
                  when 4
                    assign lbl = section.settings.shop_link_4_label
                    assign lurl = section.settings.shop_link_4_url
                endcase
              -%}
              {%- if lbl != blank -%}
                <li><a href="{{ lurl | default: '#' }}" class="footer__link">{{ lbl | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        {%- comment -%} Information column {%- endcomment -%}
        <div class="footer__col">
          <p class="footer__col-heading">{{ section.settings.col_heading_information | default: 'Information' | escape }}</p>
          <ul class="footer__links">
            {%- for i in (1..4) -%}
              {%- liquid
                case i
                  when 1
                    assign lbl = section.settings.info_link_1_label
                    assign lurl = section.settings.info_link_1_url
                  when 2
                    assign lbl = section.settings.info_link_2_label
                    assign lurl = section.settings.info_link_2_url
                  when 3
                    assign lbl = section.settings.info_link_3_label
                    assign lurl = section.settings.info_link_3_url
                  when 4
                    assign lbl = section.settings.info_link_4_label
                    assign lurl = section.settings.info_link_4_url
                endcase
              -%}
              {%- if lbl != blank -%}
                <li><a href="{{ lurl | default: '#' }}" class="footer__link">{{ lbl | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        {%- comment -%} Company column {%- endcomment -%}
        <div class="footer__col">
          <p class="footer__col-heading">{{ section.settings.col_heading_company | default: 'Company' | escape }}</p>
          <ul class="footer__links">
            {%- for i in (1..4) -%}
              {%- liquid
                case i
                  when 1
                    assign lbl = section.settings.company_link_1_label
                    assign lurl = section.settings.company_link_1_url
                  when 2
                    assign lbl = section.settings.company_link_2_label
                    assign lurl = section.settings.company_link_2_url
                  when 3
                    assign lbl = section.settings.company_link_3_label
                    assign lurl = section.settings.company_link_3_url
                  when 4
                    assign lbl = section.settings.company_link_4_label
                    assign lurl = section.settings.company_link_4_url
                endcase
              -%}
              {%- if lbl != blank -%}
                <li><a href="{{ lurl | default: '#' }}" class="footer__link">{{ lbl | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        {%- comment -%} Newsletter column {%- endcomment -%}
        <div class="footer__col footer__col--newsletter">
          <p class="footer__col-heading">{{ newsletter_heading | escape }}</p>
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer__newsletter-field">
              <label for="footer-email-{{ section.id }}" class="footer__newsletter-label">{{ 'sections.footer.newsletter_email_label' | t }}</label>
              <input
                type="email"
                id="footer-email-{{ section.id }}"
                name="contact[email]"
                class="footer__newsletter-input"
                placeholder="{{ 'sections.footer.newsletter_placeholder' | t }}"
                autocomplete="email"
                required
              >
              <button type="submit" class="footer__newsletter-submit" aria-label="{{ 'sections.footer.newsletter_submit' | t }}">
                {{ 'sections.footer.newsletter_submit' | t }} &nearr;
              </button>
            </div>
            {%- if section.settings.newsletter_privacy_url != blank -%}
              <p class="footer__newsletter-privacy">
                <label class="footer__privacy-check">
                  <input type="checkbox" required class="footer__privacy-checkbox">
                  <span>{{ 'sections.footer.privacy_accept' | t }}
                    <a href="{{ section.settings.newsletter_privacy_url }}" class="footer__privacy-link">{{ 'sections.footer.privacy_policy' | t }}</a>
                  </span>
                </label>
              </p>
            {%- endif -%}
          {% endform %}
        </div>

      </div>

    </div>
  </div>

  {%- comment -%} ── Legal bar — outside the card ── {%- endcomment -%}
  <div class="footer__legal-wrap">
    <div class="footer__legal">
      <p class="footer__copyright">
        &copy; {{ current_year }} {{ section.settings.copyright_name | default: 'MOOV Technologies' | escape }}.
        {%- if section.settings.powered_by_shopify -%}
          {{ powered_by_link }}
        {%- endif -%}
      </p>

      <div class="footer__legal-center">
        {%- if section.settings.show_currency_selector -%}
          {% form 'localization', id: 'footer-localization-form', class: 'footer__currency-form' %}
            <div class="footer__currency-select-wrap">
              <select
                name="currency_code"
                id="footer-currency-{{ section.id }}"
                class="footer__currency-select"
                onchange="this.form.submit()"
                aria-label="{{ 'general.currency_selector' | t }}"
              >
                {%- for currency in localization.available_countries -%}
                  <option
                    value="{{ currency.iso_code }}"
                    {%- if currency.iso_code == localization.country.currency.iso_code %} selected{%- endif -%}
                  >
                    {{ currency.iso_code }} {{ currency.currency.symbol }}
                  </option>
                {%- endfor -%}
              </select>
              <svg class="footer__currency-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {% endform %}
        {%- endif -%}
      </div>

      <div class="footer__payment-icons">
        {%- if section.settings.show_payment_icons -%}
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>

</footer>

{% stylesheet %}
  /* ── Outer footer shell ── */
  .footer {
    background: var(--moov-bg-light, #f5f5f4);
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 4vw, 2.5rem) 0;
  }

  /* ── Dark rounded card ── */
  .footer__card-wrap {
    max-width: 1280px;
    margin: 0 auto;
  }

  .footer__card {
    background: var(--moov-black, #0d0d0d);
    border-radius: 20px;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem);
  }

  /* ── Brand top ── */
  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: 2.5rem;
  }

  .footer__wordmark {
    display: block;
    font-family: var(--font-wordmark);
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--moov-text-primary-dark);
    text-decoration: none;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1.6;
    color: var(--moov-text-secondary-dark);
    max-width: 34rem;
    margin: 0 0 1.5rem;
  }

  /* Social icons row */
  .footer__social-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--moov-text-secondary-dark);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .footer__social-icon:hover {
    background: rgba(255, 255, 255, 0.14);
    color: var(--moov-text-primary-dark);
  }

  /* Divider */
  .footer__card-divider {
    height: 0.5px;
    background: var(--moov-border-dark);
    margin-bottom: 2.5rem;
  }

  /* ── 4-column grid ── */
  .footer__columns {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.4fr;
    gap: 40px 48px;
  }

  .footer__col-heading {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--moov-text-primary-dark);
    margin: 0 0 20px;
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-secondary-dark);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__link:hover {
    color: var(--moov-text-primary-dark);
  }

  /* Newsletter */
  .footer__newsletter-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .footer__newsletter-field {
    display: flex;
    border: 0.5px solid var(--moov-border-dark);
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255,255,255,0.04);
    transition: border-color 0.2s ease;
  }

  .footer__newsletter-field:focus-within {
    border-color: rgba(255,255,255,0.3);
  }

  .footer__newsletter-input {
    flex: 1;
    padding: 12px 14px;
    background: transparent;
    border: none;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--moov-text-primary-dark);
    outline: none;
    min-width: 0;
  }

  .footer__newsletter-input::placeholder {
    color: var(--moov-text-tertiary-dark);
  }

  .footer__newsletter-submit {
    flex-shrink: 0;
    padding: 10px 16px;
    margin: 4px 4px 4px 0;
    background: var(--moov-cream);
    color: var(--moov-black);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    white-space: nowrap;
    transition: background 0.2s ease;
  }

  .footer__newsletter-submit:hover {
    background: var(--moov-amber);
  }

  .footer__newsletter-privacy {
    margin: 12px 0 0;
  }

  .footer__privacy-check {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--moov-text-tertiary-dark);
    line-height: 1.5;
  }

  .footer__privacy-checkbox {
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: var(--moov-cream);
  }

  .footer__privacy-link {
    color: var(--moov-text-secondary-dark);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .footer__privacy-link:hover {
    color: var(--moov-text-primary-dark);
  }

  /* ── Legal bar ── */
  .footer__legal-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(0.25rem, 1vw, 0.5rem);
  }

  .footer__legal {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 1.25rem 0;
    gap: 16px;
  }

  .footer__copyright {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--moov-black);
    margin: 0;
    opacity: 0.5;
  }

  .footer__legal-center {
    display: flex;
    justify-content: center;
  }

  /* Currency selector */
  .footer__currency-form {
    margin: 0;
  }

  .footer__currency-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .footer__currency-select {
    appearance: none;
    background: transparent;
    border: 0.5px solid rgba(0,0,0,0.2);
    border-radius: 6px;
    padding: 4px 28px 4px 10px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--moov-black);
    cursor: pointer;
    outline: none;
    opacity: 0.6;
  }

  .footer__currency-caret {
    position: absolute;
    right: 8px;
    pointer-events: none;
    color: var(--moov-black);
    opacity: 0.5;
  }

  /* Payment icons */
  .footer__payment-icons {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    flex-wrap: wrap;
  }

  .footer__payment-icon {
    height: 22px;
    border-radius: 3px;
    opacity: 0.55;
  }

  /* ── Tablet ── */
  @media (min-width: 768px) and (max-width: 1023px) {
    .footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: 36px 40px;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .footer {
      padding: 1rem 1rem 0;
    }

    .footer__card {
      border-radius: 14px;
      padding: 2rem 1.25rem;
    }

    .footer__wordmark {
      font-size: clamp(3rem, 14vw, 4.5rem);
    }

    .footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }

    .footer__col--newsletter {
      grid-column: 1 / -1;
    }

    .footer__legal {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 1rem 0;
    }

    .footer__legal-center {
      justify-content: flex-start;
    }

    .footer__payment-icons {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "footer_logo_text",
      "label": "Wordmark text",
      "default": "MOOV"
    },
    {
      "type": "textarea",
      "id": "brand_tagline",
      "label": "t:labels.tagline",
      "default": "Better mornings, better minds. The morning system built for intentional living."
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X / Twitter URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Shop column"
    },
    {
      "type": "text",
      "id": "col_heading_shop",
      "label": "Column heading",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "shop_link_1_label",
      "label": "Link 1 label",
      "default": "MOOV Alarm"
    },
    {
      "type": "url",
      "id": "shop_link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
