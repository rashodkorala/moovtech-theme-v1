{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign visible_count = section.settings.visible_count | default: 3
  assign expand_label = section.settings.expand_label | default: 'Show more reviews'
  assign collapse_label = section.settings.collapse_label | default: 'Show fewer reviews'
  assign cta_label = section.settings.cta_label
  assign cta_url = section.settings.cta_url

  assign total_blocks = section.blocks.size
  assign has_overflow = false
  if total_blocks > visible_count
    assign has_overflow = true
  endif
-%}

<section
  class="home-reviews full-width"
  aria-labelledby="home-reviews-heading-{{ section.id }}"
  data-expanded="false"
>
  <div class="home-reviews__inner">
    {%- if eyebrow != blank or heading != blank or body != blank -%}
      <header class="home-reviews__header">
        {%- if eyebrow != blank -%}
          <p class="home-reviews__eyebrow">{{ eyebrow | escape }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 id="home-reviews-heading-{{ section.id }}" class="home-reviews__heading">
            {{- heading | escape -}}
          </h2>
        {%- endif -%}
        {%- if body != blank -%}
          <p class="home-reviews__body">{{ body | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if total_blocks > 0 -%}
      <ul
        class="home-reviews__grid"
        role="list"
        data-visible-count="{{ visible_count }}"
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            {%- liquid
              assign rating = block.settings.rating | default: 5
              assign is_overflow = false
              if forloop.index > visible_count
                assign is_overflow = true
              endif
            -%}

            <li
              class="home-reviews__item"
              data-overflow="{{ is_overflow }}"
              {% if is_overflow %}
                hidden
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <article class="review-card">
                <div
                  class="review-card__stars"
                  aria-label="{{ 'sections.reviews.stars_label' | t: count: rating }}"
                >
                  {%- for i in (1..5) -%}
                    {%- if i <= rating -%}
                      <svg
                        class="review-card__star review-card__star--filled"
                        width="16"
                        height="16"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M10 1.5L12.39 6.26L17.73 7.01L13.87 10.77L14.78 16.09L10 13.5L5.22 16.09L6.13 10.77L2.27 7.01L7.61 6.26L10 1.5Z"/>
                      </svg>
                    {%- else -%}
                      <svg
                        class="review-card__star review-card__star--empty"
                        width="16"
                        height="16"
                        viewBox="0 0 20 20"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path d="M10 1.5L12.39 6.26L17.73 7.01L13.87 10.77L14.78 16.09L10 13.5L5.22 16.09L6.13 10.77L2.27 7.01L7.61 6.26L10 1.5Z" stroke="currentColor" stroke-width="1.2"/>
                      </svg>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- if block.settings.quote != blank -%}
                  <blockquote class="review-card__quote">
                    <p>{{ block.settings.quote | escape }}</p>
                  </blockquote>
                {%- endif -%}

                <footer class="review-card__meta">
                  {%- if block.settings.reviewer_name != blank -%}
                    <span class="review-card__name">{{ block.settings.reviewer_name | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.location != blank -%}
                    <span class="review-card__sep" aria-hidden="true">·</span>
                    <span class="review-card__location">{{ block.settings.location | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.verified -%}
                    <span class="review-card__sep" aria-hidden="true">·</span>
                    <span class="review-card__verified">
                      <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M2.5 6L5 8.5L9.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Verified buyer
                    </span>
                  {%- endif -%}
                </footer>
              </article>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="home-reviews__actions">
        {%- if has_overflow -%}
          <button
            type="button"
            class="home-reviews__expand"
            data-reviews-expand
            aria-expanded="false"
            data-label-expand="{{ expand_label | escape }}"
            data-label-collapse="{{ collapse_label | escape }}"
          >
            <span class="home-reviews__expand-text">{{ expand_label | escape }}</span>
            <svg
              class="home-reviews__expand-icon"
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="3,5 7,9 11,5"/>
            </svg>
          </button>
        {%- endif -%}

        {%- if cta_label != blank -%}
          <a href="{{ cta_url | default: '/pages/reviews' }}" class="home-reviews__cta">
            {{- cta_label | escape -}}
            <svg
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="2" y1="7" x2="11" y2="7" />
              <polyline points="7.5,3 11,7 7.5,11" />
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .home-reviews {
    background: var(--moov-black);
    color: var(--moov-cream);
    padding: var(--section-block-pad-y-md) var(--section-inline-pad);
  }

  .home-reviews__inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
  }

  .home-reviews__header {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 1.2vw, 0.85rem);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    align-items: center;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }

  .home-reviews__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-amber);
  }

  .home-reviews__heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: var(--heading-text-transform, uppercase);
    color: var(--moov-text-primary-dark);
    text-wrap: balance;
  }

  .home-reviews__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--moov-text-secondary-dark);
  }

  /* Messy grid: 12-col base; cards span varying widths and rows, with slight rotation
     and vertical offsets. Layout collapses to 2 cols on tablet, 1 on mobile. */
  .home-reviews__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(1rem, 1.6vw, 1.5rem);
    align-items: start;
  }

  .home-reviews__item {
    grid-column: span 4;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /* Messy spans + offsets — repeats every 6 items for predictability */
  .home-reviews__item:nth-child(6n + 1) {
    grid-column: span 5;
    transform: translateY(0) rotate(-1.1deg);
  }
  .home-reviews__item:nth-child(6n + 2) {
    grid-column: span 4;
    transform: translateY(28px) rotate(0.8deg);
  }
  .home-reviews__item:nth-child(6n + 3) {
    grid-column: span 3;
    transform: translateY(-12px) rotate(-0.4deg);
  }
  .home-reviews__item:nth-child(6n + 4) {
    grid-column: span 4;
    transform: translateY(20px) rotate(1.2deg);
  }
  .home-reviews__item:nth-child(6n + 5) {
    grid-column: span 5;
    transform: translateY(-8px) rotate(-0.7deg);
  }
  .home-reviews__item:nth-child(6n + 6) {
    grid-column: span 3;
    transform: translateY(36px) rotate(0.5deg);
  }

  .home-reviews__item[hidden] {
    display: none;
  }

  /* Expanded state — fade items in */
  .home-reviews[data-expanded='true'] .home-reviews__item[data-overflow='true'] {
    animation: home-reviews-fade-in 0.45s ease both;
  }

  @keyframes home-reviews-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Card */
  .review-card {
    --card-radius: 22px;
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 1.4vw, 1.15rem);
    padding: clamp(1.4rem, 2.2vw, 2rem);
    height: 100%;
    border-radius: var(--card-radius);
    background: color-mix(in srgb, var(--moov-cream) 5%, var(--moov-black));
    border: 1px solid var(--moov-border-dark);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--moov-cream) 8%, transparent);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .home-reviews__item:hover .review-card,
  .home-reviews__item:focus-within .review-card {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--moov-cream) 22%, transparent);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--moov-black) 35%, transparent);
  }

  .review-card__stars {
    display: inline-flex;
    gap: 3px;
    color: var(--color-accent);
  }

  .review-card__quote {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.45;
    color: var(--moov-text-primary-dark);
    text-wrap: pretty;
  }

  .review-card__quote p {
    margin: 0;
  }

  .review-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin-top: auto;
    padding-top: clamp(0.5rem, 1vw, 0.75rem);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--moov-text-tertiary-dark);
  }

  .review-card__name,
  .review-card__location {
    color: var(--moov-text-secondary-dark);
  }

  .review-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-accent);
  }

  .review-card__sep {
    opacity: 0.55;
  }

  /* Actions row */
  .home-reviews__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .home-reviews__expand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--moov-cream) 24%, transparent);
    color: var(--moov-text-primary-dark);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .home-reviews__expand:hover {
    background: color-mix(in srgb, var(--moov-cream) 6%, transparent);
    border-color: color-mix(in srgb, var(--moov-cream) 38%, transparent);
    transform: translateY(-1px);
  }

  .home-reviews__expand-icon {
    transition: transform 0.25s ease;
  }

  .home-reviews[data-expanded='true'] .home-reviews__expand-icon {
    transform: rotate(180deg);
  }

  .home-reviews__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.75rem 0.5rem;
    color: var(--moov-text-secondary-dark);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--moov-cream) 18%, transparent);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .home-reviews__cta:hover {
    color: var(--moov-text-primary-dark);
    border-color: color-mix(in srgb, var(--moov-cream) 50%, transparent);
  }

  /* Tablet: 2 col */
  @media (max-width: 989px) {
    .home-reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .home-reviews__item,
    .home-reviews__item:nth-child(6n + 1),
    .home-reviews__item:nth-child(6n + 2),
    .home-reviews__item:nth-child(6n + 3),
    .home-reviews__item:nth-child(6n + 4),
    .home-reviews__item:nth-child(6n + 5),
    .home-reviews__item:nth-child(6n + 6) {
      grid-column: span 1;
    }
    .home-reviews__item:nth-child(odd) {
      transform: translateY(0) rotate(-0.6deg);
    }
    .home-reviews__item:nth-child(even) {
      transform: translateY(20px) rotate(0.6deg);
    }
  }

  /* Mobile: 1 col, no offsets */
  @media (max-width: 749px) {
    .home-reviews__grid {
      grid-template-columns: 1fr;
    }
    .home-reviews__item,
    .home-reviews__item:nth-child(odd),
    .home-reviews__item:nth-child(even) {
      transform: none;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .home-reviews__item,
    .home-reviews__item:nth-child(6n + 1),
    .home-reviews__item:nth-child(6n + 2),
    .home-reviews__item:nth-child(6n + 3),
    .home-reviews__item:nth-child(6n + 4),
    .home-reviews__item:nth-child(6n + 5),
    .home-reviews__item:nth-child(6n + 6) {
      transform: none;
    }
    .home-reviews[data-expanded='true'] .home-reviews__item[data-overflow='true'] {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const sections = document.querySelectorAll('.home-reviews');
    sections.forEach(function (section) {
      const button = section.querySelector('[data-reviews-expand]');
      if (!button) return;

      const labelEl = button.querySelector('.home-reviews__expand-text');
      const labelExpand = button.dataset.labelExpand || 'Show more reviews';
      const labelCollapse = button.dataset.labelCollapse || 'Show fewer reviews';

      button.addEventListener('click', function () {
        const isExpanded = section.getAttribute('data-expanded') === 'true';
        const next = !isExpanded;

        section.setAttribute('data-expanded', String(next));
        button.setAttribute('aria-expanded', String(next));

        const overflowItems = section.querySelectorAll('.home-reviews__item[data-overflow="true"]');
        overflowItems.forEach(function (item) {
          if (next) {
            item.removeAttribute('hidden');
          } else {
            item.setAttribute('hidden', '');
          }
        });

        if (labelEl) {
          labelEl.textContent = next ? labelCollapse : labelExpand;
        }
      });
    });
  })();
{% endjavascript %}

