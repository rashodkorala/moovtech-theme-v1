<div class="prod-app full-width">
  <div class="prod-app__inner">

    {%- comment -%} Left — Text {%- endcomment -%}
    <div class="prod-app__text" data-animate="prod-app-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="prod-app__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="prod-app__heading">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.body != blank -%}
        <p class="prod-app__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      {%- if section.settings.compat_note != blank -%}
        <p class="prod-app__compat">{{ section.settings.compat_note | escape }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Right — App screen {%- endcomment -%}
    <div class="prod-app__visual" data-animate="prod-app-visual">
      <div class="prod-app__glow" aria-hidden="true"></div>
      {%- if section.settings.app_screen -%}
        {{
          section.settings.app_screen
          | image_url: width: 600
          | image_tag:
            class: 'prod-app__img',
            loading: 'lazy',
            alt: section.settings.app_screen.alt | escape
        }}
      {%- else -%}
        <img
          src="{{ 'moov-app-home.png' | asset_url }}"
          alt="MOOV App"
          class="prod-app__img"
          loading="lazy"
          width="390"
          height="844"
        >
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .prod-app {
    background: var(--moov-black);
    padding: var(--section-block-pad-y-lg) var(--section-inline-pad);
  }

  .prod-app__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Text column */
  .prod-app__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .prod-app__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--moov-eyebrow-accent);
    margin: 0 0 24px;
  }

  .prod-app__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: 1.1;
    color: var(--moov-text-primary-dark);
    margin: 0 0 20px;
    letter-spacing: -0.02em;
  }

  .prod-app__body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 200;
    line-height: 1.75;
    color: var(--moov-text-secondary-dark);
    margin: 0;
  }

  .prod-app__compat {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--moov-text-tertiary-dark);
    margin: 24px 0 0;
  }

  /* Visual column */
  .prod-app__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .prod-app__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(ellipse at center, var(--moov-amber-glow) 0%, transparent 70%);
    pointer-events: none;
  }

  .prod-app__img {
    position: relative;
    z-index: 1;
    max-height: 480px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 40px 80px rgba(0, 0, 0, 0.4));
  }

  /* Animations */
  [data-animate="prod-app-text"] {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  [data-animate="prod-app-visual"] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.8s ease-out 0.15s, transform 0.8s ease-out 0.15s;
  }

  [data-animate="prod-app-text"].is-visible,
  [data-animate="prod-app-visual"].is-visible {
    opacity: 1;
    transform: none;
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1279px) {
    .prod-app__inner {
      gap: 48px;
    }

    .prod-app__img {
      max-height: 380px;
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .prod-app__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .prod-app__visual {
      order: -1;
    }

    .prod-app__img {
      max-height: 320px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var els = document.querySelectorAll(
      '[data-animate="prod-app-text"], [data-animate="prod-app-visual"]'
    );
    if (!els.length) return;

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    els.forEach(function (el) { observer.observe(el); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.product_app_compat.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text",
      "default": "The App"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Works with the MOOV app"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:labels.body",
      "default": "The MOOV app is available on iOS and Android. Set your alarm, choose your blocked apps, and get a short AI-powered routine each morning. Free to download, fully activated with your MOOV device."
    },
    {
      "type": "text",
      "id": "compat_note",
      "label": "t:labels.compat_note",
      "default": "iOS 14+ and Android 10+"
    },
    {
      "type": "image_picker",
      "id": "app_screen",
      "label": "t:labels.app_screen"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_app_compat.name"
    }
  ]
}
{% endschema %}
