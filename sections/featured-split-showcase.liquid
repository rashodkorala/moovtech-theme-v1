{%- liquid
  assign promo_eyebrow = section.settings.promo_eyebrow

  assign promo_heading = section.settings.promo_heading
  if promo_heading == blank
    assign promo_heading = 'sections.featured_split.default_promo_heading' | t
  endif

  assign promo_body = section.settings.promo_body

  assign promo_cta_label = section.settings.promo_cta_label
  if promo_cta_label == blank
    assign promo_cta_label = 'sections.featured_split.default_promo_cta' | t
  endif

  assign promo_cta_url = section.settings.promo_cta_url | default: routes.collections_url

  assign content_position = section.settings.content_position | default: 'middle-left'
  assign overlay_opacity = section.settings.overlay_opacity | default: 30
-%}

<section
  class="featured-split full-width featured-split--pos-{{ content_position }}"
  aria-labelledby="featured-split-heading-{{ section.id }}"
  style="--featured-split-overlay: color-mix(in srgb, var(--moov-black) {{ overlay_opacity }}%, transparent);"
>
  <div class="featured-split__media">
    {%- if section.settings.promo_image != blank -%}
      {%- assign promo_img_alt = section.settings.promo_image.alt | default: promo_heading -%}
      {{
        section.settings.promo_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          class: 'featured-split__img',
          alt: promo_img_alt,
          sizes: '100vw',
          widths: '720, 990, 1200, 1500, 1800, 2400'
      }}
    {%- elsif section.settings.promo_image_url != blank -%}
      <img
        src="{{ section.settings.promo_image_url | escape }}"
        alt="{{ promo_heading | escape }}"
        loading="lazy"
        class="featured-split__img"
        width="2400"
        height="1600"
      >
    {%- else -%}
      <div
        class="featured-split__placeholder"
        role="img"
        aria-label="{{ 'sections.featured_split.image_placeholder_label' | t }}"
      ></div>
    {%- endif -%}
    <div class="featured-split__overlay" aria-hidden="true"></div>
  </div>

  <div class="featured-split__content">
    {%- if promo_eyebrow != blank -%}
      <p class="featured-split__eyebrow">{{ promo_eyebrow | escape }}</p>
    {%- endif -%}

    <h2 id="featured-split-heading-{{ section.id }}" class="featured-split__heading">
      {{ promo_heading | escape }}
    </h2>

    {%- if promo_body != blank -%}
      <p class="featured-split__body">{{ promo_body | escape }}</p>
    {%- endif -%}

    <a href="{{ promo_cta_url }}" class="featured-split__cta">
      {{- promo_cta_label | escape -}}
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="2" y1="12" x2="12" y2="2" />
        <polyline points="5,2 12,2 12,9" />
      </svg>
    </a>
  </div>
</section>

{% stylesheet %}
  .featured-split {
    --split-radius: clamp(18px, 2.4vw, 28px);
    --split-pad: clamp(1.5rem, 5vw, 4rem);
    position: relative;
    width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-block: var(--section-block-pad-y-md);
    margin-inline: auto;
    border-radius: var(--split-radius);
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(360px, 60vw, 620px);
    display: grid;
    color: var(--moov-cream);
  }

  .featured-split__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .featured-split__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .featured-split__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--moov-cream) 62%, var(--moov-black)) 0%,
      var(--moov-neutral-deep) 100%
    );
  }

  .featured-split__overlay {
    position: absolute;
    inset: 0;
    background: var(--featured-split-overlay, color-mix(in srgb, var(--moov-black) 30%, transparent));
  }

  .featured-split__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(14px, 2vw, 22px);
    max-width: 560px;
    padding: var(--split-pad);
  }

  /* Content positioning */
  .featured-split--pos-top-left .featured-split__content {
    justify-self: start;
    align-self: start;
  }

  .featured-split--pos-top-center .featured-split__content {
    justify-self: center;
    align-self: start;
    align-items: center;
    text-align: center;
  }

  .featured-split--pos-top-right .featured-split__content {
    justify-self: end;
    align-self: start;
    align-items: flex-end;
    text-align: right;
  }

  .featured-split--pos-middle-left .featured-split__content {
    justify-self: start;
    align-self: center;
  }

  .featured-split--pos-middle-center .featured-split__content {
    justify-self: center;
    align-self: center;
    align-items: center;
    text-align: center;
  }

  .featured-split--pos-middle-right .featured-split__content {
    justify-self: end;
    align-self: center;
    align-items: flex-end;
    text-align: right;
  }

  .featured-split--pos-bottom-left .featured-split__content {
    justify-self: start;
    align-self: end;
  }

  .featured-split--pos-bottom-center .featured-split__content {
    justify-self: center;
    align-self: end;
    align-items: center;
    text-align: center;
  }

  .featured-split--pos-bottom-right .featured-split__content {
    justify-self: end;
    align-self: end;
    align-items: flex-end;
    text-align: right;
  }

  .featured-split__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--moov-cream) 88%, transparent);
  }

  .featured-split__heading {
    margin: 0;
    font-family: var(--font-hero, var(--font-body));
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: var(--heading-text-transform, uppercase);
    color: var(--moov-cream);
    text-shadow: 0 1px 24px color-mix(in srgb, var(--moov-black) 20%, transparent);
  }

  .featured-split__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    color: color-mix(in srgb, var(--moov-cream) 92%, transparent);
    max-width: 480px;
  }

  .featured-split__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: clamp(13px, 1.2vw, 16px) clamp(26px, 2.8vw, 36px);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--moov-black);
    background: var(--moov-cream);
    border: none;
    margin-top: clamp(4px, 1vw, 10px);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--moov-black) 6%, transparent);
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .featured-split__cta:hover {
    background: var(--moov-cream);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--moov-black) 24%, transparent);
  }

  @media (max-width: 749px) {
    .featured-split {
      min-height: clamp(420px, 90vw, 560px);
    }

    /* On mobile, force content to bottom-left for readability */
    .featured-split__content {
      justify-self: start;
      align-self: end;
      align-items: flex-start;
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_split.name",
  "tag": "section",
  "class": "section-featured-split",
  "settings": [
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "t:sections.featured_split.promo_image"
    },
    {
      "type": "url",
      "id": "promo_image_url",
      "label": "Image URL fallback",
      "info": "Used when no image is selected above."
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%",
      "info": "Darkens the image to improve text contrast."
    },
    {
      "type": "text",
      "id": "promo_eyebrow",
      "label": "t:sections.featured_split.promo_eyebrow",
      "default": "Designed with adventurous cyclists in mind"
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "t:sections.featured_split.promo_heading",
      "default": "Best for rocky roads"
    },
    {
      "type": "textarea",
      "id": "promo_body",
      "label": "Body text",
      "default": "Add a short description that supports your headline and gives shoppers a reason to click."
    },
    {
      "type": "text",
      "id": "promo_cta_label",
      "label": "t:labels.button_label",
      "default": "Buy now"
    },
    {
      "type": "url",
      "id": "promo_cta_url",
      "label": "t:labels.button_url"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_split.name"
    }
  ]
}
{% endschema %}
