{%- assign is_transparent = false -%}
{%- if section.settings.transparent_header and template == 'index' -%}
  {%- assign is_transparent = true -%}
{%- endif -%}

{%- assign announcement_text = section.settings.announcement_text -%}
{%- if announcement_text == blank -%}
  {%- assign announcement_text = 'general.announcement_bar' | t -%}
{%- endif -%}

{%- assign get_moov_label = section.settings.get_moov_label -%}
{%- if get_moov_label == blank -%}
  {%- assign get_moov_label = 'Get MOOV' -%}
{%- endif -%}

<header
  class="moov-header full-width{% if is_transparent %} moov-header--transparent{% endif %}{% if section.settings.sticky_header %} moov-header--sticky{% endif %}"
  data-transparent="{{ is_transparent }}"
>
  {%- comment -%} Announcement bar {%- endcomment -%}
  {%- if section.settings.announcement_enabled and announcement_text != blank -%}
    <div class="moov-announcement">
      {%- if section.settings.announcement_url != blank -%}
        <a href="{{ section.settings.announcement_url }}" class="moov-announcement__link">
          {{- announcement_text | escape -}}
        </a>
      {%- else -%}
        <span>{{- announcement_text | escape -}}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <nav class="moov-nav" aria-label="{{ 'general.accessibility.nav_label' | t }}">
    {%- comment -%} Left — Nav links (Shop-style row) {%- endcomment -%}
    <ul class="moov-nav__links" role="list">
      {%- for i in (1..4) -%}
        {%- liquid
          case i
            when 1
              assign nav_lbl = section.settings.nav_1_label
              assign nav_url = section.settings.nav_1_url
              if nav_lbl == blank
                assign nav_lbl = 'How it works'
              endif
              if nav_url == blank
                assign nav_url = '/pages/how-it-works'
              endif
            when 2
              assign nav_lbl = section.settings.nav_2_label
              assign nav_url = section.settings.nav_2_url
              if nav_lbl == blank
                assign nav_lbl = 'Our story'
              endif
              if nav_url == blank
                assign nav_url = '/pages/our-story'
              endif
            when 3
              assign nav_lbl = section.settings.nav_3_label
              assign nav_url = section.settings.nav_3_url
              if nav_lbl == blank
                assign nav_lbl = 'Support'
              endif
              if nav_url == blank
                assign nav_url = '/pages/support'
              endif
            when 4
              assign nav_lbl = section.settings.nav_4_label
              assign nav_url = section.settings.nav_4_url
          endcase
        -%}
        {%- if nav_lbl != blank -%}
          <li>
            <a
              href="{{ nav_url | default: routes.root_url }}"
              class="moov-nav__link{% if nav_url == request.path %} moov-nav__link--active{% endif %}"
              {% if nav_url == request.path %}aria-current="page"{% endif %}
            >
              {{- nav_lbl | escape -}}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- comment -%} Centre — Logo / Wordmark {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="moov-nav__wordmark" aria-label="{{ shop.name }}">
      {%- if section.settings.logo_image != blank -%}
        {{ section.settings.logo_image | image_url: width: 300 | image_tag: class: 'moov-nav__logo-img', alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <img
          src="{{ 'moov-logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          class="moov-nav__logo-img"
          loading="eager"
          width="120"
          height="40"
        >
      {%- endif -%}
    </a>

    {%- comment -%} Right — Utilities + optional CTA {%- endcomment -%}
    <div class="moov-nav__right">
      {%- comment -%} Account {%- endcomment -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="moov-nav__icon" aria-label="{{ 'general.accessibility.account' | t }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
      {%- endif -%}

      {%- comment -%} Cart — bag icon + count badge {%- endcomment -%}
      <a href="{{ routes.cart_url }}" class="moov-nav__cart" aria-label="{{ 'general.accessibility.cart' | t }}">
        <svg class="moov-nav__cart-bag" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <span class="moov-nav__cart-badge" aria-hidden="true">{{ cart.item_count }}</span>
      </a>

      {%- if section.settings.show_nav_cta -%}
        <a
          href="{{ section.settings.get_moov_url | default: routes.root_url }}"
          class="moov-nav__get-moov"
        >
          {{- get_moov_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Mobile hamburger {%- endcomment -%}
    <button
      class="moov-nav__hamburger"
      aria-label="{{ 'general.accessibility.menu' | t }}"
      aria-expanded="false"
      aria-controls="moov-mobile-drawer"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </nav>

  {%- comment -%} Mobile drawer {%- endcomment -%}
  <div id="moov-mobile-drawer" class="moov-drawer" aria-hidden="true">
    <div class="moov-drawer__header">
      {%- if section.settings.logo_image != blank -%}
        {{ section.settings.logo_image | image_url: width: 200 | image_tag: class: 'moov-nav__logo-img moov-nav__logo-img--drawer', alt: shop.name, loading: 'lazy' }}
      {%- else -%}
        <img
          src="{{ 'moov-logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          class="moov-nav__logo-img moov-nav__logo-img--drawer"
          loading="lazy"
          width="96"
          height="32"
        >
      {%- endif -%}
      <button class="moov-drawer__close" aria-label="{{ 'general.accessibility.close' | t }}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <nav class="moov-drawer__nav">
      {%- for i in (1..4) -%}
        {%- liquid
          case i
            when 1
              assign nav_lbl = section.settings.nav_1_label
              assign nav_url = section.settings.nav_1_url
              if nav_lbl == blank
                assign nav_lbl = 'How it works'
              endif
              if nav_url == blank
                assign nav_url = '/pages/how-it-works'
              endif
            when 2
              assign nav_lbl = section.settings.nav_2_label
              assign nav_url = section.settings.nav_2_url
              if nav_lbl == blank
                assign nav_lbl = 'Our story'
              endif
              if nav_url == blank
                assign nav_url = '/pages/our-story'
              endif
            when 3
              assign nav_lbl = section.settings.nav_3_label
              assign nav_url = section.settings.nav_3_url
              if nav_lbl == blank
                assign nav_lbl = 'Support'
              endif
              if nav_url == blank
                assign nav_url = '/pages/support'
              endif
            when 4
              assign nav_lbl = section.settings.nav_4_label
              assign nav_url = section.settings.nav_4_url
          endcase
        -%}
        {%- if nav_lbl != blank -%}
          <a
            href="{{ nav_url | default: routes.root_url }}"
            class="moov-drawer__link{% if nav_url == request.path %} moov-drawer__link--active{% endif %}"
            {% if nav_url == request.path %}aria-current="page"{% endif %}
          >{{- nav_lbl | escape -}}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
    {%- if section.settings.show_nav_cta -%}
      <a
        href="{{ section.settings.get_moov_url | default: routes.root_url }}"
        class="moov-drawer__get-moov"
      >
        {{- get_moov_label | escape -}}
      </a>
    {%- endif -%}
  </div>
  <div class="moov-drawer__backdrop" aria-hidden="true"></div>
</header>

{% stylesheet %}
  /* ── Announcement bar ── */
  .moov-announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px var(--section-inline-pad);
    background: var(--moov-black);
    font-family: var(--font-body);
    font-size: clamp(0.8125rem, 0.2vw + 0.72rem, 0.9375rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--moov-cream);
  }

  .moov-announcement__link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .moov-announcement__link:hover {
    opacity: 0.75;
  }

  .moov-announcement > * {
    min-width: 0;
    max-width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    text-align: center;
    text-wrap: balance;
    white-space: normal;
    overflow-wrap: break-word;
  }

  /* ── Header ── */
  .moov-header {
    position: relative;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-background);
    border-bottom: 1px solid var(--moov-border-light);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .moov-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-height);
    box-sizing: border-box;
    width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-inline: auto;
    padding: 0;
  }

  /* Wordmark — center column (bold sans, reference style) */
  .moov-nav__wordmark {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.5vw, 1.625rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--moov-black);
    text-decoration: none;
    justify-self: center;
    transition: opacity 0.2s;
  }

  .moov-nav__wordmark:hover {
    opacity: 0.7;
  }

  .moov-nav__logo-img {
    display: block;
    width: {{ section.settings.logo_max_width | default: 120 }}px;
    height: auto;
    max-height: 40px;
    object-fit: contain;
  }

  .moov-nav__logo-img--drawer {
    width: {{ section.settings.logo_max_width | default: 120 | times: 0.8 | round }}px;
    max-height: 32px;
  }

  /* Left nav links */
  .moov-nav__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(12px, 1.25vw, 24px);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: flex-start;
    min-width: 0;
  }

  .moov-nav__link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.0625rem, 0.2vw + 0.9rem, 1.125rem);
    letter-spacing: 0.02em;
    color: var(--moov-black);
    text-decoration: none;
    transition: opacity 0.2s;
    white-space: normal;
    overflow-wrap: break-word;
    line-height: 1.35;
    max-width: 100%;
  }

  .moov-nav__link:hover {
    opacity: 0.55;
  }

  .moov-nav__link--active {
    position: relative;
  }

  .moov-nav__link--active::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  /* Right utilities group */
  .moov-nav__right {
    display: flex;
    align-items: center;
    gap: clamp(8px, 0.75vw, 16px);
    justify-content: flex-end;
    flex-shrink: 0;
    flex-wrap: wrap;
    min-width: 0;
  }

  .moov-nav__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--moov-black);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
    padding: 0;
    border-radius: 50%;
  }

  .moov-nav__icon:hover {
    opacity: 0.55;
  }

  /* Cart — bag + circular count (reference style) */
  .moov-nav__cart {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    text-decoration: none;
    color: var(--moov-black);
    transition: opacity 0.2s;
  }

  .moov-nav__cart:hover {
    opacity: 0.55;
  }

  .moov-nav__cart-bag {
    flex-shrink: 0;
  }

  .moov-nav__cart-badge {
    position: absolute;
    top: 2px;
    right: -2px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 999px;
    border: 1px solid var(--moov-black);
    background: var(--moov-cream);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    line-height: 16px;
    text-align: center;
    color: var(--moov-black);
    box-sizing: border-box;
  }

  /* Get MOOV pill */
  .moov-nav__get-moov {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    letter-spacing: 0.03em;
    color: var(--moov-black);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--moov-black) 20%, transparent);
    border-radius: var(--style-border-radius-buttons);
    padding: clamp(8px, 0.6vw, 12px) clamp(18px, 1.4vw, 28px);
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    white-space: normal;
    overflow-wrap: break-word;
    text-align: center;
    line-height: 1.3;
    max-width: min(11rem, 100%);
  }

  .moov-nav__get-moov:hover {
    background: var(--moov-black);
    color: var(--moov-cream);
    border-color: var(--moov-black);
  }

  /* Hamburger — mobile only */
  .moov-nav__hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    color: var(--moov-text-primary-light);
    cursor: pointer;
  }

  .moov-nav__hamburger svg {
    width: clamp(22px, 1.5vw, 28px);
    height: clamp(22px, 1.5vw, 28px);
  }

  /* ── Sticky modifier ── */
  .shopify-section-group-header-group:has(.moov-header--sticky:not(.moov-header--transparent)),
  .shopify-section-group-header-group:has(.moov-header--sticky:not(.moov-header--transparent)) > .shopify-section {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* Transparent header: wrapper must not interfere with fixed positioning */
  .shopify-section-group-header-group:has(.moov-header--transparent),
  .shopify-section-group-header-group:has(.moov-header--transparent) > .shopify-section {
    position: relative;
    z-index: 100;
  }

  /* ── Transparent modifier (homepage) ── */
  .moov-header--transparent {
    position: fixed;
    width: 100%;
    background: transparent;
    border-bottom-color: transparent;
  }

  .moov-header--transparent .moov-announcement {
    background: color-mix(in srgb, var(--moov-black) 70%, transparent);
  }

  .moov-header--transparent .moov-nav__wordmark {
    color: var(--moov-text-primary-dark);
  }

  .moov-header--transparent .moov-nav__link {
    color: var(--moov-text-secondary-dark);
  }

  .moov-header--transparent .moov-nav__link:hover {
    color: var(--moov-text-primary-dark);
  }

  .moov-header--transparent .moov-nav__icon {
    color: var(--moov-text-secondary-dark);
  }

  .moov-header--transparent .moov-nav__icon:hover {
    color: var(--moov-text-primary-dark);
  }

  .moov-header--transparent .moov-nav__cart {
    color: var(--moov-text-secondary-dark);
  }

  .moov-header--transparent .moov-nav__cart-badge {
    background: var(--moov-cream);
    color: var(--moov-black);
    border-color: color-mix(in srgb, var(--moov-cream) 45%, transparent);
  }

  .moov-header--transparent .moov-nav__get-moov {
    color: var(--moov-amber);
    border-color: var(--moov-border-amber);
  }

  .moov-header--transparent .moov-nav__get-moov:hover {
    background: var(--moov-amber);
    color: var(--moov-black);
    border-color: var(--moov-amber);
  }

  .moov-header--transparent .moov-nav__hamburger {
    color: var(--moov-text-primary-dark);
  }

  /* Transparent + scrolled: solid dark bg */
  .moov-header--transparent.is-scrolled {
    background: var(--moov-black);
    border-bottom-color: var(--moov-border-dark);
  }

  .moov-header--transparent.is-scrolled .moov-announcement {
    background: var(--moov-black);
  }

  /* Transparent + over cream section: flip to cream bg with dark text */
  .moov-header--transparent.nav--light {
    background: var(--moov-cream);
    border-bottom-color: var(--moov-border-light);
  }

  .moov-header--transparent.nav--light .moov-announcement {
    background: var(--moov-black);
  }

  .moov-header--transparent.nav--light .moov-nav__wordmark {
    color: var(--moov-text-primary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__logo-img {
    filter: invert(1);
  }

  .moov-header--transparent.nav--light .moov-nav__link {
    color: var(--moov-text-secondary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__link:hover {
    color: var(--moov-text-primary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__icon {
    color: var(--moov-text-secondary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__icon:hover {
    color: var(--moov-text-primary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__cart {
    color: var(--moov-text-secondary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__cart-badge {
    background: var(--moov-cream);
    color: var(--moov-black);
    border-color: var(--moov-black);
  }

  .moov-header--transparent.nav--light .moov-nav__get-moov {
    color: var(--moov-text-primary-light);
    border-color: color-mix(in srgb, var(--moov-black) 25%, transparent);
  }

  .moov-header--transparent.nav--light .moov-nav__hamburger {
    color: var(--moov-text-primary-light);
  }

  /* ── Mobile drawer ── */
  .moov-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 360px;
    background: var(--moov-black);
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: var(--section-inline-pad);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .moov-drawer.is-open {
    transform: translateX(0);
  }

  .moov-drawer__backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--moov-black) 50%, transparent);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .moov-drawer.is-open ~ .moov-drawer__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .moov-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .moov-drawer__wordmark {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--moov-text-primary-dark);
  }

  .moov-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--moov-text-primary-dark);
    cursor: pointer;
    padding: 0;
  }

  .moov-drawer__nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1;
  }

  .moov-drawer__link {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-2xl);
    color: var(--moov-text-secondary-dark);
    text-decoration: none;
    transition: color 0.2s;
  }

  .moov-drawer__link:hover {
    color: var(--moov-text-primary-dark);
  }

  .moov-drawer__link--active {
    color: var(--moov-text-primary-dark);
  }

  .moov-drawer__get-moov {
    display: block;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-base);
    letter-spacing: 0.03em;
    color: var(--moov-amber);
    text-decoration: none;
    border: 0.5px solid var(--moov-border-amber);
    border-radius: 999px;
    padding: 14px 28px;
    margin-top: auto;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .moov-drawer__get-moov:hover {
    background: var(--moov-amber);
    color: var(--moov-black);
  }

  /* ── Dark mode — header ── */
  [data-theme="dark"] .moov-header {
    background: var(--color-background);
    border-bottom-color: var(--moov-border-dark);
  }

  [data-theme="dark"] .moov-announcement {
    background: var(--moov-black);
    border-bottom: 0.5px solid var(--moov-border-dark);
  }

  [data-theme="dark"] .moov-nav__wordmark {
    color: var(--moov-text-primary-dark);
  }

  [data-theme="dark"] .moov-nav__link {
    color: var(--moov-text-secondary-dark);
  }

  [data-theme="dark"] .moov-nav__link:hover {
    color: var(--moov-text-primary-dark);
  }

  [data-theme="dark"] .moov-nav__icon {
    color: var(--moov-text-secondary-dark);
  }

  [data-theme="dark"] .moov-nav__icon:hover {
    color: var(--moov-text-primary-dark);
  }

  [data-theme="dark"] .moov-nav__cart {
    color: var(--moov-text-secondary-dark);
  }

  [data-theme="dark"] .moov-nav__cart-badge {
    background: var(--moov-cream);
    color: var(--moov-black);
    border-color: var(--moov-border-dark);
  }

  [data-theme="dark"] .moov-nav__get-moov {
    color: var(--moov-text-primary-dark);
    border-color: var(--moov-border-dark);
  }

  [data-theme="dark"] .moov-nav__get-moov:hover {
    background: var(--moov-text-primary-dark);
    color: var(--moov-black);
    border-color: var(--moov-text-primary-dark);
  }

  /* ── Responsive ── */
  @media (max-width: 767px) {
    .moov-nav__links,
    .moov-nav__right {
      display: none;
    }

    .moov-nav__hamburger {
      display: flex;
      grid-column: 3;
      justify-self: end;
    }
  }
{% endstylesheet %}

{% javascript %}
  var header = document.querySelector('.moov-header');

  if (header) {
    var isTransparent = header.getAttribute('data-transparent') === 'true';

    if (isTransparent) {
      window.addEventListener('scroll', function() {
        header.classList.toggle('is-scrolled', window.scrollY > 20);
      });

      var allSurfaceSections = document.querySelectorAll('[data-surface]');
      if (allSurfaceSections.length > 0) {
        function checkNavColor() {
          var headerBottom = header.offsetHeight;
          var elementAtNav = document.elementFromPoint(window.innerWidth / 2, headerBottom + 1);
          if (elementAtNav) {
            var section = elementAtNav.closest('[data-surface]');
            if (section) {
              var surface = section.getAttribute('data-surface');
              var isOverLight = surface === 'cream' || surface === 'white';
              header.classList.toggle('nav--light', isOverLight);
            }
          }
        }

        var navObserver = new IntersectionObserver(function() {
          checkNavColor();
        }, { threshold: [0, 0.1, 0.5, 1], rootMargin: '-1px 0px -90% 0px' });

        allSurfaceSections.forEach(function(s) { navObserver.observe(s); });

        var scrollTicking = false;
        window.addEventListener('scroll', function() {
          if (!scrollTicking) {
            requestAnimationFrame(function() {
              checkNavColor();
              scrollTicking = false;
            });
            scrollTicking = true;
          }
        });
      }
    }
  }

  /* Mobile drawer toggle */
  var hamburger = document.querySelector('.moov-nav__hamburger');
  var drawer = document.getElementById('moov-mobile-drawer');
  var drawerClose = document.querySelector('.moov-drawer__close');

  if (hamburger && drawer) {
    hamburger.addEventListener('click', function() {
      var isOpen = drawer.classList.toggle('is-open');
      drawer.setAttribute('aria-hidden', String(!isOpen));
      hamburger.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (drawerClose) drawerClose.addEventListener('click', closeDrawer);

  var backdrop = document.querySelector('.moov-drawer__backdrop');
  if (backdrop) backdrop.addEventListener('click', closeDrawer);
{% endjavascript %}

