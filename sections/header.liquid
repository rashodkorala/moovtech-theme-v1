{%- assign is_transparent = false -%}
{%- if section.settings.transparent_header and template == 'index' -%}
  {%- assign is_transparent = true -%}
{%- endif -%}

{%- assign announcement_text = section.settings.announcement_text -%}
{%- if announcement_text == blank -%}
  {%- assign announcement_text = 'general.announcement_bar' | t -%}
{%- endif -%}

{%- assign get_moov_label = section.settings.get_moov_label -%}
{%- if get_moov_label == blank -%}
  {%- assign get_moov_label = 'Get MOOV' -%}
{%- endif -%}

<header
  class="moov-header full-width{% if is_transparent %} moov-header--transparent{% endif %}{% if section.settings.sticky_header %} moov-header--sticky{% endif %}"
  data-transparent="{{ is_transparent }}"
>
  {%- comment -%} Announcement bar {%- endcomment -%}
  {%- if section.settings.announcement_enabled and announcement_text != blank -%}
    <div class="moov-announcement">
      {%- if section.settings.announcement_url != blank -%}
        <a href="{{ section.settings.announcement_url }}" class="moov-announcement__link">
          {{- announcement_text | escape -}}
        </a>
      {%- else -%}
        <span>{{- announcement_text | escape -}}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <nav class="moov-nav" aria-label="{{ 'general.accessibility.nav_label' | t }}">
    {%- comment -%} Left — Nav links (nav_1 + nav_2) {%- endcomment -%}
    <ul class="moov-nav__links" role="list">
      {%- for i in (1..2) -%}
        {%- liquid
          case i
            when 1
              assign nav_lbl = section.settings.nav_1_label
              assign nav_url = section.settings.nav_1_url
              if nav_lbl == blank
                assign nav_lbl = 'How it works'
              endif
              if nav_url == blank
                assign nav_url = '/pages/how-it-works'
              endif
            when 2
              assign nav_lbl = section.settings.nav_2_label
              assign nav_url = section.settings.nav_2_url
          endcase
        -%}
        {%- if nav_lbl != blank -%}
          <li>
            <a
              href="{{ nav_url | default: routes.root_url }}"
              class="moov-nav__link{% if nav_url == request.path %} moov-nav__link--active{% endif %}"
              {% if nav_url == request.path %}aria-current="page"{% endif %}
            >
              {{- nav_lbl | escape -}}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- comment -%} Centre — Logo / Wordmark {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="moov-nav__wordmark" aria-label="{{ shop.name }}">
      {%- if section.settings.logo_image != blank -%}
        {{ section.settings.logo_image | image_url: width: 300 | image_tag: class: 'moov-nav__logo-img', alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <img
          src="{{ 'moov-logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          class="moov-nav__logo-img"
          loading="eager"
          width="120"
          height="40"
        >
      {%- endif -%}
    </a>

    {%- comment -%} Right — nav_3 link + CTA + icons {%- endcomment -%}
    <div class="moov-nav__right">
      {%- comment -%} Nav link 3 (right side) {%- endcomment -%}
      {%- assign right_lbl = section.settings.nav_3_label -%}
      {%- assign right_url = section.settings.nav_3_url -%}
      {%- if right_lbl != blank -%}
        <a
          href="{{ right_url | default: routes.root_url }}"
          class="moov-nav__link{% if right_url == request.path %} moov-nav__link--active{% endif %}"
          {% if right_url == request.path %}aria-current="page"{% endif %}
        >{{- right_lbl | escape -}}</a>
      {%- endif -%}

      {%- if section.settings.show_nav_cta -%}
        <a
          href="{{ section.settings.get_moov_url | default: routes.root_url }}"
          class="moov-nav__get-moov"
        >
          {{- get_moov_label | escape -}}
        </a>
      {%- endif -%}

      {%- comment -%} Icons group — account + cart, separated by vertical rule {%- endcomment -%}
      <div class="moov-nav__icons">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="moov-nav__icon" aria-label="{{ 'general.accessibility.account' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="moov-nav__cart" aria-label="{{ 'general.accessibility.cart' | t }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
          <span class="moov-nav__cart-badge" aria-hidden="true">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>

    {%- comment -%} Mobile hamburger {%- endcomment -%}
    <button
      class="moov-nav__hamburger"
      aria-label="{{ 'general.accessibility.menu' | t }}"
      aria-expanded="false"
      aria-controls="moov-mobile-drawer"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </nav>
</header>

{%- comment -%} Mobile drawer — kept outside <header> so backdrop-filter on the header does not create a new containing block for these position:fixed elements (Chrome bug) {%- endcomment -%}
<div id="moov-mobile-drawer" class="moov-drawer" aria-hidden="true">
  <div class="moov-drawer__header">
    {%- if section.settings.logo_image != blank -%}
      {{ section.settings.logo_image | image_url: width: 200 | image_tag: class: 'moov-nav__logo-img moov-nav__logo-img--drawer', alt: shop.name, loading: 'lazy' }}
    {%- else -%}
      <img
        src="{{ 'moov-logo.png' | asset_url }}"
        alt="{{ shop.name }}"
        class="moov-nav__logo-img moov-nav__logo-img--drawer"
        loading="lazy"
        width="96"
        height="32"
      >
    {%- endif -%}
    <button class="moov-drawer__close" aria-label="{{ 'general.accessibility.close' | t }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  <nav class="moov-drawer__nav">
    {%- for i in (1..6) -%}
      {%- liquid
        case i
          when 1
            assign nav_lbl = section.settings.nav_1_label
            assign nav_url = section.settings.nav_1_url
            if nav_lbl == blank
              assign nav_lbl = 'How it works'
            endif
            if nav_url == blank
              assign nav_url = '/pages/how-it-works'
            endif
          when 2
            assign nav_lbl = section.settings.nav_2_label
            assign nav_url = section.settings.nav_2_url
            if nav_lbl == blank
              assign nav_lbl = 'Our story'
            endif
            if nav_url == blank
              assign nav_url = '/pages/our-story'
            endif
          when 3
            assign nav_lbl = section.settings.nav_3_label
            assign nav_url = section.settings.nav_3_url
            if nav_lbl == blank
              assign nav_lbl = 'Support'
            endif
            if nav_url == blank
              assign nav_url = '/pages/support'
            endif
          when 4
            assign nav_lbl = section.settings.nav_4_label
            assign nav_url = section.settings.nav_4_url
            if nav_lbl == blank
              assign nav_lbl = 'Shop'
            endif
            if nav_url == blank
              assign nav_url = '/collections/all'
            endif
          when 5
            assign nav_lbl = section.settings.nav_5_label
            assign nav_url = section.settings.nav_5_url
          when 6
            assign nav_lbl = section.settings.nav_6_label
            assign nav_url = section.settings.nav_6_url
        endcase
      -%}
      {%- if nav_lbl != blank -%}
        <a
          href="{{ nav_url | default: routes.root_url }}"
          class="moov-drawer__link{% if nav_url == request.path %} moov-drawer__link--active{% endif %}"
          {% if nav_url == request.path %}aria-current="page"{% endif %}
        >{{- nav_lbl | escape -}}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
  {%- if section.settings.show_nav_cta -%}
    <a
      href="{{ section.settings.get_moov_url | default: routes.root_url }}"
      class="moov-drawer__get-moov"
    >
      {{- get_moov_label | escape -}}
    </a>
  {%- endif -%}
</div>
<div class="moov-drawer__backdrop" aria-hidden="true"></div>

{% stylesheet %}
  /* ── Announcement bar ── */
  .moov-announcement {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px var(--section-inline-pad);
    background: var(--moov-amber);
    font-family: var(--font-body);
    font-size: clamp(0.8125rem, 0.2vw + 0.72rem, 0.9375rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--moov-white);
  }

  .moov-announcement__link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .moov-announcement__link:hover {
    opacity: 0.75;
  }

  .moov-announcement > * {
    min-width: 0;
    max-width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    text-align: center;
    text-wrap: balance;
    white-space: normal;
    overflow-wrap: break-word;
  }

  /* ── Header shell ── */
  .moov-header {
    position: relative;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--moov-black);
    border-bottom: 0.5px solid color-mix(in srgb, var(--moov-white) 7%, transparent);
    transition: background 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
  }

  /* Frosted glass on scroll */
  .moov-header.is-scrolled {
    background: color-mix(in srgb, var(--moov-black) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: color-mix(in srgb, var(--moov-white) 5%, transparent);
  }

  /* ── Nav grid ── */
  .moov-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    column-gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    height: 82px;
    box-sizing: border-box;
    width: min(var(--layout-max-width), calc(100% - 2 * var(--section-inline-pad)));
    margin-inline: auto;
    padding: 0;
  }

  /* ── Wordmark ── */
  .moov-nav__wordmark {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    text-decoration: none;
    justify-self: center;
    transition: opacity 0.2s;
  }

  .moov-nav__wordmark:hover {
    opacity: 0.75;
  }

  .moov-nav__wordmark-text {
    font-family: var(--font-hero), 'Cormorant Garamond', Georgia, serif;
    font-size: 20px;
    letter-spacing: 0.32em;
    font-weight: 300;
    color: var(--moov-white);
    line-height: 1;
    padding-right: 4px;
  }

  .moov-nav__reg {
    font-size: 8px;
    color: color-mix(in srgb, var(--moov-white) 32%, transparent);
    font-weight: 400;
    line-height: 1;
    margin-top: 7px;
    letter-spacing: 0;
    vertical-align: top;
  }

  .moov-nav__logo-img {
    display: block;
    width: {{ section.settings.logo_max_width | default: 120 }}px;
    height: auto;
    max-height: 40px;
    object-fit: contain;
  }

  .moov-nav__logo-img--drawer {
    width: {{ section.settings.logo_max_width | default: 120 | times: 0.8 | round }}px;
    max-height: 32px;
  }

  /* ── Nav links (shared) ── */
  .moov-nav__links {
    display: flex;
    align-items: center;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: flex-start;
    min-width: 0;
  }

  .moov-nav__link {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--moov-white);
    text-decoration: none;
    transition: opacity 0.25s ease;
    white-space: nowrap;
  }

  .moov-nav__link:hover {
    opacity: 0.65;
  }

  .moov-nav__link--active {
    opacity: 0.65;
  }

  /* ── Right group ── */
  .moov-nav__right {
    display: flex;
    align-items: center;
    gap: 30px;
    justify-content: flex-end;
    flex-shrink: 0;
    min-width: 0;
  }

  /* ── Get MOOV pill ── */
  .moov-nav__get-moov {
    background: var(--moov-amber);
    color: var(--moov-black);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 6px 16px;
    border-radius: 100px;
    border: 1px solid var(--moov-amber);
    white-space: nowrap;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .moov-nav__get-moov:hover {
    background: var(--moov-amber-hover);
    border-color: var(--moov-amber-hover);
    color: var(--moov-white);
  }

  /* ── Icons group (account + cart with vertical separator) ── */
  .moov-nav__icons {
    display: flex;
    align-items: center;
    gap: 18px;
    border-left: 0.5px solid color-mix(in srgb, var(--moov-white) 10%, transparent);
    padding-left: 22px;
  }

  .moov-nav__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--moov-white);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
    padding: 0;
  }

  .moov-nav__icon svg {
    width: 16px;
    height: 16px;
    stroke-width: 1.5;
  }

  .moov-nav__icon:hover {
    opacity: 0.65;
  }

  /* ── Cart ── */
  .moov-nav__cart {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--moov-white);
    transition: opacity 0.2s ease;
  }

  .moov-nav__cart:hover {
    opacity: 0.65;
  }

  .moov-nav__cart-badge {
    position: absolute;
    top: -5px;
    right: -7px;
    background: var(--moov-amber);
    color: var(--moov-white);
    font-family: var(--font-body);
    font-size: 7px;
    font-weight: 600;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* ── Hamburger — mobile only ── */
  .moov-nav__hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    color: var(--moov-white);
    cursor: pointer;
  }

  .moov-nav__hamburger svg {
    width: 22px;
    height: 22px;
  }

  /* ── Sticky modifier ── */
  .shopify-section-group-header-group:has(.moov-header--sticky:not(.moov-header--transparent)),
  .shopify-section-group-header-group:has(.moov-header--sticky:not(.moov-header--transparent)) > .shopify-section {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* Transparent header: wrapper must not interfere with fixed positioning */
  .shopify-section-group-header-group:has(.moov-header--transparent),
  .shopify-section-group-header-group:has(.moov-header--transparent) > .shopify-section {
    position: relative;
    z-index: 100;
  }

  /* ── Transparent modifier (homepage) ── */
  .moov-header--transparent {
    position: fixed;
    width: 100%;
    background: transparent;
    border-bottom-color: transparent;
  }

  .moov-header--transparent .moov-announcement {
    background: var(--moov-amber);
  }

  /* Transparent + scrolled: frosted dark */
  .moov-header--transparent.is-scrolled {
    background: color-mix(in srgb, var(--moov-black) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: color-mix(in srgb, var(--moov-white) 5%, transparent);
  }

  /* Transparent + over cream section: flip to cream bg */
  .moov-header--transparent.nav--light {
    background: var(--moov-cream);
    border-bottom-color: var(--moov-border-light);
  }

  .moov-header--transparent.nav--light .moov-announcement {
    background: var(--moov-amber);
  }

  .moov-header--transparent.nav--light .moov-nav__wordmark-text {
    color: var(--moov-text-primary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__logo-img {
    filter: invert(1);
  }

  .moov-header--transparent.nav--light .moov-nav__link {
    color: var(--moov-text-secondary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__link:hover {
    color: var(--moov-text-primary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__icon,
  .moov-header--transparent.nav--light .moov-nav__cart {
    color: var(--moov-text-secondary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__icon:hover,
  .moov-header--transparent.nav--light .moov-nav__cart:hover {
    color: var(--moov-text-primary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__icons {
    border-left-color: color-mix(in srgb, var(--moov-black) 10%, transparent);
  }

  .moov-header--transparent.nav--light .moov-nav__hamburger {
    color: var(--moov-text-primary-light);
  }

  /* ── Mobile drawer ── */
  .moov-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 360px;
    background: var(--moov-black);
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: var(--section-inline-pad);
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .moov-drawer.is-open {
    transform: translateX(0);
  }

  .moov-drawer__backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--moov-black) 50%, transparent);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .moov-drawer.is-open ~ .moov-drawer__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .moov-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .moov-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--moov-white);
    cursor: pointer;
    padding: 0;
  }

  .moov-drawer__nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1;
  }

  .moov-drawer__link {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-2xl);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--moov-white) 48%, transparent);
    text-decoration: none;
    transition: color 0.2s;
  }

  .moov-drawer__link:hover,
  .moov-drawer__link--active {
    color: var(--moov-white);
  }

  .moov-drawer__get-moov {
    display: block;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--moov-amber);
    color: var(--moov-white);
    text-decoration: none;
    border: 1px solid var(--moov-amber);
    border-radius: 100px;
    padding: 14px 28px;
    margin-top: auto;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .moov-drawer__get-moov:hover {
    background: var(--moov-amber-hover);
    border-color: var(--moov-amber-hover);
  }

  /* ── Mobile: below 768px ── */
  @media (max-width: 767px) {
    .moov-nav {
      grid-template-columns: auto 1fr auto;
      height: 64px;
    }

    .moov-nav__links {
      display: none;
    }

    .moov-nav__right .moov-nav__link,
    .moov-nav__right .moov-nav__get-moov {
      display: none;
    }

    .moov-nav__icons {
      border-left: none;
      padding-left: 0;
    }

    .moov-nav__wordmark {
      justify-self: flex-start;
    }

    .moov-nav__hamburger {
      display: flex;
      grid-column: 3;
      justify-self: end;
    }
  }
{% endstylesheet %}

{% javascript %}
  var header = document.querySelector('.moov-header');

  if (header) {
    var isTransparent = header.getAttribute('data-transparent') === 'true';

    // Frosted glass on scroll — applies to all header types
    window.addEventListener('scroll', function() {
      header.classList.toggle('is-scrolled', window.scrollY > 20);
    }, { passive: true });

    if (isTransparent) {
      var allSurfaceSections = document.querySelectorAll('[data-surface]');
      if (allSurfaceSections.length > 0) {
        function checkNavColor() {
          var headerBottom = header.offsetHeight;
          var elementAtNav = document.elementFromPoint(window.innerWidth / 2, headerBottom + 1);
          if (elementAtNav) {
            var section = elementAtNav.closest('[data-surface]');
            if (section) {
              var surface = section.getAttribute('data-surface');
              var isOverLight = surface === 'cream' || surface === 'white';
              header.classList.toggle('nav--light', isOverLight);
            }
          }
        }

        var navObserver = new IntersectionObserver(function() {
          checkNavColor();
        }, { threshold: [0, 0.1, 0.5, 1], rootMargin: '-1px 0px -90% 0px' });

        allSurfaceSections.forEach(function(s) { navObserver.observe(s); });

        var scrollTicking = false;
        window.addEventListener('scroll', function() {
          if (!scrollTicking) {
            requestAnimationFrame(function() {
              checkNavColor();
              scrollTicking = false;
            });
            scrollTicking = true;
          }
        });
      }
    }
  }

  /* Mobile drawer toggle */
  var hamburger = document.querySelector('.moov-nav__hamburger');
  var drawer = document.getElementById('moov-mobile-drawer');
  var drawerClose = document.querySelector('.moov-drawer__close');

  if (hamburger && drawer) {
    hamburger.addEventListener('click', function() {
      var isOpen = drawer.classList.toggle('is-open');
      drawer.setAttribute('aria-hidden', String(!isOpen));
      hamburger.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (drawerClose) drawerClose.addEventListener('click', closeDrawer);

  var backdrop = document.querySelector('.moov-drawer__backdrop');
  if (backdrop) backdrop.addEventListener('click', closeDrawer);
{% endjavascript %}

