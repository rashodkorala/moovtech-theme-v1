<style>
  @font-face {
    font-family: 'Artford';
    src: url('{{ 'Artford-Regular.woff2' | asset_url }}') format('woff2'),
         url('{{ 'Artford-Regular.otf' | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-wordmark:   'Artford', serif;
    --font-display:    'Times New Roman', Times, serif;
    --font-body:       'Helvetica Neue', Helvetica, Arial, sans-serif;

    --moov-black:        #0A0A09;
    --moov-cream:        #F5EEDC;
    --moov-cream-shadow: #EDE4C8;
    --moov-amber:        #F0B429;
    --moov-amber-glow:   rgba(240, 180, 41, 0.07);

    --moov-text-primary-dark:    #F5EEDC;
    --moov-text-secondary-dark:  rgba(245, 238, 220, 0.55);
    --moov-text-tertiary-dark:   rgba(245, 238, 220, 0.30);

    --moov-text-primary-light:   #0A0A09;
    --moov-text-secondary-light: rgba(10, 10, 9, 0.50);
    --moov-text-tertiary-light:  rgba(10, 10, 9, 0.30);

    --moov-border-dark:  rgba(245, 238, 220, 0.10);
    --moov-border-light: rgba(10, 10, 9, 0.10);
    --moov-border-amber: rgba(240, 180, 41, 0.35);
  }
</style>

<header class="moov-header full-width{% if section.settings.transparent_header %} moov-header--transparent{% endif %}"
  data-transparent="{{ section.settings.transparent_header }}"
>
  <nav class="moov-nav" aria-label="{{ 'general.accessibility.nav_label' | t }}">
    {%- comment -%} Left — Wordmark {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="moov-nav__wordmark" aria-label="{{ shop.name }}">
      MOOV
    </a>

    {%- comment -%} Centre — Nav links (desktop) {%- endcomment -%}
    <ul class="moov-nav__links" role="list">
      <li><a href="{{ section.settings.shop_url | default: routes.all_products_collection_url }}" class="moov-nav__link">{{ 'general.nav.shop' | t }}</a></li>
      <li><a href="{{ section.settings.about_url | default: '/pages/about' }}" class="moov-nav__link">{{ 'general.nav.about' | t }}</a></li>
      <li><a href="{{ section.settings.contact_url | default: '/pages/contact' }}" class="moov-nav__link">{{ 'general.nav.contact' | t }}</a></li>
    </ul>

    {%- comment -%} Right — Icons + Pre-order pill {%- endcomment -%}
    <div class="moov-nav__right">
      <a href="{{ routes.cart_url }}" class="moov-nav__icon" aria-label="{{ 'general.accessibility.cart' | t }}">
        {%- if cart.item_count > 0 -%}
          <span class="moov-nav__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="moov-nav__icon" aria-label="{{ 'general.accessibility.account' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
      {%- endif -%}

      <a
        href="{{ section.settings.preorder_url | default: routes.root_url }}"
        class="moov-nav__preorder"
      >
        {{- section.settings.preorder_label | default: 'Pre-order' | escape -}}
      </a>
    </div>

    {%- comment -%} Mobile hamburger {%- endcomment -%}
    <button
      class="moov-nav__hamburger"
      aria-label="{{ 'general.accessibility.menu' | t }}"
      aria-expanded="false"
      aria-controls="moov-mobile-drawer"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </nav>

  {%- comment -%} Mobile drawer {%- endcomment -%}
  <div id="moov-mobile-drawer" class="moov-drawer" aria-hidden="true">
    <div class="moov-drawer__header">
      <span class="moov-drawer__wordmark">MOOV</span>
      <button class="moov-drawer__close" aria-label="{{ 'general.accessibility.close' | t }}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <nav class="moov-drawer__nav">
      <a href="{{ section.settings.shop_url | default: routes.all_products_collection_url }}" class="moov-drawer__link">{{ 'general.nav.shop' | t }}</a>
      <a href="{{ section.settings.about_url | default: '/pages/about' }}" class="moov-drawer__link">{{ 'general.nav.about' | t }}</a>
      <a href="{{ section.settings.contact_url | default: '/pages/contact' }}" class="moov-drawer__link">{{ 'general.nav.contact' | t }}</a>
    </nav>
    <a
      href="{{ section.settings.preorder_url | default: routes.root_url }}"
      class="moov-drawer__preorder"
    >
      {{- section.settings.preorder_label | default: 'Pre-order' | escape -}}
    </a>
  </div>
</header>

{% stylesheet %}
  /* ── Default: Solid header (cream bg, dark text) ── */
  .moov-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 72px;
    display: flex;
    align-items: center;
    background: var(--moov-cream);
    border-bottom: 0.5px solid var(--moov-border-light);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .moov-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0 48px;
  }

  /* Wordmark */
  .moov-nav__wordmark {
    font-family: var(--font-wordmark);
    font-weight: 400;
    font-size: 22px;
    letter-spacing: 0.05em;
    color: var(--moov-text-primary-light);
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }

  .moov-nav__wordmark:hover {
    opacity: 0.7;
  }

  /* Centre links */
  .moov-nav__links {
    display: flex;
    align-items: center;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .moov-nav__link {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 0.03em;
    color: var(--moov-text-secondary-light);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .moov-nav__link:hover {
    color: var(--moov-text-primary-light);
  }

  /* Right group */
  .moov-nav__right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .moov-nav__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--moov-text-secondary-light);
    text-decoration: none;
    transition: color 0.2s;
    position: relative;
    border-radius: 50%;
  }

  .moov-nav__icon:hover {
    color: var(--moov-text-primary-light);
  }

  .moov-nav__cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 16px;
    height: 16px;
    background: var(--moov-amber);
    color: var(--moov-black);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    border-radius: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
  }

  /* Pre-order pill */
  .moov-nav__preorder {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.03em;
    color: var(--moov-text-primary-light);
    text-decoration: none;
    border: 0.5px solid rgba(10, 10, 9, 0.25);
    border-radius: 999px;
    padding: 9px 20px;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .moov-nav__preorder:hover {
    opacity: 0.7;
  }

  /* Hamburger — mobile only */
  .moov-nav__hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    color: var(--moov-text-primary-light);
    cursor: pointer;
  }

  /* ── Transparent modifier (homepage) ── */
  .moov-header--transparent {
    position: fixed;
    background: transparent;
    border-bottom-color: transparent;
  }

  .moov-header--transparent .moov-nav__wordmark {
    color: var(--moov-text-primary-dark);
  }

  .moov-header--transparent .moov-nav__link {
    color: var(--moov-text-secondary-dark);
  }

  .moov-header--transparent .moov-nav__link:hover {
    color: var(--moov-text-primary-dark);
  }

  .moov-header--transparent .moov-nav__icon {
    color: var(--moov-text-secondary-dark);
  }

  .moov-header--transparent .moov-nav__icon:hover {
    color: var(--moov-text-primary-dark);
  }

  .moov-header--transparent .moov-nav__preorder {
    color: var(--moov-amber);
    border-color: var(--moov-border-amber);
  }

  .moov-header--transparent .moov-nav__hamburger {
    color: var(--moov-text-primary-dark);
  }

  /* Transparent + scrolled: solid dark bg */
  .moov-header--transparent.is-scrolled {
    background: var(--moov-black);
    border-bottom-color: var(--moov-border-dark);
  }

  /* Transparent + over cream section: flip to cream bg with dark text */
  .moov-header--transparent.nav--light {
    background: var(--moov-cream);
    border-bottom-color: var(--moov-border-light);
  }

  .moov-header--transparent.nav--light .moov-nav__wordmark {
    color: var(--moov-text-primary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__link {
    color: var(--moov-text-secondary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__link:hover {
    color: var(--moov-text-primary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__icon {
    color: var(--moov-text-secondary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__icon:hover {
    color: var(--moov-text-primary-light);
  }

  .moov-header--transparent.nav--light .moov-nav__preorder {
    color: var(--moov-text-primary-light);
    border-color: rgba(10, 10, 9, 0.25);
  }

  .moov-header--transparent.nav--light .moov-nav__hamburger {
    color: var(--moov-text-primary-light);
  }

  /* ── Mobile drawer ─────────────────────────── */
  .moov-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 360px;
    background: var(--moov-black);
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: 24px;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .moov-drawer.is-open {
    transform: translateX(0);
  }

  .moov-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .moov-drawer__wordmark {
    font-family: var(--font-wordmark);
    font-weight: 400;
    font-size: 22px;
    letter-spacing: 0.05em;
    color: var(--moov-text-primary-dark);
  }

  .moov-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--moov-text-primary-dark);
    cursor: pointer;
    padding: 0;
  }

  .moov-drawer__nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1;
  }

  .moov-drawer__link {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 24px;
    color: var(--moov-text-secondary-dark);
    text-decoration: none;
    transition: color 0.2s;
  }

  .moov-drawer__link:hover {
    color: var(--moov-text-primary-dark);
  }

  .moov-drawer__preorder {
    display: block;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 0.03em;
    color: var(--moov-amber);
    text-decoration: none;
    border: 0.5px solid var(--moov-border-amber);
    border-radius: 999px;
    padding: 14px 28px;
    margin-top: auto;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .moov-drawer__preorder:hover {
    background: var(--moov-amber);
    color: var(--moov-black);
  }

  /* ── Responsive ────────────────────────────── */
  @media (max-width: 767px) {
    .moov-nav {
      padding: 0 24px;
    }

    .moov-nav__links,
    .moov-nav__preorder {
      display: none;
    }

    .moov-nav__hamburger {
      display: flex;
    }
  }
{% endstylesheet %}

{% javascript %}
  var header = document.querySelector('.moov-header');

  if (header) {
    var isTransparent = header.getAttribute('data-transparent') === 'true';

    if (isTransparent) {
      /* Scroll state — only needed for transparent header */
      window.addEventListener('scroll', function() {
        header.classList.toggle('is-scrolled', window.scrollY > 20);
      });

      /* Nav colour switching for transparent header.
         Detects data-surface sections and flips nav colours accordingly. */
      var allSurfaceSections = document.querySelectorAll('[data-surface]');
      if (allSurfaceSections.length > 0) {
        function checkNavColor() {
          var headerBottom = 72;
          var elementAtNav = document.elementFromPoint(window.innerWidth / 2, headerBottom + 1);
          if (elementAtNav) {
            var section = elementAtNav.closest('[data-surface]');
            if (section) {
              var isOverCream = section.getAttribute('data-surface') === 'cream';
              header.classList.toggle('nav--light', isOverCream);
            }
          }
        }

        var navObserver = new IntersectionObserver(function() {
          checkNavColor();
        }, { threshold: [0, 0.1, 0.5, 1], rootMargin: '-1px 0px -90% 0px' });

        allSurfaceSections.forEach(function(s) { navObserver.observe(s); });

        var scrollTicking = false;
        window.addEventListener('scroll', function() {
          if (!scrollTicking) {
            requestAnimationFrame(function() {
              checkNavColor();
              scrollTicking = false;
            });
            scrollTicking = true;
          }
        });
      }
    }
  }

  /* Smooth scroll for nav links */
  document.querySelectorAll('.moov-nav__scroll-link').forEach(function(link) {
    link.addEventListener('click', function(e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      var headerHeight = 72;
      var top = target.getBoundingClientRect().top + window.pageYOffset - headerHeight - 16;
      window.scrollTo({ top: top, behavior: 'smooth' });

      var drawer = document.getElementById('moov-mobile-drawer');
      if (drawer && drawer.classList.contains('is-open')) {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    });
  });

  /* Mobile drawer toggle */
  var hamburger = document.querySelector('.moov-nav__hamburger');
  var drawer = document.getElementById('moov-mobile-drawer');
  var drawerClose = document.querySelector('.moov-drawer__close');

  if (hamburger && drawer) {
    hamburger.addEventListener('click', function() {
      var isOpen = drawer.classList.toggle('is-open');
      drawer.setAttribute('aria-hidden', String(!isOpen));
      hamburger.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });
  }

  if (drawerClose && drawer) {
    drawerClose.addEventListener('click', function() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "MOOV Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "Transparent header",
      "info": "Use a transparent header that overlaps page content. Recommended for pages with a full-width hero image.",
      "default": false
    },
    {
      "type": "header",
      "content": "t:general.navigation"
    },
    {
      "type": "url",
      "id": "shop_url",
      "label": "Shop link"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "About link"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact link"
    },
    {
      "type": "header",
      "content": "t:general.primary_button"
    },
    {
      "type": "text",
      "id": "preorder_label",
      "label": "Pre-order button label",
      "default": "Pre-order"
    },
    {
      "type": "url",
      "id": "preorder_url",
      "label": "Pre-order button link"
    }
  ]
}
{% endschema %}
