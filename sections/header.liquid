<header class="site-header full-width">
  <div class="site-header__pill-wrap">
    <div class="site-header__pill">

      {%- comment -%} Logo {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
        <img
          src="{{ 'moov-logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          class="site-header__logo-img"
          width="90"
          height="30"
          loading="eager"
        >
      </a>

      {%- comment -%} Nav links {%- endcomment -%}
      <nav class="site-header__nav" aria-label="{{ 'general.accessibility.nav_label' | t }}">
        <ul class="site-header__nav-links" role="list">
          <li><a href="#shopify-section-product_intro" class="site-header__nav-link site-header__scroll-link">The Alarm</a></li>
          <li><a href="#shopify-section-app_section" class="site-header__nav-link site-header__scroll-link">The App</a></li>
          <li><a href="#shopify-section-faq" class="site-header__nav-link site-header__scroll-link">FAQ</a></li>
        </ul>
      </nav>

      {%- comment -%} Icons {%- endcomment -%}
      <div class="site-header__icons">
        {%- if shop.customer_accounts_enabled -%}
          <shopify-account
            menu="{{ section.settings.customer_account_menu }}"
            class="site-header__icon-btn"
            aria-label="{{ 'general.accessibility.account' | t }}"
          >
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {%- endif -%}

        <a href="{{ routes.cart_url }}" class="site-header__icon-btn site-header__cart" aria-label="{{ 'general.accessibility.cart' | t }}">
          {%- if cart.item_count > 0 -%}
            <span class="site-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
          {{ 'icon-cart.svg' | inline_asset_content }}
        </a>
      </div>

    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 16px 24px;
    pointer-events: none; /* let clicks pass through the gap around the pill */
  }

  .site-header__pill-wrap {
    max-width: 840px;
    margin: 0 auto;
    pointer-events: auto;
  }

  .site-header__pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 14px 24px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }

  /* Logo */
  .site-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }

  .site-header__logo:hover {
    opacity: 0.7;
  }

  .site-header__logo-img {
    height: 28px;
    width: auto;
    display: block;
    /* moov-logo.png is white — invert for light backgrounds */
    filter: invert(1);
  }

  /* Nav */
  .site-header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .site-header__nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #1a1a1a;
    text-decoration: none;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .site-header__nav-link:hover {
    opacity: 0.6;
  }

  .site-header__nav-link--active {
    font-weight: 500;
  }

  /* Icons */
  .site-header__icons {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .site-header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #1a1a1a;
    text-decoration: none;
    transition: background 0.2s;
    position: relative;
  }

  .site-header__icon-btn:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .site-header__icon-btn svg {
    width: 20px;
    height: 20px;
  }

  .site-header__cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 16px;
    height: 16px;
    background: #1a1a1a;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 500;
    border-radius: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .site-header {
      padding: 12px 16px;
    }

    .site-header__pill {
      padding: 12px 18px;
      gap: 16px;
    }

    .site-header__nav {
      display: none;
    }

    .site-header__logo-img {
      height: 24px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.site-header__scroll-link').forEach(function(link) {
    link.addEventListener('click', function(e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      var headerHeight = document.querySelector('.site-header') ? document.querySelector('.site-header').offsetHeight : 0;
      var top = target.getBoundingClientRect().top + window.pageYOffset - headerHeight - 16;
      window.scrollTo({ top: top, behavior: 'smooth' });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
